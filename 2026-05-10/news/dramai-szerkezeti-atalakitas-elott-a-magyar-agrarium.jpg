  <script type="text/javascript">
    /*
     * Force-styles the dynamically injected gate banner.
     * The ad is rendered into the DOM after page load, so we observe mutations
     * and then apply inline (!important) styles to constrain width and center it.
     */
    document.addEventListener("DOMContentLoaded", () => {
        function gateBannerDisplay() {
            const kapuBanner = document.querySelector("div.kapubanner.rendered");
            if (!kapuBanner) {
                return;
            }
            kapuBanner.style.setProperty("margin-left", "auto", "important");
            kapuBanner.style.setProperty("margin-right", "auto", "important");
            kapuBanner.style.setProperty("max-width", "1140px", "important");
        }

        const observer = new MutationObserver(() => {
            if (gateBannerDisplay()) {
                observer.disconnect();
            }
        });

        observer.observe(document.body, {
            childList: true,
            subtree: true,
        });

        // Check immediately once loaded
        gateBannerDisplay();
    });
</script>


    
      
        
          

