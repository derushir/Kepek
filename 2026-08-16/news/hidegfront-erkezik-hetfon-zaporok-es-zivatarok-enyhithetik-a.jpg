ca193c-420c-41b8-98e3-b155f5950483":{"__typename":"Tag","id":"69ca193c-420c-41b8-98e3-b155f5950483","slug":"zivatarok","name":"zivatarok","description":"","url":"https://444.hu/tag/zivatarok"},"Tag:756b1c90-c623-4795-bf4d-d756065fc91a":{"__typename":"Tag","id":"756b1c90-c623-4795-bf4d-d756065fc91a","slug":"duna","name":"Duna","description":"","url":"https://444.hu/tag/duna"},"Tag:93aa7108-6c33-48d4-a1b1-ae2fb16fa540":{"__typename":"Tag","id":"93aa7108-6c33-48d4-a1b1-ae2fb16fa540","slug":"hidegfront","name":"hidegfront","description":"","url":"https://444.hu/tag/hidegfront"},"Tag:a2cd7af8-973a-46a1-b254-c2beb08ee0f3":{"__typename":"Tag","id":"a2cd7af8-973a-46a1-b254-c2beb08ee0f3","slug":"zaporok","name":"záporok","description":"","url":"https://444.hu/tag/zaporok"},"Tag:cb0988ed-fc89-4df9-bb1f-ea4b9ab2373b":{"__typename":"Tag","id":"cb0988ed-fc89-4df9-bb1f-ea4b9ab2373b","slug":"eso","name":"eső","description":"","url":"https://444.hu/tag/eso"},"Tag:ed6278b6-bdb7-4fbe-b43e-39d1be7c8f26":{"__typename":"Tag","id":"ed6278b6-bdb7-4fbe-b43e-39d1be7c8f26","slug":"aszaly","name":"aszály","description":"","url":"https://444.hu/tag/aszaly"},"Tag:fed55cd9-220c-4c8d-a8fd-381901aa401d":{"__typename":"Tag","id":"fed55cd9-220c-4c8d-a8fd-381901aa401d","slug":"dunantul","name":"dunántúl","description":"","url":"https://444.hu/tag/dunantul"},"Format:7a6036e1-c587-11f0-9297-525400d76232":{"__typename":"Format","id":"7a6036e1-c587-11f0-9297-525400d76232","slug":"cikk","name":"Cikk","description":null,"url":"https://444.hu/format/cikk","mateType":"DEFAULT"},"Article:cdcd0b9d-a17f-5a2c-b9d9-78b38d00c7f3":{"__typename":"Article","id":"cdcd0b9d-a17f-5a2c-b9d9-78b38d00c7f3","featuredImage":{"__ref":"MediaItem:c7d51147-54bf-54f6-8a37-0e37e1822ef5"},"title":"Hidegfront hoz egy kis esőt hétfőn","body":[[{"type":"core/paragraph","params":{},"content":"Az aszálynak sajnos még koránt sem lesz vége, de egy hidegfront hatására többfelé, alakulhatnak ki záporok, zivatarok hétfőn, amelyek akár zivatarláncba rendeződhetnek, írja az \u003ca href=\"https://www.idokep.hu/hirek/vegre-jon-egy-kis-eso\" target=\"_blank\" \u003eidokep.hu\u003c/a\u003e."},{"type":"core/paragraph","params":{},"content":"A frissítő hidegfronti hatás elsősorban a Dunántúlt fogja érinteni, helyenként pedig jégeső, felhőszakadás és viharos kifutószél is kísérheti a zivatarokat. Kedden keleten és északkelet örülhetnek majd egy kis esőnek záporok, zivatarok formájában. "},{"type":"image","params":{"src":"https://4cdn.hu/kraken/image/upload/s--VghFpykq--/c_limit,w_760/7UalbRCVnN5f1T4yis.jpeg","id":"c7d51147-54bf-54f6-8a37-0e37e1822ef5","showauthor":"true","alt":"","link":"","mediaItem":{"caption":"","author":"Varga György/MTI/MTVA","url":"https://assets.4cdn.hu/kraken/7UalbRCVnN5f1T4yis.jpeg","creditType":"Fotó","sourceLink":"","bucket":{"id":"70b47701-2c71-55dc-95b1-7ac5be6b8a21","slug":"444","name":"444","__typename":"Bucket"},"__typename":"Image","id":"c7d51147-54bf-54f6-8a37-0e37e1822ef5","width":5646,"height":3764,"variations":[{"url":"https://assets.4cdn.hu/kraken/7UalbRCVnN5f1T4yis-xxs.jpeg","size":"xxs","width":96,"height":64,"__typename":"ImageVariation"},{"url":"https://assets.4cdn.hu/kraken/7UalbRCVnN5f1T4yis-xs.jpeg","size":"xs","width":360,"height":240,"__typename":"ImageVariation"},{"url":"https://assets.4cdn.hu/kraken/7UalbRCVnN5f1T4yis-sm.jpeg","size":"sm","width":640,"height":427,"__typename":"ImageVariation"},{"url":"https://assets.4cdn.hu/kraken/7UalbRCVnN5f1T4yis-md.jpeg","size":"md","width":768,"height":512,"__typename":"ImageVariation"},{"url":"https://assets.4cdn.hu/kraken/7UalbRCVnN5f1T4yis-lg.jpeg","size":"lg","width":1366,"height":911,"__typename":"ImageVariation"},{"url":"https://assets.4cdn.hu/kraken/7UalbRCVnN5f1T4yis-xl.jpeg","size":"xl","width":1920,"height":1280,"__typename":"ImageVariation"},{"url":"https://assets.4cdn.hu/kraken/7UalbRCVnN5f1T4yis-xxl.jpeg","size":"xxl","width":2560,"height":1707,"__typename":"ImageVariation"}]}},"content":""},{"type":"core/paragraph","params":{},"content":"Az Időkép szerint az átvonuló front azonban csak lokálisan hozhat kiadósabb, 15–20 millimétert meghaladó csapadékot. Az ország nagy részén mindössze néhány milliméternyi esőre van kilátás, sőt a középső országrészben teljesen szárazon hagyott területek is lehetnek."},{"type":"core/paragraph","params":{},"content":"Jó hír viszont, hogy Alsó- és Felső-Ausztriában 50–80 milliméter is lehullhat a Duna vízgyűjtő területein, ami mérsékelheti, akár meg is állíthatja a folyó jelenleg is zajló apadását."}]],"slug":"hidegfront-hoz-egy-kis-esot-hetfon","publishedAt":"2026-08-16T14:14:10+02:00","bucket":{"__ref":"Bucket:70b47701-2c71-55dc-95b1-7ac5be6b8a21"},"excerpt":"Az ország közepe azonban várhatóan száraz marad.","createdAt":"2026-08-16T14:14:13+02:00","updatedAt":"2026-08-16T14:14:13+02:00","authors":[{"__ref":"Author:e4de7cc3-e38d-427f-8fc9-b65c40f4fa5a"}],"categories":[{"__ref":"Category:fec0b651-5316-498b-9705-98be8faeb348"}],"tags":[{"__ref":"Tag:69ca193c-420c-41b8-98e3-b155f5950483"},{"__ref":"Tag:756b1c90-c623-4795-bf4d-d756065fc91a"},{"__ref":"Tag:93aa7108-6c33-48d4-a1b1-ae2fb16fa540"},{"__ref":"Tag:a2cd7af8-973a-46a1-b254-c2beb08ee0f3"},{"__ref":"Tag:cb0988ed-fc89-4df9-bb1f-ea4b9ab2373b"},{"__ref":"Tag:ed6278b6-bdb7-4fbe-b43e-39d1be7c8f26"},{"__ref":"Tag:fed55cd9-220c-4c8d-a8fd-381901aa401d"}],"collections":[],"meta":[{"__typename":"Meta","key":"description","value":""},{"__typename":"Meta","key":"excerpt","value":"Az ország közepe azonban várhatóan száraz marad."},{"__typename":"Meta","key":"featuredImage","value":"c7d51147-54bf-54f6-8a37-0e37e1822ef5"},{"__typename":"Meta","key":"og:description","value":""},{"__typename":"Meta","key":"og:image","value":""},{"__typename":"Meta","key":"og:title","value":""},{"__typename":"Meta","key":"title","value":""}],"options":[{"__typename":"Option","key":"jumbotron","value":""},{"__typename":"Option","key":"title_alignment","value":""},{"__typename":"Option","key":"color_scheme","value":""},{"__typename":"Option","key":"title_inner","value":false},{"__typename":"Option","key":"background_shadow","value":false},{"__typename":"Option","key":"external_url","value":""},{"__typename":"Option","key":"lead_av","value":""},{"__typename":"Option","key":"comments_enabled","value":true},{"__typename":"Option","key":"is_anonym","value":false},{"__typename":"Option","key":"template","value":""},{"__typename":"Option","key":"language","value":"hu"},{"__typename":"Option","key":"stream","value":true}],"url":"https://444.hu/2026/08/16/hidegfront-hoz-egy-kis-esot-hetfon","format":{"__ref":"Format:7a6036e1-c587-11f0-9297-525400d76232"},"partners":[],"relatedArticles":[],"userHasAccess":true},"ROOT_QUERY":{"__typename":"Query","content({\"fromBucket\":{\"column\":\"SLUG\",\"operator\":\"IN\",\"value\":[\"444\",\"jo\"]},\"publishedAt\":\"2026-08-16\",\"slug\":\"hidegfront-hoz-egy-kis-esot-hetfon\"})":{"__ref":"Article:cdcd0b9d-a17f-5a2c-b9d9-78b38d00c7f3"}}}}</script><script type="fastboot/shoebox" id="shoebox-abgroup">null</script><script type="x/boundary" id="fastboot-body-end"></script>

    
