  <div class="magazin-container custom_row">
    <div class="main-heading">
      <h2 class="main">
        <a title="Film Magazin" href="/film_magazin">Magazin</a>
      </h2>
      <span class="icon-icon-arrow-right"></span>
      <div class="category-switch">
        <button id="magazin-options-more-btn" class="item dropdown-btn-mobile" style="position:relative;">
          <span>Több</span><i class="arrow down"></i>
          <div id="magazin-options-more" class="options-mobile" style="display:none;">
            <div class="option" style="padding-bottom: 4px;"><span class="menu-more-first-option">Több</span><i class="arrow up"></i></div>
            <div class="red-border"></div>
            <!--<div magazin-switch="true" magazin-category="1" class="option mobile-dropdown">Boxoffice</div>-->
            <div magazin-switch="true" magazin-category="2" class="option mobile-dropdown">Kult</div>
            <div magazin-switch="true" magazin-category="6" class="option mobile-dropdown">Képekben</div>
            <div magazin-switch="true" magazin-category="7" class="option mobile-dropdown">Toplista</div>
            <div magazin-switch="true" magazin-category="22" class="option mobile-dropdown">Streaming</div>
            <div magazin-switch="true" magazin-category="8" class="option mobile-dropdown">Sztárhír</div>
            <div magazin-switch="true" magazin-category="17" class="option mobile-dropdown">Art</div>
            <div magazin-switch="true" magazin-category="20" class="option mobile-dropdown">Kritika</div>
          </div>
        </button>
        <button type="button" magazin-switch="true" magazin-category="20" class="item desktop" style="margin-right: 0;">Kritika</button>
        <button type="button" magazin-switch="true" magazin-category="17" class="item desktop">Art</button>
        <button type="button" magazin-switch="true" magazin-category="8" class="item desktop">Sztárhír</button>
        <button type="button" magazin-switch="true" magazin-category="22" class="item desktop">Streaming</button>
        <button type="button" magazin-switch="true" magazin-category="7" class="item desktop">Toplista</button>
        <button type="button" magazin-switch="true" magazin-category="6" class="item desktop">Képekben</button>
        <button type="button" magazin-switch="true" magazin-category="2" class="item desktop">Kult</button>
        <!--<button type="button" magazin-switch="true" magazin-category="1" class="item desktop">Boxoffice</button>-->
        <button type="button" magazin-switch="true" magazin-category="3" class="item">Mit nézzek?</button>
        <button type="button" magazin-switch="true" magazin-category="4" class="item">Filmhír</button>
      </div>
    </div>

    <script>
      $(".category-switch #magazin-options-more-btn").on("click", function () {
        $(this).children(".options-mobile").toggle();
      });
      
      $("body").on("click", "*", function(event) {
        
        if(event.target.id === "magazin-options-more-btn" || event.target.parentElement.id === "magazin-options-more-btn") return false;
        
        let $img_more_menu = $("#magazin-options-more");
        
        if(!$img_more_menu.is(event.target) && $img_more_menu.has(event.target).length === 0) {
          $img_more_menu.hide();
        }
      });
      
      $(window).on("scroll", function(event) {
        $("#magazin-options-more").hide();
      });
    </script>

    <style>
      .magazin-container .category-switch .item.desktop {
        display: none;
      }
      .magazin-container .category-switch .dropdown-btn-mobile {
        display: none;
      }
      .magazin-container .category-switch .dropdown-btn-mobile .options-mobile {
        background-color: #FFFFFF;
        border: 1px solid #ECEFF1;
        box-shadow: 0 2px 4px 0 rgba(0,0,0,0.2);
        padding: 10px;
        display: none;
        position: absolute;
        top: -13px;
        left: -21px;
        color: #fff;
        z-index: 900;
        text-align: left;
        font-size: 12px;
        text-transform: none;
      }
      .magazin-container .category-switch .dropdown-btn-mobile .options-mobile .option {
        background-color: #FFFFFF;
        font-family: Kanit;
        font-size: 16px;
        line-height: 17px;
        color: #4A4A4A;
        letter-spacing: 0;
        padding: 5px 10px;
        white-space: nowrap;
        width: 100%;
        text-align: left;
        opacity: 0.9;
      }
      .magazin-container .category-switch .dropdown-btn-mobile .options-mobile .option:hover {
        background-color: #ECEFF1;
        cursor: pointer;
      }

      .magazin-container .category-switch .dropdown-btn-mobile .options-mobile .red-border {
        border-top: 4px solid var(--main-red);
        margin: 0 10px 5px 10px;
      }


      .magazin-container .category-switch {
        border-bottom: 4px solid #F1F1F1;
        float: right;
        margin: 2px 0 0 0;
      }
      .magazin-container .category-switch .item {
        float: right;
        text-align: center;
        border: 0;
        color: #87A6B5;
        position: relative;
        font-size: 17px;
        margin: 5px 30px 0 0;
        padding: 0;
        background-color: #FFF;
        line-height: 24px;
        font-family: Kanit;
      }
      .magazin-container .category-switch .item.active {
        border-bottom: 4px solid var(--main-red);
        margin-bottom: -4px;
        color: var(--main-blue);
      }
      .magazin-container .category-switch .item:hover {
        color: var(--main-blue);
      }


      /* newest articles - start */
      .magazin-container .left_col .magazin-newest-articles {
        margin-top: 40px;
      }
      .magazin-container .left_col .magazin-newest-articles .item {
        margin-bottom: 20px;
      }
      .magazin-container .left_col .magazin-newest-articles .item .text {
        width:calc(100% - 117px);
        display: -webkit-box;
        -webkit-line-clamp: 4;
        -webkit-box-orient: vertical;
        height: auto;
        overflow: hidden;
      }
      .magazin-container .left_col .magazin-newest-articles .item .text h3 {
        text-transform: none;
        color: var(--main-blue);
        font-family: "Source Sans Pro";
        font-size: 16px;
        letter-spacing: 0;
        line-height: 20px;
        margin: 0 0 0 10px;
        height: 83px;
      }
      /* newest articles - end */

      /* top 2 articles - start */
      .magazin-container .left_col #magazinhome-desktop-all article h3 {
        text-transform: none;
        font-family: "Source Sans Pro";
        font-size: 20px;
        margin-bottom: 0;
        font-weight: 600;
        letter-spacing: 0;
        line-height: 22px;
        color: var(--main-blue);
      }
      .magazin-container .left_col #magazinhome-desktop-all article div.description {
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
      }
      .magazin-container .left_col #magazinhome-desktop-all article div.description p {
