  </style>
  <script type="text/javascript">
    
    max_width = 0;
    $(".box-office-container .boxoffice-listing.vilag .item .value").each(function(index) {
      if(max_width < $(this)[0].getBoundingClientRect().width) max_width = $(this)[0].getBoundingClientRect().width;
      //console.log(index + " : " + $(this)[0].getBoundingClientRect().width);
    });
    $(".box-office-container .boxoffice-listing.vilag .item .value").width(max_width);
    title_parent_width = $(".box-office-container .boxoffice-listing.vilag .item .title").parent().width();
    $(".box-office-container .boxoffice-listing.vilag .item .title").width((title_parent_width - (max_width + 7)));
    
    
    $(".boxoffice-home-switch button[data-boxoffice-cat='vilag'], .boxoffice-home-switch button[data-boxoffice-cat='hazai']").on("click", function() {
      
      $(".boxoffice-home-switch button").removeClass("active");
      $(this).addClass("active");
      $(".boxoffice-listing").hide();
      $(".boxoffice-listing[data-boxoffice-cat='"+$(this).attr("data-boxoffice-cat")+"']").show();
      
      alignBoxofficeData($(this));
      
    });
    
    function alignBoxofficeData(btn) {
      // set table's cell width - start
      max_width = 0;
      $(".box-office-container .boxoffice-listing."+btn.attr("data-boxoffice-cat")+" .item .value").each(function(index) {
        //console.log(index + " : " + $(this)[0].getBoundingClientRect().width);
        if(max_width < $(this)[0].getBoundingClientRect().width) max_width = $(this)[0].getBoundingClientRect().width;
      });
      
      $(".box-office-container .boxoffice-listing."+btn.attr("data-boxoffice-cat")+" .item .value").width(max_width);
      title_parent_width = $(".box-office-container .boxoffice-listing."+btn.attr("data-boxoffice-cat")+" .item .title").parent().width();
      $(".box-office-container .boxoffice-listing."+btn.attr("data-boxoffice-cat")+" .item .title").width((title_parent_width - (max_width + 7)));
      // set table's cell width - end
    }
    
    $(window).resize(function() {
      if($(".boxoffice-home-switch button[data-boxoffice-cat='vilag']").hasClass("active")) {
        boxoffice_cat = "vilag";
      }
      else {
        boxoffice_cat = "hazai";
      }
      alignBoxofficeData($(".boxoffice-home-switch button[data-boxoffice-cat='"+boxoffice_cat+"']"));
    });


  </script>
