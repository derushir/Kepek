        "genres" : "dráma, thriller, sci-fi"
      }
    

$(document).ready(function(){
  $("#hbb-player-inner").slick({
    dots: false,
    infinite: true,
    speed: 300,
    slidesToShow: 1,
    arrows: true
  });

  $("#hbb-player-inner-placeholder").remove();

  var hbb_slick_index_last = 0;

  $("#hbb-player-inner").on("swipe afterChange", function(event, slick, direction){
    //load images
    lazyLoadOnAction("lazyTrailerBg",1);
    
    if(window.innerWidth > 1023) {
      $("html, body").stop().animate({scrollTop:$("#homebigbox").offset().top}, "500", "swing");
    }

    var hbb_slick_index = $(this).slick("slickCurrentSlide");

    $(".owl-trailer-thumb img").removeClass("selected");
    $(".owl-trailer-thumb .poster-item-img[data-index='"+hbb_slick_index+"']").addClass("selected");

    if (hbb_slick_index!=hbb_slick_index_last){
      hbbSetActiveItem(hbb_slick_index);
    }

    // nastavit index poslednej aktivnej polozky
    hbb_slick_index_last = hbb_slick_index;
  });
});

function hbbSetActiveItem(hbb_slick_index){
  var hbb_video_ytcode = $(".hbb-player-video-item[data-index='"+hbb_slick_index+"']").data("ytcode");
  var hbb_video_movie_name = $(".hbb-player-video-item[data-index='"+hbb_slick_index+"']").data("movie-name");
  var hbb_video_movie_name_orig = $(".hbb-player-video-item[data-index='"+hbb_slick_index+"']").data("movie-name-orig");
  var hbb_video_movie_rating = $(".hbb-player-video-item[data-index='"+hbb_slick_index+"']").data("movie-rating");
  var hbb_video_movie_year = $(".hbb-player-video-item[data-index='"+hbb_slick_index+"']").data("movie-year");
  var hbb_video_movie_slug = $(".hbb-player-video-item[data-index='"+hbb_slick_index+"']").data("movie-slug");
  var hbb_video_movie_premier_hu = $(".hbb-player-video-item[data-index='"+hbb_slick_index+"']").data("premier-hu");
  var hbb_video_movie_where_to_watch = $(".hbb-player-video-item[data-index='"+hbb_slick_index+"']").data("where-to-watch");
  var hbb_video_movie_genres = $(".hbb-player-video-item[data-index='"+hbb_slick_index+"']").data("genres");

  //$("#hbb-player-movie-rating > span").removeClass("cp"+hbb_video_movie_rating_last).addClass("cp"+hbb_video_movie_rating);
  if(hbb_video_movie_rating == 0) {
    $("#hbb-player-movie-rating span").html("");
    $("#hbb-player-movie-rating").css("margin-right","0");
  }
  else {
    $("#hbb-player-movie-rating span").html(hbb_video_movie_rating+"%");
    $("#hbb-player-movie-rating").css("margin-right","5px");
  }
  $("#hbb-player-movie-name-link").attr("href", hbb_video_movie_slug);
  $("#hbb-player-movie-name").html(hbb_video_movie_name);
  $("#hbb-player-movie-name-original").html(hbb_video_movie_name_orig);
  //$("#hbb-player-movie-year").html(hbb_video_movie_year);
  
  if(hbb_video_movie_premier_hu != "") {
    $("#hbb-player-movie-premier-hu").html("Premier(HU): " + hbb_video_movie_premier_hu);
  }
  else {
    $("#hbb-player-movie-premier-hu").html("");
  }
  if(hbb_video_movie_where_to_watch != "") {
    $("#hbb-player-movie-where-to-watch").html((hbb_video_movie_premier_hu != "" ? "| ": "") + hbb_video_movie_where_to_watch);
  }
  else {
    $("#hbb-player-movie-where-to-watch").html("");
  }
  if(hbb_video_movie_genres != "") {
    $("#hbb-player-movie-genres").html((hbb_video_movie_premier_hu != "" || hbb_video_movie_where_to_watch != "" ? "| ": "") + hbb_video_movie_genres);
  }
  else {
    $("#hbb-player-movie-genres").html("");
  }

  $("#hbb-player-play-btn").attr("rel", hbb_video_ytcode);
  $("#hbb-player-play-btn-mobile").attr("rel", hbb_video_ytcode);

  hbb_video_movie_rating_last = hbb_video_movie_rating;

  $(".owl-trailer-thumb img").removeClass("selected");
  $(".owl-trailer-thumb .poster-item-img[data-index='"+hbb_slick_index+"']").addClass("selected");
  
  setTimeout(function(){
    $("#hp-posters.owl-home-trailers").trigger("to.owl.carousel", [hbb_slick_index, 250]);
  }, 250);

  //$("#hp-posters .owl-wrapper").trigger("owl.goTo", hbb_slick_index);
}
</script>
