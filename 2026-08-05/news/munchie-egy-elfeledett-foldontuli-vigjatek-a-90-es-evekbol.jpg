	<div class="modal fade" id="searchModal" tabindex="-1" role="dialog" aria-labelledby="searchModalLabel" aria-hidden="true">
	<div class="modal-dialog container" role="document">
		<div class="modal-content">
		<div class="modal-header">
			<form class="search-modal-title-form" onsubmit="return searchSubmitFunc()"  action="https://www.mafab.hu/search/" method="post" accept-charset="utf-8">
				<i class="fa fa-search search-modal-title-icon" aria-hidden="true"></i>
				<input id="topic_title" name="search"  type="text" placeholder="Keress filmeket, hírességeket..." class="" >
			</form>
			<button type="button" class="close" data-dismiss="modal" aria-label="Close">
			<i class="fa fa-close"></i>
			</button>
		</div>

		<div class="modal-body" style="position:relative; overflow:auto;">
			<div class="advanced_options">
				<div class="col-xs-16 col-sm-16 col-md-16 col-lg-16 sidebox-content movie-profile-heading">
					<!-- <a href="/filmek/filmek/1/" id="movie_adv_search">
						részletes film szűrés &nbsp;<i class="fa fa-sliders"></i>
					</a> -->
				</div>
			</div>
			<div class="screencast">
			</div>
			<div class="res" style="display:none;">
			</div>
		</div>

		</div>
	</div>
	</div>
	<script type="text/javascript" src="/js/slick/slick.min.js"></script>
	<script>
		function searchSubmitFunc() {
			var topic_title = $("#topic_title").val();
		//	alert(topic_title);
			var url= "/search/&search="+topic_title; 
			window.location.href = url;
			return false;
		}

		function isMobileSearchDevice() {
			return (
				(window.matchMedia && window.matchMedia('(pointer: coarse)').matches) ||
				/Android|iPhone|iPad|iPod|Mobile/i.test(navigator.userAgent) ||
				(navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1)
			);
		}

    $('.header-search-btn, .search.search-btn, .fullscreen_menu_search').on('touchend click', function(e) {
      e.preventDefault();
      const $modal = $('#searchModal');
      const input = $modal.find('input[name="search"]').first()[0];

      $modal.removeClass('fade');

      $modal.modal({
        keyboard: false,
        backdrop: 'static',
        show: false
      });

      $modal.modal('show');

      input.value = '';
			if (isMobileSearchDevice()) {
				input.blur();
      }
      
    });

			$('#searchModal').on('shown.bs.modal', function() {
				//call boxes
				$("#searchModal .ui-autocomplete").hide();
				var $searchFilterResults = $('#searchModal .modal-body .res');

				var $searchInput = $("#searchModal input");
				$searchInput.val("");
				if (isMobileSearchDevice()) {
					$searchInput.blur();
				} else {
					$searchInput.focus();
				}

      /*
			$.post("/includes/jquery/getScreencastFinder.php", function(response){
				$("#searchModal .modal-body .screencast").html(response);
			});

			$.post("/includes/jquery/getMoviesOfTheDaySearch.php", {page:1}, function(response){
				$("#searchModal .modal-body .res").html(response);
			});
      */

	      function setMainFilterHeight() {
	        var searchModalHeight = $('#searchModal').outerHeight(); 
	        var searchModalHeaderHeight = $('#searchModal .modal-header').outerHeight(); 
			        $("#searchModal .modal-body").outerHeight(searchModalHeight - searchModalHeaderHeight);
			      }

			$(window).off('resize.searchModalFilter').on('resize.searchModalFilter', function() {
				if ($('#searchModal').hasClass('main-filter-open')) {
					setMainFilterHeight();
				}
			});

				$searchFilterResults.html('<div class="search-modal-filter-loader"><img src="/img/ajax-loader-mfb.gif" alt=""></div>').show();

			$.ajax({
	        url: "/includes/jquery/movie_filter_search.php",
	        type: "GET",
	        cache: false,
	        success: function (response) {
	          $searchFilterResults.html(response);
	          $('#searchModal').addClass('main-filter-open');
	          setMainFilterHeight();

	          setTimeout(function(){
	            // mf_ajaxFilter('mf_all_filters_form');
	          }, 300);
	        },
	        error: function () {
	          $('#searchModal .modal-body .res').html("");
	        }
	      });

		});
			$('#searchModal').on('hidden.bs.modal', function() {
				//call boxes
				$("#searchModal .ui-autocomplete").hide();
				$("#searchModal input").blur().val("");
				$('#searchModal').removeClass('main-filter-open');
				$("#searchModal .modal-body").css("height", "");
				$("#searchModal .modal-body .res").html("");
			});

		$( "#topic_title" ).on("input", function() {
			var isInp = $("#topic_title").val();
			if (isInp == "") {
				$('#searchModal .modal-body .res').show();
        $('#searchModal').addClass('main-filter-open');
			}
			else {
				$('#searchModal .modal-body .res').hide();
        $('#searchModal').removeClass('main-filter-open');
			}
		});
	</script>
	
