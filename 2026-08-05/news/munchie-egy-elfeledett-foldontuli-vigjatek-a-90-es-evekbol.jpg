      display: inline-block;
      padding: 0;
    }
    .box-office-container .boxoffice-listing .item .value {
      display: block;
      float: left;
      color: var(--main-red);
      font-family: "Source Sans Pro";
      font-size: 16px;
      letter-spacing: 0;
      line-height: 26px;
      text-align: right;
      font-weight: 400;
      margin: 0 5px 0 0;
      padding: 0;
      width: auto;
    }
    .box-office-container .boxoffice-listing .item .value .split {
      color: var(--main-grey);
      display: inline-block;
      margin: 0 2px 0 7px;
    }
    .box-office-container .boxoffice-listing .item .title {
      float: left;
      padding: 0;
    }
    .box-office-container .boxoffice-listing .item .title a {
      color: var(--hyperlink_color) !important;
      border-bottom: 1px solid #BFCACF;
      font-weight: 600;
      line-height: 26px;
      text-decoration: none;
      font-family: "Source Sans Pro";
      font-size: 16px;
      outline: none;
    }
    .box-office-container .boxoffice-listing .item .title a:hover {
      color: var(--hyperlink_color_hover) !important;
    }
    .box-office-container .category-switch.boxoffice-home-switch {
      margin-top: 54px;
      float: right;
      border-bottom: 3px solid #F1F1F1;
      height: 25px;
    }
    .box-office-container .boxoffice-home-switch button.item {
      font-size: 14px;
      padding: 0;
      line-height: 22px;
      font-family: Kanit;
      color: #87A6B5;
      margin: 0 10px 0 0;
      float: none;
    }
    .box-office-container .boxoffice-home-switch button.item.active {
      color: var(--main-blue);
      border-bottom: 3px solid var(--main-red);
    }
    .box-office-container .boxoffice-home-switch button.item:last-child {
      margin-right: 0 !important;
    }
    @media all and (max-width: 1023px) {
      .box-office-container .category-switch.boxoffice-home-switch {
