		<script type="text/javascript">
		// All other pages use the Atmedia GPT interstitial, so disable AdSense vignettes on links.
		(function() {
			function disableAdSenseVignette(root) {
				if (!root) return;

				if (root.nodeType === 1 && root.tagName.toLowerCase() === "a") {
					root.setAttribute("data-google-vignette", "false");
				}

				if (!root.querySelectorAll) return;

				var links = root.querySelectorAll("a");
				for (var i = 0; i < links.length; i++) {
					links[i].setAttribute("data-google-vignette", "false");
				}
			}

			disableAdSenseVignette(document);

			document.addEventListener("DOMContentLoaded", function() {
				disableAdSenseVignette(document);
			});

			if (window.MutationObserver && document.documentElement) {
				new MutationObserver(function(mutations) {
					for (var i = 0; i < mutations.length; i++) {
						for (var j = 0; j < mutations[i].addedNodes.length; j++) {
							disableAdSenseVignette(mutations[i].addedNodes[j]);
						}
					}
				}).observe(document.documentElement, {
					childList: true,
					subtree: true
				});
			}
		})();
		</script>
		
