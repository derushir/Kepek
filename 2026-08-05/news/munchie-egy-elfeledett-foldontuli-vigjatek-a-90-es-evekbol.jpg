  <script>
    
    // IF THE PAGE BEING SCROLLED, DISABLE SLICK SLIDERS' SWIPE OPTION (HORIZONTALL SCROLL) - START
    
    (function() {
      
      var lastScrollAt = Date.now(), timeout;
      
      function scrollStartStop() {
        
        if (Date.now() - lastScrollAt > 100) {
          $(".slick-slider").slick('setOption', 'swipe', false);
        }
        
        lastScrollAt = Date.now();
        
        clearTimeout(timeout);
        
        timeout = setTimeout(function() {
          if (Date.now() - lastScrollAt > 99) {
            $(".slick-slider").slick('setOption', 'swipe', true);
          }
        }, 100);
      }
      
      $(document).on('scroll', scrollStartStop);
      
    })();
    
    // IF THE PAGE BEING SCROLLED, DISABLE SLICK SLIDERS' SWIPE OPTION (HORIZONTALL SCROLL) - END

  </script>

