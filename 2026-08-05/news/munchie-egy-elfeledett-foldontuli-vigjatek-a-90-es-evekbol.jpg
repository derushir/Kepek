      background-size: cover;
      background-repeat: no-repeat;
      background-position-x: 25%;
    }
    .hbb-player-inner .slick-arrow.slick-prev,
    .hbb-player-inner .slick-arrow.slick-next {
      display: none !important;
      height: 50px !important;
      top: 50%;
      background: #ED044E !important;
      transition-duration: .3s;
      width: 32px !important;
      opacity: 1;
    }
    .hbb-player-inner .slick-arrow.slick-prev {
      border-top-right-radius: 25px;
      border-bottom-right-radius: 25px;
      padding: 5px 12px 7px 7px;
    }
    @media (hover: hover) and (pointer: fine) {
      .hbb-player-inner .slick-arrow.slick-prev:hover,
      .hbb-player-inner .slick-arrow.slick-next:hover {
        height: 60px !important;
        transition-duration: .3s;
      }
    }
    .hbb-player-inner .slick-arrow.slick-next {
      border-top-left-radius: 25px;
      border-bottom-left-radius: 25px;
      padding: 5px 7px 7px 12px;
    }

    .hbb-player-inner .slick-prev:before,
    .hbb-player-inner .slick-next:before {
      color: #FFF;
      font-size: 30px !important;
      line-height: 30px;
      opacity: 1;
    }

    #hbb-player-play-btn.mafab-play-btn {
      position: relative;
      top: 0;
      left: 0;
      background-repeat: no-repeat;
      width: 50px;
      height: 50px;
      background-image: url('/img/play-button.svg');
      background-size: contain;
      margin: 12px 0 20px 0;
      border: none;
    }
    #hbb-player-play-btn-mobile.mafab-play-btn {
      display: none;
    }
    #hbb-player-play-btn.mafab-play-btn:hover {
      background-image: url('/img/play-button-hover.svg');
      background-color: transparent;
    }

    #hbb-player-play-btn.mafab-play-btn .text_play {
      text-transform: uppercase;
      font-family: Kanit;
      font-size: 18px;
      color: #FFF;
      letter-spacing: 3px;
      line-height: 27px;
      font-weight: 400;
      left: 70px;
      position: absolute;
      top: 12px;
    }

    #hbb-player-movie {
      position: absolute;
      bottom: 152px;
      left: 70px;
      z-index: 3;
      width: calc(100% - 110px);
    }

    #hbb-player-movie .title_hu {
      white-space: nowrap;
