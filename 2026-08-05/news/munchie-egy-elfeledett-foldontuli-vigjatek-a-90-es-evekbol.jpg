  <style>

    :root {
      --hyperlink_color: #00628F;
      --hyperlink_color_hover: #3C98C3;
      --main-red: #ED044E;
      --main-blue: #002D42;
      --main-grey: #4A4A4A;
    }

    html {
      overflow-x: hidden;
      -webkit-filter: grayscale(0%);
      -moz-filter: grayscale(0%);
      -o-filter: grayscale(0%);
    }

    body {
      overflow-x: hidden;
    }

    body .contentbox {
      margin: 0 0 100px 0;
      border-radius: 0 0 7px 7px;
      box-shadow: 0 4px 17px 0 rgba(0,0,0,0.3);
    }

    .home-page {
      display: inline-block;
      width: 100%;
      padding-bottom: 40px;
    }

    @media (min-width: 1024px) {

      /* ---  new cols in mafab ---*/
      .m-col-d-16{width:100%}.m-col-d-15{width:93.75%}.m-col-d-14{width:87.5%}.m-col-d-13{width:81.25%}.m-col-d-12{width:75%}.m-col-d-11{width:68.75%}.m-col-d-10{width:62.5%}.m-col-d-9{width:56.25%}.m-col-d-8{width:50%}.m-col-d-7{width:43.75%}.m-col-d-6{width:37.5%}.m-col-d-5{width:31.25%}.m-col-d-4{width:25%}.m-col-d-3{width:18.75%}.m-col-d-2{width:12.5%}.m-col-d-1{width:6.25%}.m-col-d-33p{width:33.333%}

      .m-col-d-1, .m-col-d-2, .m-col-d-3, .m-col-d-4, .m-col-d-5, .m-col-d-6, .m-col-d-7, .m-col-d-8, .m-col-d-9, .m-col-d-10, .m-col-d-11, .m-col-d-12, .m-col-d-13, .m-col-d-14, .m-col-d-15, .m-col-d-16, .m-col-d-33p {
        float:left;
        position: relative;
        min-height: 1px;
        padding-left: 15px;
        padding-right: 15px;
      }
      .m-visible-d {
        display: block !important;
      }
      .m-hidden-d {
        display: none !important;
      }

      .container {
        width: 1030px;
      }
    }


    .slick-prev:before, .slick-next:before {content:""; color: rgba(46,46,46,1); font-size:28px !important;}
    .slick-prev:before {font-family: FontAwesome; content: "\f104";}
    .slick-next:before {font-family: FontAwesome; content: "\f105";}
    .slick-prev, .slick-next {
      width: auto !important;
      height: auto !important;
      z-index:2;
      background: rgba(255,255,255,.25);
      padding: 13px 7px;
      transition-duration: .3s;
    }
    .slick-prev {left:0; top:calc(50% - 25px);}
    .slick-next {right:0; top:calc(50% - 25px);}

    /*.slickbox .slick-next.slick-arrow {right:7px !important;}*/

    .slickbox:hover .slick-prev,
    .slickbox:hover .slick-next {
      padding: 14px 8px;
      background: rgba(255,255,255,.55);
    }
    .slickbox:hover .slick-prev:before,
    .slickbox:hover .slick-next:before {
    rgba(46,46,46,1);
      font-size:38px !important;
    }


    /* heading - start */

    .home-page .main-heading {
      margin: 50px 0 25px 0;
      padding: 0 30px;
      display: inline-block;
      width: 100%;
    }
    .home-page .main-heading h2 {
      display: inline-block !important;
      border-bottom: 7px solid var(--main-red);
      padding: 0 !important;
      font-size: 26px !important;
      color: var(--main-grey) !important;
      margin-right: 5px !important;
      font-family: Kanit;
      line-height: 30px;
      font-weight: 500;
      float: left;
    }
    .home-page .main-heading h2 a {
      color: var(--main-blue) !important;
      text-decoration: none;
      outline: none;
    }
    .home-page .main-heading span.icon-icon-arrow-right {
      transition: 0.3s;
      font-size: 11px;
      font-weight: 600;
      margin: 11px 0 0 2px;
      float: left;
    }
    .home-page .main-heading span.icon-icon-arrow-right::before {
      color: var(--main-red);
    }
    .home-page .main-heading h2:hover + span.icon-icon-arrow-right {
      margin-left: 5px;
    }

    .home-page .sub-heading {
      margin: 50px 0 25px 0;
      padding: 0 15px;
      display: inline-block;
      width: max-content;
    }
    .home-page .sub-heading h2 {
      display: inline-block !important;
      border-bottom: 4px solid var(--main-red);
      padding: 0 !important;
      font-size: 18px;
      color: var(--main-grey) !important;
      margin: 0 5px 0 0 !important;
      font-family: Kanit;
      line-height: 25px;
      letter-spacing: 0;
      font-weight: 400;
      text-transform: none;
      float: left;
      white-space: nowrap;
    }
    .home-page .sub-heading h2::first-letter {
      text-transform: capitalize;
    }
    .home-page .sub-heading h2 a {
      color: var(--main-blue) !important;
      text-decoration: none;
      outline: none;
    }
