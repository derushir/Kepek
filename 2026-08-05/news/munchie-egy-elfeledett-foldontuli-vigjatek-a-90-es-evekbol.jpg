        <script type="text/javascript">
          var motd_mobile_flag = 0;
          
          $(document).ready(function(){
            motd_mobile();
            align_carousel_buttons("#motd-mobile", true);
            
            $(window).resize(function(){
              motd_mobile();
              align_carousel_buttons("#motd-mobile", true);
            });
          });
          
          function motd_mobile(){
            // inicializacia galerie na mobile
            if ($(window).width() < 20000){
              // slider inicializovat len raz
              if (motd_mobile_flag==0){
                motd_mobile_flag = 1;
                
                $("#slick-motd").slick({
                  dots: false,
                  infinite: true,
                  speed: 300,
                  slidesToShow: 5,
                  slidesToScroll: 5,
                  responsive: [
                    {
                      breakpoint: 1024,
                      settings: {
                        slidesToShow: 5,
                        slidesToScroll: 5,
                        infinite: true,
                        dots: false,
                        arrows: false
                      }
                    },
                    {
                      breakpoint: 850,
                      settings: {
                        slidesToShow: 4,
                        slidesToScroll: 4,
                        infinite: true,
                        dots: false,
                        arrows: false
                      }
                    },
                    {
                      breakpoint: 600,
                      settings: {
                        slidesToShow: 3,
                        slidesToScroll: 3,
                        infinite: true,
                        dots: false,
                        arrows: false
                      }
                    },
                    {
                      breakpoint: 430,
                      settings: {
                        slidesToShow: 2,
                        slidesToScroll: 2,
                        infinite: true,
                        dots: false,
                        arrows: false
                      }
                    }
                  ]
                });
                
                $("#slick-motd").show();
              }
            }
          }
        </script>
      </div>
      <div class="clear"></div>
    </div>
  </div>
  <script type="text/javascript">
    $("div[motd-switch^='true'],button[motd-switch^='true']").on("click touchend", function(){
      $("div[motd-switch^='true'],button[motd-switch^='true']").removeClass("active");
      //$("#home-motd-wrapper").html('<br><br><center><img src="img/ajax-loader-mfb.gif"></center><br><br>');
      $(this).addClass("active");
      var genre_id = $(this).attr("motd-category");
      
      if (typeof genre_id !== "undefined" && genre_id != ""){
        // html for desktop
        $.ajax({
          url: "https://www.mafab.hu/includes/jquery/boxesAjax.php",
          //data: {homepage: "1", section: "motd", genre: genre_id},
          data: {homepage: "1", section: "motd_mobile", genre: genre_id, age: 0},
          type: "POST",
          dataType: "html",
          success: function (data) {
            //$("#home-motd-wrapper").html(data);
            $("#motd-mobile").html(data);
            setTimeout(function(){
              allInOneButtons();
            }, 250);
            setTimeout(function(){
              align_carousel_buttons("#motd-mobile");
            }, 1000);
          },
          error: function (xhr, status) {
            //alert("Chyba pri nacitavani filmov dna");
          }
        });
        // html for mobile
        if ($(window).width() < 992){
          $.ajax({
            url: "https://www.mafab.hu/includes/jquery/boxesAjax.php",
            data: {homepage: "1", section: "motd_mobile", genre: genre_id, age: 0},
            type: "POST",
            dataType: "html",
            success: function (data) {
              $("#motd-mobile").html(data);
              setTimeout(function(){
                allInOneButtons();
              }, 250);
              setTimeout(function(){
                align_carousel_buttons("#motd-mobile");
              }, 1000);
            },
            error: function (xhr, status) {
              //alert("Chyba pri nacitavani filmov dna");
            }
          });
        }
        setTimeout(function(){
          $("#topMoviesBox.dropdown-btn > .options").hide();
        }, 150);
      }
    });



  </script>
