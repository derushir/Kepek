      <script type="text/javascript">
        
        var magazinhome_new_mobile_flag = 0;
        
        $(document).ready(function(){
          magazinhome_new_mobile();
          
          $(window).resize(function(){
            magazinhome_new_mobile();
          });
          
        });
        
        function magazinhome_new_mobile() {
          
          // inicializacia galerie na mobile
          if ($(window).width() < 1024) {
            
            // slider inicializovat len raz
            if (magazinhome_new_mobile_flag == 0) {
              
              magazinhome_new_mobile_flag = 1;
              
              $("#slick-magazinhome").slick({
                dots: false,
                infinite: true,
                speed: 300,
                slidesToShow: 1,
                slidesToScroll: 1
              });
              
              $("#slick-magazinhome").on("beforeChange", function(){
                $("#magazinhome-mobile .slick-arrow").hide();
              });
              
              $("#slick-magazinhome .slick-list").on("touchstart", function(){
                $("#magazinhome-mobile .slick-arrow").hide();
              });
              
              
              $("#slick-magazinhome .slick-list").on("touchend", function(){
                $("#magazinhome-mobile .slick-arrow").fadeIn(300);
              });
              
              $("#slick-magazinhome").on("afterChange", function(){
                $("#magazinhome-mobile .slick-arrow").fadeIn(300);
              });
              
              $("#slick-magazinhome").on("swipe afterChange", function(event, slick, direction){
                //lazyLoadOnAction("lazyTrailerBg",1);
              });
              
              var slick_mag_btn_pos = ($("#slick-magazinhome .slick-list .slick-track").children("article").children("a").children(".image").height()) / 2;
              $("#slick-magazinhome").children(".slick-prev, .slick-next").css("top", slick_mag_btn_pos+"px");
              
              $("#slick-magazinhome").show();
            }
          }
        }
        
        $("div[magazin-switch^='true'],button[magazin-switch^='true']").bind("click", function() {
          
          $(".category-switch button").removeClass("active");
          
          $("#home-magazin-loader-icon").show();
          
          $(this).addClass("active");
          
          if(!$(this).hasClass("mobile-dropdown")) {
            $("#magazin-options-more-btn span").html("Több");
            $("#magazin-options-more-btn #magazin-options-more .option span.menu-more-first-option").html("Több");
          }
          
          if($(this).hasClass("mobile-dropdown")){
            $("#magazin-options-more-btn").addClass("active");
            $("#magazin-options-more-btn span").html($(this).text());
            $("#magazin-options-more-btn #magazin-options-more .option span.menu-more-first-option").html($(this).text());
          }
          
          var mag_cat = $(this).attr("magazin-category");
          
          if (typeof mag_cat !== "undefined" && mag_cat != ""){
            
            $.ajax({
              url: "https://www.mafab.hu/includes/jquery/boxesAjaxNew.php",
              data: {
                homepage: "1",
                section: "magazin_desktop",
                category: mag_cat,
                not_article_id:"47108"
              },
              type: "POST",
              dataType: "html",
              success: function (data) {
                $("#home-magazin-loader-icon").hide();
                $("#magazinhome-desktop").html(data);
              },
              error: function (xhr, status) {
                //alert("Chyba pri nacitavani clankov");
              }
            });
            
            if (window.innerWidth < 1200){
              $("#slick-magazinhome").slick('removeSlide', null, null, true);
            }
            
            
            $.ajax({
              url: "https://www.mafab.hu/includes/jquery/boxesAjaxNew.php",
              data: {
                section: "magazin_mobile",
                category: mag_cat
              },
              type: "POST",
              dataType: "html",
              success: function (data) {
                //$("#slick-magazinhome").remove();
                //$("#slick-magazinhome").slick("unslick");
                //$("#magazinhome-mobile").html(data);
                $("#magazinhome-mobile").append(data);
              },
              error: function (xhr, status) {
                //alert("Chyba pri nacitavani clankov");
              }
            });
            
            setTimeout(function(){
              $.ajax({
                url: "https://www.mafab.hu/includes/jquery/boxesAjaxNew.php",
                data: {
                  homepage: "1",
                  section: "magazin_desktop_mini",
                  category: mag_cat,
                  not_article_id:"47108"
                },
                type: "POST",
                dataType: "html",
                success: function (data) {
                  $("#magazinhome-desktop-mini").html(data);
                },
                error: function (xhr, status) {
                  //alert("Chyba pri nacitavani clankov");
                }
              });
            }, 100);
            
          }
          
          /*
          setTimeout(function(){
            $(".dropdown-btn > .options").hide();
          }, 150);
          */
          
        });

      </script>

    </div>
