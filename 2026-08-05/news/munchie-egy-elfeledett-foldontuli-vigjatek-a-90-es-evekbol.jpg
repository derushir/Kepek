    }
    .home-page .default-carousel .slick-slider .slick-arrow {
      background-color: #fff;
      border: 2px solid #ED044E;
      border-radius: 17px;
      padding: 15px;
      height: 34px !important;
      width: 34px !important;
      z-index: 2;
      box-shadow: 0 2px 4px 0 rgba(0,0,0,0.4);
      transition-duration: 0s;
    }
    .home-page .default-carousel .slick-slider .slick-prev::before,
    .home-page .default-carousel .slick-slider .slick-next::before {
