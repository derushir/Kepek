<style>
  #hbb_movie_carousel {
    display: block !important;
    position: absolute;
    top: 410px;
    left: 0;
    height: 120px;
    padding: 0 40px;
    width: 100%;
  }
  #hbb_movie_carousel #hp-posters {
    max-height: 235px;
    display: block;
    opacity: 1;
    height: 100%;
    background-color: var(--main-blue);
    padding: 0 20px;
  }
  #hbb_movie_carousel .owl-home-trailers .owl-stage-outer {
    overflow: hidden;
  }
  #hbb_movie_carousel .owl-home-trailers .owl-item {
    height: 120px;
  }
  #hbb_movie_carousel .owl-home-trailers .owl-item .item {
    height: 120px;
    display: grid;
  }
  #hbb_movie_carousel .owl-home-trailers .owl-item .item .owl-trailer-thumb {
    height: 100px;
    margin: 10px;
  }
  #hbb_movie_carousel .owl-home-trailers .owl-item .item .owl-trailer-thumb img {
    height: 95px;
    width: 155px;
    border: 1px solid #727272;
    transition-duration: 0s;
    margin: 3px 0 0 0;
    object-fit: cover;
  }
  #hbb_movie_carousel .owl-home-trailers .owl-item .item .owl-trailer-thumb img.selected {
    box-shadow: none;
    border: 2px solid #ECF0F1;
  }
  #hbb_movie_carousel .owl-home-trailers .owl-item .item .owl-trailer-thumb p.movie_title {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 155px;
    margin: 0;
    padding: 0 10px 5px;
    text-align: center;
    line-height: 16px;
  }
  #hbb_movie_carousel .owl-home-trailers .owl-item .item .owl-trailer-thumb p.movie_title,
  #hbb_movie_carousel .owl-home-trailers .owl-item .item .owl-trailer-thumb p.movie_title a {
    text-decoration: none;
    font-size: 14px;
    text-shadow: 1px 1px 1px rgba(0, 0, 0, 1);
    color: #FFF;
    font-family: Kanit;
    font-weight: 400;
  }
  #hbb_movie_carousel .owl-home-trailers .owl-nav .owl-prev,
  #hbb_movie_carousel .owl-home-trailers .owl-nav .owl-next {
    position: absolute;
    background-color: var(--main-red);
    border: 2px solid var(--main-red);
    border-radius: 17px;
    padding: 15px;
    height: 34px !important;
    width: 34px !important;
    z-index: 2;
    opacity: 1;
  }
  
  #hbb_movie_carousel .owl-home-trailers .owl-nav .owl-prev:hover,
  #hbb_movie_carousel .owl-home-trailers .owl-nav .owl-next:hover,
  #hbb_movie_carousel.navigation-featured:hover #owl-home-trailers-leftnav.owl-leftnav,
  #hbb_movie_carousel.navigation-featured:hover #owl-home-trailers-rightnav.owl-rightnav {
    opacity: 1;
    background-color: var(--main-red) !important;
    background: none;
    border: 2px solid var(--main-red);
  }
  
  #hbb_movie_carousel.navigation-featured:hover #owl-home-trailers-leftnav.owl-leftnav::before,
  #hbb_movie_carousel.navigation-featured:hover #owl-home-trailers-rightnav.owl-rightnav::before {
    font-size: 34px !important;
  }
  
  #hbb_movie_carousel .owl-home-trailers .owl-nav .owl-prev {
    top: 43px;
    left: -17px;
    cursor: pointer;
  }
  
  #hbb_movie_carousel .owl-home-trailers .owl-nav .owl-next {
    top: 43px;
    right: -17px;
    cursor: pointer;
  }
  
  #hbb_movie_carousel .owl-home-trailers .owl-nav .owl-prev::before,
  #hbb_movie_carousel .owl-home-trailers .owl-nav .owl-next::before {
    position: absolute;
    color: #FFF;
    font-size: 34px !important;
    opacity: 1;
  }
  #hbb_movie_carousel .owl-home-trailers .owl-nav .owl-prev::before {
    top: -4px;
    left: 7px;
    line-height: 1;
    font-family: FontAwesome;
    content: "\f104";
  }
  #hbb_movie_carousel .owl-home-trailers .owl-nav .owl-next::before {
    top: -4px;
    left: 11px;
    line-height: 1;
    font-family: FontAwesome;
    content: "\f105";
  }
</style>

<script type="text/javascript">

  // trailers: set first poster as selected
  function selectTrailerPoster(id){
    $(".owl-trailer-thumb .poster-item-img").removeClass("selected"); // deselect poster
    $(".owl-trailer-thumb .poster-item-img[data-index='"+id+"']").addClass("selected");
    activeThumbIndex = id;
  }
  
  // select video
  $(".owl-trailer-thumb").on("click", function(e){
    activeThumbIndex = parseInt($(this).attr("data-index"));
    $("#hbb-player-inner").slick("slickGoTo", activeThumbIndex, true);
    $("html, body").stop().animate({scrollTop:$("#homebigbox").offset().top}, "500", "swing");
  });
  
  if(window.innerWidth > 1023) {
    
    lazyLoadOnAction("lazyTrailers2");
    
    $(window).load(function(){
      // initialize owl carousel
      $("#hp-posters.owl-home-trailers").owlCarousel2({
        loop : true,
        nav : true,
        navText: ["",""],
        items : 5,
        center : true,
        dots : false,
        onInitialized: function() {
          setTimeout(function(){ // NEED TO WAIT AT LEAST 1 SEC, BECAUSE SCRIPT DOES NOT WAIT UNTIL THE CAROUSEL INITIALIZES (BUG)
            // MAKE THE CLICK EVENT WORK ON CLONED ELEMENTS AS WELL
            $("#hp-posters.owl-carousel .owl-item.cloned .owl-trailer-thumb").on("click", function () {
              activeThumbIndex = parseInt($(this).attr("data-index"));
              $("#hbb-player-inner").slick("slickGoTo", activeThumbIndex, true);
              $("html, body").stop().animate({scrollTop:$("#homebigbox").offset().top}, "500", "swing");
            });
          }, 1000);
        }
      });
      
      var $owl_poster_items = $("#hp-posters.owl-carousel .owl-stage");
      $owl_poster_items.children().each( function( index ) {
        $(this).attr( "data-position", index ); // NB: .attr() instead of .data()
      });

      // POSITIONING THE CLICKED ELEMENT TO THE CENTER
      $(document).on("click", "#hp-posters.owl-carousel .owl-item", function() {
        $owl_poster_items.trigger("to.owl.carousel", [$(this).data("position"), 250]);
      });

      // LOADING THE CORRESPONDING TRAILER WHEN CLICKED ON PREV/NEXT BUTTON
      $("#hp-posters.owl-home-trailers .owl-prev, #hp-posters.owl-home-trailers .owl-next").click(function(){
        // get current center item position after the carousel has been slided
        var center_pos = $("#hp-posters.owl-home-trailers").find(".owl-item.active.center").attr("data-position");
        $("#hbb-player-inner").slick("slickGoTo", center_pos, true);
        $("html, body").stop().animate({scrollTop:$("#homebigbox").offset().top}, "500", "swing");
      });

      selectTrailerPoster(0);
      
      $("#hp-preloader").hide();
      $("#hp-posters").show();
      $("#movieinfo-inner").show();
      $("#owl-home-trailers-leftnav").show();
      $("#owl-home-trailers-rightnav").show();
    });
  }
</script>
</div>

