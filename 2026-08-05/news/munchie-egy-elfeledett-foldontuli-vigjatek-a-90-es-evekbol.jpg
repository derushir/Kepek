    .home-page .default-carousel .slick-slider .slick-list .slick-track .img-item a .img-image .mfb-btn-allinone[data-rating="0"] .fa,
    .home-page .default-carousel .slick-slider .slick-list .slick-track .img-item a .img-image .mfb-btn-allinone[data-rating="1"] .fa,
