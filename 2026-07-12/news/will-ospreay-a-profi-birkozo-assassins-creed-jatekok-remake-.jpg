839-a64e805d6e72937e.js\",\"7970\",\"static/chunks/7970-cbe8cfb974a67910.js\",\"3223\",\"static/chunks/3223-e667df023ea2d494.js\",\"1046\",\"static/chunks/1046-5594d3e4688d047e.js\",\"9602\",\"static/chunks/9602-fdcce6c65525ee1e.js\",\"1082\",\"static/chunks/1082-efad1fc76cce368b.js\",\"6532\",\"static/chunks/6532-8f68ec44de408912.js\",\"9994\",\"static/chunks/9994-5da9c56e33b34e70.js\",\"7843\",\"static/chunks/7843-6d8473f1a21cd707.js\",\"1194\",\"static/chunks/1194-fc811715e672ad9c.js\",\"1519\",\"static/chunks/app/gamingbible/content/%5B...staticLink%5D/page-c727b33fe26e87dd.js\"],\"AdvertPlacement\"]\n4c:I[30097,[\"4839\",\"static/chunks/4839-a64e805d6e72937e.js\",\"7970\",\"static/chunks/7970-cbe8cfb974a67910.js\",\"3223\",\"static/chunks/3223-e667df023ea2d494.js\",\"1046\",\"static/chunks/1046-5594d3e4688d047e.js\",\"9602\",\"static/chunks/9602-fdcce6c65525ee1e.js\",\"1082\",\"static/chunks/1082-efad1fc76cce368b.js\",\"6532\",\"static/chunks/6532-8f68ec44de408912.js\",\"9994\",\"static/chunks/9994-5da9c56e33b34e70.js\",\"7843\",\"static/chunks/7843-6d8473f1a21cd707.js\",\"1194\",\"static/chunks/1194-fc811715e672ad9c.js\",\"1519\",\"static/chunks/app/gamingbible/content/%5B...staticLink%5D/page-c727b33fe26e87dd.js\"],\"ResizableImage\"]\n"])</script><script>self.__next_f.push([1,"47:[\"$\",\"$L4b\",null,{\"adsConfig\":\"$43:props:children:1:props:children:0:props:adsConfig\",\"contentType\":\"article\",\"isFloatingVideoAd\":true,\"children\":[[\"$\",\"p\",\"0\",{\"className\":\"text_text__nEn66\",\"children\":[\"Ahead of the launch of \",[\"$\",\"em\",\"1\",{\"children\":\"Assassin’s Creed Black Flag Resynced\"}],\", we had the opportunity to speak with AEW star and huge fan of the Ubisoft series, the “Aerial Assassin’ Will Ospreay, about his love for Assassin’s Creed and how he brings his love for the series into the world of professional wrestling.\"]}],[\"$\",\"p\",\"1\",{\"className\":\"text_text__nEn66\",\"children\":[\"Will Ospreay’s love for the series never began with a typical entry at the beginning of a story, but rather 2011’s \",[\"$\",\"em\",\"1\",{\"children\":\"Assassin’s Creed Revelations\"}],\", which was the final chapter of the Ezio Auditore da Firenze trilogy, and the fourth entry in the franchise.\"]}],[\"$\",\"p\",\"2\",{\"className\":\"text_text__nEn66\",\"children\":[\"“My introduction to the series was \",[\"$\",\"em\",\"1\",{\"children\":\"Revelations\"}],\". So I played that, fell in love with the older version of Ezio after he’s been through some wars,” began a passionate Will.\"]}],[\"$\",\"p\",\"3\",{\"className\":\"text_text__nEn66\",\"children\":[\"“I hadn't played the games before. So it was really cool to play that first and then the preludes to find out how \",[\"$\",\"em\",\"1\",{\"children\":\"Revelations \"}],\"came to be and how Ezio got to that situation. That's my earliest memory, I had such an awakening in my brain to be like, ‘Oh, I can move like this character, and that’s why I started incorporating parkour into my move-set in pro wrestling.”\"]}],[\"$\",\"p\",\"4\",{\"className\":\"text_text__nEn66\",\"children\":[[\"$\",\"strong\",\"0\",{\"children\":\"READ MORE: \"}],[\"$\",\"$L35\",\"1\",{\"href\":\"https://www.gamingbible.com/reviews/assassins-creed-black-flag-resynced-review-778209-20260708\",\"className\":\"anchor_link__6t7IO\",\"children\":[\"$\",\"strong\",null,{\"children\":\"Assassin's Creed Black Flag Resynced is better than the original in almost every way\"}],\"prefetch\":false}]]}],[\"$\",\"h2\",\"5\",{\"children\":[\"$\",\"strong\",null,{\"children\":\"Experience Assassin's Creed Black Flag Like Never Before\"}]}],[\"$\",\"div\",\"6\",{\"className\":\"article-image_articleImage__eyzAn\",\"children\":[[\"$\",\"div\",null,{\"className\":\"article-image_imageWrapper__ANtPE\",\"children\":[\"$\",\"$L4c\",null,{\"className\":\"article-image_image__XvzgU\",\"src\":\"https://eu-images.contentstack.com/v3/assets/bltbc1876152fcd9f07/blt63f796cb17f081f9/6a5120c41c2dee3056205f3d/assassins-creed-black-flag-resynced-10072026.jpg\",\"fill\":true,\"alt\":\"Assassin's Creed Black Flag Resynced, Ubisoft\",\"sizes\":\"(max-width: 430px) 33vw, (max-width: 768px) 50vw, (max-width: 1024px) 50vw, 33vw\"}]}],[\"$\",\"cite\",null,{\"className\":\"image-credit_imageCredit__YMlqS\",\"children\":\"Assassin's Creed Black Flag Resynced, Ubisoft\"}]]}],[\"$\",\"p\",\"7\",{\"className\":\"text_text__nEn66\",\"children\":[\"Obviously, Will has immense love for the Assassin’s Creed series and the Ezio character, but with the launch of \",[\"$\",\"em\",\"1\",{\"children\":\"Assassin’s Creed Black Flag Resynced\"}],\" this week, a remake of the beloved 2013 release starring Edward Kenway, the “Aerial Assassin” explains what this entry means to him.\"]}],[\"$\",\"p\",\"8\",{\"className\":\"text_text__nEn66\",\"children\":\"“It's one of my favourite games for the storyline and the character. Ezio is my OG and is the sole reason why I fell in love with the franchise. But getting to play as Edward, and now seeing the graphics updated in this remake, it just reaffirmed to me that he's one of the coolest assassins,” explains Will.\"}],[\"$\",\"p\",\"9\",{\"className\":\"text_text__nEn66\",\"children\":[\"“I’ve been playing \",[\"$\",\"em\",\"1\",{\"children\":\"Assassin’s Creed Black Flag Resynced\"}],\", the graphics update, the gameplay improvements, and reliving some of those nostalgia pops from the original game. It’s amazing to see how far this modernised version of the game has come.”\"]}],[\"$\",\"p\",\"10\",{\"className\":\"text_text__nEn66\",\"children\":[\"Pretty much since the beginning, while the \",[\"$\",\"$L35\",\"1\",{\"href\":\"https://www.gamingbible.com/assassins-creed\",\"className\":\"anchor_link__6t7IO\",\"children\":\"Assassin’s Creed\",\"prefetch\":false}],\" series has primarily been about stealth, it also gives players the option of going in all guns blazing. Well, unless you plan to utilise your best sneaky skills, before it goes epically wrong and chaos consumes. But what kind of player is Will Ospreay?\"]}],[\"$\",\"p\",\"11\",{\"className\":\"text_text__nEn66\",\"children\":\"“I try my best to be stealthy, because that’s what the Brotherhood of Assassins is all about,” he recalls. “They’re like ninjas, before there were ninjas. I try to play it that way, but that doesn't mean I’m any good at it,” but that’s why I love it, it’s all about having fun.”\"}],[\"$\",\"h2\",\"12\",{\"children\":[\"$\",\"strong\",null,{\"children\":\"Which Assassin's Creed games should get the remake treatment next?\"}]}],[\"$\",\"p\",\"13\",{\"className\":\"text_text__nEn66\",\"children\":\"For centuries, the Templars and the Brotherhood have been at war over the Apple of Eden. In the Assassin’s Creed universe, the Apple of Eden gives its holder unlimited power and can even control every human on the planet.\"}],[\"$\",\"p\",\"14\",{\"className\":\"text_text__nEn66\",\"children\":[\"The Templars say it's about peace, but the Brotherhood knows it’s about power, and that’s why they will stop at nothing to prevent the world from turning into a hub of slaves. However, if Will had the Apple of Eden just for one moment and had the power to have \",[\"$\",\"$L35\",\"1\",{\"href\":\"https://www.gamingbible.com/assassins-creed\",\"className\":\"anchor_link__6t7IO\",\"children\":\"Ubisoft\",\"prefetch\":false}],\" remake any game in the Assassin’s Creed series, what would he choose?\"]}],[\"$\",\"p\",\"15\",{\"className\":\"text_text__nEn66\",\"children\":[\"“Ohh, that’s a good one. Can I make improvements, as well?” He asks. “A lot of people didn't like \",[\"$\",\"em\",\"1\",{\"children\":\"Assassin’s Creed Syndicate\"}],\", but I love it. Especially as it's set in London, so close to my home. If I were able to modernise it for today, not only with its graphics, but also the parkour, combat and abilities. I would love to see that. Also, because I love \",[\"$\",\"em\",\"3\",{\"children\":\"Assassin’s Creed Revelations\"}],\" so much, I’d have to go with that, along with the whole Ezio trilogy. Oh, and \",[\"$\",\"em\",\"5\",{\"children\":\"Assassin’s Creed III\"}],\".”\"]}],[\"$\",\"p\",\"16\",{\"className\":\"text_text__nEn66\",\"children\":[\"Other than being a huge fan of the series, Will Ospreay has not only incorporated his pro wrestling move-set inspired by Assassin’s Creed, but he’s also had some of his ring walk entrances inspired by the series, such as the aforementioned \",[\"$\",\"em\",\"1\",{\"children\":\"Assassin’s Creed Syndicate\"}],\" at Wrestle Kingdom 18 during his time at NJPW, as well as \",[\"$\",\"$L35\",\"3\",{\"href\":\"https://www.gamingbible.com/news/assassins-creed-ezio-official-return-469924-20240828\",\"className\":\"anchor_link__6t7IO\",\"children\":[[\"$\",\"em\",\"0\",{\"children\":\"Assassin’s Creed Shadows\"}],\" at All In\"],\"prefetch\":false}],\" at Wembley for his current promotion, AEW. With the next All In taking place next month at Wembley once more on August 31, could we see another spectator entrance inspired by his beloved series?\"]}],[\"$\",\"div\",\"17\",{\"className\":\"article-image_articleImage__eyzAn\",\"children\":[[\"$\",\"div\",null,{\"className\":\"article-image_imageWrapper__ANtPE\",\"children\":[\"$\",\"$L4c\",null,{\"className\":\"article-image_image__XvzgU\",\"src\":\"https://eu-images.contentstack.com/v3/assets/bltbc1876152fcd9f07/bltfd029b0da3b23f95/6a512ab677c96d50eed946bf/will-ospreay-aew-michael-watson.jpg\",\"fill\":true,\"alt\":\"Will Ospreay backstage at All In Wembley 2024,\",\"sizes\":\"(max-width: 430px) 33vw, (max-width: 768px) 50vw, (max-width: 1024px) 50vw, 33vw\"}]}],[\"$\",\"cite\",null,{\"className\":\"image-credit_imageCredit__YMlqS\",\"children\":\"Michael Watson/AEW\"}]]}],[\"$\",\"h2\",\"18\",{\"children\":[\"$\",\"strong\",null,{\"children\":\"Will Ospreay has an Assassin's Creed-inspired entrance up his sleeve\"}]}],[\"$\",\"p\",\"19\",{\"className\":\"text_text__nEn66\",\"children\":[\"“Maybe not next month at Wembley, just because we had two real stellar entrances on both All In shows in 2023 and 2024, I don't want to oversaturate it,” explains Will. “If we were to do it again, some strings will need to be pulled, and I do have something in my back pocket related to \",[\"$\",\"em\",\"1\",{\"children\":\"Black Flag\"}],\", but I’m saving that for further down the line,” he teases.\"]}],[\"$\",\"p\",\"20\",{\"className\":\"text_text__nEn66\",\"children\":\"Spectacular entrances aside, what other Assassin’s Creed collaborations could there be for the Aerial Assassin, perhaps a cameo? “I need to do a cameo,” he says. “At the very least, I would love to get some DLC in the game inspired by my ring gear. I have such a connection with the series throughout my career that I feel we’d complement each other perfectly.\"}],[\"$\",\"p\",\"21\",{\"className\":\"text_text__nEn66\",\"children\":[\"“But of course, I’d love to be in one of the games, or even a live-action project like a movie or TV series. I’d love to try to dip my toes into something like that. Whether it’s a voice or full-on live-action acting.” \",[\"$\",\"$L35\",\"1\",{\"href\":\"https://www.gamingbible.com/news/assassins-creed-live-action-movie-reboot-teased-289639-20250206\",\"className\":\"anchor_link__6t7IO\",\"children\":\"Netflix does have an Assassin’s Creed movie\",\"prefetch\":false}],\" in the works, Ubisoft, just saying.\"]}],[\"$\",\"h2\",\"22\",{\"children\":[\"$\",\"strong\",null,{\"children\":\"Recovering from neck surgery while still chasing a dream\"}]}],[\"$\",\"p\",\"23\",{\"className\":\"text_text__nEn66\",\"children\":\"Following Forbidden Door at the O2, London in July 2025, Will Ospreay would be out of action for around eight months after needing vital surgery on his neck to repair two herniated discs, a severe injury that he had been dealing with for close to a year. When Will walked down the aisle in what would be his final match for quite some time at the O2, the emotion was clear on his face, likely wondering if he would ever return to the business he loves again. Next month, when he faces current AEW World Champion, Kenny Omega at All In Wembley, Will is to face an emotion of a very different kind.\"}],[\"$\",\"p\",\"24\",{\"className\":\"text_text__nEn66\",\"children\":\"“Honestly, it's so hard to put into words. So I tell people the story of when I was a 14-year-old kid, when my mum and dad bought me a wrestling ring to put in my back garden. Mainly because I was a little troublemaker, at that age where I grew up, it was a natural thing to find yourself in trouble,” Will recalls.\"}],[\"$\",\"p\",\"25\",{\"className\":\"text_text__nEn66\",\"children\":\"“My mum and dad thought that the best way to keep me off the streets and keep me home was to keep my passion burning alive, and put a wrestling ring in our back garden. I always remember in school, every boy wanted to be a football player. But I just wanted to be a professional wrestler, and people laughed at me.\"}],[\"$\",\"p\",\"26\",{\"className\":\"text_text__nEn66\",\"children\":\"“Now, being the age that I'm at now, where I've wrestled in front of 40,000 people in the Tokyo Dome, nearly 80,000 people in Wembley Stadium, I've got to dip my toes into so many amazing moments in wrestling. Now I get to return to Wembley Stadium. I'm fighting for a piece of history that no one else in the world can say that they've done. Being the first Englishman to win a World Championship on home soil is such a huge thing that I could never even dream of.\"}],[\"$\",\"p\",\"27\",{\"className\":\"text_text__nEn66\",\"children\":\"“It’s a feeling that I struggle to put into words, of how special it feels to be in this position and fighting for that prize. I am grateful, man. I'm so grateful. To be able to influence a new generation coming through and to give hope to anyone who was ever told that they're not going to be able to fulfil their dreams because of where they're from,” he continues.\"}],[\"$\",\"p\",\"28\",{\"className\":\"text_text__nEn66\",\"children\":\"“I wasn't an academic kid; I just had a belief in my stomach that pro wrestling was going to pay off one day. And next month, I'll be in Wembley Stadium fighting for the most important prize in pro wrestling. I hope I can just walk away as the first Englishman to ever do it.”\"}],[\"$\",\"p\",\"29\",{\"className\":\"text_text__nEn66\",\"children\":[[\"$\",\"strong\",\"0\",{\"children\":\"READ MORE: \"}],[\"$\",\"$L35\",\"1\",{\"href\":\"https://www.gamingbible.com/features/aew-interview-will-ospreay-wrestling-assassins-creed-189107-20250507\",\"className\":\"anchor_link__6t7IO\",\"children\":[\"$\",\"strong\",null,{\"children\":\"AEW Will Ospreay talks Wrestling, Assassin’s Creed, and life on the spectrum\"}],\"prefetch\":false}]]}]]}]\n"])</script><script>self.__next_f.push([1,"4d:I[36219,[\"4839\",\"static/chunks/4839-a64e805d6e72937e.js\",\"7970\",\"static/chunks/7970-cbe8cfb974a67910.js\",\"3223\",\"static/chunks/3223-e667df023ea2d494.js\",\"1046\",\"static/chunks/1046-5594d3e4688d047e.js\",\"9602\",\"static/chunks/9602-fdcce6c65525ee1e.js\",\"1082\",\"static/chunks/1082-efad1fc76cce368b.js\",\"6532\",\"static/chunks/6532-8f68ec44de408912.js\",\"9994\",\"static/chunks/9994-5da9c56e33b34e70.js\",\"7843\",\"static/chunks/7843-6d8473f1a21cd707.js\",\"1194\",\"static/chunks/1194-fc811715e672ad9c.js\",\"1519\",\"static/chunks/app/gamingbible/content/%5B...staticLink%5D/page-c727b33fe26e87dd.js\"],\"Form\"]\n4f:I[64865,[\"4839\",\"static/chunks/4839-a64e805d6e72937e.js\",\"7970\",\"static/chunks/7970-cbe8cfb974a67910.js\",\"3223\",\"static/chunks/3223-e667df023ea2d494.js\",\"1046\",\"static/chunks/1046-5594d3e4688d047e.js\",\"9602\",\"static/chunks/9602-fdcce6c65525ee1e.js\",\"1082\",\"static/chunks/1082-efad1fc76cce368b.js\",\"6532\",\"static/chunks/6532-8f68ec44de408912.js\",\"9994\",\"static/chunks/9994-5da9c56e33b34e70.js\",\"7843\",\"static/chunks/7843-6d8473f1a21cd707.js\",\"1194\",\"static/chunks/1194-fc811715e672ad9c.js\",\"1519\",\"static/chunks/app/gamingbible/content/%5B...staticLink%5D/page-c727b33fe26e87dd.js\"],\"TagListCardLoop\"]\n4e:{\"id\":\"7f8a8700d20652e2cfb0139a5da1a929e2721d00f2\",\"bound\":null}\n"])</script><script>self.__next_f.push([1,"4a:[\"$\",\"div\",null,{\"className\":\"more-like-this_container__Vlabm\",\"children\":[\"$\",\"div\",null,{\"className\":\"$undefined\",\"children\":[\"$\",\"div\",null,{\"className\":\"choose-content_container__8rqCi\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"heading_heading__hZT3h\",\"style\":{\"color\":\"$undefined\"},\"children\":\"Choose your content:\"}],[\"$\",\"$L4d\",null,{\"articles\":[{\"id\":\"blt9c0b89985f6db2c0\",\"title\":\"Super Mario 64's superior version is finally getting a PC port\",\"staticLink\":\"/news/platform/pc/super-mario-64-superior-version-pc-port-112607-20260708\",\"summary\":\"Super Mario 64 DS is finally getting a PC port you'll be able to play soon, and it'll probably be the definitive way to play.\",\"featuredImage\":\"https://eu-images.contentstack.com/v3/assets/bltbc1876152fcd9f07/blt1ec5cc6f59825f59/6a4e4b4503deeee7be7a45c0/supermario64pcport.jpg\",\"featuredImageInfo\":{\"url\":null,\"credit\":{\"text\":\"Nintendo\",\"link\":null},\"alt\":null},\"publishedAt\":\"2026-07-12T16:00:00.278Z\",\"updatedAt\":\"2026-07-12T16:00:00.278Z\",\"categories\":[{\"name\":\"News\",\"slug\":\"news\"},{\"name\":\"Platform\",\"slug\":\"platform\"},{\"name\":\"PC\",\"slug\":\"pc\"}],\"featured\":false,\"featuredVideo\":null,\"breaking\":false,\"isLiveArticle\":false,\"isLiveArticleActive\":false,\"isSponsored\":false,\"author\":{\"name\":\"Sam Cawley\",\"avatar\":\"https://eu-images.contentstack.com/v3/assets/bltbc1876152fcd9f07/blt1f56f8e7c4a3cc1c/69611edcd4ff36298db6798f/IMG_20240502_183641_811.jpg\"}},{\"id\":\"blte293b06a3d36c164\",\"title\":\"Console-exclusive Silent Hill game finally gets PC release 14 years later\",\"staticLink\":\"/news/platform/pc/silent-hill-downpour-unofficial-pc-port-671416-20260709\",\"summary\":\"This marks another win for games preservation.\",\"featuredImage\":\"https://eu-images.contentstack.com/v3/assets/bltbc1876152fcd9f07/bltba77a76d59ccdf81/6a4fb77348d7d3aefe78a2bd/silent_hill_downpour.jpg\",\"featuredImageInfo\":{\"url\":null,\"credit\":{\"text\":\"Konami\",\"link\":null},\"alt\":null},\"publishedAt\":\"2026-07-12T15:00:00.435Z\",\"updatedAt\":\"2026-07-12T15:00:00.435Z\",\"categories\":[{\"name\":\"News\",\"slug\":\"news\"},{\"name\":\"Platform\",\"slug\":\"platform\"},{\"name\":\"PC\",\"slug\":\"pc\"}],\"featured\":false,\"featuredVideo\":null,\"breaking\":false,\"isLiveArticle\":false,\"isLiveArticleActive\":false,\"isSponsored\":false,\"author\":{\"name\":\"Olly Smith\",\"avatar\":null}},{\"id\":\"blt1e60c8ecd3b82888\",\"title\":\"God of War fans detail exactly what they want from upcoming remakes\",\"staticLink\":\"/news/platform/playstation/god-of-war-fans-want-changes-upcoming-remakes-108840-20260710\",\"summary\":\"God of War fans hope the remakes don't change too much\",\"featuredImage\":\"https://eu-images.contentstack.com/v3/assets/bltbc1876152fcd9f07/bltfe083c34bd1bbe77/6a511ec6d4cd814e8e3bf7f3/god-of-war-remakes-10072026.jpg\",\"featuredImageInfo\":{\"url\":null,\"credit\":{\"text\":\"Sony Interactive Entertainment\",\"link\":null},\"alt\":null},\"publishedAt\":\"2026-07-12T13:00:00.396Z\",\"updatedAt\":\"2026-07-12T13:00:00.396Z\",\"categories\":[{\"name\":\"News\",\"slug\":\"news\"},{\"name\":\"Platform\",\"slug\":\"platform\"},{\"name\":\"Playstation\",\"slug\":\"playstation\"}],\"featured\":false,\"featuredVideo\":null,\"breaking\":false,\"isLiveArticle\":false,\"isLiveArticleActive\":false,\"isSponsored\":false,\"author\":{\"name\":\"Richard Breslin\",\"avatar\":\"https://eu-images.contentstack.com/v3/assets/bltbc1876152fcd9f07/blt969314dde2beb329/6812368ddfd7b95ef735940b/me_villa.jpg\"}},{\"id\":\"bltb68f36d835b341ef\",\"title\":\"GTA Online's final free DLC hides 'hints' for what's to come in GTA 6\",\"staticLink\":\"/news/gta-online-free-dlc-gta-6-hints-901855-20260711\",\"summary\":\"The end is near for GTA Online, but its leading the way to a new generation\",\"featuredImage\":\"https://eu-images.contentstack.com/v3/assets/bltbc1876152fcd9f07/bltd19624a59c2a2a3f/6a5256f696fbe3d1c6cb1b43/GTA_Online_GTA_6.jpg\",\"featuredImageInfo\":{\"url\":null,\"credit\":{\"text\":\"Rockstar Games\",\"link\":null},\"alt\":null},\"publishedAt\":\"2026-07-12T12:00:04.262Z\",\"updatedAt\":\"2026-07-12T12:00:04.262Z\",\"categories\":[{\"name\":\"News\",\"slug\":\"news\"}],\"featured\":false,\"featuredVideo\":null,\"breaking\":false,\"isLiveArticle\":false,\"isLiveArticleActive\":false,\"isSponsored\":false,\"author\":{\"name\":\"Jack Marsh\",\"avatar\":\"https://eu-images.contentstack.com/v3/assets/bltbc1876152fcd9f07/bltaa881be528c41b7d/69f5b38042bace55857aa47f/Image_(4).jpg\"}}],\"limit\":4,\"idsToExclude\":[],\"tagAction\":\"$F4e\",\"children\":[\"$\",\"$L4f\",null,{\"tags\":[],\"hasSeeMoreButton\":false}]}]]}]}]}]\n"])</script><script>self.__next_f.push([1,"50:I[69731,[\"4839\",\"static/chunks/4839-a64e805d6e72937e.js\",\"7970\",\"static/chunks/7970-cbe8cfb974a67910.js\",\"3223\",\"static/chunks/3223-e667df023ea2d494.js\",\"1046\",\"static/chunks/1046-5594d3e4688d047e.js\",\"9602\",\"static/chunks/9602-fdcce6c65525ee1e.js\",\"1082\",\"static/chunks/1082-efad1fc76cce368b.js\",\"6532\",\"static/chunks/6532-8f68ec44de408912.js\",\"9994\",\"static/chunks/9994-5da9c56e33b34e70.js\",\"7843\",\"static/chunks/7843-6d8473f1a21cd707.js\",\"1194\",\"static/chunks/1194-fc811715e672ad9c.js\",\"1519\",\"static/chunks/app/gamingbible/content/%5B...staticLink%5D/page-c727b33fe26e87dd.js\"],\"RelatedArticles\"]\n51:T1330,"])</script><script>self.__next_f.push([1,"\u003cp\u003e\u003cem\u003eAssassin’s Creed Black Flag Resynced\u003c/em\u003e players are being warned of a bug present in the game, which can apparently wipe out hours of progress.\u003c/p\u003e\u003cp\u003eThe \u003ca href=\"https://www.gamingbible.com/assassins-creed\" rel=\"noopener\" target=\"_blank\"\u003eAssassin’s Creed\u003c/a\u003e series features some of the biggest and most in-depth virtual worlds you’ll ever experience, but with that comes the caveat that you’ll often spend hundreds of hours playing through them.\u003c/p\u003e\u003cp\u003eWith \u003cem\u003eBlack Flag Resynced\u003c/em\u003e being the most recent release, one particularly nasty glitch has the potential to wipe out hours of progress from your save file.\u003c/p\u003e\u003cp\u003eThe bug was \u003ca href=\"https://bsky.app/profile/stephentotilo.bsky.social/post/3mq5cjqbskk2m\" rel=\"noopener\" target=\"_blank\"\u003efirst shared\u003c/a\u003e by Game File’s Stephen Totilo (\u003ca href=\"https://www.gamesradar.com/games/assassin-s-creed/assassins-creed-black-flag-resynced-reportedly-has-a-bug-that-can-wipe-hours-of-playtime-but-ubisoft-is-working-on-a-fix/\" rel=\"noopener\" target=\"_blank\"\u003evia\u003c/a\u003e GamesRadar), who reports that Templar Hunt side quests may leave players losing hours of their save file if they leave them unfinished.\u003c/p\u003e\u003cp\u003e“If you're playing \u003cem\u003eAssassin's Creed Black Flag Resynced\u003c/em\u003e, do not leave any Templar Hunt sidequest chains unfinished. It produced a glitch that cost me five hours of playing time,” Totilo writes on Bluesky.\u003c/p\u003e\u003cp\u003eAdding specifics in a follow-up post, Totilo says that he was “I was several quests into the Templar Hunt in Kingston, had left the region to play other parts. Eventually triggered a main story mission in Kingston (\"Imagine my Surprise\"). The TH chain and main quest blocked each other. Couldn't progress.”\u003c/p\u003e\u003cdiv class=\"social-embed\" contenteditable=\"false\"\u003e\u003cblockquote class=\"bluesky-embed\" data-bluesky-uri=\"at://did:plc:fs2pfwz4ohuc7nhlshklw55d/app.bsky.feed.post/3mq5cjqbskk2m\" data-bluesky-cid=\"bafyreiaezlln3oc4yrp626q4gn472fanxk2ve7ru4pvmbt5e74q743y3ei\" data-bluesky-embed-color-mode=\"system\"\u003e\u003cp lang=\"en\"\u003ePSA: If you're playing Assassin's Creed Black Flag Resynced, do not leave any Templar Hunt sidequest chains unfinished. It produced a glitch that cost me five hours of playing time. \n\nThe game's really fun and some of the new bits are interesting in unexpected ways. But my write-up is delayed!\u003cbr\u003e\u003cbr\u003e\u003ca href=\"https://bsky.app/profile/did:plc:fs2pfwz4ohuc7nhlshklw55d/post/3mq5cjqbskk2m?ref_src=embed\"\u003e[image or embed]\u003c/a\u003e\u003c/p\u003e— Stephen Totilo (\u003ca href=\"https://bsky.app/profile/did:plc:fs2pfwz4ohuc7nhlshklw55d?ref_src=embed\"\u003e@stephentotilo.bsky.social\u003c/a\u003e) \u003ca href=\"https://bsky.app/profile/did:plc:fs2pfwz4ohuc7nhlshklw55d/post/3mq5cjqbskk2m?ref_src=embed\"\u003e8 July 2026 at 15:14\u003c/a\u003e\u003c/blockquote\u003e\u003cscript async=\"\" src=\"https://embed.bsky.app/static/embed.js\" charset=\"utf-8\"\u003e\u003c/script\u003e\u003c/div\u003e\u003cp\u003e\u003cbr\u003e\u003c/p\u003e\u003cp\u003eHe then says that Ubisoft has identified the bug and that it will be fixed as part of a future update, though it isn’t confirmed when that will be live.\u003c/p\u003e\u003cp\u003e\u003cstrong\u003eRead More: \u003c/strong\u003e\u003ca href=\"https://www.gamingbible.com/news/assassins-creed-future-game-settings-538131-20260701\" rel=\"noopener\" target=\"_blank\"\u003e\u003cstrong\u003e6 Historical Periods Assassin's Creed Needs To Visit After Black Flag Resynced\u003c/strong\u003e\u003c/a\u003e\u003c/p\u003e\u003ch2\u003eHow to avoid the Templar Hunt save progress glitch in \u003cem\u003eAssassin's Creed Black Flag Resynced\u003c/em\u003e\u003c/h2\u003e\u003cp\u003eThe best way to avoid this bug is to simply avoid doing the Templar Hunt side quests for now until the next patch fixes it.\u003c/p\u003e\u003cp\u003eTemplar Hunts are missions in which you can collect a series of keys which will allow you to unlock the desirable Templar Armor set for Edward, one of the most powerful armours in the game.\u003c/p\u003e\u003cp\u003eThere are four quests in the game which allow you to unlock these keys, which must be played in order, and once you’ve collected all the keys, you’ll be able to unlock the armour and claim it for yourself.\u003c/p\u003e\u003cp\u003eThe first of these quests is called This Old Cove, and occurs at the beginning of Sequence 4.\u003c/p\u003e\u003cp\u003eHowever, with the save progress glitch currently in the game, you have to essentially complete one Templar Hunt side quest as you receive them, as starting a main story mission may result in both questlines blocking each other and softlocking you, meaning you need to go back to an earlier save.\u003c/p\u003e\u003cp\u003eWith Ubisoft aware of the issue, it’s only a matter of time before the issue is patched out, which has already been confirmed to be coming in a future update.\u003c/p\u003e\u003cp\u003eIn GAMINGbible’s \u003ca href=\"https://www.gamingbible.com/reviews/assassins-creed-black-flag-resynced-review-778209-20260708\" rel=\"noopener\" target=\"_blank\"\u003e\u003cem\u003eAssassin’s Creed Black Flag Resynced review\u003c/em\u003e\u003c/a\u003e, we said that Ubisoft has “clearly gone to great lengths to ensure that this remake deserves to exist, and it’s very clear after spending many hours with the game that it’s a love letter to the fans and the developers.”\u003c/p\u003e"])</script><script>self.__next_f.push([1,"53:T15a4,"])</script><script>self.__next_f.push([1,"\u003cp\u003eUbisoft is enjoying a successful launch of the highly anticipated \u003cem\u003eAssassin’s Creed Black Flag\u003c/em\u003e remake, but it hasn't prevented jobs from being lost at the company.\u003c/p\u003e\u003cp\u003eFollowing months of rumours, \u003ca href=\"https://www.gamingbible.com/ubisoft\" rel=\"noopener\" target=\"_blank\"\u003eUbisoft\u003c/a\u003e officially confirmed the existence of the remake in April 2026, and it would carry a new name, \u003cem\u003eAssassin’s Creed Black Flag Resynced\u003c/em\u003e. Powered by an enhanced version of Ubisoft’s Anvil engine, this remake of the beloved 2013 release has improved visuals, performance, gameplay and even some new story missions, accompanied by new cinematics.\u003c/p\u003e\u003cp\u003eSure, it is missing some content that was not in the original game, such as the modern-day Abstergo office missions, as well as the fantastic \u003cem\u003eFreedom Cry\u003c/em\u003e expansion, but \u003ca href=\"https://www.gamingbible.com/assassins-creed\" rel=\"noopener\" target=\"_blank\"\u003e\u003cem\u003eAssassin’s Creed\u003c/em\u003e\u003c/a\u003e\u003cem\u003e Black Flag Resynced\u003c/em\u003e has been well-received across the board from critics and fans alike.\u003c/p\u003e\u003ch2\u003e\u003cstrong\u003eAssassin’s Creed Black Flag Resynced Hits Record-Breaking Player Milestone\u003c/strong\u003e\u003c/h2\u003e\u003cp\u003eAs brought to our attention \u003ca href=\"https://www.ign.com/articles/assassins-creed-black-flag-resynced-has-already-earned-the-series-biggest-player-peak-on-steam?link_source=ta_first_comment\u0026amp;taid=6a4ff33c06db11000115c1a8\u0026amp;fbclid=IwdGRjcAS83d9leHRuA2FlbQIxMQBzcnRjBmFwcF9pZAwzNTA2ODU1MzE3MjgAAR7AT5TqRlYDKDj_dHBzUaj3ZEiJz9GLwgMqSmYRycHjSpQWDsGCTlAC8anfaA_aem_tsd-D9ZNd_l3rnxrddBCHA\" rel=\"noopener\" target=\"_blank\"\u003eby IGN\u003c/a\u003e, despite only releasing on Thursday, \u003cem\u003eAssassin’s Creed Black Flag Resynced\u003c/em\u003e has already achieved the highest player peak on Steam in the entire series. Granted, these numbers only reflect the PC platform, but if a game performs well on Steam, it can be seen as an indication for the console counterpart.\u003c/p\u003e\u003cp\u003eAt the time of writing, \u003cem\u003eAssassin’s Creed Black Flag Resynced\u003c/em\u003e has an all-time \u003ca href=\"https://steamdb.info/app/3751950/charts/\" rel=\"noopener\" target=\"_blank\"\u003econcurrent player peak\u003c/a\u003e of 99,451, compared to the original game, which was released nearly 13 years ago, with 16,049. To put things into a more perspective, this is a whopping 520% increase.\u003c/p\u003e\u003cp\u003e\u003cimg src=\"https://eu-images.contentstack.com/v3/assets/bltbc1876152fcd9f07/blt41a3c83ae6d47220/6a50d78dad2fb292e5270497/assassins-creed-black-flag-jackdaw.jpg\" alt=\"Assassin's Creed Black Flag Resynced, Ubisoft\"\u003e\u003c/p\u003e\u003ch2\u003e\u003cstrong\u003eAssassin’s Creed mainline games with the highest Steam player peaks\u003c/strong\u003e\u003c/h2\u003e\u003cul\u003e\u003cli\u003eAssassin’s Creed Shadows (2025) - \u003cstrong\u003e64, 825\u003c/strong\u003e\u003c/li\u003e\u003cli\u003eAssassin’s Creed Odyssey (2018) - \u003cstrong\u003e62, 069\u003c/strong\u003e\u003c/li\u003e\u003cli\u003eAssassin’s Creed Origins (2017) - \u003cstrong\u003e41, 551\u003c/strong\u003e\u003c/li\u003e\u003cli\u003eAssassin’s Creed Valhalla (2020) - \u003cstrong\u003e19,181\u003c/strong\u003e\u003c/li\u003e\u003cli\u003eAssassin’s Creed III (2012) - \u003cstrong\u003e15,007\u003c/strong\u003e\u003c/li\u003e\u003cli\u003eAssassin’s Creed Unity (2014) - \u003cstrong\u003e12,180\u003c/strong\u003e\u003c/li\u003e\u003cli\u003eAssassin’s Creed Syndicate (2015) - \u003cstrong\u003e4,729\u003c/strong\u003e\u003c/li\u003e\u003cli\u003eAssassin’s Creed Brotherhood (2010) - \u003cstrong\u003e3,848\u003c/strong\u003e\u003c/li\u003e\u003cli\u003eAssassin’s Creed II (2009) -\u003cstrong\u003e3,617\u003c/strong\u003e\u003c/li\u003e\u003cli\u003eAssassin’s Creed Revelations (2011) - \u003cstrong\u003e3,105\u003c/strong\u003e\u003c/li\u003e\u003cli\u003eAssassin’s Creed: Director’s Cut (2008) - \u003cstrong\u003e1,468\u003c/strong\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e\u003cstrong\u003e READ MORE: \u003c/strong\u003e\u003ca href=\"https://www.gamingbible.com/news/assassins-creed-black-flag-resynced-progress-glitch-236495-20260709\" rel=\"noopener\" target=\"_blank\"\u003e\u003cstrong\u003eAssassin's Creed Black Flag Resynced players warned about bug which wipes hours of progress\u003c/strong\u003e\u003c/a\u003e\u003c/p\u003e\u003ch2\u003e\u003cstrong\u003eUbisoft lays off employees despite Black Flag Resynced success\u003c/strong\u003e\u003c/h2\u003e\u003cp\u003eSadly, as reported \u003ca href=\"https://insider-gaming.com/assassins-creed-black-flag-resynced-layoffs/\" rel=\"noopener\" target=\"_blank\"\u003eby Insider Gaming\u003c/a\u003e, 51 employees have been made redundant from Ubisoft Barcelona, some of whom had worked on \u003cem\u003eAssassin’s Creed Black Flag Resynced\u003c/em\u003e.\u003c/p\u003e\u003cp\u003eThe article from Insider Gaming states that some of those employees knew that the writing was on the proverbial wall, no matter the success of the remake, because a new project wasn't assigned after its launch. Typically, developers know what’s coming next way ahead of time. It’s claimed that the team wasn't assigned any new projects dating back to the summer of 2025.\u003c/p\u003e\u003cp\u003eThe report says that the 51 Ubisoft Barcelona employees were laid off just days after completing the development of \u003cem\u003eAssassin’s Creed Black Flag Resynced\u003c/em\u003e. One ex-employee impacted by the redundancies told Insider Gaming:\u003c/p\u003e\u003cp\u003e”These layoffs coincide with the broader context of ongoing workplace issues. This is not an isolated event; it reflects a pattern of constant mistreatment, loss of talent, forced departures resulting from the erosion of workers’ rights, and an increasingly top-down management culture that leaves employees with little voice in decisions affecting their work.”\u003c/p\u003e\u003cp\u003eFurthermore, employees at Ubisoft Barcelona have announced a series of strikes supported by the Video Game Union Coordinating Committee. Those strikes will take place every Tuesday and Thursday afternoon between 30 June and 16 July.\u003c/p\u003e\u003cp\u003e\u003cstrong\u003eREAD MORE: \u003c/strong\u003e\u003ca href=\"https://www.gamingbible.com/reviews/assassins-creed-black-flag-resynced-review-778209-20260708\" rel=\"noopener\" target=\"_blank\"\u003e\u003cstrong\u003eAssassin's Creed Black Flag Resynced is better than the original in almost every way\u003c/strong\u003e\u003c/a\u003e\u003c/p\u003e"])</script><script>self.__next_f.push([1,"55:T1e23,"])</script><script>self.__next_f.push([1,"\u003cp\u003eThe Assassin’s Creed series has visited many different time periods over the years, bringing a mix of historical authenticity and mythological folklore to bring these settings alive.\u003c/p\u003e\u003cp\u003eWith \u003ca href=\"https://www.gamingbible.com/news/assassins-creed-black-flag-resynced-biggest-changes-747409-20260521\" rel=\"noopener\" target=\"_blank\"\u003e\u003cem\u003eAssassin’s Creed Black Flag Resynced\u003c/em\u003e\u003c/a\u003e revisiting a familiar story within the wider \u003ca href=\"https://www.gamingbible.com/assassins-creed\" rel=\"noopener\" target=\"_blank\"\u003eAssassin’s Creed\u003c/a\u003e saga, the question of where the series could head next is the question on everyone’s lips.\u003c/p\u003e\u003cp\u003eFrom witnessing the bonfire of the vanities to participating in the American revolution, the series doesn’t shy away from making you a virtual tourist in some of history’s most significant events.\u003c/p\u003e\u003cp\u003eHere’s our picks for where the Assassin’s Creed series could go after \u003cem\u003eBlack Flag Resynced\u003c/em\u003e, and a few events that we could experience in a game set during these time periods.\u003c/p\u003e\u003ch2\u003e1. Ancient Rome (753 BC–476 AD)\u003c/h2\u003e\u003cp\u003eWe’ve done Ancient Greece. We’ve done Ancient Egypt. Now it’s time for Ancient Rome. We saw bits of this setting at the end of \u003cem\u003eAssassin’s Creed Origins\u003c/em\u003e, where we briefly took control of Amunet to take part in the assassination of Julius Caesar.\u003c/p\u003e\u003cp\u003eWith Ancient Roman history covering a huge span of history, a whole Assassin’s Creed game set during this time could depict events and myths like the founding of Rome by Romulus and Remus, the Spartacus rebellion, or the naval battle of Actium which instigated the deaths of Cleopatra and Mark Antony, as well as the ascension of Octavian as the first Roman emperor.\u003c/p\u003e\u003cp\u003eAncient Rome is due to be explored in the live-action Assassin's Creed television series being made for Netflix, but the era is so vast that a video game could also definitely be made here without it interfering with Ubisoft's plans.\u003c/p\u003e\u003cp\u003e\u003cimg src=\"https://eu-images.contentstack.com/v3/assets/bltbc1876152fcd9f07/blt0a80fe17aecde72c/6a45297b79cfbc682b4c632a/spartacius.jpg\" alt=\"Credit: Universal\"\u003e\u003c/p\u003e\u003ch2\u003e2. Three Kingdoms (220–280 AD)\u003c/h2\u003e\u003cp\u003eThe Three Kingdoms of Cao Wei, Shu Han, and Eastern Wu were ruling factions in China following the end of the Han dynasty in the early third century, whose collapse caused chaotic infighting between many different dynasties.\u003c/p\u003e\u003cp\u003eChina is supposedly being explored in \u003cem\u003eAssassin’s Creed Jade\u003c/em\u003e, which was supposed to be released in 2023 but was eventually pushed back. With this period being set a few centuries after \u003cem\u003eAssassin’s Creed Origins\u003c/em\u003e, it’d be cool to see the conflicts and battles leading up to the forming of the Three Kingdoms from the perspective of a Hidden One.\u003c/p\u003e\u003cp\u003e\u003cimg src=\"https://eu-images.contentstack.com/v3/assets/bltbc1876152fcd9f07/blt2775f364428b3ad7/6a45204d3afe3fd1a6aa8f55/three_kingdoms.jpg\" alt=\" Eastern Han-Three Kingdoms Battle Painting (Source: Gary Todd/Xuchang City Museum, Henan Province)\"\u003e\u003c/p\u003e\u003ch2\u003e3. Tudor England (1485–1603)\u003c/h2\u003e\u003cp\u003eUbisoft has touched England twice now for the Assassin’s Creed games, but it hasn’t yet touched upon the Tudor reign. With a legacy lasting over a hundred years, there are plenty of opportunities for stories to tell during this time.\u003c/p\u003e\u003cp\u003eAn Assassin’s Creed game set during the Tudor reign could include the following events: the Battle of Bosworth Field, the Battle of Flodden and the end of the Middle Ages in the British Isles, the long reign of Henry VIII in the early 16th century, the Siege of Calais and the loss of Britain’s control of France, William Shakespeare, and the signing of the Treaty of Perpetual Peace in 1602.\u003c/p\u003e\u003cp\u003eTaking place during the same period as the Italian Renaissance, it’s also the perfect opportunity to have fan favourite character Ezio Auditore da Firenze make a cameo appearance, who would be active in the Assassins during the early Tudor reign.\u003c/p\u003e\u003cp\u003e\u003cimg src=\"https://eu-images.contentstack.com/v3/assets/bltbc1876152fcd9f07/bltf50468daca75a058/6a451fd42f9de47eddb70340/tudor.jpg\" alt=\"An Allegory of the Tudor Succession: The Family of Henry VIII (Source: \tYale Center for British Art)\"\u003e\u003c/p\u003e\u003ch2\u003e4. Thirty Years’ War (1618–1648)\u003c/h2\u003e\u003cp\u003eOften described as the one of the bloodiest conflicts in European history, the Thirty Years’ War was a political power struggle that began as a religious dispute between Catholics and Protestants, and escalated across the continent to include many European countries.\u003c/p\u003e\u003cp\u003eAn Assassin’s Creed game set during this war could tell the story of one character’s involvement in this war of the thirty-year period, all while detailing the involvement of the Assassins and the Templars. You’d have a bit of trouble trying to justify which side belongs to which faction, but depicting them as independent entities taking advantage of the chaos for their own means could be the setting for an interesting Assassin’s Creed story.\u003c/p\u003e\u003cp\u003e\u003cimg src=\"https://eu-images.contentstack.com/v3/assets/bltbc1876152fcd9f07/blt6088c3b9d2de0514/6a451f894711540ab7ab84a2/30_years_war.jpg\" alt=\"Wallenstein: A Scene of the Thirty Years War (oil on canvas) (Source: Ernest Crofts/Leeds Museums and Galleries)\"\u003e\u003c/p\u003e\u003ch2\u003e5. Salem Witch Trials (1692–1693)\u003c/h2\u003e\u003cp\u003eThe Salem witch trials took place in Salem, Massachusetts between February 1692 and May 1693, in which over 30 people were found guilty of practicing witchcraft, and 19 were executed.\u003c/p\u003e\u003cp\u003eTaking place just under a century before the Massachusetts we see in \u003cem\u003eAssassin’s Creed 3\u003c/em\u003e, the game could use the Salem witch trials as a background for the Assassin-Templar conflict, with Pieces of Eden being at the centre of these accusations.\u003c/p\u003e\u003cp\u003eFirmly, it’d also give historians a chance to clear up some misconceptions about the Salem witch trials, which still persist to this day. For example, common myths surrounding the trials include that all of the accused were women (around 20–25% of accusations were levelled at men), and that it was the result of superstition (many accusations were the result of fears of immigration and “outsiders” to the Puritans’ conformist society).\u003c/p\u003e\u003cp\u003e\u003cimg src=\"https://eu-images.contentstack.com/v3/assets/bltbc1876152fcd9f07/bltbeab89471ea4f3f4/6a451f1d47115458cdab849e/salem.jpg\" alt=\"The Witch No. 1 (Source: Joseph E. Baker/Library of Congress Prints \u0026amp; Photographs Division)\"\u003e\u003c/p\u003e\u003ch2\u003e6. Y2K (2000)\u003c/h2\u003e\u003cp\u003eOkay, hear me out. I actually find a lot to enjoy with Assassin’s Creed’s modern day plot. Well, maybe not the narrative in the more recent games, but if you think about the original conception of the modern day story involving Desmond and his allies, the mystery of the series’ mythology certainly provided us with a satisfying framing device to explain why we’re using the animus.\u003c/p\u003e\u003cp\u003eAn Assassin’s Creed game set in recent history, let’s say during Y2K, could introduce a fresh take on the series’ tired formula. It’d be play more akin to Ubisoft’s Watch Dogs games, but be intrinsically linked to the Assassin’s Creed lore which might give it a bit more gravitas.\u003c/p\u003e\u003cp\u003eSet 12 years before the events of the Desmond saga in Assassin’s Creed, a game set in this time period could involve characters like Daniel Cross and William Miles as key figures in the modern day conflict between the Assassins and Templars. We’d see Abstergo Industries, plus an early version of the Animus being developed.\u003c/p\u003e\u003cp\u003e\u003cimg src=\"https://eu-images.contentstack.com/v3/assets/bltbc1876152fcd9f07/blt73a7d827baa69675/6a4529ecb6620f33ecd8ee51/GettyImages-2283341830.jpg\" alt=\"Credit: Michael Nagle/Bloomberg via Getty Images\"\u003e\u003c/p\u003e"])</script><script>self.__next_f.push([1,"57:T24b1,"])</script><script>self.__next_f.push([1,"\u003cp\u003e\u003cem\u003eAssassin’s Creed IV: Black Flag\u003c/em\u003e is one of the most popular entries in the Ubisoft series, and 13 years on from its original release, it’s now been remade from the ground up for the modern era.\u003c/p\u003e\u003cp\u003eWith lush new visuals, improved animations, combat, exploration, stealth and more, \u003cem\u003eAssassin’s Creed Black Flag Resynced\u003c/em\u003e should be the definitive way to experience this beloved classic, so let’s find out.\u003c/p\u003e\u003cp\u003eThe story of \u003cem\u003eBlack Flag\u003c/em\u003e follows Edward Kenway, an adventurous man who takes on the pirate life in the hope of returning to his wife, Caroline, with endless riches to live a blissful and relaxing life. However, destiny would have plans for the charismatic Welshman after finding himself entangled in the centuries-old war between the Assassins and the Templars. What started as a selfish voyage in the hope of unimaginable riches, Edward would soon discover that he had a more meaningful purpose in life.\u003c/p\u003e\u003ch2\u003e\u003cstrong\u003e\u003cem\u003eAssassin’s Creed Black Flag Resynced\u003c/em\u003e is gorgeous\u003c/strong\u003e\u003c/h2\u003e\u003cp\u003eAnyone who is familiar with the 2013 original will know that it’s a gorgeous game, even to this day. I recently fired it up on my PlayStation 5 and Nintendo Switch, and it still holds up, to an extent. However, built from the ground up using the latest version of \u003ca href=\"https://www.gamingbible.com/ubisoft\" rel=\"noopener\" target=\"_blank\"\u003eUbisoft’s\u003c/a\u003e Anvil engine, \u003cem\u003eAssassin’s Creed Black Flag Resynced\u003c/em\u003e is an instant eye pleaser. The details on Edward and the supporting main cast, their animations, and the crisp voice audio make it feel like a brand new game. It’s perhaps not quite as visually pleasing as \u003cem\u003eAssassin’s Creed Shadows\u003c/em\u003e, especially when the seasons change, but this remake isn't too far off.\u003c/p\u003e\u003cp\u003eThe cities of Havana, Kingston, Nassau and more are vibrant with NPC life, with more active, life-like crowds. The sun shining on the stunning architecture, the vibrant jungle with dense foliage, the crashing waves on the Jackdown, with the sun reflecting off the sea, is a sight to behold. The lighting and shadows have also been greatly improved. Trust me, you’ll soon be spanning the photo mode to create some stunning screenshots to share with the community. I must also mention the dynamic weather. It’s quite a sight to be walking in a sunny Havana, to then face tropical rain. However, it's more than just a visual change, because when out at sea on the Jackdaw, you’ll be feeling the power of the wind as you fight against the elements, while frantically trying to avoid the approaching tornadoes during an intense thunderstorm.\u003c/p\u003e\u003cp\u003eIn terms of gameplay, this is quite possibly where \u003cem\u003eAssassin’s Creed Black Flag Resynced\u003c/em\u003e shines the most. Combat feels more free-flowing, and you’ll have more of a reliance on parrying and dodging attacks. Much like Dark Souls, enemies will have a sub-metre that will break down their defence the more you hammer them. But be warned, if you spam an attack, the enemy will soon counter you with ease.\u003c/p\u003e\u003cp\u003e\u003cimg src=\"https://eu-images.contentstack.com/v3/assets/bltbc1876152fcd9f07/blt390aed679f744102/6a4e16ac7a9247744471d602/assassins-creed-black-flag-resynced-review-screenshot-2.jpg\" alt=\"Assassin’s Creed Black Flag Resynced, Ubisoft\"\u003e\u003c/p\u003e\u003ch2\u003e\u003cstrong\u003eCombat is greatly improved\u003c/strong\u003e\u003c/h2\u003e\u003cp\u003eOther than a well-timed parry, which can result in an instant-kill depending on the enemy type, successfully killing a sequence of foes will trigger a satisfactory chain of attacks. Furthermore, if you successfully parry an attack, you’ll be able to unleash a deadly execution, which will soon have the enemy regretting coming after you, because you dared put a foot on its turf.\u003c/p\u003e\u003cp\u003eHowever, it’s the stealth that has improved most of all in this remake. For starters, there appears to be more foliage to hide in, and while purely aesthetic, it actually looks like you're hidden, instead of worrying how on earth the enemy can't see your backside sticking out of the bush. In the original game, the stealth missions were rather annoying, in respect of receiving an instant game over if the enemy saw you. Now, instead of that, when the enemy spots you, it will trigger combat, instead of restarting the checkpoint.\u003c/p\u003e\u003cp\u003eEdward can now crouch at any point; he can pretty much lean against all walls and boxes. There’s no set path when tailing enemies. He can easily tag enemies when using eagle vision, and it's easier to keep track of enemies when they walk around a corner or run away. Yet, while Edward has more stealth abilities, enemies appear to be more alert and will often suspect your presence.\u003c/p\u003e\u003cp\u003eIf I had one criticism with the stealth, it is not being able to move to a prone position, an ability that was available in 2025’s \u003cem\u003eAssassin’s Creed Shadows\u003c/em\u003e. So, having just finished that game recently, it feels odd not being able to do this in the remake. I’m hoping Ubisoft adds this ability sooner rather than later. Oh, you can also jump on the spot, but I’ve never used this ability once. It feels out of place, which is odd to say for a parkour game. But, that’s probably since it never existed in the original and exists here for reasons unknown.\u003c/p\u003e\u003ch2\u003e\u003cstrong\u003eRun, Edward, run!\u003c/strong\u003e\u003c/h2\u003e\u003cp\u003eWhile not perfect, as you will find yourself accidentally jumping in the wrong direction from time to time, the parkour in the remake is far more precise than in the original. It feels like you have more freedom and control when it comes to scaling structures.\u003c/p\u003e\u003cp\u003eEdward can leap in more directions when scaling, running across rooftops has more flow, and Edward's parkour animations look more natural. That being said, there doesn't appear to be as much freedom in the number of natural environments that you can climb, such as a rockface. While this wasn't perfect in \u003cem\u003eAssassin’s Creed Shadows\u003c/em\u003e, it certainly has greater variety than this remake, at this time. It can just feel a bit off-putting trying to climb a rock wall that Edward \u003cem\u003eshould \u003c/em\u003ebe able to scale, only for him to get invisible wall syndrome.\u003c/p\u003e\u003cp\u003e\u003cimg src=\"https://eu-images.contentstack.com/v3/assets/bltbc1876152fcd9f07/bltdff55f7fcb7341ae/6a4e1704c502e85812d21670/assassins-creed-black-flag-resynced-review-screenshot-3.jpg\" alt=\"Assassin’s Creed Black Flag Resynced, Ubisoft\"\u003e\u003c/p\u003e\u003ch2\u003e\u003cstrong\u003eThere are plenty of new missions and some exclusions\u003c/strong\u003e\u003c/h2\u003e\u003cp\u003eWithout giving too much away, while much of the remake remains very faithful to the original game, it does have new content not in the 2013 game. There are new missions for the new NPCs, Lucy Baldwin, the Padre and Deadman, all of which can become officers on the Jackdaw, once you’ve completed their story missions. When completed, Lucy will add a new defensive brace ability. The Padre will add a new ram dash, and Deadman will improve the canons. So, it’s well worth taking the time to hire these recruits.\u003c/p\u003e\u003cp\u003eWhat’s more, there are also new missions for existing fan-favourite characters, namely Blackbeard, James Kidd, Stede Bonnet, and Edward’s wife, Caroline. There are also eight endgame missions involving Blackbeard, which adds some intriguing lore for the infamous pirate in the world of \u003ca href=\"https://www.gamingbible.com/assassins-creed\" rel=\"noopener\" target=\"_blank\"\u003eAssassin’s Creed\u003c/a\u003e. I must say that all this new content helps make up for the absence of the \u003cem\u003eFreedom Cry\u003c/em\u003e expansion to an extent. But those Abstergo, modern-day office missions, perhaps I won't miss those quite as much. Though I suppose you can recruit cute cats and monkeys to chill on your Jackdaw, which cushions the blow.\u003c/p\u003e\u003ch2\u003e\u003cstrong\u003eOne of the best Assassin’s Creed games gets even better\u003c/strong\u003e\u003c/h2\u003e\u003cp\u003eWhen \u003cem\u003eAssassin’s Creed Black Flag Resynced\u003c/em\u003e was officially announced, it had some fair criticism, debating whether or not it really needed to exist. After all, it was only released during the early days of the last generation in 2013. However, this is arguably the best game in the series, perhaps only topped by \u003cem\u003eAssassin’s Creed II\u003c/em\u003e and \u003cem\u003eAssassin’s Creed Brotherhood\u003c/em\u003e.\u003c/p\u003e\u003cp\u003eThe developers at Ubisoft have clearly gone to great lengths to ensure that this remake deserves to exist, and it’s very clear after spending many hours with the game that it’s a love letter to the fans and the developers. The folks at Ubisoft have made one of the best games ever, even better. Whether you’re a returning veteran or a newbie, \u003cem\u003eAssassin’s Creed Black Flag Resynced\u003c/em\u003e is the definitive way to experience this all-time classic.\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cem\u003ePros: \u003c/em\u003e\u003c/strong\u003e\u003cem\u003eGorgeous visuals, improved combat and stealth, lots of new meaningful missions\u003c/em\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cem\u003eCons: \u003c/em\u003e\u003c/strong\u003e\u003cem\u003eNo prone ability, no Freedom Cry expansion\u003c/em\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cem\u003eFor fans of: \u003c/em\u003e\u003c/strong\u003e\u003cem\u003eAssassin’s Creed III, Skull \u0026amp; Bones, Sea of Thieves\u003c/em\u003e\u003c/p\u003e\u003ch2\u003e\u003cstrong\u003e\u003cem\u003e8/10:\u003c/em\u003e\u003c/strong\u003e\u003cem\u003e Excellent\u003c/em\u003e\u003c/h2\u003e\u003cp\u003e\u003cem\u003eAssassin’s Creed Black Flag Resynced will be released on 9 July 2026 on PC, PlayStation 5 (version tested) and Xbox Series X/S. A review code was provided by the publisher. \u003c/em\u003e\u003ca href=\"https://www.gamingbible.com/features/gamingbibles-review-scores-guide-110351-20240716\" rel=\"noopener\" target=\"_blank\"\u003e\u003cem\u003eRead a guide to our review scores here\u003c/em\u003e\u003c/a\u003e\u003cem\u003e.\u003c/em\u003e\u003c/p\u003e"])</script><script>self.__next_f.push([1,"49:[\"$\",\"$L50\",null,{\"articles\":[{\"id\":\"bltfad0a59ae697a251\",\"title\":\"Assassin's Creed Black Flag Resynced players warned about bug which wipes hours of progress\",\"staticLink\":\"/news/assassins-creed-black-flag-resynced-progress-glitch-236495-20260709\"},{\"id\":\"blt7189a4f3b951bece\",\"title\":\"Assassin’s Creed Black Flag remake hits record player numbers on day 51 staff are laid off\",\"staticLink\":\"/news/assassins-creed-black-flag-remake-record-ubisoft-layoffs-024089-20260710\"},{\"id\":\"blt20e6b754b451e0a7\",\"title\":\"6 Historical Periods Assassin's Creed Needs To Visit After Black Flag Resynced\",\"staticLink\":\"/news/assassins-creed-future-game-settings-538131-20260701\"},{\"id\":\"blt86f97344eb160578\",\"title\":\"Assassin's Creed Black Flag Resynced is better than the original in almost every way\",\"staticLink\":\"/reviews/assassins-creed-black-flag-resynced-review-778209-20260708\"}],\"children\":[[\"$\",\"$L45\",\"bltfad0a59ae697a251\",{\"channel\":\"gamingbible\",\"content\":{\"author\":{\"avatar\":null,\"bio\":\"Olly is an experienced journalist of over 10 years. He loves stealth and adventure games, with some of his favourites including Hitman, Dishonored, Tomb Raider, and Thief.\",\"name\":\"Olly Smith\",\"slug\":\"olly-smith\",\"twitterHandle\":\"\"},\"body\":\"$51\",\"breaking\":false,\"categories\":[{\"name\":\"News\",\"slug\":\"news\"}],\"classification\":[{\"key\":\"mantis_green\",\"value\":\"Cadbury,Default,GamingBibleBS,HighRisk,PMI,PayUK,amazon,bbc,gambling,sky,tesco,valmorggov\"},{\"key\":\"mantis_amber\",\"value\":\"AgencyMasterBS\"},{\"key\":\"mantis_red\",\"value\":\"Disney,categorythresholds,hoopla\"},{\"key\":\"mantis_emotions\",\"value\":\"sadness-low,joy-low,fear-low,disgust-low,anger-low\"},{\"key\":\"mantis_sentiment\",\"value\":\"veryNegative\"},{\"key\":\"mantis_context\",\"value\":\"technology_computing,operating_systems,windows,art_entertainment,shows_events,business_industrial,business_operations,business_plans,software,graphics_software\"},{\"key\":\"iab_cat\",\"value\":\"615,150,73,602\"},{\"key\":\"watson_context\",\"value\":\"/technology and computing/operating systems/windows,/art and entertainment/shows and events,/business and industrial/business operations/business plans,/technology and computing/software/graphics software\"}],\"containsAffiliateContent\":false,\"contentType\":\"article\",\"distributions\":[{\"name\":\"msn\",\"slug\":\"msn\"},{\"name\":\"recirc-unit\",\"slug\":\"recirc-unit\"},{\"name\":\"Apple News\",\"slug\":\"apple-news\"},{\"name\":\"Category Pages\",\"slug\":\"category-page\"},{\"name\":\"News Now\",\"slug\":\"news-now\"},{\"name\":\"Samsung News\",\"slug\":\"samsung-news\"},{\"name\":\"Google News\",\"slug\":\"google-news\"},{\"name\":\"Google Search\",\"slug\":\"google-search\"},{\"name\":\"Homepage\",\"slug\":\"homepage\"},{\"name\":\"Tag Pages\",\"slug\":\"tag-page\"},{\"name\":\"Website\",\"slug\":\"website\"}],\"featuredImage\":\"https://eu-images.contentstack.com/v3/assets/bltbc1876152fcd9f07/blt07065dd706627658/6a4fa7e5360c6b44d6656792/black_flag_resynced.jpg\",\"featuredImageInfo\":{\"url\":null,\"credit\":{\"text\":\"Ubisoft\",\"link\":null}},\"featuredVideo\":null,\"featuredVideoInfo\":null,\"id\":\"bltfad0a59ae697a251\",\"isLiveArticle\":false,\"isLiveArticleActive\":false,\"isSponsored\":false,\"list\":null,\"metaDescription\":\"Be warned if you're playing the Black Flag remake!\",\"metaTitle\":\"Assassin's Creed Black Flag Resynced players warned about bug which wipes hours of progress\",\"properties\":[{\"name\":\"Rating-U\",\"slug\":\"rating-u\"}],\"publishedAt\":\"2026-07-10T02:00:00.798Z\",\"publishedAtUTC\":\"2026-07-10T02:00:00.798Z\",\"showAdverts\":true,\"showRelatedArticles\":true,\"socialImage\":null,\"sponsor\":null,\"sponsoredType\":null,\"staticLink\":\"/news/assassins-creed-black-flag-resynced-progress-glitch-236495-20260709\",\"summary\":\"If you're playing the Assassin's Creed Black Flag remake, be warned about this glitch that'll set you back hours.\",\"tags\":[{\"name\":\"Assassin's Creed\",\"slug\":\"assassins-creed\"},{\"name\":\"Ubisoft\",\"slug\":\"ubisoft\"}],\"title\":\"Assassin's Creed Black Flag Resynced players warned about bug which wipes hours of progress\",\"updatedAt\":\"2026-07-10T02:00:00.798Z\",\"updatedAtUTC\":\"2026-07-10T02:00:00.798Z\",\"version\":5},\"editorsPicksArticles\":\"$43:props:children:1:props:children:0:props:editorsPicksArticles\",\"editorsPicksVariant\":\"default\",\"adsConfig\":\"$43:props:children:1:props:children:0:props:adsConfig\",\"index\":0,\"children\":\"$L52\"}],[\"$\",\"$L45\",\"blt7189a4f3b951bece\",{\"channel\":\"gamingbible\",\"content\":{\"author\":{\"avatar\":\"https://eu-images.contentstack.com/v3/assets/bltbc1876152fcd9f07/blt969314dde2beb329/6812368ddfd7b95ef735940b/me_villa.jpg\",\"bio\":\"Studied at BDes Hons Video Games and Digital Media and is obsessed with everything Resident Evil, Silent Hill, Metal Gear Solid, football and WWE/AEW. Richard is also a proud mental health ambassador for Safe in Our World.\",\"name\":\"Richard Breslin\",\"slug\":\"richard-breslin\",\"twitterHandle\":\"\"},\"body\":\"$53\",\"breaking\":false,\"categories\":[{\"name\":\"News\",\"slug\":\"news\"}],\"classification\":[{\"key\":\"mantis_green\",\"value\":\"Default,GamingBibleBS,HighRisk,PMI,PayUK,amazon,bbc,gambling,sky,tesco,valmorggov\"},{\"key\":\"mantis_amber\",\"value\":\"categorythresholds\"},{\"key\":\"mantis_red\",\"value\":\"AgencyMasterBS,Cadbury,Disney,hoopla\"},{\"key\":\"mantis_emotions\",\"value\":\"sadness-low,joy-low,fear-low,disgust-low,anger-low\"},{\"key\":\"mantis_sentiment\",\"value\":\"negative\"},{\"key\":\"mantis_context\",\"value\":\"technology_computing,software,graphics_software,hardware,society,work,business_industrial,business_operations,business_plans,careers,career_planning,art_entertainment,shows_events,law_govt_politics,telecommuting\"},{\"key\":\"iab_cat\",\"value\":\"602,596,73,126,150,123\"},{\"key\":\"watson_context\",\"value\":\"/technology and computing/software/graphics software,/technology and computing/hardware,/society/work,/business and industrial/business operations/business plans,/careers/career planning,/art and entertainment/shows and events,/law, govt and politics,/careers/telecommuting\"}],\"containsAffiliateContent\":false,\"contentType\":\"article\",\"distributions\":[{\"name\":\"msn\",\"slug\":\"msn\"},{\"name\":\"recirc-unit\",\"slug\":\"recirc-unit\"},{\"name\":\"Apple News\",\"slug\":\"apple-news\"},{\"name\":\"Category Pages\",\"slug\":\"category-page\"},{\"name\":\"News Now\",\"slug\":\"news-now\"},{\"name\":\"Samsung News\",\"slug\":\"samsung-news\"},{\"name\":\"Google News\",\"slug\":\"google-news\"},{\"name\":\"Google Search\",\"slug\":\"google-search\"},{\"name\":\"Homepage\",\"slug\":\"homepage\"},{\"name\":\"Tag Pages\",\"slug\":\"tag-page\"},{\"name\":\"Website\",\"slug\":\"website\"}],\"featuredImage\":\"https://eu-images.contentstack.com/v3/assets/bltbc1876152fcd9f07/bltb73da4396c7fd656/6a50d72d6e0fe1d2fc42f8c6/assassins-creed-black-flag-10072026.jpg\",\"featuredImageInfo\":{\"url\":null,\"credit\":{\"text\":\"Ubisoft\",\"link\":null}},\"featuredVideo\":null,\"featuredVideoInfo\":null,\"id\":\"blt7189a4f3b951bece\",\"isLiveArticle\":false,\"isLiveArticleActive\":false,\"isSponsored\":false,\"list\":null,\"metaDescription\":\"Assassin’s Creed Black Flag Resynced continues to go down well, but it can't save jobs\",\"metaTitle\":\"Assassin’s Creed Black Flag remake hits record player numbers on day 51 staff are laid off\",\"properties\":[{\"name\":\"Rating-U\",\"slug\":\"rating-u\"}],\"publishedAt\":\"2026-07-10T11:37:04.169Z\",\"publishedAtUTC\":\"2026-07-10T11:37:04.169Z\",\"showAdverts\":true,\"showRelatedArticles\":true,\"socialImage\":null,\"sponsor\":null,\"sponsoredType\":null,\"staticLink\":\"/news/assassins-creed-black-flag-remake-record-ubisoft-layoffs-024089-20260710\",\"summary\":\"Black Flag Remake Has Strong Launch Despite Ubisoft Layoffs\",\"tags\":[{\"name\":\"Assassin's Creed\",\"slug\":\"assassins-creed\"},{\"name\":\"Ubisoft\",\"slug\":\"ubisoft\"}],\"title\":\"Assassin’s Creed Black Flag remake hits record player numbers on day 51 staff are laid off\",\"updatedAt\":\"2026-07-10T11:39:53.263Z\",\"updatedAtUTC\":\"2026-07-10T11:39:53.263Z\",\"version\":3},\"editorsPicksArticles\":\"$43:props:children:1:props:children:0:props:editorsPicksArticles\",\"editorsPicksVariant\":\"default\",\"adsConfig\":\"$43:props:children:1:props:children:0:props:adsConfig\",\"index\":1,\"children\":\"$L54\"}],[\"$\",\"$L45\",\"blt20e6b754b451e0a7\",{\"channel\":\"gamingbible\",\"content\":{\"author\":{\"avatar\":null,\"bio\":\"Olly is an experienced journalist of over 10 years. He loves stealth and adventure games, with some of his favourites including Hitman, Dishonored, Tomb Raider, and Thief.\",\"name\":\"Olly Smith\",\"slug\":\"olly-smith\",\"twitterHandle\":\"\"},\"body\":\"$55\",\"breaking\":false,\"categories\":[{\"name\":\"News\",\"slug\":\"news\"}],\"classification\":[{\"key\":\"mantis_green\",\"value\":\"GamingBibleBS,bbc,gambling,tesco\"},{\"key\":\"mantis_amber\",\"value\":\"categorythresholds\"},{\"key\":\"mantis_red\",\"value\":\"AgencyMasterBS,Cadbury,Default,Disney,HighRisk,PMI,PayUK,amazon,hoopla,sky,valmorggov\"},{\"key\":\"mantis_emotions\",\"value\":\"sadness-low,joy-low,fear-low,disgust-low,anger-low\"},{\"key\":\"mantis_sentiment\",\"value\":\"positive\"},{\"key\":\"mantis_context\",\"value\":\"law_govt_politics,politics,art_entertainment,shows_events\"},{\"key\":\"iab_cat\",\"value\":\"386,150\"},{\"key\":\"watson_context\",\"value\":\"/law, govt and politics/politics,/art and entertainment/shows and events\"}],\"containsAffiliateContent\":false,\"contentType\":\"article\",\"distributions\":[{\"name\":\"msn\",\"slug\":\"msn\"},{\"name\":\"recirc-unit\",\"slug\":\"recirc-unit\"},{\"name\":\"Apple News\",\"slug\":\"apple-news\"},{\"name\":\"Category Pages\",\"slug\":\"category-page\"},{\"name\":\"News Now\",\"slug\":\"news-now\"},{\"name\":\"Samsung News\",\"slug\":\"samsung-news\"},{\"name\":\"Google News\",\"slug\":\"google-news\"},{\"name\":\"Google Search\",\"slug\":\"google-search\"},{\"name\":\"Homepage\",\"slug\":\"homepage\"},{\"name\":\"Tag Pages\",\"slug\":\"tag-page\"},{\"name\":\"Website\",\"slug\":\"website\"}],\"featuredImage\":\"https://eu-images.contentstack.com/v3/assets/bltbc1876152fcd9f07/blta46a4dccc7cfe47a/6a452cf9206421cb834369eb/assassins_creed.jpg\",\"featuredImageInfo\":{\"url\":null,\"credit\":{\"text\":\"Ubisoft\",\"link\":null}},\"featuredVideo\":null,\"featuredVideoInfo\":null,\"id\":\"blt20e6b754b451e0a7\",\"isLiveArticle\":false,\"isLiveArticleActive\":false,\"isSponsored\":false,\"list\":null,\"metaDescription\":\"Assassin's Creed needs to go to these places next!\",\"metaTitle\":\"6 Historical Periods Assassin's Creed Needs To Visit After Black Flag Resynced\",\"properties\":[{\"name\":\"Rating-U\",\"slug\":\"rating-u\"}],\"publishedAt\":\"2026-07-04T23:00:00.931Z\",\"publishedAtUTC\":\"2026-07-04T23:00:00.931Z\",\"showAdverts\":true,\"showRelatedArticles\":true,\"socialImage\":null,\"sponsor\":null,\"sponsoredType\":null,\"staticLink\":\"/news/assassins-creed-future-game-settings-538131-20260701\",\"summary\":\"From the Salem Witch Trials to the Thirty Years' War, here's where Ubisoft should take the series next.\",\"tags\":[{\"name\":\"Assassin's Creed\",\"slug\":\"assassins-creed\"},{\"name\":\"Ubisoft\",\"slug\":\"ubisoft\"},{\"name\":\"List\",\"slug\":\"list\"},{\"name\":\"Features\",\"slug\":\"features\"}],\"title\":\"6 Historical Periods Assassin's Creed Needs To Visit After Black Flag Resynced\",\"updatedAt\":\"2026-07-04T23:00:00.931Z\",\"updatedAtUTC\":\"2026-07-04T23:00:00.931Z\",\"version\":11},\"editorsPicksArticles\":\"$43:props:children:1:props:children:0:props:editorsPicksArticles\",\"editorsPicksVariant\":\"default\",\"adsConfig\":\"$43:props:children:1:props:children:0:props:adsConfig\",\"index\":2,\"children\":\"$L56\"}],[\"$\",\"$L45\",\"blt86f97344eb160578\",{\"channel\":\"gamingbible\",\"content\":{\"author\":{\"avatar\":\"https://eu-images.contentstack.com/v3/assets/bltbc1876152fcd9f07/blt969314dde2beb329/6812368ddfd7b95ef735940b/me_villa.jpg\",\"bio\":\"Studied at BDes Hons Video Games and Digital Media and is obsessed with everything Resident Evil, Silent Hill, Metal Gear Solid, football and WWE/AEW. Richard is also a proud mental health ambassador for Safe in Our World.\",\"name\":\"Richard Breslin\",\"slug\":\"richard-breslin\",\"twitterHandle\":\"\"},\"body\":\"$57\",\"breaking\":false,\"categories\":[{\"name\":\"Reviews\",\"slug\":\"reviews\"}],\"classification\":[{\"key\":\"mantis_green\",\"value\":\"Default,GamingBibleBS,PayUK,amazon,bbc,gambling,hoopla,tesco\"},{\"key\":\"mantis_amber\",\"value\":\"\"},{\"key\":\"mantis_red\",\"value\":\"AgencyMasterBS,Cadbury,Disney,HighRisk,PMI,categorythresholds,sky,valmorggov\"},{\"key\":\"mantis_emotions\",\"value\":\"sadness-low,joy-medium,fear-low,disgust-low,anger-low\"},{\"key\":\"mantis_sentiment\",\"value\":\"positive\"},{\"key\":\"mantis_context\",\"value\":\"art_entertainment,shows_events,business_industrial,business_operations,business_plans,style_fashion,body_art,society,senior_living,family_parenting,children,dating,technology_computing,hardware,computer_components,pets,large_animals\"},{\"key\":\"iab_cat\",\"value\":\"150,73,574,230,197,188,596,427\"},{\"key\":\"watson_context\",\"value\":\"/art and entertainment/shows and events,/business and industrial/business operations/business plans,/style and fashion/body art,/society/senior living,/family and parenting/children,/society/dating,/technology and computing/hardware,/technology and computing/hardware/computer components,/pets/large animals\"}],\"containsAffiliateContent\":false,\"contentType\":\"article\",\"distributions\":[{\"name\":\"msn\",\"slug\":\"msn\"},{\"name\":\"recirc-unit\",\"slug\":\"recirc-unit\"},{\"name\":\"Apple News\",\"slug\":\"apple-news\"},{\"name\":\"Category Pages\",\"slug\":\"category-page\"},{\"name\":\"News Now\",\"slug\":\"news-now\"},{\"name\":\"Samsung News\",\"slug\":\"samsung-news\"},{\"name\":\"Google News\",\"slug\":\"google-news\"},{\"name\":\"Google Search\",\"slug\":\"google-search\"},{\"name\":\"Homepage\",\"slug\":\"homepage\"},{\"name\":\"Tag Pages\",\"slug\":\"tag-page\"},{\"name\":\"Website\",\"slug\":\"website\"}],\"featuredImage\":\"https://eu-images.contentstack.com/v3/assets/bltbc1876152fcd9f07/bltf954a8f00ba06615/6a4e13ba74167f20c8a6cb1c/assassins-creed-black-flag-resynced-review-feature.jpg\",\"featuredImageInfo\":{\"url\":null,\"credit\":{\"text\":\"Ubisoft\",\"link\":null}},\"featuredVideo\":null,\"featuredVideoInfo\":null,\"id\":\"blt86f97344eb160578\",\"isLiveArticle\":false,\"isLiveArticleActive\":false,\"isSponsored\":false,\"list\":null,\"metaDescription\":\"13 years later, Assassin's Creed Black Flag feels brand new\",\"metaTitle\":\"Assassin's Creed Black Flag Resynced is better than the original in almost every way\",\"properties\":[{\"name\":\"Rating-U\",\"slug\":\"rating-u\"}],\"publishedAt\":\"2026-07-08T10:00:00.292Z\",\"publishedAtUTC\":\"2026-07-08T10:00:00.292Z\",\"showAdverts\":true,\"showRelatedArticles\":true,\"socialImage\":null,\"sponsor\":null,\"sponsoredType\":null,\"staticLink\":\"/reviews/assassins-creed-black-flag-resynced-review-778209-20260708\",\"summary\":\"Assassin's Creed Black Flag Resynced is a pirate masterpiece reborn\",\"tags\":[{\"name\":\"Assassin's Creed\",\"slug\":\"assassins-creed\"},{\"name\":\"Reviews\",\"slug\":\"reviews\"},{\"name\":\"Ubisoft\",\"slug\":\"ubisoft\"}],\"title\":\"Assassin's Creed Black Flag Resynced is better than the original in almost every way\",\"updatedAt\":\"2026-07-08T10:00:00.292Z\",\"updatedAtUTC\":\"2026-07-08T10:00:00.292Z\",\"version\":3},\"editorsPicksArticles\":\"$43:props:children:1:props:children:0:props:editorsPicksArticles\",\"editorsPicksVariant\":\"default\",\"adsConfig\":\"$43:props:children:1:props:children:0:props:adsConfig\",\"index\":3,\"children\":\"$L58\"}]]}]\n"])</script><script>self.__next_f.push([1,"52:[\"$\",\"$L4b\",null,{\"adsConfig\":\"$43:props:children:1:props:children:0:props:adsConfig\",\"contentType\":\"article\",\"isFloatingVideoAd\":false,\"children\":[[\"$\",\"p\",\"0\",{\"className\":\"text_text__nEn66\",\"children\":[[\"$\",\"em\",\"0\",{\"children\":\"Assassin’s Creed Black Flag Resynced\"}],\" players are being warned of a bug present in the game, which can apparently wipe out hours of progress.\"]}],[\"$\",\"p\",\"1\",{\"className\":\"text_text__nEn66\",\"children\":[\"The \",[\"$\",\"$L35\",\"1\",{\"href\":\"https://www.gamingbible.com/assassins-creed\",\"className\":\"anchor_link__6t7IO\",\"children\":\"Assassin’s Creed\",\"prefetch\":false}],\" series features some of the biggest and most in-depth virtual worlds you’ll ever experience, but with that comes the caveat that you’ll often spend hundreds of hours playing through them.\"]}],[\"$\",\"p\",\"2\",{\"className\":\"text_text__nEn66\",\"children\":[\"With \",[\"$\",\"em\",\"1\",{\"children\":\"Black Flag Resynced\"}],\" being the most recent release, one particularly nasty glitch has the potential to wipe out hours of progress from your save file.\"]}],[\"$\",\"p\",\"3\",{\"className\":\"text_text__nEn66\",\"children\":[\"The bug was \",[\"$\",\"$L35\",\"1\",{\"href\":\"https://bsky.app/profile/stephentotilo.bsky.social/post/3mq5cjqbskk2m\",\"className\":\"anchor_link__6t7IO\",\"target\":\"_blank\",\"rel\":\"noopener\",\"children\":\"first shared\",\"prefetch\":false}],\" by Game File’s Stephen Totilo (\",[\"$\",\"$L35\",\"3\",{\"href\":\"https://www.gamesradar.com/games/assassin-s-creed/assassins-creed-black-flag-resynced-reportedly-has-a-bug-that-can-wipe-hours-of-playtime-but-ubisoft-is-working-on-a-fix/\",\"className\":\"anchor_link__6t7IO\",\"target\":\"_blank\",\"rel\":\"noopener\",\"children\":\"via\",\"prefetch\":false}],\" GamesRadar), who reports that Templar Hunt side quests may leave players losing hours of their save file if they leave them unfinished.\"]}],[\"$\",\"p\",\"4\",{\"className\":\"text_text__nEn66\",\"children\":[\"“If you're playing \",[\"$\",\"em\",\"1\",{\"children\":\"Assassin's Creed Black Flag Resynced\"}],\", do not leave any Templar Hunt sidequest chains unfinished. It produced a glitch that cost me five hours of playing time,” Totilo writes on Bluesky.\"]}],[\"$\",\"p\",\"5\",{\"className\":\"text_text__nEn66\",\"children\":\"Adding specifics in a follow-up post, Totilo says that he was “I was several quests into the Templar Hunt in Kingston, had left the region to play other parts. Eventually triggered a main story mission in Kingston (\\\"Imagine my Surprise\\\"). The TH chain and main quest blocked each other. Couldn't progress.”\"}],[\"$\",\"$19\",\"6\",{\"children\":[[\"$\",\"blockquote\",\"0\",{\"className\":\"bluesky-embed\",\"data-bluesky-uri\":\"at://did:plc:fs2pfwz4ohuc7nhlshklw55d/app.bsky.feed.post/3mq5cjqbskk2m\",\"data-bluesky-cid\":\"bafyreiaezlln3oc4yrp626q4gn472fanxk2ve7ru4pvmbt5e74q743y3ei\",\"data-bluesky-embed-color-mode\":\"system\",\"children\":[[\"$\",\"p\",\"0\",{\"className\":\"text_text__nEn66\",\"children\":[\"PSA: If you're playing Assassin's Creed Black Flag Resynced, do not leave any Templar Hunt sidequest chains unfinished. It produced a glitch that cost me five hours of playing time. \\n\\nThe game's really fun and some of the new bits are interesting in unexpected ways. But my write-up is delayed!\",[\"$\",\"br\",\"1\",{\"children\":\"$undefined\"}],[\"$\",\"br\",\"2\",{\"children\":\"$undefined\"}],[\"$\",\"$L35\",\"3\",{\"href\":\"https://bsky.app/profile/did:plc:fs2pfwz4ohuc7nhlshklw55d/post/3mq5cjqbskk2m?ref_src=embed\",\"className\":\"anchor_link__6t7IO\",\"target\":\"$undefined\",\"rel\":\"$undefined\",\"children\":\"[image or embed]\",\"prefetch\":false}]]}],\"— Stephen Totilo (\",[\"$\",\"$L35\",\"2\",{\"href\":\"https://bsky.app/profile/did:plc:fs2pfwz4ohuc7nhlshklw55d?ref_src=embed\",\"className\":\"anchor_link__6t7IO\",\"target\":\"$undefined\",\"rel\":\"$undefined\",\"children\":\"@stephentotilo.bsky.social\",\"prefetch\":false}],\") \",[\"$\",\"$L35\",\"4\",{\"href\":\"https://bsky.app/profile/did:plc:fs2pfwz4ohuc7nhlshklw55d/post/3mq5cjqbskk2m?ref_src=embed\",\"className\":\"anchor_link__6t7IO\",\"target\":\"$undefined\",\"rel\":\"$undefined\",\"children\":\"8 July 2026 at 15:14\",\"prefetch\":false}]]}],[\"$\",\"div\",\"1\",{}]]}],[\"$\",\"p\",\"7\",{\"className\":\"text_text__nEn66\",\"children\":[\"$\",\"br\",null,{\"children\":\"$undefined\"}]}],[\"$\",\"p\",\"8\",{\"className\":\"text_text__nEn66\",\"children\":\"He then says that Ubisoft has identified the bug and that it will be fixed as part of a future update, though it isn’t confirmed when that will be live.\"}],[\"$\",\"p\",\"9\",{\"className\":\"text_text__nEn66\",\"children\":[[\"$\",\"strong\",\"0\",{\"children\":\"Read More: \"}],[\"$\",\"$L35\",\"1\",{\"href\":\"https://www.gamingbible.com/news/assassins-creed-future-game-settings-538131-20260701\",\"className\":\"anchor_link__6t7IO\",\"children\":[\"$\",\"strong\",null,{\"children\":\"6 Historical Periods Assassin's Creed Needs To Visit After Black Flag Resynced\"}],\"prefetch\":false}]]}],[\"$\",\"h2\",\"10\",{\"children\":[\"How to avoid the Templar Hunt save progress glitch in \",[\"$\",\"em\",\"1\",{\"children\":\"Assassin's Creed Black Flag Resynced\"}]]}],[\"$\",\"p\",\"11\",{\"className\":\"text_text__nEn66\",\"children\":\"The best way to avoid this bug is to simply avoid doing the Templar Hunt side quests for now until the next patch fixes it.\"}],[\"$\",\"p\",\"12\",{\"className\":\"text_text__nEn66\",\"children\":\"Templar Hunts are missions in which you can collect a series of keys which will allow you to unlock the desirable Templar Armor set for Edward, one of the most powerful armours in the game.\"}],[\"$\",\"p\",\"13\",{\"className\":\"text_text__nEn66\",\"children\":\"There are four quests in the game which allow you to unlock these keys, which must be played in order, and once you’ve collected all the keys, you’ll be able to unlock the armour and claim it for yourself.\"}],[\"$\",\"p\",\"14\",{\"className\":\"text_text__nEn66\",\"children\":\"The first of these quests is called This Old Cove, and occurs at the beginning of Sequence 4.\"}],[\"$\",\"p\",\"15\",{\"className\":\"text_text__nEn66\",\"children\":\"However, with the save progress glitch currently in the game, you have to essentially complete one Templar Hunt side quest as you receive them, as starting a main story mission may result in both questlines blocking each other and softlocking you, meaning you need to go back to an earlier save.\"}],[\"$\",\"p\",\"16\",{\"className\":\"text_text__nEn66\",\"children\":\"With Ubisoft aware of the issue, it’s only a matter of time before the issue is patched out, which has already been confirmed to be coming in a future update.\"}],[\"$\",\"p\",\"17\",{\"className\":\"text_text__nEn66\",\"children\":[\"In GAMINGbible’s \",[\"$\",\"$L35\",\"1\",{\"href\":\"https://www.gamingbible.com/reviews/assassins-creed-black-flag-resynced-review-778209-20260708\",\"className\":\"anchor_link__6t7IO\",\"children\":[\"$\",\"em\",null,{\"children\":\"Assassin’s Creed Black Flag Resynced review\"}],\"prefetch\":false}],\", we said that Ubisoft has “clearly gone to great lengths to ensure that this remake deserves to exist, and it’s very clear after spending many hours with the game that it’s a love letter to the fans and the developers.”\"]}]]}]\n"])</script><script>self.__next_f.push([1,"54:[\"$\",\"$L4b\",null,{\"adsConfig\":\"$43:props:children:1:props:children:0:props:adsConfig\",\"contentType\":\"article\",\"isFloatingVideoAd\":false,\"children\":[[\"$\",\"p\",\"0\",{\"className\":\"text_text__nEn66\",\"children\":[\"Ubisoft is enjoying a successful launch of the highly anticipated \",[\"$\",\"em\",\"1\",{\"children\":\"Assassin’s Creed Black Flag\"}],\" remake, but it hasn't prevented jobs from being lost at the company.\"]}],[\"$\",\"p\",\"1\",{\"className\":\"text_text__nEn66\",\"children\":[\"Following months of rumours, \",[\"$\",\"$L35\",\"1\",{\"href\":\"https://www.gamingbible.com/ubisoft\",\"className\":\"anchor_link__6t7IO\",\"children\":\"Ubisoft\",\"prefetch\":false}],\" officially confirmed the existence of the remake in April 2026, and it would carry a new name, \",[\"$\",\"em\",\"3\",{\"children\":\"Assassin’s Creed Black Flag Resynced\"}],\". Powered by an enhanced version of Ubisoft’s Anvil engine, this remake of the beloved 2013 release has improved visuals, performance, gameplay and even some new story missions, accompanied by new cinematics.\"]}],[\"$\",\"p\",\"2\",{\"className\":\"text_text__nEn66\",\"children\":[\"Sure, it is missing some content that was not in the original game, such as the modern-day Abstergo office missions, as well as the fantastic \",[\"$\",\"em\",\"1\",{\"children\":\"Freedom Cry\"}],\" expansion, but \",[\"$\",\"$L35\",\"3\",{\"href\":\"https://www.gamingbible.com/assassins-creed\",\"className\":\"anchor_link__6t7IO\",\"children\":[\"$\",\"em\",null,{\"children\":\"Assassin’s Creed\"}],\"prefetch\":false}],[\"$\",\"em\",\"4\",{\"children\":\" Black Flag Resynced\"}],\" has been well-received across the board from critics and fans alike.\"]}],[\"$\",\"h2\",\"3\",{\"children\":[\"$\",\"strong\",null,{\"children\":\"Assassin’s Creed Black Flag Resynced Hits Record-Breaking Player Milestone\"}]}],[\"$\",\"p\",\"4\",{\"className\":\"text_text__nEn66\",\"children\":[\"As brought to our attention \",[\"$\",\"$L35\",\"1\",{\"href\":\"https://www.ign.com/articles/assassins-creed-black-flag-resynced-has-already-earned-the-series-biggest-player-peak-on-steam?link_source=ta_first_comment\u0026taid=6a4ff33c06db11000115c1a8\u0026fbclid=IwdGRjcAS83d9leHRuA2FlbQIxMQBzcnRjBmFwcF9pZAwzNTA2ODU1MzE3MjgAAR7AT5TqRlYDKDj_dHBzUaj3ZEiJz9GLwgMqSmYRycHjSpQWDsGCTlAC8anfaA_aem_tsd-D9ZNd_l3rnxrddBCHA\",\"className\":\"anchor_link__6t7IO\",\"target\":\"_blank\",\"rel\":\"noopener\",\"children\":\"by IGN\",\"prefetch\":false}],\", despite only releasing on Thursday, \",[\"$\",\"em\",\"3\",{\"children\":\"Assassin’s Creed Black Flag Resynced\"}],\" has already achieved the highest player peak on Steam in the entire series. Granted, these numbers only reflect the PC platform, but if a game performs well on Steam, it can be seen as an indication for the console counterpart.\"]}],[\"$\",\"p\",\"5\",{\"className\":\"text_text__nEn66\",\"children\":[\"At the time of writing, \",[\"$\",\"em\",\"1\",{\"children\":\"Assassin’s Creed Black Flag Resynced\"}],\" has an all-time \",[\"$\",\"$L35\",\"3\",{\"href\":\"https://steamdb.info/app/3751950/charts/\",\"className\":\"anchor_link__6t7IO\",\"target\":\"_blank\",\"rel\":\"noopener\",\"children\":\"concurrent player peak\",\"prefetch\":false}],\" of 99,451, compared to the original game, which was released nearly 13 years ago, with 16,049. To put things into a more perspective, this is a whopping 520% increase.\"]}],[\"$\",\"div\",\"6\",{\"className\":\"article-image_articleImage__eyzAn\",\"children\":[[\"$\",\"div\",null,{\"className\":\"article-image_imageWrapper__ANtPE\",\"children\":[\"$\",\"$L4c\",null,{\"className\":\"article-image_image__XvzgU\",\"src\":\"https://eu-images.contentstack.com/v3/assets/bltbc1876152fcd9f07/blt41a3c83ae6d47220/6a50d78dad2fb292e5270497/assassins-creed-black-flag-jackdaw.jpg\",\"fill\":true,\"alt\":\"Assassin's Creed Black Flag Resynced, Ubisoft\",\"sizes\":\"(max-width: 430px) 33vw, (max-width: 768px) 50vw, (max-width: 1024px) 50vw, 33vw\"}]}],[\"$\",\"cite\",null,{\"className\":\"image-credit_imageCredit__YMlqS\",\"children\":\"Assassin's Creed Black Flag Resynced, Ubisoft\"}]]}],[\"$\",\"h2\",\"7\",{\"children\":[\"$\",\"strong\",null,{\"children\":\"Assassin’s Creed mainline games with the highest Steam player peaks\"}]}],[\"$\",\"ul\",\"8\",{\"className\":\"list_list__njBdr\",\"children\":[[\"$\",\"li\",\"ul-:S1:-0\",{\"children\":[\"Assassin’s Creed Shadows (2025) - \",[\"$\",\"strong\",\"1\",{\"children\":\"64, 825\"}]]}],[\"$\",\"li\",\"ul-:S1:-1\",{\"children\":[\"Assassin’s Creed Odyssey (2018) - \",[\"$\",\"strong\",\"1\",{\"children\":\"62, 069\"}]]}],[\"$\",\"li\",\"ul-:S1:-2\",{\"children\":[\"Assassin’s Creed Origins (2017) - \",[\"$\",\"strong\",\"1\",{\"children\":\"41, 551\"}]]}],[\"$\",\"li\",\"ul-:S1:-3\",{\"children\":[\"Assassin’s Creed Valhalla (2020) - \",[\"$\",\"strong\",\"1\",{\"children\":\"19,181\"}]]}],[\"$\",\"li\",\"ul-:S1:-4\",{\"children\":[\"Assassin’s Creed III (2012) - \",[\"$\",\"strong\",\"1\",{\"children\":\"15,007\"}]]}],[\"$\",\"li\",\"ul-:S1:-5\",{\"children\":[\"Assassin’s Creed Unity (2014) - \",[\"$\",\"strong\",\"1\",{\"children\":\"12,180\"}]]}],[\"$\",\"li\",\"ul-:S1:-6\",{\"children\":[\"Assassin’s Creed Syndicate (2015) - \",[\"$\",\"strong\",\"1\",{\"children\":\"4,729\"}]]}],[\"$\",\"li\",\"ul-:S1:-7\",{\"children\":[\"Assassin’s Creed Brotherhood (2010) - \",[\"$\",\"strong\",\"1\",{\"children\":\"3,848\"}]]}],[\"$\",\"li\",\"ul-:S1:-8\",{\"children\":[\"Assassin’s Creed II (2009) -\",[\"$\",\"strong\",\"1\",{\"children\":\"3,617\"}]]}],[\"$\",\"li\",\"ul-:S1:-9\",{\"children\":[\"Assassin’s Creed Revelations (2011) - \",[\"$\",\"strong\",\"1\",{\"children\":\"3,105\"}]]}],[\"$\",\"li\",\"ul-:S1:-10\",{\"children\":[\"Assassin’s Creed: Director’s Cut (2008) - \",[\"$\",\"strong\",\"1\",{\"children\":\"1,468\"}]]}]]}],[\"$\",\"p\",\"9\",{\"className\":\"text_text__nEn66\",\"children\":[[\"$\",\"strong\",\"0\",{\"children\":\" READ MORE: \"}],[\"$\",\"$L35\",\"1\",{\"href\":\"https://www.gamingbible.com/news/assassins-creed-black-flag-resynced-progress-glitch-236495-20260709\",\"className\":\"anchor_link__6t7IO\",\"children\":[\"$\",\"strong\",null,{\"children\":\"Assassin's Creed Black Flag Resynced players warned about bug which wipes hours of progress\"}],\"prefetch\":false}]]}],[\"$\",\"h2\",\"10\",{\"children\":[\"$\",\"strong\",null,{\"children\":\"Ubisoft lays off employees despite Black Flag Resynced success\"}]}],[\"$\",\"p\",\"11\",{\"className\":\"text_text__nEn66\",\"children\":[\"Sadly, as reported \",[\"$\",\"$L35\",\"1\",{\"href\":\"https://insider-gaming.com/assassins-creed-black-flag-resynced-layoffs/\",\"className\":\"anchor_link__6t7IO\",\"target\":\"_blank\",\"rel\":\"noopener\",\"children\":\"by Insider Gaming\",\"prefetch\":false}],\", 51 employees have been made redundant from Ubisoft Barcelona, some of whom had worked on \",[\"$\",\"em\",\"3\",{\"children\":\"Assassin’s Creed Black Flag Resynced\"}],\".\"]}],[\"$\",\"p\",\"12\",{\"className\":\"text_text__nEn66\",\"children\":\"The article from Insider Gaming states that some of those employees knew that the writing was on the proverbial wall, no matter the success of the remake, because a new project wasn't assigned after its launch. Typically, developers know what’s coming next way ahead of time. It’s claimed that the team wasn't assigned any new projects dating back to the summer of 2025.\"}],[\"$\",\"p\",\"13\",{\"className\":\"text_text__nEn66\",\"children\":[\"The report says that the 51 Ubisoft Barcelona employees were laid off just days after completing the development of \",[\"$\",\"em\",\"1\",{\"children\":\"Assassin’s Creed Black Flag Resynced\"}],\". One ex-employee impacted by the redundancies told Insider Gaming:\"]}],[\"$\",\"p\",\"14\",{\"className\":\"text_text__nEn66\",\"children\":\"”These layoffs coincide with the broader context of ongoing workplace issues. This is not an isolated event; it reflects a pattern of constant mistreatment, loss of talent, forced departures resulting from the erosion of workers’ rights, and an increasingly top-down management culture that leaves employees with little voice in decisions affecting their work.”\"}],[\"$\",\"p\",\"15\",{\"className\":\"text_text__nEn66\",\"children\":\"Furthermore, employees at Ubisoft Barcelona have announced a series of strikes supported by the Video Game Union Coordinating Committee. Those strikes will take place every Tuesday and Thursday afternoon between 30 June and 16 July.\"}],[\"$\",\"p\",\"16\",{\"className\":\"text_text__nEn66\",\"children\":[[\"$\",\"strong\",\"0\",{\"children\":\"READ MORE: \"}],[\"$\",\"$L35\",\"1\",{\"href\":\"https://www.gamingbible.com/reviews/assassins-creed-black-flag-resynced-review-778209-20260708\",\"className\":\"anchor_link__6t7IO\",\"children\":[\"$\",\"strong\",null,{\"children\":\"Assassin's Creed Black Flag Resynced is better than the original in almost every way\"}],\"prefetch\":false}]]}]]}]\n"])</script><script>self.__next_f.push([1,"56:[\"$\",\"$L4b\",null,{\"adsConfig\":\"$43:props:children:1:props:children:0:props:adsConfig\",\"contentType\":\"article\",\"isFloatingVideoAd\":false,\"children\":[[\"$\",\"p\",\"0\",{\"className\":\"text_text__nEn66\",\"children\":\"The Assassin’s Creed series has visited many different time periods over the years, bringing a mix of historical authenticity and mythological folklore to bring these settings alive.\"}],[\"$\",\"p\",\"1\",{\"className\":\"text_text__nEn66\",\"children\":[\"With \",[\"$\",\"$L35\",\"1\",{\"href\":\"https://www.gamingbible.com/news/assassins-creed-black-flag-resynced-biggest-changes-747409-20260521\",\"className\":\"anchor_link__6t7IO\",\"children\":[\"$\",\"em\",null,{\"children\":\"Assassin’s Creed Black Flag Resynced\"}],\"prefetch\":false}],\" revisiting a familiar story within the wider \",[\"$\",\"$L35\",\"3\",{\"href\":\"https://www.gamingbible.com/assassins-creed\",\"className\":\"anchor_link__6t7IO\",\"children\":\"Assassin’s Creed\",\"prefetch\":false}],\" saga, the question of where the series could head next is the question on everyone’s lips.\"]}],[\"$\",\"p\",\"2\",{\"className\":\"text_text__nEn66\",\"children\":\"From witnessing the bonfire of the vanities to participating in the American revolution, the series doesn’t shy away from making you a virtual tourist in some of history’s most significant events.\"}],[\"$\",\"p\",\"3\",{\"className\":\"text_text__nEn66\",\"children\":[\"Here’s our picks for where the Assassin’s Creed series could go after \",[\"$\",\"em\",\"1\",{\"children\":\"Black Flag Resynced\"}],\", and a few events that we could experience in a game set during these time periods.\"]}],[\"$\",\"h2\",\"4\",{\"children\":\"1. Ancient Rome (753 BC–476 AD)\"}],[\"$\",\"p\",\"5\",{\"className\":\"text_text__nEn66\",\"children\":[\"We’ve done Ancient Greece. We’ve done Ancient Egypt. Now it’s time for Ancient Rome. We saw bits of this setting at the end of \",[\"$\",\"em\",\"1\",{\"children\":\"Assassin’s Creed Origins\"}],\", where we briefly took control of Amunet to take part in the assassination of Julius Caesar.\"]}],[\"$\",\"p\",\"6\",{\"className\":\"text_text__nEn66\",\"children\":\"With Ancient Roman history covering a huge span of history, a whole Assassin’s Creed game set during this time could depict events and myths like the founding of Rome by Romulus and Remus, the Spartacus rebellion, or the naval battle of Actium which instigated the deaths of Cleopatra and Mark Antony, as well as the ascension of Octavian as the first Roman emperor.\"}],[\"$\",\"p\",\"7\",{\"className\":\"text_text__nEn66\",\"children\":\"Ancient Rome is due to be explored in the live-action Assassin's Creed television series being made for Netflix, but the era is so vast that a video game could also definitely be made here without it interfering with Ubisoft's plans.\"}],[\"$\",\"div\",\"8\",{\"className\":\"article-image_articleImage__eyzAn\",\"children\":[[\"$\",\"div\",null,{\"className\":\"article-image_imageWrapper__ANtPE\",\"children\":[\"$\",\"$L4c\",null,{\"className\":\"article-image_image__XvzgU\",\"src\":\"https://eu-images.contentstack.com/v3/assets/bltbc1876152fcd9f07/blt0a80fe17aecde72c/6a45297b79cfbc682b4c632a/spartacius.jpg\",\"fill\":true,\"alt\":\"\",\"sizes\":\"(max-width: 430px) 33vw, (max-width: 768px) 50vw, (max-width: 1024px) 50vw, 33vw\"}]}],[\"$\",\"cite\",null,{\"className\":\"image-credit_imageCredit__YMlqS\",\"children\":\"Universal\"}]]}],[\"$\",\"h2\",\"9\",{\"children\":\"2. Three Kingdoms (220–280 AD)\"}],[\"$\",\"p\",\"10\",{\"className\":\"text_text__nEn66\",\"children\":\"The Three Kingdoms of Cao Wei, Shu Han, and Eastern Wu were ruling factions in China following the end of the Han dynasty in the early third century, whose collapse caused chaotic infighting between many different dynasties.\"}],[\"$\",\"p\",\"11\",{\"className\":\"text_text__nEn66\",\"children\":[\"China is supposedly being explored in \",[\"$\",\"em\",\"1\",{\"children\":\"Assassin’s Creed Jade\"}],\", which was supposed to be released in 2023 but was eventually pushed back. With this period being set a few centuries after \",[\"$\",\"em\",\"3\",{\"children\":\"Assassin’s Creed Origins\"}],\", it’d be cool to see the conflicts and battles leading up to the forming of the Three Kingdoms from the perspective of a Hidden One.\"]}],[\"$\",\"div\",\"12\",{\"className\":\"article-image_articleImage__eyzAn\",\"children\":[[\"$\",\"div\",null,{\"className\":\"article-image_imageWrapper__ANtPE\",\"children\":[\"$\",\"$L4c\",null,{\"className\":\"article-image_image__XvzgU\",\"src\":\"https://eu-images.contentstack.com/v3/assets/bltbc1876152fcd9f07/blt2775f364428b3ad7/6a45204d3afe3fd1a6aa8f55/three_kingdoms.jpg\",\"fill\":true,\"alt\":\" Eastern Han-Three Kingdoms Battle Painting (Source: Gary Todd/Xuchang City Museum, Henan Province)\",\"sizes\":\"(max-width: 430px) 33vw, (max-width: 768px) 50vw, (max-width: 1024px) 50vw, 33vw\"}]}],[\"$\",\"cite\",null,{\"className\":\"image-credit_imageCredit__YMlqS\",\"children\":\" Eastern Han-Three Kingdoms Battle Painting (Source: Gary Todd/Xuchang City Museum, Henan Province)\"}]]}],[\"$\",\"h2\",\"13\",{\"children\":\"3. Tudor England (1485–1603)\"}],[\"$\",\"p\",\"14\",{\"className\":\"text_text__nEn66\",\"children\":\"Ubisoft has touched England twice now for the Assassin’s Creed games, but it hasn’t yet touched upon the Tudor reign. With a legacy lasting over a hundred years, there are plenty of opportunities for stories to tell during this time.\"}],[\"$\",\"p\",\"15\",{\"className\":\"text_text__nEn66\",\"children\":\"An Assassin’s Creed game set during the Tudor reign could include the following events: the Battle of Bosworth Field, the Battle of Flodden and the end of the Middle Ages in the British Isles, the long reign of Henry VIII in the early 16th century, the Siege of Calais and the loss of Britain’s control of France, William Shakespeare, and the signing of the Treaty of Perpetual Peace in 1602.\"}],[\"$\",\"p\",\"16\",{\"className\":\"text_text__nEn66\",\"children\":\"Taking place during the same period as the Italian Renaissance, it’s also the perfect opportunity to have fan favourite character Ezio Auditore da Firenze make a cameo appearance, who would be active in the Assassins during the early Tudor reign.\"}],[\"$\",\"div\",\"17\",{\"className\":\"article-image_articleImage__eyzAn\",\"children\":[[\"$\",\"div\",null,{\"className\":\"article-image_imageWrapper__ANtPE\",\"children\":[\"$\",\"$L4c\",null,{\"className\":\"article-image_image__XvzgU\",\"src\":\"https://eu-images.contentstack.com/v3/assets/bltbc1876152fcd9f07/bltf50468daca75a058/6a451fd42f9de47eddb70340/tudor.jpg\",\"fill\":true,\"alt\":\"An Allegory of the Tudor Succession: The Family of Henry VIII (Source: \\tYale Center for British Art)\",\"sizes\":\"(max-width: 430px) 33vw, (max-width: 768px) 50vw, (max-width: 1024px) 50vw, 33vw\"}]}],[\"$\",\"cite\",null,{\"className\":\"image-credit_imageCredit__YMlqS\",\"children\":\"An Allegory of the Tudor Succession: The Family of Henry VIII (Source: \\tYale Center for British Art)\"}]]}],[\"$\",\"h2\",\"18\",{\"children\":\"4. Thirty Years’ War (1618–1648)\"}],[\"$\",\"p\",\"19\",{\"className\":\"text_text__nEn66\",\"children\":\"Often described as the one of the bloodiest conflicts in European history, the Thirty Years’ War was a political power struggle that began as a religious dispute between Catholics and Protestants, and escalated across the continent to include many European countries.\"}],[\"$\",\"p\",\"20\",{\"className\":\"text_text__nEn66\",\"children\":\"An Assassin’s Creed game set during this war could tell the story of one character’s involvement in this war of the thirty-year period, all while detailing the involvement of the Assassins and the Templars. You’d have a bit of trouble trying to justify which side belongs to which faction, but depicting them as independent entities taking advantage of the chaos for their own means could be the setting for an interesting Assassin’s Creed story.\"}],[\"$\",\"div\",\"21\",{\"className\":\"article-image_articleImage__eyzAn\",\"children\":[[\"$\",\"div\",null,{\"className\":\"article-image_imageWrapper__ANtPE\",\"children\":[\"$\",\"$L4c\",null,{\"className\":\"article-image_image__XvzgU\",\"src\":\"https://eu-images.contentstack.com/v3/assets/bltbc1876152fcd9f07/blt6088c3b9d2de0514/6a451f894711540ab7ab84a2/30_years_war.jpg\",\"fill\":true,\"alt\":\"Wallenstein: A Scene of the Thirty Years War (oil on canvas) (Source: Ernest Crofts/Leeds Museums and Galleries)\",\"sizes\":\"(max-width: 430px) 33vw, (max-width: 768px) 50vw, (max-width: 1024px) 50vw, 33vw\"}]}],[\"$\",\"cite\",null,{\"className\":\"image-credit_imageCredit__YMlqS\",\"children\":\"Wallenstein: A Scene of the Thirty Years War (oil on canvas) (Source: Ernest Crofts/Leeds Museums and Galleries)\"}]]}],[\"$\",\"h2\",\"22\",{\"children\":\"5. Salem Witch Trials (1692–1693)\"}],[\"$\",\"p\",\"23\",{\"className\":\"text_text__nEn66\",\"children\":\"The Salem witch trials took place in Salem, Massachusetts between February 1692 and May 1693, in which over 30 people were found guilty of practicing witchcraft, and 19 were executed.\"}],[\"$\",\"p\",\"24\",{\"className\":\"text_text__nEn66\",\"children\":[\"Taking place just under a century before the Massachusetts we see in \",[\"$\",\"em\",\"1\",{\"children\":\"Assassin’s Creed 3\"}],\", the game could use the Salem witch trials as a background for the Assassin-Templar conflict, with Pieces of Eden being at the centre of these accusations.\"]}],[\"$\",\"p\",\"25\",{\"className\":\"text_text__nEn66\",\"children\":\"Firmly, it’d also give historians a chance to clear up some misconceptions about the Salem witch trials, which still persist to this day. For example, common myths surrounding the trials include that all of the accused were women (around 20–25% of accusations were levelled at men), and that it was the result of superstition (many accusations were the result of fears of immigration and “outsiders” to the Puritans’ conformist society).\"}],[\"$\",\"div\",\"26\",{\"className\":\"article-image_articleImage__eyzAn\",\"children\":[[\"$\",\"div\",null,{\"className\":\"article-image_imageWrapper__ANtPE\",\"children\":[\"$\",\"$L4c\",null,{\"className\":\"article-image_image__XvzgU\",\"src\":\"https://eu-images.contentstack.com/v3/assets/bltbc1876152fcd9f07/bltbeab89471ea4f3f4/6a451f1d47115458cdab849e/salem.jpg\",\"fill\":true,\"alt\":\"The Witch No. 1 (Source: Joseph E. Baker/Library of Congress Prints \u0026 Photographs Division)\",\"sizes\":\"(max-width: 430px) 33vw, (max-width: 768px) 50vw, (max-width: 1024px) 50vw, 33vw\"}]}],[\"$\",\"cite\",null,{\"className\":\"image-credit_imageCredit__YMlqS\",\"children\":\"The Witch No. 1 (Source: Joseph E. Baker/Library of Congress Prints \u0026 Photographs Division)\"}]]}],[\"$\",\"h2\",\"27\",{\"children\":\"6. Y2K (2000)\"}],[\"$\",\"p\",\"28\",{\"className\":\"text_text__nEn66\",\"children\":\"Okay, hear me out. I actually find a lot to enjoy with Assassin’s Creed’s modern day plot. Well, maybe not the narrative in the more recent games, but if you think about the original conception of the modern day story involving Desmond and his allies, the mystery of the series’ mythology certainly provided us with a satisfying framing device to explain why we’re using the animus.\"}],[\"$\",\"p\",\"29\",{\"className\":\"text_text__nEn66\",\"children\":\"An Assassin’s Creed game set in recent history, let’s say during Y2K, could introduce a fresh take on the series’ tired formula. It’d be play more akin to Ubisoft’s Watch Dogs games, but be intrinsically linked to the Assassin’s Creed lore which might give it a bit more gravitas.\"}],[\"$\",\"p\",\"30\",{\"className\":\"text_text__nEn66\",\"children\":\"Set 12 years before the events of the Desmond saga in Assassin’s Creed, a game set in this time period could involve characters like Daniel Cross and William Miles as key figures in the modern day conflict between the Assassins and Templars. We’d see Abstergo Industries, plus an early version of the Animus being developed.\"}],[\"$\",\"div\",\"31\",{\"className\":\"article-image_articleImage__eyzAn\",\"children\":[[\"$\",\"div\",null,{\"className\":\"article-image_imageWrapper__ANtPE\",\"children\":[\"$\",\"$L4c\",null,{\"className\":\"article-image_image__XvzgU\",\"src\":\"https://eu-images.contentstack.com/v3/assets/bltbc1876152fcd9f07/blt73a7d827baa69675/6a4529ecb6620f33ecd8ee51/GettyImages-2283341830.jpg\",\"fill\":true,\"alt\":\"\",\"sizes\":\"(max-width: 430px) 33vw, (max-width: 768px) 50vw, (max-width: 1024px) 50vw, 33vw\"}]}],[\"$\",\"cite\",null,{\"className\":\"image-credit_imageCredit__YMlqS\",\"children\":\"Michael Nagle/Bloomberg via Getty Images\"}]]}]]}]\n"])</script><script>self.__next_f.push([1,"58:[\"$\",\"$L4b\",null,{\"adsConfig\":\"$43:props:children:1:props:children:0:props:adsConfig\",\"contentType\":\"article\",\"isFloatingVideoAd\":false,\"children\":[[\"$\",\"p\",\"0\",{\"className\":\"text_text__nEn66\",\"children\":[[\"$\",\"em\",\"0\",{\"children\":\"Assassin’s Creed IV: Black Flag\"}],\" is one of the most popular entries in the Ubisoft series, and 13 years on from its original release, it’s now been remade from the ground up for the modern era.\"]}],[\"$\",\"p\",\"1\",{\"className\":\"text_text__nEn66\",\"children\":[\"With lush new visuals, improved animations, combat, exploration, stealth and more, \",[\"$\",\"em\",\"1\",{\"children\":\"Assassin’s Creed Black Flag Resynced\"}],\" should be the definitive way to experience this beloved classic, so let’s find out.\"]}],[\"$\",\"p\",\"2\",{\"className\":\"text_text__nEn66\",\"children\":[\"The story of \",[\"$\",\"em\",\"1\",{\"children\":\"Black Flag\"}],\" follows Edward Kenway, an adventurous man who takes on the pirate life in the hope of returning to his wife, Caroline, with endless riches to live a blissful and relaxing life. However, destiny would have plans for the charismatic Welshman after finding himself entangled in the centuries-old war between the Assassins and the Templars. What started as a selfish voyage in the hope of unimaginable riches, Edward would soon discover that he had a more meaningful purpose in life.\"]}],[\"$\",\"h2\",\"3\",{\"children\":[\"$\",\"strong\",null,{\"children\":[[\"$\",\"em\",\"0\",{\"children\":\"Assassin’s Creed Black Flag Resynced\"}],\" is gorgeous\"]}]}],[\"$\",\"p\",\"4\",{\"className\":\"text_text__nEn66\",\"children\":[\"Anyone who is familiar with the 2013 original will know that it’s a gorgeous game, even to this day. I recently fired it up on my PlayStation 5 and Nintendo Switch, and it still holds up, to an extent. However, built from the ground up using the latest version of \",[\"$\",\"$L35\",\"1\",{\"href\":\"https://www.gamingbible.com/ubisoft\",\"className\":\"anchor_link__6t7IO\",\"children\":\"Ubisoft’s\",\"prefetch\":false}],\" Anvil engine, \",[\"$\",\"em\",\"3\",{\"children\":\"Assassin’s Creed Black Flag Resynced\"}],\" is an instant eye pleaser. The details on Edward and the supporting main cast, their animations, and the crisp voice audio make it feel like a brand new game. It’s perhaps not quite as visually pleasing as \",[\"$\",\"em\",\"5\",{\"children\":\"Assassin’s Creed Shadows\"}],\", especially when the seasons change, but this remake isn't too far off.\"]}],[\"$\",\"p\",\"5\",{\"className\":\"text_text__nEn66\",\"children\":\"The cities of Havana, Kingston, Nassau and more are vibrant with NPC life, with more active, life-like crowds. The sun shining on the stunning architecture, the vibrant jungle with dense foliage, the crashing waves on the Jackdown, with the sun reflecting off the sea, is a sight to behold. The lighting and shadows have also been greatly improved. Trust me, you’ll soon be spanning the photo mode to create some stunning screenshots to share with the community. I must also mention the dynamic weather. It’s quite a sight to be walking in a sunny Havana, to then face tropical rain. However, it's more than just a visual change, because when out at sea on the Jackdaw, you’ll be feeling the power of the wind as you fight against the elements, while frantically trying to avoid the approaching tornadoes during an intense thunderstorm.\"}],[\"$\",\"p\",\"6\",{\"className\":\"text_text__nEn66\",\"children\":[\"In terms of gameplay, this is quite possibly where \",[\"$\",\"em\",\"1\",{\"children\":\"Assassin’s Creed Black Flag Resynced\"}],\" shines the most. Combat feels more free-flowing, and you’ll have more of a reliance on parrying and dodging attacks. Much like Dark Souls, enemies will have a sub-metre that will break down their defence the more you hammer them. But be warned, if you spam an attack, the enemy will soon counter you with ease.\"]}],[\"$\",\"div\",\"7\",{\"className\":\"article-image_articleImage__eyzAn\",\"children\":[[\"$\",\"div\",null,{\"className\":\"article-image_imageWrapper__ANtPE\",\"children\":[\"$\",\"$L4c\",null,{\"className\":\"article-image_image__XvzgU\",\"src\":\"https://eu-images.contentstack.com/v3/assets/bltbc1876152fcd9f07/blt390aed679f744102/6a4e16ac7a9247744471d602/assassins-creed-black-flag-resynced-review-screenshot-2.jpg\",\"fill\":true,\"alt\":\"Assassin’s Creed Black Flag Resynced, Ubisoft\",\"sizes\":\"(max-width: 430px) 33vw, (max-width: 768px) 50vw, (max-width: 1024px) 50vw, 33vw\"}]}],[\"$\",\"cite\",null,{\"className\":\"image-credit_imageCredit__YMlqS\",\"children\":\"Assassin’s Creed Black Flag Resynced, Ubisoft\"}]]}],[\"$\",\"h2\",\"8\",{\"children\":[\"$\",\"strong\",null,{\"children\":\"Combat is greatly improved\"}]}],[\"$\",\"p\",\"9\",{\"className\":\"text_text__nEn66\",\"children\":\"Other than a well-timed parry, which can result in an instant-kill depending on the enemy type, successfully killing a sequence of foes will trigger a satisfactory chain of attacks. Furthermore, if you successfully parry an attack, you’ll be able to unleash a deadly execution, which will soon have the enemy regretting coming after you, because you dared put a foot on its turf.\"}],[\"$\",\"p\",\"10\",{\"className\":\"text_text__nEn66\",\"children\":\"However, it’s the stealth that has improved most of all in this remake. For starters, there appears to be more foliage to hide in, and while purely aesthetic, it actually looks like you're hidden, instead of worrying how on earth the enemy can't see your backside sticking out of the bush. In the original game, the stealth missions were rather annoying, in respect of receiving an instant game over if the enemy saw you. Now, instead of that, when the enemy spots you, it will trigger combat, instead of restarting the checkpoint.\"}],[\"$\",\"p\",\"11\",{\"className\":\"text_text__nEn66\",\"children\":\"Edward can now crouch at any point; he can pretty much lean against all walls and boxes. There’s no set path when tailing enemies. He can easily tag enemies when using eagle vision, and it's easier to keep track of enemies when they walk around a corner or run away. Yet, while Edward has more stealth abilities, enemies appear to be more alert and will often suspect your presence.\"}],[\"$\",\"p\",\"12\",{\"className\":\"text_text__nEn66\",\"children\":[\"If I had one criticism with the stealth, it is not being able to move to a prone position, an ability that was available in 2025’s \",[\"$\",\"em\",\"1\",{\"children\":\"Assassin’s Creed Shadows\"}],\". So, having just finished that game recently, it feels odd not being able to do this in the remake. I’m hoping Ubisoft adds this ability sooner rather than later. Oh, you can also jump on the spot, but I’ve never used this ability once. It feels out of place, which is odd to say for a parkour game. But, that’s probably since it never existed in the original and exists here for reasons unknown.\"]}],[\"$\",\"h2\",\"13\",{\"children\":[\"$\",\"strong\",null,{\"children\":\"Run, Edward, run!\"}]}],[\"$\",\"p\",\"14\",{\"className\":\"text_text__nEn66\",\"children\":\"While not perfect, as you will find yourself accidentally jumping in the wrong direction from time to time, the parkour in the remake is far more precise than in the original. It feels like you have more freedom and control when it comes to scaling structures.\"}],[\"$\",\"p\",\"15\",{\"className\":\"text_text__nEn66\",\"children\":[\"Edward can leap in more directions when scaling, running across rooftops has more flow, and Edward's parkour animations look more natural. That being said, there doesn't appear to be as much freedom in the number of natural environments that you can climb, such as a rockface. While this wasn't perfect in \",[\"$\",\"em\",\"1\",{\"children\":\"Assassin’s Creed Shadows\"}],\", it certainly has greater variety than this remake, at this time. It can just feel a bit off-putting trying to climb a rock wall that Edward \",[\"$\",\"em\",\"3\",{\"children\":\"should \"}],\"be able to scale, only for him to get invisible wall syndrome.\"]}],[\"$\",\"div\",\"16\",{\"className\":\"article-image_articleImage__eyzAn\",\"children\":[[\"$\",\"div\",null,{\"className\":\"article-image_imageWrapper__ANtPE\",\"children\":[\"$\",\"$L4c\",null,{\"className\":\"article-image_image__XvzgU\",\"src\":\"https://eu-images.contentstack.com/v3/assets/bltbc1876152fcd9f07/bltdff55f7fcb7341ae/6a4e1704c502e85812d21670/assassins-creed-black-flag-resynced-review-screenshot-3.jpg\",\"fill\":true,\"alt\":\"Assassin’s Creed Black Flag Resynced, Ubisoft\",\"sizes\":\"(max-width: 430px) 33vw, (max-width: 768px) 50vw, (max-width: 1024px) 50vw, 33vw\"}]}],[\"$\",\"cite\",null,{\"className\":\"image-credit_imageCredit__YMlqS\",\"children\":\"Assassin’s Creed Black Flag Resynced, Ubisoft\"}]]}],[\"$\",\"h2\",\"17\",{\"children\":[\"$\",\"strong\",null,{\"children\":\"There are plenty of new missions and some exclusions\"}]}],[\"$\",\"p\",\"18\",{\"className\":\"text_text__nEn66\",\"children\":\"Without giving too much away, while much of the remake remains very faithful to the original game, it does have new content not in the 2013 game. There are new missions for the new NPCs, Lucy Baldwin, the Padre and Deadman, all of which can become officers on the Jackdaw, once you’ve completed their story missions. When completed, Lucy will add a new defensive brace ability. The Padre will add a new ram dash, and Deadman will improve the canons. So, it’s well worth taking the time to hire these recruits.\"}],[\"$\",\"p\",\"19\",{\"className\":\"text_text__nEn66\",\"children\":[\"What’s more, there are also new missions for existing fan-favourite characters, namely Blackbeard, James Kidd, Stede Bonnet, and Edward’s wife, Caroline. There are also eight endgame missions involving Blackbeard, which adds some intriguing lore for the infamous pirate in the world of \",[\"$\",\"$L35\",\"1\",{\"href\":\"https://www.gamingbible.com/assassins-creed\",\"className\":\"anchor_link__6t7IO\",\"children\":\"Assassin’s Creed\",\"prefetch\":false}],\". I must say that all this new content helps make up for the absence of the \",[\"$\",\"em\",\"3\",{\"children\":\"Freedom Cry\"}],\" expansion to an extent. But those Abstergo, modern-day office missions, perhaps I won't miss those quite as much. Though I suppose you can recruit cute cats and monkeys to chill on your Jackdaw, which cushions the blow.\"]}],[\"$\",\"h2\",\"20\",{\"children\":[\"$\",\"strong\",null,{\"children\":\"One of the best Assassin’s Creed games gets even better\"}]}],[\"$\",\"p\",\"21\",{\"className\":\"text_text__nEn66\",\"children\":[\"When \",[\"$\",\"em\",\"1\",{\"children\":\"Assassin’s Creed Black Flag Resynced\"}],\" was officially announced, it had some fair criticism, debating whether or not it really needed to exist. After all, it was only released during the early days of the last generation in 2013. However, this is arguably the best game in the series, perhaps only topped by \",[\"$\",\"em\",\"3\",{\"children\":\"Assassin’s Creed II\"}],\" and \",[\"$\",\"em\",\"5\",{\"children\":\"Assassin’s Creed Brotherhood\"}],\".\"]}],[\"$\",\"p\",\"22\",{\"className\":\"text_text__nEn66\",\"children\":[\"The developers at Ubisoft have clearly gone to great lengths to ensure that this remake deserves to exist, and it’s very clear after spending many hours with the game that it’s a love letter to the fans and the developers. The folks at Ubisoft have made one of the best games ever, even better. Whether you’re a returning veteran or a newbie, \",[\"$\",\"em\",\"1\",{\"children\":\"Assassin’s Creed Black Flag Resynced\"}],\" is the definitive way to experience this all-time classic.\"]}],[\"$\",\"p\",\"23\",{\"className\":\"text_text__nEn66\",\"children\":[[\"$\",\"strong\",\"0\",{\"children\":[\"$\",\"em\",null,{\"children\":\"Pros: \"}]}],[\"$\",\"em\",\"1\",{\"children\":\"Gorgeous visuals, improved combat and stealth, lots of new meaningful missions\"}]]}],[\"$\",\"p\",\"24\",{\"className\":\"text_text__nEn66\",\"children\":[[\"$\",\"strong\",\"0\",{\"children\":[\"$\",\"em\",null,{\"children\":\"Cons: \"}]}],[\"$\",\"em\",\"1\",{\"children\":\"No prone ability, no Freedom Cry expansion\"}]]}],[\"$\",\"p\",\"25\",{\"className\":\"text_text__nEn66\",\"children\":[[\"$\",\"strong\",\"0\",{\"children\":[\"$\",\"em\",null,{\"children\":\"For fans of: \"}]}],[\"$\",\"em\",\"1\",{\"children\":\"Assassin’s Creed III, Skull \u0026 Bones, Sea of Thieves\"}]]}],[\"$\",\"h2\",\"26\",{\"children\":[[\"$\",\"strong\",\"0\",{\"children\":[\"$\",\"em\",null,{\"children\":\"8/10:\"}]}],[\"$\",\"em\",\"1\",{\"children\":\" Excellent\"}]]}],[\"$\",\"p\",\"27\",{\"className\":\"text_text__nEn66\",\"children\":[[\"$\",\"em\",\"0\",{\"children\":\"Assassin’s Creed Black Flag Resynced will be released on 9 July 2026 on PC, PlayStation 5 (version tested) and Xbox Series X/S. A review code was provided by the publisher. \"}],[\"$\",\"$L35\",\"1\",{\"href\":\"https://www.gamingbible.com/features/gamingbibles-review-scores-guide-110351-20240716\",\"className\":\"anchor_link__6t7IO\",\"children\":[\"$\",\"em\",null,{\"children\":\"Read a guide to our review scores here\"}],\"prefetch\":false}],[\"$\",\"em\",\"2\",{\"children\":\".\"}]]}]]}]\n"])</script><div hidden id="S:1"><div class="advert-placement_advertPlacement__RpuSl"><p class="text_text__nEn66">Ahead of the launch of <em>Assassin’s Creed Black Flag Resynced</em>, we had the opportunity to speak with AEW star and huge fan of the Ubisoft series, the “Aerial Assassin’ Will Ospreay, about his love for Assassin’s Creed and how he brings his love for the series into the world of professional wrestling.</p><p class="text_text__nEn66">Will Ospreay’s love for the series never began with a typical entry at the beginning of a story, but rather 2011’s <em>Assassin’s Creed Revelations</em>, which was the final chapter of the Ezio Auditore da Firenze trilogy, and the fourth entry in the franchise.</p><p class="text_text__nEn66">“My introduction to the series was <em>Revelations</em>. So I played that, fell in love with the older version of Ezio after he’s been through some wars,” began a passionate Will.</p><div class="floating-video-player_container__u4D9_"></div><p class="text_text__nEn66">“I hadn&#x27;t played the games before. So it was really cool to play that first and then the preludes to find out how <em>Revelations </em>came to be and how Ezio got to that situation. That&#x27;s my earliest memory, I had such an awakening in my brain to be like, ‘Oh, I can move like this character, and that’s why I started incorporating parkour into my move-set in pro wrestling.”</p><div class="advert-placeholder_advertPlaceholder____F2W advert-placeholder_mobileAd__jTsos" id="advert-1_1"><p>Advert</p><div class="advert-size_container__6Bsb_" style="min-width:200px;min-height:330px"><div id="inline_1_1" class="aditude-advert_advert__TlQVQ"></div></div></div><p class="text_text__nEn66"><strong>READ MORE: </strong><a class="anchor_link__6t7IO" href="https://www.gamingbible.com/reviews/assassins-creed-black-flag-resynced-review-778209-20260708"><strong>Assassin&#x27;s Creed Black Flag Resynced is better than the original in almost every way</strong></a></p><h2><strong>Experience Assassin&#x27;s Creed Black Flag Like Never Before</strong></h2><div class="article-image_articleImage__eyzAn"><div class="article-image_imageWrapper__ANtPE"><img alt="Assassin&#x27;s Creed Black Flag Resynced, Ubisoft" data-chromatic="ignore" loading="lazy" decoding="async" data-nimg="fill" class="article-image_image__XvzgU" style="position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent" sizes="(max-width: 430px) 33vw, (max-width: 768px) 50vw, (max-width: 1024px) 50vw, 33vw" srcSet="https://resizer.ladbiblegroup.com/unsafe/rs:fit:128:0:0:0/g:sm/q:70/aHR0cHM6Ly9ldS1pbWFnZXMuY29udGVudHN0YWNrLmNvbS92My9hc3NldHMvYmx0YmMxODc2MTUyZmNkOWYwNy9ibHQ2M2Y3OTZjYjE3ZjA4MWY5LzZhNTEyMGM0MWMyZGVlMzA1NjIwNWYzZC9hc3Nhc3NpbnMtY3JlZWQtYmxhY2stZmxhZy1yZXN5bmNlZC0xMDA3MjAyNi5qcGc.webp 128w, https://resizer.ladbiblegroup.com/unsafe/rs:fit:256:0:0:0/g:sm/q:70/aHR0cHM6Ly9ldS1pbWFnZXMuY29udGVudHN0YWNrLmNvbS92My9hc3NldHMvYmx0YmMxODc2MTUyZmNkOWYwNy9ibHQ2M2Y3OTZjYjE3ZjA4MWY5LzZhNTEyMGM0MWMyZGVlMzA1NjIwNWYzZC9hc3Nhc3NpbnMtY3JlZWQtYmxhY2stZmxhZy1yZXN5bmNlZC0xMDA3MjAyNi5qcGc.webp 256w, https://resizer.ladbiblegroup.com/unsafe/rs:fit:320:0:0:0/g:sm/q:70/aHR0cHM6Ly9ldS1pbWFnZXMuY29udGVudHN0YWNrLmNvbS92My9hc3NldHMvYmx0YmMxODc2MTUyZmNkOWYwNy9ibHQ2M2Y3OTZjYjE3ZjA4M