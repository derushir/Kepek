	<div class="m-articleHead__titleWrap u-cntBase">

		
			
			<h1 class="m-articleHead__title u-brandFont1">Cristiano Ronaldo menyasszony platinaszőkén jelent meg Cannesban &#8211; igazi bombázó!</h1>
			<div class="m-articleHead__authorWrap u-fontSecond d-block d-lg-flex justify-content-lg-left">
				<div class="m-articleHead__authorInnerWrap m-author  d-flex justify-content-left">
					<div class="m-author__item d-block d-lg-flex justify-content-lg-between align-items-lg-center">
	<div class="m-author__imgWrap">
		<img src="https://marieclaire.hu/uploads/2025/06/szabo-eszter-64x64.png" width="56" height="56" alt="Szabó Fruzsina" class="avatar avatar-56 wp-user-avatar wp-user-avatar-56 alignnone photo" />	</div>
	<a class="m-author__name u-brandFont2 text-uppercase"
	href="https://marieclaire.hu/author/szaszter/">
		Szabó Fruzsina	</a>
</div>
				</div>
				<span class="m-articleHead__date a-date u-brandFont2 d-block d-lg-flex justify-content-lg-between align-items-lg-center">
					2026. május 18.				</span>
			</div>
							<div class="m-articleHead__lead">
					Teljesen új külsővel érkezett a cannes-i filmfesztivál vörös szőnyegére Cristiano Ronaldo menyasszonya. Platinaszőke tincseivel mindenkit ujja köré csavart. Neked hogy tetszik?				</div>
			
							<div class="m-articleHead__imgWrap">
					<img width="2560" height="1707" src="https://marieclaire.hu/uploads/2026/05/GettyImages-2276767460-Cropped-scaled.jpg" class="m-articleHead__img" alt="Georgina Rodriguez" decoding="async" loading="lazy" sizes="(max-width: 1046px) 100vw,1098px" srcset="https://marieclaire.hu/uploads/2026/05/GettyImages-2276767460-Cropped-scaled.jpg 2560w, https://marieclaire.hu/uploads/2026/05/GettyImages-2276767460-Cropped-300x200.jpg 300w, https://marieclaire.hu/uploads/2026/05/GettyImages-2276767460-Cropped-1024x683.jpg 1024w, https://marieclaire.hu/uploads/2026/05/GettyImages-2276767460-Cropped-768x512.jpg 768w, https://marieclaire.hu/uploads/2026/05/GettyImages-2276767460-Cropped-160x107.jpg 160w, https://marieclaire.hu/uploads/2026/05/GettyImages-2276767460-Cropped-320x213.jpg 320w, https://marieclaire.hu/uploads/2026/05/GettyImages-2276767460-Cropped-480x320.jpg 480w, https://marieclaire.hu/uploads/2026/05/GettyImages-2276767460-Cropped-660x440.jpg 660w, https://marieclaire.hu/uploads/2026/05/GettyImages-2276767460-Cropped-800x533.jpg 800w, https://marieclaire.hu/uploads/2026/05/GettyImages-2276767460-Cropped-1536x1024.jpg 1536w, https://marieclaire.hu/uploads/2026/05/GettyImages-2276767460-Cropped-2048x1365.jpg 2048w" title="cannes-2026-georgina-rodriguez | Marie Claire" />				</div>
			
			
		</div>
	</div>
			</div>
			<div class="o-post__cnt">
				<div class="o-post__cntWrap d-flex row m-0">
							<!-- CTS - toothbrush-handle -->
		<div class="banner-container clearfix fl">
			<div class="banner-wrapper clearfix" data-position=toothbrush-handle>
				<script>
					try {
						tagging.render('toothbrush-handle'); }
					catch (err) {
