                      style="border: 1px solid #dedede; width: calc(100% - 20px); min-width: calc(100% - 20px); max-width: calc(100% - 20px); overflow-x:hidden;"
                      placeholder=""></textarea>
            <div style="padding:5px 10px 10px 10px;">
              <div class="pull-right text-right">
                <input type="hidden" value="542918" name="modal-thread_main_id" id="modal-thread_main_id">
