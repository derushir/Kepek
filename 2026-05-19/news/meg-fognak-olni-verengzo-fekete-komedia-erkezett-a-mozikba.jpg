    <script>
      $("body").on("click", ".forum-reply", function () {
        
        
        if (!mainlogined) {
          JelentkezzBe();
        } else {
          $("#modal-comment").modal("show");
          
          var thread_id = ($(this).attr("data-id"));
          var level = ($(this).attr("data-level"));
          $("#modal-level").val(level);
          $("#modal-thread_id").val(thread_id);
        }
        
      });
      
      // edit
      $(".forum-edit-btn").on("click", function () {
        
        let comment_id = $(this).attr("data-id");
        
        $(".cmt_" + comment_id).hide();
        $("#forum-comment-edit-box-" + comment_id).show();
        
        let textarea_scrollheight = $("#forum-comment-edit-box-" + comment_id).prop("scrollHeight");
        
        $("#forum-comment-edit-box-" + comment_id).height(textarea_scrollheight - 4);
        
        $("#forum-edit-btn-" + comment_id).hide();
        $("#forum-save-btn-" + comment_id).show();
        
        $("#forum-comment-edit-box-" + comment_id).on("input", function () {
          this.style.height = "auto";
          this.style.height = (this.scrollHeight) + 4 + "px";
        });
        
      });
      
      $(".forum-save-btn").bind("click", function () {
        
        let edited_comment = $("#forum-comment-edit-box-" + $(this).attr("data-id")).val();
        let comment_id = $(this).attr("data-id");
        
        if (edited_comment != "") {
          
          $.post("https://www.mafab.hu/includes/jquery/editForumCommentForum.php", {
              comment_text: edited_comment,
              comment_id: comment_id
            },
            function (response) {
              
              response = response.replace(/\n/g, "");
              
              $("p.cmt_" + comment_id).html(response);
              
              response = response.replace(/<br>|<br\/>|<br \/>/g, "\n");
              
              $("#forum-comment-edit-box-" + comment_id).val(response.trim());
              
              $("p.cmt_" + comment_id).show();
              $("#forum-comment-edit-box-" + comment_id).hide();
              $("#forum-edit-btn-" + comment_id).show();
              $("#forum-save-btn-" + comment_id).hide();
              $("#forum-comment-edit-box-" + comment_id).css("border", "1px solid grey");
            }
          );
        } else {
          $("#forum-comment-edit-box-" + comment_id).css("border", "2px solid red");
          return false;
        }
      });
      
      
      //delete
      $("body").on("click", ".forum-delete", function () {
        var thread_id = ($(this).attr("data-id"));
        var level = ($(this).attr("data-level"));
        
        if (level == 0) {
          //delete topic
          if (confirm("Tényleg törölni szeretnéd a fórumtémát?")) {
            
            $.post("https://www.mafab.hu/includes/jquery/deleteCommentForumSection.php", {
                thread_id: thread_id,
                userid: ""
              },
              function (data) {
                //redirect to forum
                window.location.replace("https://www.mafab.hu/forum");
              });
          }
        } else {
          if (confirm("Tényleg törölni szeretnéd a hozzászólást?")) {
            
            $.post("https://www.mafab.hu/includes/jquery/deleteCommentForumSection.php", {
                thread_id: thread_id,
                userid: ""
              },
              function (data) {
                //change text
                $(".cmt_" + thread_id).html("<i class='cmti-date'><small>A felhasználó kitörölte a hozzászólását.</small></i>");
                
              });
          }
        }
        
      });
      
      // ulozit komentar
      $("#comment-save").on("click", function () {
        
        if ($("#modal-comment-text").val() != "" && $('#comment-save').prop('disabled') == false) {
          $('#comment-save').prop('disabled', true);
          
          var comment_text = $("#modal-comment-text").val();
          var comment_movie_id = $("#modal-thread_id").val();
          var comment_thread_main_id = $("#modal-thread_main_id").val();
          var level = $("#modal-level").val();
          
          $.post("https://www.mafab.hu/includes/jquery/addCommentForumSection.php", {
              comment: comment_text,
              thread_id: comment_movie_id,
              thread_main_id: comment_thread_main_id,
              level: level
            },
            function (data) {
              // zatvorit modal, refresh
              $("#modal-comment").modal("hide");
              $('#comment-save').prop('disabled', false);
              //add after comment + add level
              $("#thread" + comment_movie_id).after(data);
              
              // report (ban) btn
              $("button.forum-ban").click(
                function () {
                  if (!mainlogined) {
                    JelentkezzBe();
                  } else {
                    var thread_id = $(this).attr("data-id");
                    
                    $.post("https://www.mafab.hu/includes/jquery/banCommentForumSection.php",
                      {
                        thread_id: thread_id
                      },
                      function () {
                        alert("Köszönjük a bejelentést. Adminisztrátorunk hamarosan elbírálja a hozzászólást.");
                      }
                    );
                  }
                }
              );
              
              // edit btn
              $(".forum-edit-btn").on("click", function () {
                
                let comment_id = $(this).attr("data-id");
                
                $(".cmt_" + comment_id).hide();
                $("#forum-comment-edit-box-" + comment_id).show();
                
                let textarea_scrollheight = $("#forum-comment-edit-box-" + comment_id).prop("scrollHeight");
                
                $("#forum-comment-edit-box-" + comment_id).height(textarea_scrollheight - 4);
                
                $("#forum-edit-btn-" + comment_id).hide();
                $("#forum-save-btn-" + comment_id).show();
                
                $("#forum-comment-edit-box-" + comment_id).on("input", function () {
                  this.style.height = "auto";
                  this.style.height = (this.scrollHeight) + 4 + "px";
                });
                
              });
              
              // save btn
              $(".forum-save-btn").bind("click", function () {
                
                let edited_comment = $("#forum-comment-edit-box-" + $(this).attr("data-id")).val();
                let comment_id = $(this).attr("data-id");
                
                if (edited_comment != "") {
                  
                  $.post("https://www.mafab.hu/includes/jquery/editForumCommentForum.php", {
                      comment_text: edited_comment,
                      comment_id: comment_id
                    },
                    function (response) {
                      
                      response = response.replace(/\n/g, "");
                      
                      $("p.cmt_" + comment_id).html(response.replace(/\n/g, "<br>"));
                      
                      response = response.replace(/<br>|<br\/>|<br \/>/g, "\n");
                      
                      $("#forum-comment-edit-box-" + comment_id).val(response.trim());
                      
                      $("p.cmt_" + comment_id).show();
                      $("#forum-comment-edit-box-" + comment_id).hide();
                      $("#forum-edit-btn-" + comment_id).show();
                      $("#forum-save-btn-" + comment_id).hide();
                      $("#forum-comment-edit-box-" + comment_id).css("border", "1px solid grey");
                    }
                  );
                } else {
                  $("#forum-comment-edit-box-" + comment_id).css("border", "2px solid red");
                  return false;
                }
              });
            }
          );
          
          
        } else {
          //$("#modal-comment").modal("hide");
          $("#modal-comment-text").fadeOut("fast").fadeIn("fast").fadeOut("fast").fadeIn("fast");
        }
        
      });
      
      $("#modal-comment").on("shown.bs.modal", function () {
        $("#modal-comment-text").focus();
        $("#modal-comment-text").val("");
      });

    </script>
    
    </div>
    <div class="modal fade" tabindex="-1" role="dialog" id="modal-commentNew">
      <div class="modal-dialog">
        <div class="modal-content modal-mafab">
          <div class="modal-header">
            <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span
                aria-hidden="true">&times;</span></button>
            <h4 class="modal-title" style="display:inline-block;">Új fórumtéma létrehozása</h4>
          </div>
          <div class="modal-body" style="padding:20px; text-align: center;">
            <div class="form-group">
              <input class="modal-comment form-control" id="modal-commentNew-subject" value=""
                     placeholder="A fórumtéma neve" style="border: 1px solid #dedede;">
            </div>
            <div class="form-group">
              <textarea placeholder="Fórumtéma leírása" class="modal-comment form-control" id="modal-commentNew-text"
                        style="border: 1px solid #dedede;  overflow-x:hidden;"></textarea>
            </div>
            <div style="padding:5px 10px 10px 10px;">
              <div class="pull-right text-right">
                <button type="submit" class="modal-comment" id="commentNew-save">
                  Mentés &nbsp;<i class="fa fa-send"></i>
                </button>
                <div class="clear"></div>
              </div>
              <div class="clear"></div>
            </div>


            <div class="clear"></div>
          </div>
        </div><!-- /.modal-content -->
      </div><!-- /.modal-dialog -->
    </div><!-- /.modal -->

    <script>
      
      
      $(".openModalCreate").click(
        function (event) {
          
          if (!mainlogined) {
            JelentkezzBe();
          } else {
            $("#modal-commentNew").modal("show");
          }
        }
      );
      
      
      // ulozit komentar
      $("#commentNew-save").on("click", function () {
        
        if ($("#modal-commentNew-text").val() != "" && $("#modal-commentNew-subject").val() != "") {
          var comment_text = $("#modal-commentNew-text").val();
          var comment_subject = $("#modal-commentNew-subject").val();
          
          $.post("https://www.mafab.hu/includes/jquery/addCommentForumSection.php", {
              comment: comment_text,
              thread_id: -1,
              subject: comment_subject
            },
            function (data) {
              // zatvorit modal, refresh
              $("#modal-commentNew").modal("hide");
              //refresh
              window.location.replace("https://www.mafab.hu/forum/" + $.trim(data));
            });
          
          
        } else {
          //$("#modal-commentNew").modal("hide");
          $("#modal-comment-textNew").fadeOut("fast").fadeIn("fast").fadeOut("fast").fadeIn("fast");
        }
        
      });
      
      $("#modal-commentNew").on("shown.bs.modal", function () {
        $("#modal-commentNew-subject").focus();
      });
      
      
      $(".forum-ban").click(
        function (event) {
          
          if (!mainlogined) {
            JelentkezzBe();
          } else {
            var thread_id = ($(this).attr("data-id"));
            
            $.post("https://www.mafab.hu/includes/jquery/banCommentForumSection.php", {thread_id: thread_id},
              function (data) {
                alert("Köszönjük a bejelentést. Adminisztrátorunk hamarosan elbírálja a hozzászólást.");
              });
            
            
          }
        }
      );

    </script>
    
            </div>
      </div>
