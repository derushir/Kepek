				<span data-toggle="tooltip" data-placement="bottom" data-html="true" title="<strong>Tetszik:</strong><br>"  data-counter="0" class="counter counter-up" id="th_up-0-230642-654531-c" style="margin-top:4px; display:inline-block;">0</span>
