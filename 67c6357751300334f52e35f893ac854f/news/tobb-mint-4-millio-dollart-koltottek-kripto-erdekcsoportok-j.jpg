14,\"title\":\"Ecosystem\",\"link\":null,\"openInNewTab\":false,\"nofollow\":false,\"position\":5,\"category\":\"desktop\",\"children\":{\"docs\":[{\"id\":19,\"title\":\"Magazine\",\"link\":\"https:\u002F\u002Fcointelegraph-magazine.com\u002F\",\"openInNewTab\":true,\"nofollow\":true,\"position\":0,\"category\":\"desktop\",\"__typename\":\"Menu\"},{\"id\":15,\"title\":\"Accelerator\",\"link\":\"https:\u002F\u002Fcointelegraph-accelerate.com\u002F \",\"openInNewTab\":true,\"nofollow\":true,\"position\":1,\"category\":\"desktop\",\"__typename\":\"Menu\"},{\"id\":16,\"title\":\"Events\",\"link\":\"https:\u002F\u002Fcointelegraph-events.com\u002F \",\"openInNewTab\":true,\"nofollow\":true,\"position\":2,\"category\":\"desktop\",\"__typename\":\"Menu\"},{\"id\":17,\"title\":\"Decentralization Guardians\",\"link\":\"https:\u002F\u002Fcointelegraph-guardians.com\u002F \",\"openInNewTab\":true,\"nofollow\":true,\"position\":3,\"category\":\"desktop\",\"__typename\":\"Menu\"},{\"id\":18,\"title\":\"LONGITUDE Event\",\"link\":\"https:\u002F\u002Fcointelegraph-longitude.com\u002F\",\"openInNewTab\":true,\"nofollow\":true,\"position\":4,\"category\":\"desktop\",\"__typename\":\"Menu\"}],\"__typename\":\"Menu_Children\"},\"__typename\":\"Menu\"},{\"id\":33,\"title\":\"About\",\"link\":null,\"openInNewTab\":false,\"nofollow\":false,\"position\":6,\"category\":\"desktop\",\"children\":{\"docs\":[{\"id\":34,\"title\":\"About Cointelegraph\",\"link\":\"\u002Fabout\",\"openInNewTab\":false,\"nofollow\":false,\"position\":0,\"category\":\"desktop\",\"__typename\":\"Menu\"},{\"id\":35,\"title\":\"Editorial Policy\",\"link\":\"\u002Feditorial-policy\",\"openInNewTab\":false,\"nofollow\":false,\"position\":1,\"category\":\"desktop\",\"__typename\":\"Menu\"},{\"id\":36,\"title\":\"Ads Disclosure\",\"link\":\"\u002Fadvertising-disclosure\",\"openInNewTab\":false,\"nofollow\":false,\"position\":2,\"category\":\"desktop\",\"__typename\":\"Menu\"},{\"id\":37,\"title\":\"Financial Risk Disclaimer\",\"link\":\"\u002Ffinancial-risk-disclaimer\",\"openInNewTab\":false,\"nofollow\":false,\"position\":3,\"category\":\"desktop\",\"__typename\":\"Menu\"}],\"__typename\":\"Menu_Children\"},\"__typename\":\"Menu\"}],\"__typename\":\"Menus\"}}",{"hasNext":89,"data":98},"{\"Articles\":{\"docs\":[{\"id\":3413,\"title\":\"Georgia primary to test crypto PAC’s support for Democratic candidate\",\"dek\":\"A political action committee aligned with crypto interest groups reported spending more than $4 million in support of Democratic US House candidate Jasmine Clark in Georgia.\",\"slug\":\"georgia-primary-jasmine-clark-crypto-pacs-support\",\"status\":\"published\",\"contentType\":\"editorial\",\"publishedAt\":\"2026-05-18T20:20:00.000Z\",\"updatedAt\":\"2026-05-18T20:33:44.538Z\",\"noindex\":false,\"cover\":{\"url\":\"https:\u002F\u002Fs3-images.ctmedia.io\u002Fmedia\u002Farticle-covers\u002Fhi-voting-app.jpg\",\"alt\":null,\"width\":1450,\"height\":966,\"__typename\":\"ArticleCover\"},\"author\":{\"id\":11,\"name\":\"Turner Wright\",\"slug\":\"turner-wright\",\"positionLabel\":\"Staff Writer\",\"noindexPosts\":false,\"cover\":{\"url\":\"https:\u002F\u002Fs3-images.ctmedia.io\u002Fmedia\u002Fauthor-images\u002Fauthor-870-turner-wright.jpg\",\"alt\":\"Turner Wright\",\"width\":400,\"height\":400,\"__typename\":\"AuthorImage\"},\"__typename\":\"Author\"},\"category\":{\"id\":1,\"name\":\"Latest News\",\"slug\":\"latest-news\",\"folder\":\"news\",\"__typename\":\"Category\"},\"customAuthor\":null,\"__typename\":\"Article\",\"text\":{\"root\":{\"type\":\"root\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"The Protect Progress, a political action committee (PAC) affiliated with the cryptocurrency company-backed Fairshake PAC, has spent more than $4 million attempting to help secure a win for a Georgia state representative running for the US House of Representatives.\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"left\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"On Tuesday, Georgia voters will decide on their candidate in the primary for the state’s 13th Congressional district, where state representative Jasmine Clark faces competition among Democrats. According to data from the Federal Election Commission, Clark has been the beneficiary of more than $4.2 million in spending on media by the Protect Progress PAC ahead of the primary, as crypto-aligned interest groups attempt to influence voters in key elections.\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"id\":\"6a0b67b86609a249d32e0b18\",\"type\":\"upload\",\"value\":{\"id\":6275,\"alt\":null,\"prefix\":\"media\u002Fcontent\",\"updatedAt\":\"2026-05-18T19:25:44.055Z\",\"createdAt\":\"2026-05-18T19:25:43.482Z\",\"url\":\"https:\u002F\u002Fs3-images.ctmedia.io\u002Fmedia\u002Fcontent\u002Fscreenshot-2026-05-18-at-22520-pm.png\",\"thumbnailURL\":null,\"filename\":\"screenshot-2026-05-18-at-22520-pm.png\",\"mimeType\":\"image\u002Fpng\",\"filesize\":251469,\"width\":994,\"height\":1256,\"focalX\":50,\"focalY\":50},\"fields\":null,\"format\":\"center\",\"version\":3,\"relationTo\":\"media\"},{\"type\":\"paragraph\",\"format\":\"center\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Source: \",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":2,\"version\":1},{\"id\":\"6a0b67bf6609a249d32e0b19\",\"type\":\"link\",\"fields\":{\"url\":\"https:\u002F\u002Fdocquery.fec.gov\u002Fcgi-bin\u002Fforms\u002FC00848440\u002F1974646\u002Fse\",\"linkType\":\"custom\"},\"format\":\"\",\"indent\":0,\"version\":3,\"children\":[{\"mode\":\"normal\",\"text\":\"FEC\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":2,\"version\":1}],\"direction\":null}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":2},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Notably, Clark appeared to have \",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1},{\"id\":\"6a0b63926609a249d32e0b16\",\"type\":\"link\",\"fields\":{\"url\":\"https:\u002F\u002Fx.com\u002Fjasmineforga\u002Fstatus\u002F2033675800763850922\",\"newTab\":false,\"linkType\":\"custom\"},\"format\":\"\",\"indent\":0,\"version\":3,\"children\":[{\"mode\":\"normal\",\"text\":\"deleted\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null},{\"mode\":\"normal\",\"text\":\" a social media post from March saying that “digital assets are the future and provide long-overdue financial tools for unbanked communities,” referencing the US Congress considering a crypto market structure bill. She also completed a questionnaire from the Coinbase-aligned organization Stand With Crypto, which \",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1},{\"id\":\"6a0b63926609a249d32e0b17\",\"type\":\"link\",\"fields\":{\"url\":\"https:\u002F\u002Fwww.standwithcrypto.org\u002Fpoliticians\u002Fperson\u002Fjasmine---clark\",\"newTab\":false,\"linkType\":\"custom\"},\"format\":\"\",\"indent\":0,\"version\":3,\"children\":[{\"mode\":\"normal\",\"text\":\"said\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null},{\"mode\":\"normal\",\"text\":\" she was a candidate who “expressed strong support for establishing clear legislative and regulatory frameworks for digital assets in the United States.”\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Protect Progress and its affiliates Fairshake and Defend American Jobs are expected to spend millions of dollars in 2026 to support candidates they consider will advance pro-crypto policies and opposing those who don’t. In 2024, Fairshake spent more than $130 million on media and ads, resulting in what Coinbase CEO Brian Armstrong called the “most pro-crypto Congress ever.” Coinbase is a backer of Fairshake. \",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Related: \",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":3,\"version\":1},{\"id\":\"6a0b69456609a249d32e0b1f\",\"type\":\"link\",\"fields\":{\"url\":\"https:\u002F\u002Fcointelegraph.com\u002Fnews\u002Fcrypto-pacs-spending-candidates-five-states-midterms\",\"newTab\":false,\"linkType\":\"custom\"},\"format\":\"\",\"indent\":0,\"version\":3,\"children\":[{\"mode\":\"normal\",\"text\":\"Crypto PACs spend $7.2M to support candidates in 5 US states ahead of elections\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":3,\"version\":1}],\"direction\":null}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":3},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Not every election or party primary has been a winner for Fairshake or crypto interest groups seeking to influence voters. The PAC\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1},{\"id\":\"6a0b6a546609a249d32e0b21\",\"type\":\"link\",\"fields\":{\"url\":\"https:\u002F\u002Fcointelegraph.com\u002Ffeatures\u002Fcrypto-industry-ties-liability-illinois-primary\",\"linkType\":\"custom\"},\"format\":\"\",\"indent\":0,\"version\":3,\"children\":[{\"mode\":\"normal\",\"text\":\" spent a reported $8 million\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null},{\"mode\":\"normal\",\"text\":\" opposing Illinois Lieutenant Governor Juliana Stratton in her US Senate primary, but in March more than 40% of voters chose her over candidates supported by Fairshake and Protect Progress-backed ads.\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"id\":\"6a0b7349096009356ac65e0b\",\"type\":\"upload\",\"value\":{\"id\":6282,\"alt\":null,\"prefix\":\"media\u002Fcontent\",\"updatedAt\":\"2026-05-18T20:15:06.271Z\",\"createdAt\":\"2026-05-18T20:15:05.803Z\",\"url\":\"https:\u002F\u002Fs3-images.ctmedia.io\u002Fmedia\u002Fcontent\u002Fscreenshot-2026-05-18-111415-pm.png\",\"thumbnailURL\":null,\"filename\":\"screenshot-2026-05-18-111415-pm.png\",\"mimeType\":\"image\u002Fpng\",\"filesize\":86523,\"width\":533,\"height\":649,\"focalX\":50,\"focalY\":50},\"fields\":null,\"format\":\"center\",\"version\":3,\"relationTo\":\"media\"},{\"type\":\"paragraph\",\"format\":\"center\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Screenshot of Stand With Crypto's rating of Jasmine Clark. Source: \",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":2,\"version\":1},{\"id\":\"6a0b738f096009356ac65e0c\",\"type\":\"link\",\"fields\":{\"url\":\"https:\u002F\u002Fwww.standwithcrypto.org\u002Fpoliticians\u002Fperson\u002Fjasmine---clark\",\"linkType\":\"custom\"},\"format\":\"\",\"indent\":0,\"version\":3,\"children\":[{\"mode\":\"normal\",\"text\":\"Stand With Crypto\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":2,\"version\":1}],\"direction\":null}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":2},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"“From a Stand With Crypto perspective, we are going to do everything we can to give our advocates the tools they need to make sure that they make an informed vote and they’re able to cast their ballot on election day for the candidate that is pro-crypto they care about,” Mason Lynaugh, executive director of Stand With Crypto, told Cointelegraph on the organization’s work in 2026. “If everyone makes their voices heard [...] we will have a more pro-crypto Congress than we did this past year.”\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Cointelegraph sought a comment from Fairshake ahead of Tuesday's voting but did not receive an immediate response.\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"tag\":\"h2\",\"type\":\"heading\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Texas run-off election also getting big spending\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Next week, voters in Texas’ 18th Congressional District will head to the ballot boxes to decide between Representative Al Green and Democratic candidate Christian Menefee. Protect Progress reportedly \",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1},{\"id\":\"6a0b6d0e6609a249d32e0b22\",\"type\":\"link\",\"fields\":{\"url\":\"https:\u002F\u002Fcointelegraph.com\u002Fnews\u002Fcrypto-pac-spending-against-al-green-texas-primary\",\"linkType\":\"custom\"},\"format\":\"\",\"indent\":0,\"version\":3,\"children\":[{\"mode\":\"normal\",\"text\":\"spent more than $1.5 million\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null},{\"mode\":\"normal\",\"text\":\" opposing Green in a March primary, but Menefee only secured 46% of voters compared to Green’s 44%, triggering a runoff on May 26.\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"FEC filings showed Protect Progress \",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1},{\"id\":\"6a0b6ea66609a249d32e0b23\",\"type\":\"link\",\"fields\":{\"url\":\"https:\u002F\u002Fdocquery.fec.gov\u002Fcgi-bin\u002Fforms\u002FC00848440\u002F1975426\u002Fse\",\"linkType\":\"custom\"},\"format\":\"\",\"indent\":0,\"version\":3,\"children\":[{\"mode\":\"normal\",\"text\":\"spent\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null},{\"mode\":\"normal\",\"text\":\" more than $2.8 million on media opposing Green, who while in Congress voted against legislation the industry largely supported, including the GENIUS Act and CLARITY Act. The PAC \",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1},{\"id\":\"6a0b6ebc6609a249d32e0b24\",\"type\":\"link\",\"fields\":{\"url\":\"https:\u002F\u002Fdocquery.fec.gov\u002Fcgi-bin\u002Fforms\u002FC00848440\u002F1975329\u002Fse\",\"linkType\":\"custom\"},\"format\":\"\",\"indent\":0,\"version\":3,\"children\":[{\"mode\":\"normal\",\"text\":\"spent\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null},{\"mode\":\"normal\",\"text\":\" about the same amount supporting Menefee, who has publicly supported blockchain technology. \",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Magazine: \",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":3,\"version\":1},{\"id\":\"6a0b696a6609a249d32e0b20\",\"type\":\"link\",\"fields\":{\"url\":\"https:\u002F\u002Fcointelegraph-magazine.com\u002Flegal-battle-over-who-defis-stolen-millions\u002F\",\"newTab\":false,\"linkType\":\"custom\"},\"format\":\"\",\"indent\":0,\"version\":3,\"children\":[{\"mode\":\"normal\",\"text\":\"The legal battle over who can claim DeFi’s stolen millions\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":3,\"version\":1}],\"direction\":null}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":3}],\"direction\":null}},\"metaTitle\":\"Georgia Primary to Test Crypto PAC’s Support for Democratic Candidate\",\"metaDescription\":\"Georgia state representative Jasmine Clark faces competition from Democrats in a Tuesday primary, but may benefit from more than $4 million in supportive media from a crypto-aligned political action committee.\",\"topic\":{\"id\":630,\"slug\":\"regulation\",\"title\":\"Regulation\",\"__typename\":\"Tag\"},\"allTags\":[{\"id\":68,\"title\":\"Politics\",\"slug\":\"politics\",\"__typename\":\"Tag\"},{\"id\":353,\"title\":\"Elections\",\"slug\":\"elections\",\"__typename\":\"Tag\"},{\"id\":257,\"title\":\"United States\",\"slug\":\"united-states\",\"__typename\":\"Tag\"},{\"id\":17,\"title\":\"Cryptocurrencies\",\"slug\":\"cryptocurrencies\",\"__typename\":\"Tag\"},{\"id\":630,\"title\":\"Regulation\",\"slug\":\"regulation\",\"__typename\":\"Tag\"}],\"editor\":{\"id\":43,\"name\":\"Robert Lakin\",\"slug\":\"robert-lakin\",\"positionLabel\":\"Staff Editor\",\"cover\":{\"url\":\"https:\u002F\u002Fs3-images.ctmedia.io\u002Fmedia\u002Fauthor-images\u002Fauthor-3868-robert-lakin.jpg\",\"__typename\":\"AuthorImage\"},\"__typename\":\"Author\"}}],\"__typename\":\"Articles\"}}",{"hasNext":89,"data":100},"{\"KeyValues\":{\"docs\":[{\"id\":7,\"slug\":\"in.article_disclaimer_news\",\"value\":\"Cointelegraph is committed to independent, transparent journalism. This news article is produced in accordance with Cointelegraph’s \u003Ca href=\\\"https:\u002F\u002Fcointelegraph.com\u002Feditorial-policy\\\">Editorial Policy\u003C\u002Fa> and aims to provide accurate and timely information. Readers are encouraged to verify information independently. \",\"__typename\":\"KeyValue\"}],\"__typename\":\"KeyValues\"}}",{"hasNext":89,"data":102},"{\"ArticlesByTagSlug\":{\"docs\":[{\"id\":3421,\"title\":\"SEC rescinds defendant ‘gag rule’ when settling enforcement actions\",\"dek\":\"SEC Chair Paul Atkins says he is “pleased that we are rescinding the no-deny policy,” as the agency scrapped its “gag rule” that has been in place since 1972.\",\"slug\":\"sec-rescinds-gag-rule-when-settling-enforcement-actions\",\"status\":\"published\",\"contentType\":\"editorial\",\"publishedAt\":\"2026-05-19T04:03:13.511Z\",\"updatedAt\":\"2026-05-19T04:03:17.330Z\",\"noindex\":false,\"cover\":{\"url\":\"https:\u002F\u002Fs3-images.ctmedia.io\u002Fmedia\u002Farticle-covers\u002Fbankcman-sec.jpg\",\"alt\":null,\"width\":1450,\"height\":966,\"__typename\":\"ArticleCover\"},\"author\":{\"id\":20,\"name\":\"Jesse Coghlan\",\"slug\":\"jesse-coghlan\",\"positionLabel\":\"Staff Editor\",\"noindexPosts\":false,\"cover\":{\"url\":\"https:\u002F\u002Fs3-images.ctmedia.io\u002Fmedia\u002Fauthor-images\u002Fauthor-1510-jesse-coghlan.jpg\",\"alt\":\"Jesse Coghlan\",\"width\":400,\"height\":400,\"__typename\":\"AuthorImage\"},\"__typename\":\"Author\"},\"category\":{\"id\":1,\"name\":\"Latest News\",\"slug\":\"latest-news\",\"folder\":\"news\",\"__typename\":\"Category\"},\"customAuthor\":null,\"__typename\":\"Article\"},{\"id\":3404,\"title\":\"Odds against rate cuts high as new US Fed chair set for swearing in\",\"dek\":\"Many experts voiced concerns that the confirmation of Kevin Warsh as Federal Reserve chair would lead to uncertainty about the central bank’s independence, particularly in setting interest rates.\",\"slug\":\"interest-rates-fed-chair-kevin-warsh-sworn-in\",\"status\":\"published\",\"contentType\":\"editorial\",\"publishedAt\":\"2026-05-18T21:49:27.059Z\",\"updatedAt\":\"2026-05-18T21:49:29.579Z\",\"noindex\":false,\"cover\":{\"url\":\"https:\u002F\u002Fs3-images.ctmedia.io\u002Fmedia\u002Farticle-covers\u002Fbank-building-hall-entrance-door-fed.jpg\",\"alt\":null,\"width\":1450,\"height\":966,\"__typename\":\"ArticleCover\"},\"author\":{\"id\":11,\"name\":\"Turner Wright\",\"slug\":\"turner-wright\",\"positionLabel\":\"Staff Writer\",\"noindexPosts\":false,\"cover\":{\"url\":\"https:\u002F\u002Fs3-images.ctmedia.io\u002Fmedia\u002Fauthor-images\u002Fauthor-870-turner-wright.jpg\",\"alt\":\"Turner Wright\",\"width\":400,\"height\":400,\"__typename\":\"AuthorImage\"},\"__typename\":\"Author\"},\"category\":{\"id\":1,\"name\":\"Latest News\",\"slug\":\"latest-news\",\"folder\":\"news\",\"__typename\":\"Category\"},\"customAuthor\":null,\"__typename\":\"Article\"},{\"id\":3418,\"title\":\"Galaxy secures New York BitLicense to expand institutional crypto services\",\"dek\":\"The NYDFS approvals allow GalaxyOne Prime NY to offer trading and financing services to institutional investors in one of the most tightly regulated US crypto markets.\\n\",\"slug\":\"galaxy-secures-new-york-bitlicense-institutional-crypto-services\",\"status\":\"published\",\"contentType\":\"editorial\",\"publishedAt\":\"2026-05-18T21:20:31.831Z\",\"updatedAt\":\"2026-05-18T21:20:35.800Z\",\"noindex\":false,\"cover\":{\"url\":\"https:\u002F\u002Fs3-images.ctmedia.io\u002Fmedia\u002Farticle-covers\u002Fletter-paper-office.jpg\",\"alt\":null,\"width\":1450,\"height\":966,\"__typename\":\"ArticleCover\"},\"author\":{\"id\":15,\"name\":\"Sam Bourgi\",\"slug\":\"sam-bourgi\",\"positionLabel\":\"Staff Editor\",\"noindexPosts\":false,\"cover\":{\"url\":\"https:\u002F\u002Fs3-images.ctmedia.io\u002Fmedia\u002Fauthor-images\u002Fauthor-1142-sam-bourgi.jpg\",\"alt\":\"Sam Bourgi\",\"width\":400,\"height\":400,\"__typename\":\"AuthorImage\"},\"__typename\":\"Author\"},\"category\":{\"id\":1,\"name\":\"Latest News\",\"slug\":\"latest-news\",\"folder\":\"news\",\"__typename\":\"Category\"},\"customAuthor\":null,\"__typename\":\"Article\"}],\"__typename\":\"ArticlesByTagSlugResult\"}}",["Set"],["ShallowReactive",105],{"rates-header":-1},"\u002Fnews\u002Fgeorgia-primary-jasmine-clark-crypto-pacs-support?utm_campaign=rss_partner_inbound&utm_medium=rss&utm_source=rss_feed",["Reactive",108],{}]</script></body></html>