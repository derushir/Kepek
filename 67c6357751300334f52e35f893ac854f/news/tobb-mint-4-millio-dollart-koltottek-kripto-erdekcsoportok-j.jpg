-xs ring ring-1 ring-ct-ds-border-default bg-ct-ds-bg-default ui-not-selected:hover:ring-ct-ds-border-clear focus-visible:ring-ct-ds-border-clear aria-checked:ring-ct-ds-border-clear aria-pressed:ring-ct-ds-border-clear aria-disabled:bg-ct-ds-bg-default aria-disabled:text-ct-ds-fg-weak aria-disabled:ring-ct-ds-border-default bg-ct-ds-bg-2 text-ct-ds-fg-default ui-not-selected:hover:bg-ct-ds-bg-2 focus-visible:bg-ct-ds-bg-2 aria-checked:bg-ct-ds-bg-2 aria-pressed:bg-ct-ds-bg-2 ui-not-selected:hover:text-ct-ds-fg-strong focus-visible:text-ct-ds-fg-strong aria-checked:text-ct-ds-fg-strong aria-pressed:text-ct-ds-fg-strong" variant="outlined" color="default" size="xs" round="default" dense="false" aria-disabled="false" data-testid="post-tag"><!--[--><span class="px-1">Cryptocurrencies</span><!--]--></a></li><li><a href="/tags/regulation" class="inline-flex justify-center items-center font-semibold transition focus:outline-none cursor-pointer aria-disabled:cursor-default rounded p-1 text-xs ring ring-1 ring-ct-ds-border-default bg-ct-ds-bg-default ui-not-selected:hover:ring-ct-ds-border-clear focus-visible:ring-ct-ds-border-clear aria-checked:ring-ct-ds-border-clear aria-pressed:ring-ct-ds-border-clear aria-disabled:bg-ct-ds-bg-default aria-disabled:text-ct-ds-fg-weak aria-disabled:ring-ct-ds-border-default bg-ct-ds-bg-2 text-ct-ds-fg-default ui-not-selected:hover:bg-ct-ds-bg-2 focus-visible:bg-ct-ds-bg-2 aria-checked:bg-ct-ds-bg-2 aria-pressed:bg-ct-ds-bg-2 ui-not-selected:hover:text-ct-ds-fg-strong focus-visible:text-ct-ds-fg-strong aria-checked:text-ct-ds-fg-strong aria-pressed:text-ct-ds-fg-strong" variant="outlined" color="default" size="xs" round="default" dense="false" aria-disabled="false" data-testid="post-tag"><!--[--><span class="px-1">Regulation</span><!--]--></a></li><!--]--></ul></div><section class="pt-6 tablet:pt-7 desktop:pt-9" data-testid="more-on-subject"><div class="mb-5 flex items-baseline gap-0.5" data-testid="more-on-subject__title"><div class="flex-1 flex items-end gap-0.5"><p class="font-semibold text-ct-ds-fg-strong text-lg/6 tracking-tight desktop:text-xl/6.5"><!--[--> More on the subject <!--]--></p></div><!----></div><div class="_list_192f0_3 tablet:hidden" data-testid="more-on-subject__list--mobile"><!--[--><!--[--><article class="group/card grid content-start grid-cols-1 items-start" data-has-cover="true" data-testid="article-card" data-size="medium"><a href="/news/sec-rescinds-gag-rule-when-settling-enforcement-actions" class="cursor-pointer pb-3" data-cover data-testid="article-card__image"><div class="size-full shrink-0 overflow-hidden rounded-md opacity-100 outline -outline-offset-1 outline-ct-ds-border-clear transition-opacity duration-200 ease-out group-has-[[data-cover]:hover]/card:opacity-90 group-has-[[data-title-link]:hover]/card:opacity-90 [&amp;_img]:size-full [&amp;_img]:object-cover"><!--[--><img width="358" height="240" data-nuxt-img sizes="358px" srcset="https://s3-images.ctmedia.io/media/article-covers/bankcman-sec.jpg 358w, https://s3-images.ctmedia.io/media/article-covers/bankcman-sec.jpg 716w, https://s3-images.ctmedia.io/media/article-covers/bankcman-sec.jpg 1074w" onerror="this.setAttribute(&#39;data-error&#39;, 1)" alt loading="lazy" decoding="async" src="https://s3-images.ctmedia.io/media/article-covers/bankcman-sec.jpg"><!--]--></div></a><div class="flex flex-col max-tablet:order-1" data-content><a href="/news/sec-rescinds-gag-rule-when-settling-enforcement-actions" class="group/title flex min-w-0 cursor-pointer flex-col justify-center pe-3" data-title-link><div class="line-clamp-3 w-full text-base/5.5 font-semibold tracking-tight text-pretty text-ct-ds-fg-strong group-hover/title:underline group-has-[[data-cover]:hover]/card:underline" data-testid="article-card__title"><!--[-->SEC rescinds defendant ‘gag rule’ when settling enforcement actions<!--]--></div><!----></a><div class="mt-1.5 flex flex-row-reverse flex-wrap-reverse justify-end gap-x-2 gap-y-1 desktop:mt-3 pe-3"><!--