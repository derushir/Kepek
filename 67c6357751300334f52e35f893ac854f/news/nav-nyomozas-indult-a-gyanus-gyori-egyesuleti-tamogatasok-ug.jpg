0-9297-525400d76232":{"__typename":"Format","id":"7a6036e1-c587-11f0-9297-525400d76232","slug":"cikk","name":"Cikk","description":null,"url":"https://444.hu/format/cikk","mateType":"DEFAULT"},"MediaItem:c5c83a62-f43e-5778-8ab6-c8d9d338025a":{"__typename":"Image","caption":"Mága Zoltán Orbán Viktor szüleinek húzza a nótát Székesfehérváron","author":"Mága Zoltán/Facebook","url":"https://assets.4cdn.hu/kraken/8IIg9udWMIvCOSGHs.jpeg","creditType":"Fotó","sourceLink":"https://www.facebook.com/MagaZoltanHegedumuvesz/posts/pfbid0WytbbR8oPzDh6BqWh5Tsb1MnXPHZ5B6jMQ4jvKPCSBFKv9KmVFpREPyUqvug28Z2l","bucket":{"__ref":"Bucket:70b47701-2c71-55dc-95b1-7ac5be6b8a21"},"id":"c5c83a62-f43e-5778-8ab6-c8d9d338025a","width":1516,"height":1009,"variations":[{"__typename":"ImageVariation","url":"https://assets.4cdn.hu/kraken/8IIg9udWMIvCOSGHs-xxs.jpeg","size":"xxs","width":96,"height":64},{"__typename":"ImageVariation","url":"https://assets.4cdn.hu/kraken/8IIg9udWMIvCOSGHs-xs.jpeg","size":"xs","width":360,"height":240},{"__typename":"ImageVariation","url":"https://assets.4cdn.hu/kraken/8IIg9udWMIvCOSGHs-sm.jpeg","size":"sm","width":640,"height":426},{"__typename":"ImageVariation","url":"https://assets.4cdn.hu/kraken/8IIg9udWMIvCOSGHs-md.jpeg","size":"md","width":768,"height":511},{"__typename":"ImageVariation","url":"https://assets.4cdn.hu/kraken/8IIg9udWMIvCOSGHs-lg.jpeg","size":"lg","width":1366,"height":909},{"__typename":"ImageVariation","url":"https://assets.4cdn.hu/kraken/8IIg9udWMIvCOSGHs-xl.jpeg","size":"xl","width":1920,"height":1278},{"__typename":"ImageVariation","url":"https://assets.4cdn.hu/kraken/8IIg9udWMIvCOSGHs-xxl.jpeg","size":"xxl","width":2560,"height":1704}]},"Author:45441a7e-c193-4302-8763-0782e8267764":{"__typename":"Author","id":"45441a7e-c193-4302-8763-0782e8267764","name":"Gazda Albert","avatar":"https://assets.4cdn.hu/kraken/7fD6yLt3URxyKeDls.jpeg?width=96\u0026height=96\u0026fit=crop","slug":"gazdaa"},"Category:492b6bf0-019a-4f4a-a596-fec37b6676b1":{"__typename":"Category","id":"492b6bf0-019a-4f4a-a596-fec37b6676b1","slug":"politika","name":"POLITIKA","description":"","url":"https://444.hu/category/politika"},"Article:3789562f-e3d2-5d2d-b336-d728f89a13c4":{"__typename":"Article","id":"3789562f-e3d2-5d2d-b336-d728f89a13c4","title":"NKA-támogatások: költségvetési csalás és hűtlen kezelés gyanúja miatt nyomoz a NAV","slug":"nka-tamogatasok-koltsegvetesi-csalas-es-hutlen-kezeles-gyanuja-miatt-nyomoz-a-nav","featuredImage":{"__ref":"MediaItem:c5c83a62-f43e-5778-8ab6-c8d9d338025a"},"excerpt":"A Telexnek írták ezt arra a kérdésre, hogy indult-e nyomozás az NKA-támogatásokkal összefüggésben, amelyek az elmúlt években „az egyik közismert hegedűművészhez” jutottak el.","publishedAt":"2026-05-22T16:42:28+02:00","createdAt":"2026-05-22T16:42:30+02:00","authors":[{"__ref":"Author:45441a7e-c193-4302-8763-0782e8267764"}],"categories":[{"__ref":"Category:492b6bf0-019a-4f4a-a596-fec37b6676b1"}],"collections":[],"bucket":{"__ref":"Bucket:70b47701-2c71-55dc-95b1-7ac5be6b8a21"},"options":[{"__typename":"Option","key":"template","value":""},{"__typename":"Option","key":"language","value":"hu"},{"__typename":"Option","key":"color_scheme","value":""},{"__typename":"Option","key":"is_anonym","value":false},{"__typename":"Option","key":"background_shadow","value":false},{"__typename":"Option","key":"title_inner","value":false},{"__typename":"Option","key":"lead_av","value":""},{"__typename":"Option","key":"jumbotron","value":""},{"__typename":"Option","key":"external_url","value":""},{"__typename":"Option","key":"title_alignment","value":""},{"__typename":"Option","key":"comments_enabled","value":true},{"__typename":"Option","key":"stream","value":true}],"format":{"__ref":"Format:7a6036e1-c587-11f0-9297-525400d76232"},"partners":[],"url":"https://444.hu/2026/05/22/nka-tamogatasok-koltsegvetesi-csalas-es-hutlen-kezeles-gyanuja-miatt-nyomoz-a-nav"},"Article:e8c18ab4-e054-5b57-b85c-5bcf574e2836":{"__typename":"Article","id":"e8c18ab4-e054-5b57-b85c-5bcf574e2836","featuredImage":{"__ref":"MediaItem:004bae00-176c-567f-b599-81087fec603c"},"title":"Ugyanazon a napon indítottak el négy egyesületet Győrben és környékén, ezek összesen 105 millió forint támogatást kaptak az NKA feketekasszájából, a NAV nyomozást rendelt el","body":[[{"type":"core/paragraph","params":{},"content":"Nyomozást rendelt el a NAV a győri és Győr környéki furcsa NKA-támogatások ügyében, Kósa Roland alpolgármester feljelentése után – \u003ca href=\"https://www.facebook.com/kosarolandgyor/posts/pfbid02fq9jCwy78dHQkj1XfJVaC6NbVAbqR8BZucdJpDzjoMkZpvmEQRfqwSTjCcykgNkrl\" target=\"_blank\" \u003eírja\u003c/a\u003e a politikus a közösségi médiában. Kósáék négy, ugyanazon a napon indított egyesületet találtak, amelyek összesen 105 millió forint állami támogatást kaptak az NKA feketekasszájából, és amelyek mindegyikében képviseleti jogosultsággal rendelkezik Juhász Balázs abdai fideszes önkormányzati képviselő, a bécsi Fidelitas alapító elnöke."},{"type":"core/paragraph","params":{},"content":"Az alpolgármester szerint azután kezdtek vizsgálódni, hogy kiderült, a Nemzeti Kulturális Alap (NKA) a választások előtt egy ideiglenes kollégiumán keresztül 17 milliárd forintot osztott ki sokszor helyi és nem helyi fideszesekhez köthető szervezeteknek. Az ügyben költségvetési csalás és hűtlen kezelés gyanúja miatt \u003ca href=\"https://444.hu/2026/05/22/nka-tamogatasok-koltsegvetesi-csalas-es-hutlen-kezeles-gyanuja-miatt-nyomoz-a-nav\" target=\"_blank\" \u003enyomoz\u003c/a\u003e a Nemzeti Adó- és Vámhivatal (NAV) – Kósa Roland szerint a győri esetet is egy, az NKA-ügyben már folyamatban lévő büntetőeljárással vonták össze."},{"type":"image","params":{"src":"https://4cdn.hu/kraken/image/upload/s--JaoNhK2D--/c_limit,w_760/8LXpAFHACOE9mOWHs.jpeg","id":"004bae00-176c-567f-b599-81087fec603c","showauthor":"true","alt":"","link":"","mediaItem":{"caption":"","author":"Németh Dániel/444","url":"https://assets.4cdn.hu/kraken/8LXpAFHACOE9mOWHs.jpeg","creditType":"Fotó","sourceLink":null,"bucket":{"id":"70b47701-2c71-55dc-95b1-7ac5be6b8a21","slug":"444","name":"444","__typename":"Bucket"},"__typename":"Image","id":"004bae00-176c-567f-b599-81087fec603c","width":3000,"height":2001,"variations":[{"url":"https://assets.4cdn.hu/kraken/8LXpAFHACOE9mOWHs-xxs.jpeg","size":"xxs","width":96,"height":64,"__typename":"ImageVariation"},{"url":"https://assets.4cdn.hu/kraken/8LXpAFHACOE9mOWHs-xs.jpeg","size":"xs","width":360,"height":240,"__typename":"ImageVariation"},{"url":"https://assets.4cdn.hu/kraken/8LXpAFHACOE9mOWHs-sm.jpeg","size":"sm","width":640,"height":427,"__typename":"ImageVariation"},{"url":"https://assets.4cdn.hu/kraken/8LXpAFHACOE9mOWHs-md.jpeg","size":"md","width":768,"height":512,"__typename":"ImageVariation"},{"url":"https://assets.4cdn.hu/kraken/8LXpAFHACOE9mOWHs-lg.jpeg","size":"lg","width":1366,"height":911,"__typename":"ImageVariation"},{"url":"https://assets.4cdn.hu/kraken/8LXpAFHACOE9mOWHs-xl.jpeg","size":"xl","width":1920,"height":1281,"__typename":"ImageVariation"},{"url":"https://assets.4cdn.hu/kraken/8LXpAFHACOE9mOWHs-xxl.jpeg","size":"xxl","width":2560,"height":1708,"__typename":"ImageVariation"}]}},"content":"Hankó Balázs"},{"type":"core/paragraph","params":{},"content":"Kósa szerint négy egyesület, a Fiatalok Külügyi és Kultúr Egyesülete, a Fiatalok Sport és Kultúr Egyesülete, a Polgári Sport Kör Egyesület és a HD Sport Egyesület összesen 105 millió forintot kapott 2025. november 19. és 2026. január 22. között."},{"type":"core/paragraph","params":{},"content":"„Mindegyik egyesület bejegyzési eljárását ugyanazon a napon indították, mindegyik egyesület alapszabályát ugyanazon a napon fogadták el” – írja Kósa. Az egyesületek előző évekre vonatkozó beszámolói tavaly júliusban ugyanabban 11 másodpercben érkeztek be, ráadásul két egyesület adószáma felcserélve jelent meg a beszámolókon. Ezek alapján 2022-ben, 2023-ban és 2024-ben 0 forint bevételük és kiadásuk volt, „magyarán szólva nem csináltak semmi értelmezhetőt”."},{"type":"core/paragraph","params":{},"content":"„Dühítő, hogy üres egyesületekhez folyik a közpénz, miközben értékteremtő helyi szervezetek anyagi nehézségekkel küzdenek” – írta Kósa, aki költségvetési csalás és hivatali visszaélés miatt tett feljelentés, amire reagálva a NAV nyomozást indított."}]],"slug":"ugyanazon-a-napon-inditottak-el-negy-egyesuletet-gyorben-es-kornyeken-ezek-osszesen-105-millio-forint-tamogatast-kaptak-az-nka-feketekasszajabol-a-nav-nyomozast-rendelt-el","publishedAt":"2026-06-16T10:43:36+02:00","bucket":{"__ref":"Bucket:70b47701-2c71-55dc-95b1-7ac5be6b8a21"},"excerpt":"Mindegyikben képviseleti jogosultsága van Juhász Balázsnak, a bécsi Fidelitas alapító elnökének.","createdAt":"2026-06-16T10:43:40+02:00","updatedAt":"2026-06-16T10:57:44+02:00","authors":[{"__ref":"Author:6cba2d25-9994-43cc-b220-239068a003f0"}],"categories":[{"__ref":"Category:b722e920-44ed-4c26-bca0-2ac8fc0cd644"}],"tags":[{"__ref":"Tag:0764a5cb-403b-4164-9a99-afd99f72cc29"},{"__ref":"Tag:2564f809-ba77-4396-a557-4c298689b395"},{"__ref":"Tag:27535d03-4fd7-432c-951e-62d6e1da9750"},{"__ref":"Tag:2edfd9e3-b418-40e0-ad4d-3a56ba4c7c85"},{"__ref":"Tag:3a80bb30-cc5a-4117-a846-800dc3aa0fbf"},{"__ref":"Tag:50323bb4-9d89-45ad-ac05-1aa7f75e9293"},{"__ref":"Tag:6c7a61f0-db57-4322-80c4-a5b1e484b760"},{"__ref":"Tag:7a6feea7-3845-40eb-b1c6-a9e90f7786c4"},{"__ref":"Tag:8f023910-03af-489c-b4d5-58bd097f0e17"},{"__ref":"Tag:a957f431-9687-4193-a650-75d6086ae638"},{"__ref":"Tag:ad172a86-3064-4a80-aea3-7e64e5553be3"},{"__ref":"Tag:dc4acf42-c8e6-4e81-94a8-1e42c1c25fe9"},{"__ref":"Tag:e2104d1a-a18d-4698-8cc4-577f51529ea1"},{"__ref":"Tag:e4935e38-7efc-4049-830f-97c3de831186"},{"__ref":"Tag:e5c24ae0-9517-4e32-be83-360839c15460"},{"__ref":"Tag:ecb0881f-3133-42bd-96b7-19987833f513"},{"__ref":"Tag:f063be3c-394a-5548-a71e-5308e3b2440f"},{"__ref":"Tag:feed4e31-b29f-4c9f-8001-e8918b15fd2e"}],"collections":[],"meta":[{"__typename":"Meta","key":"description","value":""},{"__typename":"Meta","key":"excerpt","value":"Mindegyikben képviseleti jogosultsága van Juhász Balázsnak, a bécsi Fidelitas alapító elnökének."},{"__typename":"Meta","key":"featuredImage","value":"004bae00-176c-567f-b599-81087fec603c"},{"__typename":"Meta","key":"og:description","value":""},{"__typename":"Meta","key":"og:image","value":""},{"__typename":"Meta","key":"og:title","value":""},{"__typename":"Meta","key":"title","value":""}],"options":[{"__typename":"Option","key":"template","value":""},{"__typename":"Option","key":"language","value":"hu"},{"__typename":"Option","key":"color_scheme","value":""},{"__typename":"Option","key":"is_anonym","value":false},{"__typename":"Option","key":"background_shadow","value":false},{"__typename":"Option","key":"title_inner","value":false},{"__typename":"Option","key":"lead_av","value":""},{"__typename":"Option","key":"jumbotron","value":""},{"__typename":"Option","key":"external_url","value":""},{"__typename":"Option","key":"title_alignment","value":""},{"__typename":"Option","key":"comments_enabled","value":true},{"__typename":"Option","key":"stream","value":true}],"url":"https://444.hu/2026/06/16/ugyanazon-a-napon-inditottak-el-negy-egyesuletet-gyorben-es-kornyeken-ezek-osszesen-105-millio-forint-tamogatast-kaptak-az-nka-feketekasszajabol-a-nav-nyomozast-rendelt-el","format":{"__ref":"Format:7a6036e1-c587-11f0-9297-525400d76232"},"partners":[],"relatedArticles":[{"__ref":"Article:3789562f-e3d2-5d2d-b336-d728f89a13c4"}],"userHasAccess":true},"ROOT_QUERY":{"__typename":"Query","content({\"fromBucket\":{\"column\":\"SLUG\",\"operator\":\"IN\",\"value\":[\"444\"]},\"publishedAt\":\"2026-06-16\",\"slug\":\"ugyanazon-a-napon-inditottak-el-negy-egyesuletet-gyorben-es-kornyeken-ezek-osszesen-105-millio-forint-tamogatast-kaptak-az-nka-feketekasszajabol-a-nav-nyomozast-rendelt-el\"})":{"__ref":"Article:e8c18ab4-e054-5b57-b85c-5bcf574e2836"}}}}</script><script type="fastboot/shoebox" id="shoebox-abgroup">"5"</script><script type="x/boundary" id="fastboot-body-end"></scrip