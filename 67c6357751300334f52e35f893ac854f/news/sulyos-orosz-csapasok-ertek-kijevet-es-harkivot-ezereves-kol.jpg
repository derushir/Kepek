:134d230f-2d78-412f-b658-1f48fbe1239b":{"__typename":"Tag","id":"134d230f-2d78-412f-b658-1f48fbe1239b","slug":"kijev","name":"kijev","description":"","url":"https://444.hu/tag/kijev"},"Tag:14e3216d-c397-43fe-aadf-c5a727968a1a":{"__typename":"Tag","id":"14e3216d-c397-43fe-aadf-c5a727968a1a","slug":"andrij-szibiha","name":"Andrij Szibiha","description":"","url":"https://444.hu/tag/andrij-szibiha"},"Tag:2c9251d5-8571-4951-9c1c-be3be7a46bb5":{"__typename":"Tag","id":"2c9251d5-8571-4951-9c1c-be3be7a46bb5","slug":"timur-tkacsenko","name":"Timur Tkacsenko","description":"","url":"https://444.hu/tag/timur-tkacsenko"},"Tag:47b365c1-3965-492b-b36b-faae33793bfd":{"__typename":"Tag","id":"47b365c1-3965-492b-b36b-faae33793bfd","slug":"harkiv","name":"harkiv","description":"","url":"https://444.hu/tag/harkiv"},"Tag:5857c2b4-b398-43a6-a193-a840be6183ef":{"__typename":"Tag","id":"5857c2b4-b398-43a6-a193-a840be6183ef","slug":"orosz-ukran-haboru","name":"orosz-ukrán háború","description":"","url":"https://444.hu/tag/orosz-ukran-haboru"},"Tag:972ad3bc-e11c-4610-b69b-7d70999357d7":{"__typename":"Tag","id":"972ad3bc-e11c-4610-b69b-7d70999357d7","slug":"vitalij-klicsko","name":"vitalij klicsko","description":"","url":"https://444.hu/tag/vitalij-klicsko"},"Tag:bd849165-c496-426f-b5dc-da1baa1bec6e":{"__typename":"Tag","id":"bd849165-c496-426f-b5dc-da1baa1bec6e","slug":"legiriado","name":"légiriadó","description":"","url":"https://444.hu/tag/legiriado"},"Tag:c7bca5a5-b585-4d98-b079-a3afda1d9a7b":{"__typename":"Tag","id":"c7bca5a5-b585-4d98-b079-a3afda1d9a7b","slug":"moszkva","name":"moszkva","description":"","url":"https://444.hu/tag/moszkva"},"Tag:cfbabdd0-43cc-46ee-bd49-6405620ceed8":{"__typename":"Tag","id":"cfbabdd0-43cc-46ee-bd49-6405620ceed8","slug":"pecserszka-lavra","name":"Pecserszka lavra","description":"","url":"https://444.hu/tag/pecserszka-lavra"},"Tag:db62a7fc-aa07-46a2-b7d5-8ee1679bae4f":{"__typename":"Tag","id":"db62a7fc-aa07-46a2-b7d5-8ee1679bae4f","slug":"ukrajna","name":"ukrajna","description":"","url":"https://444.hu/tag/ukrajna"},"Tag:eb48fb6b-3937-4244-8eb9-b7b41bf1dddf":{"__typename":"Tag","id":"eb48fb6b-3937-4244-8eb9-b7b41bf1dddf","slug":"tula","name":"tula","description":"","url":"https://444.hu/tag/tula"},"Collection:932764d8-920c-46bb-b19c-b3dcc012f962":{"__typename":"Collection","id":"932764d8-920c-46bb-b19c-b3dcc012f962","slug":"orosz-ukran-haboru","name":"orosz-ukrán háború","description":"Az ukrajnai háború a 444-en","url":"https://444.hu/ukran-haboru","picture":"https://img.444.hu/svg/pictogram__ukrajna.svg"},"Format:7a6036e1-c587-11f0-9297-525400d76232":{"__typename":"Format","id":"7a6036e1-c587-11f0-9297-525400d76232","slug":"cikk","name":"Cikk","description":null,"url":"https://444.hu/format/cikk","mateType":"DEFAULT"},"Article:1ddfa70a-dbba-53a1-a8bb-1366a7cd032d":{"__typename":"Article","id":"1ddfa70a-dbba-53a1-a8bb-1366a7cd032d","featuredImage":{"__ref":"MediaItem:c766ff8a-0244-5f46-8980-f4fb3e0b08c0"},"title":"Az oroszok felgyújtottak egy ezer éves kolostort Kijevben","body":[[{"type":"core/paragraph","params":{},"content":"Kilenc ember meghalt, többen pedig megsebesültek Ukrajnában az újabb orosz csapások miatt. Kijevben a közel ezer éves barlangkolostor, a Pecserszka lavra is kigyulladt. Emellett az oroszok lakóépületeket is lőttek. A főváros elleni támadásokban legalább négyen meghaltek, valamint \u003ca href=\"https://www.rbc.ua/rus/news/rizko-zrosla-kilkist-postrazhdalih-vid-ataki-1781502236.html\" target=\"_blank\" \u003e30 ember megsebesült\u003c/a\u003e. A sebesültek között két, egy 5 és egy 6 éves gyermek volt. A kelet-ukrajnai Harkivban öt mentőmunkás halt meg, miközben egy orosz csapás által okozott tüzet próbálták eloltani ."},{"type":"image","params":{"src":"https://4cdn.hu/kraken/image/upload/s--OeWqg55J--/c_limit,w_760/8M165SMwEEwy1UBzSs.jpeg","id":"c766ff8a-0244-5f46-8980-f4fb3e0b08c0","showauthor":"true","alt":"","link":"","mediaItem":{"caption":"","author":"GENYA SAVILOV/AFP","url":"https://assets.4cdn.hu/kraken/8M165SMwEEwy1UBzSs.jpeg","creditType":"Fotó","sourceLink":null,"bucket":{"id":"70b47701-2c71-55dc-95b1-7ac5be6b8a21","slug":"444","name":"444","__typename":"Bucket"},"__typename":"Image","id":"c766ff8a-0244-5f46-8980-f4fb3e0b08c0","width":5715,"height":3810,"variations":[{"url":"https://assets.4cdn.hu/kraken/8M165SMwEEwy1UBzSs-xxs.jpeg","size":"xxs","width":96,"height":64,"__typename":"ImageVariation"},{"url":"https://assets.4cdn.hu/kraken/8M165SMwEEwy1UBzSs-xs.jpeg","size":"xs","width":360,"height":240,"__typename":"ImageVariation"},{"url":"https://assets.4cdn.hu/kraken/8M165SMwEEwy1UBzSs-sm.jpeg","size":"sm","width":640,"height":427,"__typename":"ImageVariation"},{"url":"https://assets.4cdn.hu/kraken/8M165SMwEEwy1UBzSs-md.jpeg","size":"md","width":768,"height":512,"__typename":"ImageVariation"},{"url":"https://assets.4cdn.hu/kraken/8M165SMwEEwy1UBzSs-lg.jpeg","size":"lg","width":1366,"height":911,"__typename":"ImageVariation"},{"url":"https://assets.4cdn.hu/kraken/8M165SMwEEwy1UBzSs-xl.jpeg","size":"xl","width":1920,"height":1280,"__typename":"ImageVariation"},{"url":"https://assets.4cdn.hu/kraken/8M165SMwEEwy1UBzSs-xxl.jpeg","size":"xxl","width":2560,"height":1707,"__typename":"ImageVariation"}]}},"content":""},{"type":"core/paragraph","params":{},"content":"„\u003ci \u003eSürgősen megindítjuk az összes vonatkozó eljárást az UNESCO-nál és minden más nemzetközi mechanizmus keretében, azonnali és megfelelő válaszokat követelve erre az állami barbárságra\u003c/i\u003e” – közölte Andrij Szibiha ukrán külügyminiszter az X-en."},{"type":"core/paragraph","params":{},"content":"Timur Tkacsenko, a kijevi városi katonai közigazgatás vezetője szerint a tüzet közvetlen találat okozta. „\u003ci \u003eAz oroszok tudatosan csapást mértek az egyik legnagyobb keresztény szentély szívére!\u003c/i\u003e” – jelentette ki Tkacsenko. Az ukrán Állami Sürgősségi Szolgálat adatai szerint a tűz a székesegyház tetejére terjedt át, és mintegy 800 négyzetméteres területet érintett."},{"type":"image","params":{"src":"https://4cdn.hu/kraken/image/upload/s--K5Ty_Ch1--/c_limit,w_760/8M162qbeT9UN2TI1eCs.jpeg","id":"108e0959-961f-5da6-97f8-183c0dc37335","showauthor":"true","alt":"","link":"","mediaItem":{"__typename":"Image","id":"108e0959-961f-5da6-97f8-183c0dc37335","author":"OLEKSII FILIPPOV/AFP","bucket":{"id":"70b47701-2c71-55dc-95b1-7ac5be6b8a21","slug":"444","name":"444","__typename":"Bucket"},"caption":"Egy lakóház lángjai Kijevben az orosz támadás után","creditType":"Fotó","sourceLink":null,"url":"https://assets.4cdn.hu/kraken/8M162qbeT9UN2TI1eCs.jpeg","height":6336,"width":9504,"variations":[{"__typename":"ImageVariation","height":64,"width":96,"size":"xxs","url":"https://assets.4cdn.hu/kraken/8M162qbeT9UN2TI1eCs-xxs.jpeg"},{"__typename":"ImageVariation","height":240,"width":360,"size":"xs","url":"https://assets.4cdn.hu/kraken/8M162qbeT9UN2TI1eCs-xs.jpeg"},{"__typename":"ImageVariation","height":427,"width":640,"size":"sm","url":"https://assets.4cdn.hu/kraken/8M162qbeT9UN2TI1eCs-sm.jpeg"},{"__typename":"ImageVariation","height":512,"width":768,"size":"md","url":"https://assets.4cdn.hu/kraken/8M162qbeT9UN2TI1eCs-md.jpeg"},{"__typename":"ImageVariation","height":911,"width":1366,"size":"lg","url":"https://assets.4cdn.hu/kraken/8M162qbeT9UN2TI1eCs-lg.jpeg"},{"__typename":"ImageVariation","height":1280,"width":1920,"size":"xl","url":"https://assets.4cdn.hu/kraken/8M162qbeT9UN2TI1eCs-xl.jpeg"},{"__typename":"ImageVariation","height":1707,"width":2560,"size":"xxl","url":"https://assets.4cdn.hu/kraken/8M162qbeT9UN2TI1eCs-xxl.jpeg"}]}},"content":"Egy lakóház lángjai Kijevben az orosz támadás után"},{"type":"core/paragraph","params":{},"content":"Közben az oroszországi Tula városában, Moszkvától délre, egy ukrán dróntámadás három ember ölt meg, és további hárman megsebesültek, köztük egy egyéves gyermek."},{"type":"core/paragraph","params":{},"content":"A drón- és rakétacsapások épületeket és autókat gyújtottak fel, és több mint 140 ezer ember maradt áram nélkül Ukrajna fővárosában – közölte Vitalij Klicsko kijevi polgármester. Hétfőn Ukrajna nagy részén légiriadót rendeltek el. A több lakóépületet célzó kijevi csapásokban legalább 23 ember megsebesült, Harkivban pedig további öten sérültek meg. "},{"type":"core/paragraph","params":{},"content":"Lengyelország közölte, hogy vadászgépeket riasztott, és készenlétbe helyezte a földi légvédelmi rendszereket, „\u003ci \u003emegelőző\u003c/i\u003e” válaszlépésként a Kijevet ért orosz csapásokra. (\u003ca href=\"https://www.rbc.ua/rus/news/lavra-vogni-k-viglyadae-uspenskiy-sobor-pislya-1781483241.html\" target=\"_blank\" \u003eRBC\u003c/a\u003e/\u003ca href=\"https://www.bbc.com/news/articles/c4gy037gjz3o\" target=\"_blank\" \u003eBBC\u003c/a\u003e/\u003ca href=\"https://ru.themoscowtimes.com/2026/06/15/tramp-obyavil-o-mirnoi-sdelke-s-iranom-a198111\" target=\"_blank\" \u003eMoscow Times\u003c/a\u003e)"}]],"slug":"az-oroszok-felgyujtottak-egy-ezer-eves-kolostort-kijevben","publishedAt":"2026-06-15T08:17:49+02:00","bucket":{"__ref":"Bucket:70b47701-2c71-55dc-95b1-7ac5be6b8a21"},"excerpt":"Az orosz támadások miatt legalább négy ember halt meg az ukrán fővárosban.","createdAt":"2026-06-15T08:17:52+02:00","updatedAt":"2026-06-15T08:49:35+02:00","authors":[{"__ref":"Author:b5b97984-4185-4de7-8278-4eddd6a69e9a"}],"categories":[{"__ref":"Category:30bfd86b-4bf2-4dd0-afcb-1416a0c76c76"}],"tags":[{"__ref":"Tag:134d230f-2d78-412f-b658-1f48fbe1239b"},{"__ref":"Tag:14e3216d-c397-43fe-aadf-c5a727968a1a"},{"__ref":"Tag:2c9251d5-8571-4951-9c1c-be3be7a46bb5"},{"__ref":"Tag:47b365c1-3965-492b-b36b-faae33793bfd"},{"__ref":"Tag:5857c2b4-b398-43a6-a193-a840be6183ef"},{"__ref":"Tag:972ad3bc-e11c-4610-b69b-7d70999357d7"},{"__ref":"Tag:bd849165-c496-426f-b5dc-da1baa1bec6e"},{"__ref":"Tag:c7bca5a5-b585-4d98-b079-a3afda1d9a7b"},{"__ref":"Tag:cfbabdd0-43cc-46ee-bd49-6405620ceed8"},{"__ref":"Tag:db62a7fc-aa07-46a2-b7d5-8ee1679bae4f"},{"__ref":"Tag:eb48fb6b-3937-4244-8eb9-b7b41bf1dddf"}],"collections":[{"__ref":"Collection:932764d8-920c-46bb-b19c-b3dcc012f962"}],"meta":[{"__typename":"Meta","key":"description","value":""},{"__typename":"Meta","key":"excerpt","value":"Az orosz támadások miatt legalább négy ember halt meg az ukrán fővárosban."},{"__typename":"Meta","key":"featuredImage","value":"c766ff8a-0244-5f46-8980-f4fb3e0b08c0"},{"__typename":"Meta","key":"og:description","value":""},{"__typename":"Meta","key":"og:image","value":""},{"__typename":"Meta","key":"og:title","value":""},{"__typename":"Meta","key":"title","value":""}],"options":[{"__typename":"Option","key":"template","value":""},{"__typename":"Option","key":"language","value":"hu"},{"__typename":"Option","key":"color_scheme","value":""},{"__typename":"Option","key":"is_anonym","value":false},{"__typename":"Option","key":"background_shadow","value":false},{"__typename":"Option","key":"title_inner","value":false},{"__typename":"Option","key":"lead_av","value":""},{"__typename":"Option","key":"jumbotron","value":""},{"__typename":"Option","key":"external_url","value":""},{"__typename":"Option","key":"title_alignment","value":""},{"__typename":"Option","key":"comments_enabled","value":true},{"__typename":"Option","key":"stream","value":true}],"url":"https://444.hu/2026/06/15/az-oroszok-felgyujtottak-egy-ezer-eves-kolostort-kijevben","format":{"__ref":"Format:7a6036e1-c587-11f0-9297-525400d76232"},"partners":[],"relatedArticles":[],"userHasAccess":true},"ROOT_QUERY":{"__typename":"Query","content({\"fromBucket\":{\"column\":\"SLUG\",\"operator\":\"IN\",\"value\":[\"444\"]},\"publishedAt\":\"2026-06-15\",\"slug\":\"az-oroszok-felgyujtottak-egy-ezer-eves-kolostort-kijevben\"})":{"__ref":"Article:1ddfa70a-dbba-53a1-a8bb-1366a7cd032d"}}}}</script><script type="fastboot/shoebox" id="shoebox-abgroup">null</script><script type="x/boundary" id="fastboot-body-end"></script>

    
