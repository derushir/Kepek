"url":"https://assets.4cdn.hu/kraken/8Mcoxvv2FblTWGLWs-xl.jpeg","size":"xl","width":1920,"height":1281},{"__typename":"ImageVariation","url":"https://assets.4cdn.hu/kraken/8Mcoxvv2FblTWGLWs-xxl.jpeg","size":"xxl","width":2560,"height":1708}]},"Category:b1fca7cb-91fd-4dfc-8782-182c41cc3a5d":{"__typename":"Category","id":"b1fca7cb-91fd-4dfc-8782-182c41cc3a5d","slug":"szolgalati-kozlemeny","name":"szolgálati közlemény","description":"","url":"https://444.hu/category/szolgalati-kozlemeny"},"Article:beeec7c5-c687-570c-b20b-0af1e1376016":{"__typename":"Article","id":"beeec7c5-c687-570c-b20b-0af1e1376016","title":"Bemutatkozom, augusztustól én vagyok a 444 új főszerkesztője","slug":"bemutatkozom-augusztustol-en-vagyok-a-444-uj-foszerkesztoje","featuredImage":{"__ref":"MediaItem:25597a0a-c217-5f29-9724-657012bd7c23"},"excerpt":"Kívülről jövök, de nem kívülállóként, és nem újraírni, hanem megerősíteni jöttem a 444-et. Augusztustól veszem át az irányítást, UP pedig nem megy sehova. Arról írok, mit hozok magammal és hogy hiába változik minden, a jó újságírás feladata ugyanaz.","publishedAt":"2026-07-09T13:22:48+02:00","createdAt":"2026-07-09T13:22:49+02:00","authors":[{"__ref":"Author:fa82fcb8-efef-400d-964f-7f703549690f"}],"categories":[{"__ref":"Category:b1fca7cb-91fd-4dfc-8782-182c41cc3a5d"}],"collections":[],"bucket":{"__ref":"Bucket:70b47701-2c71-55dc-95b1-7ac5be6b8a21"},"options":[{"__typename":"Option","key":"template","value":""},{"__typename":"Option","key":"language","value":"hu"},{"__typename":"Option","key":"color_scheme","value":""},{"__typename":"Option","key":"is_anonym","value":false},{"__typename":"Option","key":"background_shadow","value":false},{"__typename":"Option","key":"title_inner","value":false},{"__typename":"Option","key":"lead_av","value":""},{"__typename":"Option","key":"jumbotron","value":""},{"__typename":"Option","key":"external_url","value":""},{"__typename":"Option","key":"title_alignment","value":""},{"__typename":"Option","key":"comments_enabled","value":true},{"__typename":"Option","key":"stream","value":true}],"format":{"__ref":"Format:7a6036e1-c587-11f0-9297-525400d76232"},"partners":[],"url":"https://444.hu/2026/07/09/bemutatkozom-augusztustol-en-vagyok-a-444-uj-foszerkesztoje"},"MediaItem:cd362b79-c76f-56a2-acbe-25b14d8eb5b6":{"__typename":"Image","caption":"","author":"Bankó Gábor/444","url":"https://assets.4cdn.hu/kraken/8McoyAX1cxigWGLWs.jpeg","creditType":"Fotó","sourceLink":null,"bucket":{"__ref":"Bucket:70b47701-2c71-55dc-95b1-7ac5be6b8a21"},"id":"cd362b79-c76f-56a2-acbe-25b14d8eb5b6","width":2000,"height":1334,"variations":[{"__typename":"ImageVariation","url":"https://assets.4cdn.hu/kraken/8McoyAX1cxigWGLWs-xxs.jpeg","size":"xxs","width":96,"height":64},{"__typename":"ImageVariation","url":"https://assets.4cdn.hu/kraken/8McoyAX1cxigWGLWs-xs.jpeg","size":"xs","width":360,"height":240},{"__typename":"ImageVariation","url":"https://assets.4cdn.hu/kraken/8McoyAX1cxigWGLWs-sm.jpeg","size":"sm","width":640,"height":427},{"__typename":"ImageVariation","url":"https://assets.4cdn.hu/kraken/8McoyAX1cxigWGLWs-md.jpeg","size":"md","width":768,"height":512},{"__typename":"ImageVariation","url":"https://assets.4cdn.hu/kraken/8McoyAX1cxigWGLWs-lg.jpeg","size":"lg","width":1366,"height":911},{"__typename":"ImageVariation","url":"https://assets.4cdn.hu/kraken/8McoyAX1cxigWGLWs-xl.jpeg","size":"xl","width":1920,"height":1281},{"__typename":"ImageVariation","url":"https://assets.4cdn.hu/kraken/8McoyAX1cxigWGLWs-xxl.jpeg","size":"xxl","width":2560,"height":1708}]},"Article:c5606035-d7a0-5bbb-bfec-04e073002a56":{"__typename":"Article","id":"c5606035-d7a0-5bbb-bfec-04e073002a56","title":"Ezt még megírom, aztán maradok*","slug":"ezt-meg-megirom-aztan-maradok","featuredImage":{"__ref":"MediaItem:cd362b79-c76f-56a2-acbe-25b14d8eb5b6"},"excerpt":"Munk Vera lesz a 444 új főszerkesztője. Én meg – érdemeim maradéktalan elismerése mellett – más, fontos beosztásba helyezem magam. Továbbra is kulcsszerepet kívánok játszani saját szakmai fejlődésemben.","publishedAt":"2026-07-09T13:22:01+02:00","createdAt":"2026-07-09T13:22:04+02:00","authors":[{"__ref":"Author:09a5f92a-60e5-4e10-bd1d-c78cc457a547"}],"categories":[{"__ref":"Category:b1fca7cb-91fd-4dfc-8782-182c41cc3a5d"}],"collections":[],"bucket":{"__ref":"Bucket:70b47701-2c71-55dc-95b1-7ac5be6b8a21"},"options":[{"__typename":"Option","key":"template","value":""},{"__typename":"Option","key":"language","value":"hu"},{"__typename":"Option","key":"color_scheme","value":""},{"__typename":"Option","key":"is_anonym","value":false},{"__typename":"Option","key":"background_shadow","value":false},{"__typename":"Option","key":"title_inner","value":false},{"__typename":"Option","key":"lead_av","value":""},{"__typename":"Option","key":"jumbotron","value":""},{"__typename":"Option","key":"external_url","value":""},{"__typename":"Option","key":"title_alignment","value":""},{"__typename":"Option","key":"comments_enabled","value":true},{"__typename":"Option","key":"stream","value":true}],"format":{"__ref":"Format:7a6036e1-c587-11f0-9297-525400d76232"},"partners":[],"url":"https://444.hu/2026/07/09/ezt-meg-megirom-aztan-maradok"},"Article:9e21b62d-c333-53a2-802e-3b8d6219bf98":{"__typename":"Article","id":"9e21b62d-c333-53a2-802e-3b8d6219bf98","featuredImage":{"__ref":"MediaItem:6772e8be-bb28-5c82-bf7a-76c3d79b8231"},"title":"Új főszerkesztő kerül a 24.hu élére","body":[[{"type":"core/paragraph","params":{},"content":"Augusztus 1-jétől a 24.hu eddigi főszerkesztője, Pető Péter digitális előfizetéses tartalom- és hírigazgatóként folytatja munkáját a kiadó Central Médiacsoportnál. A lap főszerkesztői feladatait Bita Dániel veszi át, aki 2019 óta főszerkesztő-helyettes és a Közélet rovat vezetője. A cég közleménye szerint „meghatározó szerepet játszott a lap szakmai munkájának és napi működésének irányításában”. Az új főszerkesztő-helyettes Jankovics Márton lesz."},{"type":"image","params":{"src":"https://4cdn.hu/kraken/image/upload/s--uUcPn9Dm--/c_limit,w_760/8MePnzHAjPEEuZbis.jpeg","id":"6772e8be-bb28-5c82-bf7a-76c3d79b8231","showauthor":"true","alt":"","link":"","mediaItem":{"caption":"","author":"Adrián Zoltán / 24.hu/Adrián Zoltán / 24.hu","url":"https://assets.4cdn.hu/kraken/8MePnzHAjPEEuZbis.jpeg","creditType":"Fotó","sourceLink":null,"bucket":{"id":"70b47701-2c71-55dc-95b1-7ac5be6b8a21","slug":"444","name":"444","__typename":"Bucket"},"__typename":"Image","id":"6772e8be-bb28-5c82-bf7a-76c3d79b8231","width":3507,"height":2338,"variations":[{"url":"https://assets.4cdn.hu/kraken/8MePnzHAjPEEuZbis-xxs.jpeg","size":"xxs","width":96,"height":64,"__typename":"ImageVariation"},{"url":"https://assets.4cdn.hu/kraken/8MePnzHAjPEEuZbis-xs.jpeg","size":"xs","width":360,"height":240,"__typename":"ImageVariation"},{"url":"https://assets.4cdn.hu/kraken/8MePnzHAjPEEuZbis-sm.jpeg","size":"sm","width":640,"height":427,"__typename":"ImageVariation"},{"url":"https://assets.4cdn.hu/kraken/8MePnzHAjPEEuZbis-md.jpeg","size":"md","width":768,"height":512,"__typename":"ImageVariation"},{"url":"https://assets.4cdn.hu/kraken/8MePnzHAjPEEuZbis-lg.jpeg","size":"lg","width":1366,"height":911,"__typename":"ImageVariation"},{"url":"https://assets.4cdn.hu/kraken/8MePnzHAjPEEuZbis-xl.jpeg","size":"xl","width":1920,"height":1280,"__typename":"ImageVariation"},{"url":"https://assets.4cdn.hu/kraken/8MePnzHAjPEEuZbis-xxl.jpeg","size":"xxl","width":2560,"height":1707,"__typename":"ImageVariation"}]}},"content":""},{"type":"core/paragraph","params":{},"content":"Pető Péter 2019-ben került 24.hu élére. A mostani váltás után új feladatkörében a vállalat digitális előfizetéses tartalomstratégiájáért, a 24 Extra további fejlesztéséért – a 24 Extrát a kiadó közleménye a Central digitális előfizetéses ernyőmárkájának nevezi –, valamint a News portfólió tartalmi és üzleti eredményeiért felel majd. A cég közleménye szerint emellett továbbra is aktívan részt vesz a 24 Extra tartalmainak készítésében: cikkeket és hírleveleket ír, valamint podcastokban is szerepel."},{"type":"core/paragraph","params":{},"content":"A 444 tegnap jelentette be, hogy szintén augusztus 1-jén főszerkesztőt vált: az alapító főszerkesztőnk, Uj Péter más fontos beosztásba helyezi magát érdemei maradéktalan elismerése mellett, helyébe Munk Vera lép. UP elköszönő szövegét \u003ca href=\"https://444.hu/2026/07/09/ezt-meg-megirom-aztan-maradok\" target=\"_blank\" \u003eitt\u003c/a\u003e, Vera beköszönését pedig \u003ca href=\"https://444.hu/2026/07/09/bemutatkozom-augusztustol-en-vagyok-a-444-uj-foszerkesztoje\" target=\"_blank\" \u003eitt\u003c/a\u003e olvashatjátok, és \u003ca href=\"https://444.hu/2026/07/09/uj-peter-lekoszon-munk-veronika-erkezik-mi-jon-a-444-nel\" target=\"_blank\" \u003eezen a linken\u003c/a\u003e nézhető meg a tegnap esti élő adásunk kettejükkel."}]],"slug":"uj-foszerkeszto-kerul-a-24hu-elere","publishedAt":"2026-07-10T13:48:31+02:00","bucket":{"__ref":"Bucket:70b47701-2c71-55dc-95b1-7ac5be6b8a21"},"excerpt":"A lapot eddig vezető Pető Péter digitális előfizetéses tartalom- és hírigazgatóként folytatja munkáját, az új főszerkesztő Bita Dániel lesz.","createdAt":"2026-07-10T13:48:34+02:00","updatedAt":"2026-07-10T14:17:25+02:00","authors":[{"__ref":"Author:f723c67c-e201-4f4d-9810-aff43af7a645"}],"categories":[{"__ref":"Category:303109ab-96ad-4846-abb1-82876a8f090d"}],"tags":[{"__ref":"Tag:305cae75-997c-489f-b0b1-43ce9b86c4ce"},{"__ref":"Tag:36f8903b-d1b5-48c3-bf31-88be0d0d10f7"},{"__ref":"Tag:4b14c6bf-706e-4dfe-ae0d-f087fc4638fb"},{"__ref":"Tag:50ca91f0-281d-5caa-b41b-85bc0cbd939a"},{"__ref":"Tag:81638558-e916-5564-ab85-9bf321930f5b"},{"__ref":"Tag:bd3894bd-f899-47de-93c7-f1ff155a47f7"},{"__ref":"Tag:c0cf1f68-bb52-4f89-8ae9-14c3f058a260"}],"collections":[],"meta":[{"__typename":"Meta","key":"description","value":""},{"__typename":"Meta","key":"excerpt","value":"A lapot eddig vezető Pető Péter digitális előfizetéses tartalom- és hírigazgatóként folytatja munkáját, az új főszerkesztő Bita Dániel lesz."},{"__typename":"Meta","key":"featuredImage","value":"6772e8be-bb28-5c82-bf7a-76c3d79b8231"},{"__typename":"Meta","key":"og:description","value":""},{"__typename":"Meta","key":"og:image","value":""},{"__typename":"Meta","key":"og:title","value":""},{"__typename":"Meta","key":"title","value":""}],"options":[{"__typename":"Option","key":"template","value":""},{"__typename":"Option","key":"language","value":"hu"},{"__typename":"Option","key":"color_scheme","value":""},{"__typename":"Option","key":"is_anonym","value":false},{"__typename":"Option","key":"background_shadow","value":false},{"__typename":"Option","key":"title_inner","value":false},{"__typename":"Option","key":"lead_av","value":""},{"__typename":"Option","key":"jumbotron","value":""},{"__typename":"Option","key":"external_url","value":""},{"__typename":"Option","key":"title_alignment","value":""},{"__typename":"Option","key":"comments_enabled","value":true},{"__typename":"Option","key":"stream","value":true}],"url":"https://444.hu/2026/07/10/uj-foszerkeszto-kerul-a-24hu-elere","format":{"__ref":"Format:7a6036e1-c587-11f0-9297-525400d76232"},"partners":[],"relatedArticles":[{"__ref":"Article:43c0a502-fdd6-5d04-9724-467514a39478"},{"__ref":"Article:beeec7c5-c687-570c-b20b-0af1e1376016"},{"__ref":"Article:c5606035-d7a0-5bbb-bfec-04e073002a56"}],"userHasAccess":true},"ROOT_QUERY":{"__typename":"Query","content({\"fromBucket\":{\"column\":\"SLUG\",\"operator\":\"IN\",\"value\":[\"444\",\"jo\"]},\"publishedAt\":\"2026-07-10\",\"slug\":\"uj-foszerkeszto-kerul-a-24hu-elere\"})":{"__ref":"Article:9e21b62d-c333-53a2-802e-3b8d6219bf98"}}}}</script><script type="fastboot/shoebox" id="shoebox-abgroup">null</script><script type="x/boundary" id="fastboot-body-end"></script>

    
