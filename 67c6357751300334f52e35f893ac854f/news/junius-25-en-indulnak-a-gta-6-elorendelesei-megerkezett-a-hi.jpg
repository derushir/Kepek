p-items-overlay-background: #283044; --theme-elements-tenUp-items-overlay-text: #ffffff; --theme-elements-tenUp-items-overlay-textShadow: none; --theme-elements-tenUp-items-shape: rounded; --theme-elements-tenUp-items-text-data: #ffffff; --theme-elements-tenUp-items-text-default: #f6f8f7; --theme-elements-tenUp-items-text-hover: #edf2ef; --theme-elements-threeColumn-background: transparent; --theme-elements-threeColumn-border-width: 0; --theme-elements-threeColumn-border-style: solid; --theme-elements-threeColumn-border-color: transparent; --theme-elements-threeColumn-heading: #f6f8f7; --theme-elements-threeColumn-padding: 0; --theme-elements-threeColumn-items-text-default: #f6f8f7; --theme-elements-threeColumn-items-text-hover: #edf2ef; --theme-elements-threeColumn-items-shape: rounded; --theme-elements-threeColumn-items-border: 0; --theme-elements-fourUpVideos-background: transparent; --theme-elements-fourUpVideos-border-width: 0; --theme-elements-fourUpVideos-border-style: solid; --theme-elements-fourUpVideos-border-color: transparent; --theme-elements-fourUpVideos-heading: #f6f8f7; --theme-elements-fourUpVideos-padding: 0; --theme-elements-fourUpVideos-items-text-data: #bbc4c4; --theme-elements-fourUpVideos-items-text-default: #f6f8f7; --theme-elements-fourUpVideos-items-text-hover: #edf2ef; --theme-elements-fourUpVideos-items-text-muted: #d3ddd9; --theme-elements-fourUpVideos-items-shape: rounded; --theme-elements-fourUpVideos-items-border: 0; --theme-elements-fourUpVideos-items-scrollbar: #bf1313; --theme-elements-objectBlock-background: transparent; --theme-elements-objectBlock-border-width: 0; --theme-elements-objectBlock-border-style: solid; --theme-elements-objectBlock-border-color: transparent; --theme-elements-objectBlock-heading: #f6f8f7; --theme-elements-objectBlock-padding: 0; --theme-elements-objectBlock-items-text-default: #f6f8f7; --theme-elements-objectBlock-items-text-hover: #edf2ef; --theme-elements-objectBlock-items-text-muted: #d3ddd9; --theme