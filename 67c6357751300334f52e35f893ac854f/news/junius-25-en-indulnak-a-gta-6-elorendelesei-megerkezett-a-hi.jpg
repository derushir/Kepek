that pre-orders will begin on June 25.","contributors":[{"__typename":"Contributor","authorId":101546909,"thumbnailUrl":"https://assets-prd.ignimgs.com/avatars/682ae571844d33001df37887/bafkreidcdvzaebn4npc6hj3ffj6fzlg3kqnfpgazyarf24lfrnboi6lzbe-1747728739638.jpg","id":"7bdc25e3-b432-4a53-b4c0-47985080b1c7","name":"Tom Phillips","nickname":"tomphillipsIGN"}],"vertical":"Games","hrefLangs":{"en-in":"https://in.ign.com/grand-theft-auto-vi/264201/gta-6-cover-artwork-revealed-pre-orders-begin-june-25","en-pk":"https://pk.ign.com/grand-theft-auto-vi-rumored-title/256854/gta-6-cover-artwork-revealed-pre-orders-begin-june-25","pl":"https://pl.ign.com/grand-theft-auto-vi/72299/zaprezentowano-oficjalna-okladke-gry-gta-vi-przedsprzedaz-ruszy-w-przyszlym-tygodniu","en-se":"https://nordic.ign.com/grand-theft-auto-vi/108968/gta-6-cover-artwork-revealed-pre-orders-begin-june-25","pt-br":"https://br.ign.com/grand-theft-auto-vi/153994/rockstar-revela-arte-de-capa-de-gta-6-e-anuncia-data-de-inicio-das-pre-vendas","tr":"https://tr.ign.com/grand-theft-auto-vi/134371/gta-6-kapak-tasarimi-paylasildi-on-siparisler-baslamak-uzere","en-sg":"https://sea.ign.com/grand-theft-auto-vi-rumored-title/244392/gta-6-cover-artwork-revealed-pre-orders-begin-june-25","fr":"https://fr.ign.com/grand-theft-auto-6/89765/lillustration-de-la-jaquette-de-gta-6-a-ete-devoilee-ouverture-des-precommandes-le-25-juin","cs":"https://cz.ign.com/grand-theft-auto-vi/25759/rockstar-odhalil-cover-art-gta-6-predobjednavky-startuji-uz-pristi-tyden","de":"https://de.ign.com/grand-theft-auto-vi/153454/das-cover-von-gta-6-wurde-enthullt-vorbestellungen-starten-am-25-juni"},"eventSlugs":["GTA6"],"events":["GTA6"],"attributes":[{"__typename":"TypedAttribute","type":"Genre","attribute":{"__typename":"Attribute","name":"Action"}},{"__typename":"TypedAttribute","type":"Genre","attribute":{"__typename":"Attribute","name":"Adventure"}},{"__typename":"TypedAttribute","type":"Publisher","attribute":{"__typename":"Attribute","name":"Rockstar Games"}},{"__typename":"TypedAttribute","type":"Producer","attribute":{"__typename":"Attribute","name":"Rockstar Games"}},{"__typename":"TypedAttribute","type":"Platform","attribute":{"__typename":"Attribute","name":"Xbox Series X/S"}},{"__typename":"TypedAttribute","type":"Platform","attribute":{"__typename":"Attribute","name":"PlayStation 5"}},{"__typename":"TypedAttribute","type":"Franchise","attribute":{"__typename":"Attribute","name":"GTA - Grand Theft Auto"}},{"__typename":"TypedAttribute","type":"Genre","attribute":{"__typename":"Attribute","name":"Open-World"}}],"primaryObject":{"__typename":"Object","franchises":[{"__typename":"Attribute","name":"GTA - Grand Theft Auto","slug":"grand-theft-auto"}],"genres":[{"__typename":"Attribute","slug":"action"},{"__typename":"Attribute","slug":"adventure"},{"__typename":"Attribute","slug":"open-world"}],"merchant":null,"affiliateLink":null,"objectRegions":[{"__typename":"ObjectRegion","releases":[{"__typename":"Release","id":"12cfde38-89fc-4e6e-beb2-ad123acc6c4c","date":"2026-11-19","estimatedDate":false,"timeframeYear":null,"platformAttributes":[{"__typename":"Attribute","id":5711233,"name":"PlayStation 5","slug":"ps5"}]},{"__typename":"Release","id":"18d364b9-f6cb-4354-803e-fbbaa4b5981a","date":"2026-11-19","estimatedDate":false,"timeframeYear":null,"platformAttributes":[{"__typename":"Attribute","id":5711232,"name":"Xbox Series X/S","slug":"xbox-4"}]}],"id":2361186,"name":"","region":"US"}],"id":"508c68d5-8685-460c-9578-f4356e9bac59","url":"/games/grand-theft-auto-vi","slug":"grand-theft-auto-vi","type":"Game","metadata":{"__typename":"Metadata","names":{"__typename":"Names","name":"Grand Theft Auto VI","alt":["GTA 6","\nGTA VI","Grand Theft Auto 6"],"short":"GTA 6"}}},"objects":[{"__typename":"Object","id":"508c68d5-8685-460c-9578-f4356e9bac59","url":"/games/grand-theft-auto-vi","slug":"grand-theft-auto-vi","type":"Game","merchant":null,"affiliateLink":null,"metadata":{"__typename":"Metadata","names":{"__typename":"Names","name":"Grand Theft Auto VI","alt":["GTA 6","\nGTA VI","Grand Theft Auto 6"],"short":"GTA 6"}},"objectRegions":[{"__typename":"ObjectRegion","id":2361186,"name":"","region":"US","releases":[{"__typename":"Release","id":"12cfde38-89fc-4e6e-beb2-ad123acc6c4c","date":"2026-11-19","platformAttributes":[{"__typename":"Attribute","id":5711233,"name":"PlayStation 5"}]},{"__typename":"Release","id":"18d364b9-f6cb-4354-803e-fbbaa4b5981a","date":"2026-11-19","platformAttributes":[{"__typename":"Attribute","id":5711232,"name":"Xbox Series X/S"}]}]}],"franchises":[{"__typename":"Attribute","name":"GTA - Grand Theft Auto","slug":"grand-theft-auto"}]}],"seoTitle":"GTA 6 Cover Artwork Revealed, Pre-Orders Begin June 25","ogTitle":"GTA 6 Cover Artwork Revealed, Pre-Orders Begin June 25","nonIndexable":false,"abTests":[{"__typename":"ABTest","id":67853,"represents":"promoTitle","values":["GTA 6 Cover Artwork Revealed, Pre-Orders Begin June 25","Grand Theft Auto 6 Cover Artwork Revealed, Pre-Orders Begin June 25"],"winnerIndex":1}],"sponsorships":[],"contentCategory":{"__typename":"ContentCategory","id":1,"name":"News"},"brand":null,"sequenceNumber":null,"id":"aabb27c5-f44e-4ad4-b8bf-5e10bf58fe39","type":"Article","title":"GTA 6 Cover Artwork Revealed, Pre-Orders Begin June 25 - IGN","subtitle":"Into gear.","promoteAt":null,"publishDate":"2026-06-18T13:07:41.296Z","slug":"gta-6-cover-artwork-revealed-pre-orders-begin-june-25","feedTitle":"GTA 6 Cover Artwork Revealed, Pre-Orders Begin June 25","feedImage":{"__typename":"Image","url":"https://assets-prd.ignimgs.com/2026/06/18/grand-theft-auto-vi-official-cover-art-reveal-00-00-16-1781792192284.png"},"v3Id":null,"url":"/articles/gta-6-cover-artwork-revealed-pre-orders-begin-june-25","heroVideoContentId":null,"heroVideoContentSlug":"","processedHtml":"\u003csection class=\"article-page\"\u003e\u003cp\u003eRockstar has just revealed the cover artwork for \u003ca href=\"https://www.ign.com/games/grand-theft-auto-vi\"\u003eGTA 6\u003c/a\u003e, and announced that pre-orders for the long-awaited blockbuster will finally begin on June 25. \u003c/p\u003e\u003csection data-transform=\"mobile-ad-break\"\u003e\u003c/section\u003e\u003cp\u003eThe game\u0026#39;s artwork was revealed this morning in a brief 30-second teaser video that\u0026#39;s now live on Rockstar\u0026#39;s \u003ca href=\"https://www.youtube.com/watch?v=EiQEBYDox_k\"\u003eYouTube\u003c/a\u003e channel, or you can watch it right below. To be clear, this is not the game\u0026#39;s next trailer — we\u0026#39;re still waiting for that to land at some point. Maybe June 25 is the date for that, too?\u003c/p\u003e\u003cp\u003eRegardless, with fans able to spend money on pre-ordering the game next week, June 25 will be the date we finally discover GTA 6\u0026#39;s price point — something that has been the subject of intense speculation over the past year or so. Will the game launch at $70? $80? Some estimates have suggested it could arrive at as much as $100 to cover the cost of its mammoth development — though the game will surely earn this back over time, in a similar manner to how the hugely-lucrative GTA 5 continues to rake in money even now.\u003c/p\u003e\u003csection data-transform=\"ignvideo\" data-slug=\"gta-6-grand-theft-auto-6-official-cover-art-reveal-video\" data-loop=\"\"\u003e\u003c/section\u003e\u003cp\u003eSpeaking at the video game executive conference iicon in April this year, Strauss Zelnick, the boss of GTA 6 publisher Take-Two Interactive, suggested that his company \u003ca href=\"https://www.ign.com/articles/take-two-ceo-addresses-grand-theft-auto-6-price-and-the-possibility-for-more-la-noire\"\u003ewould keep the game\u0026#39;s cost in check to ensure players felt the price was \u0026quot;fair.\u0026quot;\u003c/a\u003e\u003c/p\u003e\u003cp\u003e\u0026quot;Consumers pay for the value that you bring to them, and our job is to charge way way way less of the value delivery,\u0026quot; Zelnick said. \u0026quot;How you feel about something you buy is the intersection of the thing itself and what you pay for. Consumers need to feel like the thing itself is amazing and the price they were charged was fair for what they got.\u003c/p\u003e\u003cp\u003e\u0026quot;What we think about is making the most spectacular piece of entertainment on Earth, in history – and it’s a pretty daunting challenge,\u0026quot; Zelnick continued. \u0026quot;If we do that, and if we’re of service to our customers, then the upside will take care of itself.”\u003c/p\u003e\u003cp\u003eNow, let\u0026#39;s take a look at that cover art in more detail, via this high-quality version that Rockstar has just shared with IGN:\u003c/p\u003e\u003csection data-transform=\"image-with-caption\" data-image-url=\"https://assets-prd.ignimgs.com/2026/06/18/image001-1781788385585.jpg\" data-image-title=\"undefined\" data-image-class=\"article-image-full-size\" data-image-link=\"https://assets-prd.ignimgs.com/2026/06/18/image001-1781788385585.jpg\" data-caption=\"Grand%20Theft%20Auto%206%26%2339%3Bs%20cover%20art%20has%20been%20revealed.%20Image%20credit%3A%20Rockstar%20Games.\" /\u003e\u003c/section\u003e\u003cp\u003eThe image is of course headlined by GTA 6\u0026#39;s dual protagonists, Lucia Caminos and Jason Duval, sandwiched between a motorbike riding pulling off a trick alongside a cop car, and a helicopter with a minigun strapped to one side. \u003c/p\u003e\u003cp\u003eLower down the cover we see an unknown woman wearing a necklace showing the word \u0026quot;siempre\u0026quot; (meaning \u0026quot;always\u0026quot;). On the right, one of the game\u0026#39;s previously-announced supporting characters is featured: Boobie Ike, a real estate mogul and club owner. \u003c/p\u003e\u003cp\u003eAt the base of the cover it looks like we can see Raul Bautista, a veteran Vice City bank robber who crosses paths with Lucia and Jason, alongside a sports car, a speedboat (and flamingo), plus a hungry-looking alligator. \u003c/p\u003e\u003cp\u003eThe image seeks to establish the game\u0026#39;s core concepts and characters: being able to tote guns and drive all sorts of vehicles across an urban environment, but also head out into the open world, where wild animals roam.\u003c/p\u003e\u003cp\u003eFor more on what could the biggest video game launch in history, check out the latest on the \u003ca href=\"https://www.ign.com/articles/take-two-appears-unaffected-by-rockstar-hack\"\u003estolen data from the Rockstar hack saga\u003c/a\u003e and Zelnick\u0026#39;s comments on \u003ca href=\"https://www.ign.com/articles/take-two-ceo-denies-rumors-that-gta-6-will-be-digital-only-at-launch\"\u003eGTA 6 being a digital-only release\u003c/a\u003e. GTA 6 is set to launch on November 19, 2026 for PlayStation 5 and Xbox Series X/S, and we\u0026#39;ll be keeping up with everything leading up its release.\u003c/p\u003e\u003cp\u003e\u003c/p\u003e\u003csection data-transform=\"divider\"\u003e\u003c/section\u003e\u003cp\u003e\u003cem\u003eTom Phillips is IGN\u0026#39;s News Editor. You can reach Tom at tom_phillips@ign.com or find him on Bluesky \u003c/em\u003e\u003ca href=\"https://bsky.app/profile/tomphillipseg.bsky.social\"\u003e@tomphillipseg.bsky.social\u003c/a\u003e\u003c/p\u003e\u003c/section\u003e","showCommerceDisclaimer":false,"review":null,"articleId":"aabb27c5-f44e-4ad4-b8bf-5e10bf58fe39","isCommunity":"no","resource":"article","pageType":"article","twitterCard":"summary_large_image","hasAds":true,"extraAds":false,"isPreview":false,"pageTitle":"GTA 6 Cover Artwork Revealed, Pre-Orders Begin June 25","image":"https://assets-prd.ignimgs.com/2026/06/18/grand-theft-auto-vi-official-cover-art-reveal-00-00-16-1781792192284.png?width=1280\u0026format=jpg\u0026auto=webp\u0026quality=80","description":"Rockstar has just revealed the cover artwork for GTA 6, and announced that pre-orders will begin on June 25.","category":"News","categories":["News"],"objectId":"508c68d5-8685-460c-9578-f4356e9bac59","objectSlug":"grand-theft-auto-vi","genreSlugs":["action","adventure","open-world"],"platforms":["PlayStation 5","Xbox Series X/S"],"platformSlugs":["ps5","xbox-4"],"franchiseNames":["GTA - Grand Theft Auto"],"editPage":{"type":"article","params":{"id":"aabb27c5-f44e-4ad4-b8bf-5e10bf58fe39"}},"additionalDataLayer":{"content":{"contentId":"aabb27c5-f44e-4ad4-b8bf-5e10bf58fe39","objectIds":["508c68d5-8685-460c-9578-f4356e9bac59"]}},"commercePage":false,"articleType":"News","schema":[{"@context":"http://schema.org/","mainEntityOfPage":{"@type":"WebPage","@id":"https://www.ign.com/articles/gta-6-cover-artwork-revealed-pre-orders-begin-june-25"},"image":["https://assets-prd.ignimgs.com/2026/06/18/grand-theft-auto-vi-official-cover-art-reveal-00-00-16-1781792192284.png?width=1200\u0026canvas=1200%2C1200\u0026format=jpg\u0026auto=webp\u0026quality=80","https://assets-prd.ignimgs.com/2026/06/18/grand-theft-auto-vi-official-cover-art-reveal-00-00-16-1781792192284.png?width=1200\u0026canvas=1200%2C900\u0026format=jpg\u0026auto=webp\u0026quality=80","https://assets-prd.ignimgs.com/2026/06/18/grand-theft-auto-vi-official-cover-art-reveal-00-00-16-1781792192284.png?width=1280\u0026canvas=1280%2C720\u0026format=jpg\u0026auto=webp\u0026quality=80"],"url":"https://www.ign.com/articles/gta-6-cover-artwork-revealed-pre-orders-begin-june-25","description":"Rockstar has just revealed the cover artwork for GTA 6, and announced that pre-orders will begin on June 25.","@type":"NewsArticle","datePublished":"2026-06-18T13:07:41.296Z","headline":"GTA 6 Cover Artwork Revealed, Pre-Orders Begin June 25","publisher":{"@id":"https://www.ign.com/#organization"},"author":{"@type":"Person","name":"Tom Phillips","url":"https://www.ign.com/person/tomphillipsIGN"},"dateModified":"2026-06-18T15:29:30.152Z"},{"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"item":{"@id":"https://www.ign.com/","name":"Home"}},{"@type":"ListItem","position":2,"item":{"@id":"h