n-button sidebar-toggle contained centered small" data-cy="sidebar-toggle" type="button" title="Toggle Sidebar" tabindex="0"><span class="ign-icon left-chevron jsx-2750866048 jsx-3782449470" role="presentation" aria-hidden="true" data-cy="left-chevron" style="mask:url(https://kraken.ignimgs.com/_next/static/media/LeftChevron.c64b87f1.svg?cors=1) no-repeat center center / contain;background:currentColor"></span></button><span class="stack jsx-3236076941 jsx-1627515930 logo-container"><a href="/" data-cy="logo-link" title="IGN" class="logo-link" tabindex="-1"><img src="https://assets1.ignimgs.com/kraken/ign30-logo-alt.png?width=96&amp;auto=webp" srcSet="https://assets1.ignimgs.com/kraken/ign30-logo-alt.png?width=192&amp;auto=webp 2x" alt="IGN Logo" data-cy="icon-logo" class="ign-icon icon-logo light jsx-495676280"/><img src="https://assets1.ignimgs.com/kraken/ign30-logo.png?width=96&amp;auto=webp" srcSet="https://assets1.ignimgs.com/kraken/ign30-logo.png?width=192&amp;auto=webp 2x" alt="IGN Logo" data-cy="icon-logo" class="ign-icon icon-logo dark jsx-495676280"/></a><div class="doodle jsx-3562710790 empty"></div></span></span></div><div class="jsx-2155806329 adunit-wrapper"><div class="jsx-2155806329 bobble bobble- pogocnt pg-article"><div data-mix-name="fourBy" data-pos="" data-pogo-hide="1" class="jsx-343126785 pogo-slot"></div></div></div></header><main data-cy="page-main-content" id="main-content" class="jsx-1166515047"><div class="jsx-2155806329 adunit-wrapper"><div class="jsx-2155806329 bobble bobble-0 pogocnt pg-article"><div data-pogo="top" data-mix-name="leaderboardOnly" data-pos="0" class="jsx-343126785 top pogo-slot"></div></div></div><div data-cy="page-header" class="jsx-3209398698 page-header page-content short"><div class="interface jsx-326752785 stack jsx-2959124702 jsx-2128362915 bold small"><a href="/games/grand-theft-auto-vi" class="link jsx-1337145738 jsx-3299197477 article-object-link underlined" data-cy="object-breadcrumb">GTA 6</a></div><h1 class="display-title jsx-684634384 jsx-560310519" data-cy="article-headline">GTA 6 Cover Artwork Revealed, Pre-Orders Begin June 25</h1><h2 data-cy="article-sub-headline" class="title3 jsx-12333944 jsx-37621054">Into gear.</h2></div><div class="jsx-264942055 page-content"><section class="jsx-2162140478 byline"><span class="stack jsx-59817748 jsx-702910195 byline-stack"><span class="stack jsx-3647836811 jsx-4269505506 article-authors"><section data-cy="author-avatars" class="jsx-1825775112 author-avatars avatars-1"><div class="rounded jsx-444076027 jsx-4218469134 author-thumb profile-thumb jsx-3097962137 aspect-ratio aspect-ratio-1-1"><img alt="Tom Phillips Avatar" decoding="async" class="progressive-image profile-thumb-img jsx-249361588 jsx-2338608387 expand" loading="lazy" src="https://assets-prd.ignimgs.com/avatars/682ae571844d33001df37887/bafkreidcdvzaebn4npc6hj3ffj6fzlg3kqnfpgazyarf24lfrnboi6lzbe-1747728739638.jpg?crop=1%3A1&amp;width=21&amp;format=jpg&amp;auto=webp&amp;quality=80" srcSet="https://assets-prd.ignimgs.com/avatars/682ae571844d33001df37887/bafkreidcdvzaebn4npc6hj3ffj6fzlg3kqnfpgazyarf24lfrnboi6lzbe-1747728739638.jpg?crop=1%3A1&amp;width=21&amp;format=jpg&amp;auto=webp&amp;quality=80 1x, https://assets-prd.ignimgs.com/avatars/682ae571844d33001df37887/bafkreidcdvzaebn4npc6hj3ffj6fzlg3kqnfpgazyarf24lfrnboi6lzbe-1747728739638.jpg?crop=1%3A1&amp;width=21&amp;dpr=2&amp;format=jpg&amp;auto=webp&amp;quality=80 2x" data-cy="progressive-image"/></div></section><div data-cy="caption" class="caption jsx-1762799490">By <a href="/person/tomphillipsIGN" class="link jsx-1337145738 article-author underlined" data-cy="article-author">Tom Phillips</a></div></span><div class="jsx-3449795453 divider jsx-428691023"></div><div data-cy="caption" class="caption jsx-1762799490 byline-date">Updated<!-- -->: <time dateTime="2026-06-18T15:29:30Z">Jun 18, 2026 3:29pm UTC</time></div><div class="jsx-3449795453 divider jsx-428691023"></div><div data-cy="caption" class="caption jsx-1762799490"><a class="link jsx-1337145738 jsx-2474574152 underlined" data-cy="styled-link" href="/articles/gta-6-cover-artwork-revealed-pre-orders-begin-june-25#comments"><span class="stack jsx-3647836811"><span class="ign-icon icon-comment jsx-2750866048 jsx-4173866675" role="img" aria-hidden="false" data-cy="icon-comment" aria-label="Comments" style="mask:url(https://kraken.ignimgs.com/_next/static/media/Comment.e2c389d0.svg?cors=1) no-repeat center center / contain;background:currentColor"></span>287 comments</span></a></div></span><div class="jsx-3449795453 divider jsx-3709034244"></div></section></div><div class="jsx-2870106660 page-content"><div class="jsx-2870106660 side-by-side"><div data-cy="article-content" class="jsx-2870106660 article-content page-0"><section data-cy="article-subtitle" class="article jsx-3932497636 article-section jsx-862658659 news" data-autopogo="true"><section class="article-page"><p data-cy="paragraph" class="paragraph jsx-2269604527">Rockstar has just revealed the cover artwork for <a class="link jsx-1337145738 jsx-3925284146 underlined" data-cy="styled-link" href="/games/grand-theft-auto-vi">GTA 6</a>, and announced that pre-orders for the long-awaited blockbuster will finally begin on June 25. </p><p></p><p data-cy="paragraph" class="paragraph jsx-2269604527">The game&#x27;s artwork was revealed this morning in a brief 30-second teaser video that&#x27;s now live on Rockstar&#x27;s <a href="https://www.youtube.com/watch?v=EiQEBYDox_k" class="link jsx-1337145738 jsx-3925284146 underlined" data-cy="styled-link" target="_blank" rel="noopener noreferrer">YouTube</a> channel, or you can watch it right below. To be clear, this is not the game&#x27;s next trailer — we&#x27;re still waiting for that to land at some point. Maybe June 25 is the date for that, too?</p><p data-cy="paragraph" class="paragraph jsx-2269604527">Regardless, with fans able to spend money on pre-ordering the game next week, June 25 will be the date we finally discover GTA 6&#x27;s price point — something that has been the subject of intense speculation over the past year or so. Will the game launch at $70? $80? Some estimates have suggested it could arrive at as much as $100 to cover the cost of its mammoth development — though the game will surely earn this back over time, in a similar manner to how the hugely-lucrative GTA 5 continues to rake in money even now.</p><output class="box-wrapper jsx-2673806401" data-cy="article-video"><div class="jsx-2896921488 video jsx-2008855984 aspect-ratio aspect-ratio-16-9"><div class="badge jsx-1349606671 jsx-3647116352"><span class="ign-icon icon-play jsx-2750866048 jsx-1044454891" role="img" aria-hidden="false" data-cy="icon-play" aria-label="Play" style="mask:url(https://kraken.ignimgs.com/_next/static/media/Play.59e5540b.svg?cors=1) no-repeat center center / contain;background:currentColor"></span></div></div></output><p data-cy="paragraph" class="paragraph jsx-2269604527">Speaking at the video game executive conference iicon in April this year, Strauss Zelnick, the boss of GTA 6 publisher Take-Two Interactive, suggested that his company <a class="link jsx-1337145738 jsx-3925284146 underlined" data-cy="styled-link" href="/articles/take-two-ceo-addresses-grand-theft-auto-6-price-and-the-possibility-for-more-la-noire">would keep the game&#x27;s cost in check to ensure players felt the price was &quot;fair.&quot;</a></p><p data-cy="paragraph" class="paragraph jsx-2269604527">&quot;Consumers pay for the value that you bring to them, and our job is to charge way way way less of the value delivery,&quot; Zelnick said. &quot;How you feel about something you buy is the intersection of the thing itself and what you pay for. Consumers need to feel like the thing itself is amazing and the price they were charged was fair for what they got.</p><p data-cy="paragraph" class="paragraph jsx-2269604527">&quot;What we think about is making the most spectacular piece of entertainment on Earth, in history – and it’s a pretty daunting challenge,&quot; Zelnick continued. &quot;If we do that, and if we’re of service to our customers, then the upside will take care of itself.”</p><p data-cy="paragraph" class="paragraph jsx-2269604527">Now, let&#x27;s take a look at that cover art in more detail, via this high-quality version that Rockstar has just shared with IGN:</p><output class="box-wrapper jsx-2673806401"><figure class="jsx-313219616"><a href="https://assets-prd.ignimgs.com/2026/06/18/image001-1781788385585.jpg" target="_blank" rel="noopener noreferrer"><img alt="" aria-hidden="true" decoding="async" role="presentation" class="progressive-image article-image article-image-full-size jsx-1809694635 jsx-2338608387" loading="lazy" src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7" data-cy="progressive-image"/></a><figcaption data-cy="caption" class="caption jsx-1762799490 jsx-479945570 article-image-caption">Grand Theft Auto 6&#x27;s cover art has been revealed. Image credit: Rockstar Games.</figcaption></figure></output><p data-cy="paragraph" class="paragraph jsx-2269604527">The image is of course headlined by GTA 6&#x27;s dual protagonists, Lucia Caminos and Jason Duval, sandwiched between a motorbike riding pulling off a trick alongside a cop car, and a helicopter with a minigun strapped to one side. </p><p data-cy="paragraph" class="paragraph jsx-2269604527">Lower down the cover we see an unknown woman wearing a necklace showing the word &quot;siempre&quot; (meaning &quot;always&quot;). On the right, one of the game&#x27;s previously-announced supporting characters is featured: Boobie Ike, a real estate mogul and club owner. </p><p data-cy="paragraph" class="paragraph jsx-2269604527">At the base of the cover it looks like we can see Raul Bautista, a veteran Vice City bank robber who crosses paths with Lucia and Jason, alongside a sports car, a speedboat (and flamingo), plus a hungry-looking alligator. </p><p data-cy="paragraph" class="paragraph jsx-2269604527">The image seeks to establish the game&#x27;s core concepts and characters: being able to tote guns and drive all sorts of vehicles across an urban environment, but also head out into the open world, where wild animals roam.</p><p data-cy="paragraph" class="paragraph jsx-2269604527">For more on what could the biggest video game launch in history, check out the latest on the <a class="link jsx-1337145738 jsx-3925284146 underlined" data-cy="styled-link" href="/articles/take-two-appears-unaffected-by-rockstar-hack">stolen data from the Rockstar hack saga</a> and Zelnick&#x27;s comments on <a class="link jsx-1337145738 jsx-3925284146 underlined" data-cy="styled-link" href="/articles/take-two-ceo-denies-rumors-that-gta-6-will-be-digital-only-at-launch">GTA 6 being a digital-only release</a>. GTA 6 is set to launch on November 19, 2026 for PlayStation 5 and Xbox Series X/S, and we&#x27;ll be keeping up with everything leading up its release.</p><div data-cy="accent-divider" class="jsx-3449795453 divider jsx-2786329600"></div><p data-cy="paragraph" class="paragraph jsx-2269604527"><em>Tom Phillips is IGN&#x27;s News Editor. You can reach Tom at tom_phillips@ign.com or find him on Bluesky </em><a href="https://bsky.app/profile/tomphillipseg.bsky.social" class="link jsx-1337145738 jsx-3925284146 underlined" data-cy="styled-link" target="_blank" rel="noopener noreferrer">@tomphillipseg.bsky.social</a></p></section></section><span class="stack jsx-1475529924"><div class="jsx-2155806329 adunit-wrapper"><div class="jsx-2155806329 bobble bobble-1 pogocnt pg-article"><div data-mix-name="secondaryMedrec" data-pos="1" data-pogo-hide="1" class="jsx-343126785 pogo-slot"></div></div></div></span></div><div class="jsx-2870106660 right-rail"><div class="jsx-448876066 sticky-wrapper"><div class="jsx-2155806329 adunit-wrapper"><div class="jsx-2155806329 bobble bobble-0 pogocnt pg-article"><div data-pogo="sidebar" data-mix-name="tallAd" data-pos="0" class="jsx-3431267