listingBoxSlug":32},[412],[413],"fesztival",1783415160,"https://track.adform.net/adfserve/?bn=89464206;1x1inv=1;srctype=3;gdpr=${GDPR};gdpr_consent=${GDPR_CONSENT_50};ord=[timestamp]","https://track.adform.net/C/?bn=89464206;gdpr=${GDPR};gdpr_consent=${GDPR_CONSENT_50}","Lépni neked kell. Higgy magadban!","erste-line-b",{"active":8,"sites":32,"mainSuperTags":32,"tags":420,"dateFrom":414,"dateTo":423,"avCode":424,"ctLink":425,"description":426,"cssClass":427,"listPage":9,"newest":9,"frontPageSlug":428,"listingBoxSlug":32},[421],[422],"idojaras",1790805540,"https://securepubads.g.doubleclick.net/gampad/adx?iu=/22386506929/idojaras_szponzor_AV-CT&sz=1x1&c=[TIMESTAMP]&d_imp=1&d_imp_hdr=1","https://pubads.g.doubleclick.net/gampad/clk?id=7364469752&iu=/22386506929/idojaras_szponzor_AV-CT","Hamilton klímák már 173.000 Ft-tól","hamilton-line","idokep",[],{"tests":-1,"myVariants":431},{},{"remotePipData":32,"showVideo":9,"isNano":9,"isFinishing":9,"forceClosed":9,"hideSwitchToLive":9,"preOpenPip":9,"isTeleportableAutoPlacemenModeEnabled":9,"isTeleportableManualToggleEnable":8,"isTeleportableAnimationEnable":9,"isTeleportableActive":9,"isTeleportedToPip":9,"isTeleportSupported":8,"isTeleportablePlaying":9,"teleportableTitle":50,"teleportableWildernessAnchor":50,"teleportableVideoUrl":50,"teleportableArticleSlug":50,"teleportableVideoTitle":50,"teleportableArticleVersion":32},{"isSupportLinkBlocked":9},{"article":435,"page":32,"subArticles":32,"childArticles":32,"dashboard":32,"hasSponsoredLine":8},{"id":436,"type":38,"title":437,"pubDate":438,"updatedAt":438,"deletedAt":32,"version":439,"slug":440,"articleAuthors":441,"lead":32,"mainSuperTag":449,"superTags":452,"flags":453,"live":9,"recommendedBoxImage":454,"mobileImage43":455,"mobileImage11":456,"active":8,"rank":66,"mirroringSites":457,"recommender":458,"colorClass":32,"coverEmbed":32,"coverEmbedTitle":32,"allowCoverEmbedForClk":9,"parent":32,"speech":459,"originatingSite":17,"subType":460,"subtitle":32,"headerType":32,"minute":32,"coverImage":461,"coverImageText":32,"facebookImage":462,"resizedRecommendedBoxImage":454,"coverImageSet":463,"content":464,"paragraphCount":465,"articleContributors":466,"tags":467,"avCode":32,"ogDescription":458,"actions":478,"contextTitle":32,"contextLead":32,"livescoreId":32,"relatedArticles":480,"facebookTitle":437},197559,"Ritkán lehet látni, hogy Messit ennyire elragadják az érzelmei",1783449767,1783453414,"lionel-messit-elragadtak-az-erzelmek-argentina-egyiptom",[442],{"id":443,"authorId":444,"name":445,"email":446,"slug":447,"avatarSrc":448,"position":51,"information":32,"title":50,"facebookUrl":32,"linkedinUrl":32,"organization":32},230989,39,"Fehér János","feherj@telex.hu","feher-janos","https://assets.telex.hu/images/0_szerzok/kis_avatar/_JO_2706_avatar.jpg",{"id":450,"name":214,"slug":451,"siteSlug":17,"active":8},11,"sport",[],[],"https://assets.telex.hu/images/20260707/1783449310-temp-t9qbl0pga995fbkjoej_cimlap-normal.jpg","https://assets.telex.hu/images/20260707/1783449311-temp-hsjlnpemi0o3bikmojf_cimlap-normal-4per3.jpg","https://assets.telex.hu/images/20260707/1783449312-temp-f8hgosekq35d3kjogmn_cimlap-normal-1per1.jpg",[17],"Az argentinok csapatkapitánya mélyen átélte a futball-vb eddigi legnagyobb fordítását. Gólja óriási energiákat szabadított fel benne.","https://audio-assets.telex.hu/20260707/1783453412-70k7d8kdfe768mfppad.mp3","N","https://assets.telex.hu/images/20260707/1783449328-temp-esvd1p4u3jcg1ckdboc_cover.jpg","https://assets.telex.hu/images/20260707/1783449309-temp-rlfd88tngb98eelkopj_facebook.jpg","https://assets.telex.hu/images/20260707/1783449328-temp-esvd1p4u3jcg1ckdboc_cover@1x.jpg 1x, https://assets.telex.hu/images/20260707/1783449328-temp-esvd1p4u3jcg1ckdboc_cover@2x.jpg 2x, https://assets.telex.hu/images/20260707/1783449328-temp-esvd1p4u3jcg1ckdboc_cover@3x.jpg 3x, https://assets.telex.hu/images/20260707/1783449328-temp-esvd1p4u3jcg1ckdboc_cover@4x.jpg 4x","\u003Cp>\u003Cnuxt-link to=\"/sport/2026/07/07/argentina-egyiptom-vb-nyolcaddonto-osszefoglalo\">Az Argentína–Egyiptom világbajnoki nyolcaddöntőn\u003C/nuxt-link> sokáig úgy nézett ki, hogy kikapnak az argentinok, amivel Lionel Messi vb-karrierje is véget érhetett volna. A 39 éves játékos viszont egy pillanatra sem adta fel, és igazi vezérként vitte győzelemre csapatát.\u003C/p>\u003Cp>Az argentin kapitány nem volt könnyű helyzetben, mert mindjárt a meccs elején kihagyott egy 11-est, ennek a terhét is cipelte, és az egyiptomiak kétgólos előnybe kerültek. A szépítő gólt a 79. percben szerezték az argentinok, amikor Messi beívelése után Cristian Romero kapuba fejelt. Ezután óriási tűzzel játszottak, és néhány perc múlva már Messi is betalált. Gólja után óriási érzelmek szabadultak fel benne, a levegőbe csapkodott és ugrált, ritkán lehetett látni eddig így ünnepelni.\u003C/p>\u003Cp class=\"ad\" data-index=\"1\">\u003Cplaceholder-view :english=\"false\" class=\"placeholder ad\" content-type=\"ad\" :index=\"1\"> \u003C/placeholder-view>\u003C/p>\u003Cp>Miután Argentína a győztes gólt is megszerezte, Messi elérzékenyült, meg is könnyezte az eredményt, majd a végén mosolygósan szaladozott a pályán.\u003C/p>\u003Cfigure class=\"media\">\u003Coembed url=\"https://www.instagram.com/p/DagH72RIEzy/\">\u003C/oembed>\u003C/figure>\u003Cp>Társai is átérezték, hogy Messi karrierjében is nagy mérföldkő ez a mérkőzés, és a levegőbe dobálva ünnepelték a csapatkapitányukat.\u003C/p>\u003Cadvanced-image pic-type=\"normal\" pic1=\"https://assets.telex.hu/images/20260707/1783449566-temp-idcap8ffv5p38gdiblf_cikktorzs.jpg\" pic2=\"\" pic3=\"\" pic4=\"\" image-alt=\"Lionel Messit dobálják a levegőbe argentin csapattársai – Fotó: Carlos Barria / Reuters\" align=\"top\" vertical=\"true\"> \u003C/advanced-image>\u003Cp>Messi a mostani világbajnokság mind az öt meccsén betalált, és nyolc találatával a góllövőlista élén áll.\u003C/p>\u003Cp class=\"ad\" data-index=\"2\">\u003Cplaceholder-view :english=\"false\" class=\"placeholder ad\" content-type=\"ad\" :index=\"2\">AD!!!!\u003C/placeholder-view>\u003C/p>\n",10,[],[468,471,475],{"id":469,"name":470,"slug":470},188,"futball",{"id":472,"name":473,"slug":474},1673,"Lionel Messi","lionel-messi",{"id":476,"name":477,"slug":382},25213,"foci-vb 2026",{"recommended":479},"/api/recommended/mstag/all{?v}",[],{"quizzes":482,"answers":483},[],[],{"fixture":32,"sidebarItems":485},[486,491,497,503,509,515,521],{"id":487,"label1":488,"to":113,"icon":489,"matchRouteName":490},"homepage","Címlap","mdi mdi-home-variant-outline","cimlap",{"id":492,"label1":493,"to":494,"icon":495,"matchRouteName":496},"articles","Cikkek","/melleklet/foci-vb-2026","mdi mdi-newspaper-variant-outline","cikkek",{"id":498,"label1":499,"to":500,"icon":501,"matchRouteName":502},"timeline","Mérkőzések","/melleklet/foci-vb-2026/merkozesek","mdi mdi-table-clock","merkozesek",{"id":504,"label1":505,"to":506,"icon":507,"matchRouteName":508},"elimination","Rájátszás","/melleklet/foci-vb-2026/rajatszas","mdi mdi-tournament","rajatszas",{"id":510,"label1":511,"to":512,"icon":513,"matchRouteName":514},"groups","Csoportok","/melleklet/foci-vb-2026/csoportok","mdi mdi-scoreboard-outline","csoportok",{"id":516,"label1":517,"to":518,"icon":519,"matchRouteName":520},"toplists","Toplisták","/melleklet/foci-vb-2026/toplistak","mdi mdi-format-list-bulleted","toplistak",{"id":522,"label1":523,"to":524,"icon":525,"matchRouteName":526},"squads","Játékoskeretek","/melleklet/foci-vb-2026/keretek","mdi mdi-account-group-outline","keretek",{"user":32,"subscriptions":32,"subscriptionsInited":9,"showProfileModal":9,"userChecked":9},{"visible":9,"minimalized":51,"episode":32,"playing":9,"autoPlay":8},{"recommenderBoxVersions":530,"random":32,"special":32,"breaking":32,"important":32,"newest":32,"favorite":32,"pr":32,"after":32,"g7":32,"karakter":32},[],{"imageItems":532,"subImageItems":533,"quizImageItems":534,"otherImageItems":535,"imageIndex":32,"isGallery":9,"lastImageThumb":32},[],[],[],[]]</script></body></html>