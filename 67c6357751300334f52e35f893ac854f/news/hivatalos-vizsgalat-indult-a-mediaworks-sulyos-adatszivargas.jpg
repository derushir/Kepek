cdn.hu/kraken/6mcaIUIiQDMX3E3Ea.gif?width=96\u0026height=96\u0026fit=crop","slug":"szily"},"Category:3f5635b8-c99f-47fd-a51a-c257ef14c011":{"__typename":"Category","id":"3f5635b8-c99f-47fd-a51a-c257ef14c011","slug":"internet","name":"INTERNET","description":"","url":"https://444.hu/category/internet"},"Article:a64e85db-a387-55ea-9cb0-6d3fafd3c244":{"__typename":"Article","id":"a64e85db-a387-55ea-9cb0-6d3fafd3c244","title":"Feltörték a Mediaworksöt, rengeteg adatukat tették ki a dark webre","slug":"feltortek-a-mediaworksot-rengeteg-adatukat-tettek-ki-a-dark-webre","featuredImage":{"__ref":"MediaItem:b6272ad3-4396-57e3-abc8-42455c7adc12"},"excerpt":"Vannak közöttük szerződések, kimutatások, bérjegyzékek, belső üzenetek is.","publishedAt":"2026-04-30T19:58:43+02:00","createdAt":"2026-04-30T19:58:46+02:00","authors":[{"__ref":"Author:903f72f5-d8b3-47e5-9755-eb92e76e7b1f"}],"categories":[{"__ref":"Category:3f5635b8-c99f-47fd-a51a-c257ef14c011"}],"collections":[],"bucket":{"__ref":"Bucket:70b47701-2c71-55dc-95b1-7ac5be6b8a21"},"options":[{"__typename":"Option","key":"template","value":""},{"__typename":"Option","key":"language","value":"hu"},{"__typename":"Option","key":"color_scheme","value":""},{"__typename":"Option","key":"is_anonym","value":false},{"__typename":"Option","key":"background_shadow","value":false},{"__typename":"Option","key":"title_inner","value":false},{"__typename":"Option","key":"lead_av","value":""},{"__typename":"Option","key":"jumbotron","value":""},{"__typename":"Option","key":"external_url","value":""},{"__typename":"Option","key":"title_alignment","value":""},{"__typename":"Option","key":"comments_enabled","value":true},{"__typename":"Option","key":"stream","value":true}],"format":{"__ref":"Format:7a6036e1-c587-11f0-9297-525400d76232"},"partners":[],"url":"https://444.hu/2026/04/30/feltortek-a-mediaworksot-rengeteg-adatukat-tettek-ki-a-dark-webre"},"Article:58e142f6-0e1e-5044-9ab9-48af59dd5283":{"__typename":"Article","id":"58e142f6-0e1e-5044-9ab9-48af59dd5283","featuredImage":{"__ref":"MediaItem:7a8bc1f8-4606-5a08-b008-46155aeed585"},"title":"Vizsgálatot indít az adatvédelmi hatóság a Mediaworks adatlopási ügyében","body":[[{"type":"core/paragraph","params":{},"content":"A Nemzeti Adatvédelmi és Információszabadság Hatóság hivatalból vizsgálatot indít a Mediaworks adatvédelmi incidensével kapcsolatban. "},{"type":"core/paragraph","params":{},"content":"Közleményük szerint a sajtóban megjelent információk alapján szereztek tudomást arról, hogy a World Leaks nevű, zsarolásra specializálódott hackercsoport csaknem 15 millió fájlt, összesen mintegy 8,5 terabájtnyi adatot \u003ca href=\"https://444.hu/2026/04/30/feltortek-a-mediaworksot-rengeteg-adatukat-tettek-ki-a-dark-webre\" \u003eszerzett meg jogellenesen\u003c/a\u003e a fideszes médiaholding rendszeréből és tett közzé a darkweben. A nyilvánosságra hozott fájlok nagy része régebbi, de vannak újak is, közöttük bérjegyzékek, szerződések, kimutatások, belső üzenetek is."},{"type":"image","params":{"src":"https://4cdn.hu/kraken/image/upload/s--jeGUyKEU--/c_limit,w_760/7bmknw5wXQ1ii8TQs.jpeg","id":"7a8bc1f8-4606-5a08-b008-46155aeed585","showauthor":"true","alt":"","link":"","mediaItem":{"caption":"Péterfalvi Attila, a Nemzeti Adatvédelmi és Információszabadság Hatóság elnöke.","author":"Koszticsák Szilárd/MTI/MTVA","url":"https://assets.4cdn.hu/kraken/7bmknw5wXQ1ii8TQs.jpeg","creditType":"Fotó","sourceLink":null,"bucket":{"id":"70b47701-2c71-55dc-95b1-7ac5be6b8a21","slug":"444","name":"444","__typename":"Bucket"},"__typename":"Image","id":"7a8bc1f8-4606-5a08-b008-46155aeed585","width":2736,"height":1824,"variations":[{"url":"https://assets.4cdn.hu/kraken/7bmknw5wXQ1ii8TQs-xxs.jpeg","size":"xxs","width":96,"height":64,"__typename":"ImageVariation"},{"url":"https://assets.4cdn.hu/kraken/7bmknw5wXQ1ii8TQs-xs.jpeg","size":"xs","width":360,"height":240,"__typename":"ImageVariation"},{"url":"https://assets.4cdn.hu/kraken/7bmknw5wXQ1ii8TQs-sm.jpeg","size":"sm","width":640,"height":427,"__typename":"ImageVariation"},{"url":"https://assets.4cdn.hu/kraken/7bmknw5wXQ1ii8TQs-md.jpeg","size":"md","width":768,"height":512,"__typename":"ImageVariation"},{"url":"https://assets.4cdn.hu/kraken/7bmknw5wXQ1ii8TQs-lg.jpeg","size":"lg","width":1366,"height":911,"__typename":"ImageVariation"},{"url":"https://assets.4cdn.hu/kraken/7bmknw5wXQ1ii8TQs-xl.jpeg","size":"xl","width":1920,"height":1280,"__typename":"ImageVariation"},{"url":"https://assets.4cdn.hu/kraken/7bmknw5wXQ1ii8TQs-xxl.jpeg","size":"xxl","width":2560,"height":1707,"__typename":"ImageVariation"}]}},"content":"Péterfalvi Attila, a Nemzeti Adatvédelmi és Információszabadság Hatóság elnöke."},{"type":"core/paragraph","params":{},"content":"A NAIH szerint a dokumentumok között vannak, amelyek nagy számban személyes adatokat (neveket, lakcímeket, bankszámla adatokat), valamint közérdekű és közérdekből nyilvános adatokat is tartalmaznak. Azt írták, megalapozottan állítható, hogy ez a magatartás személyes adatok jogellenes kezelését valósíthatja meg, ezért hivatalból vizsgálatot indítanak, és ennek eredményétől függően megteszik a szükséges további intézkedéseket."},{"type":"core/blockquote","params":{},"content":"\u003cp \u003e„A Hatóság, ahogyan azt a Tisza Párt adatvédelmi incidense kapcsán is tette, nyomatékosan felhívja a figyelmet arra, hogy amennyiben a Mediaworks Hungary Zrt. adatvédelmi incidenséről – mint közérdekű ügyről – a sajtó beszámol, tartózkodjon attól, hogy közölje a jogellenesen nyilvánosságra hozott személyes adatok internetes elérhetőségét”\u003c/p\u003e"},{"type":"core/paragraph","params":{},"content":"– figyelmeztettek. Miközben a Tisza Világ applikáció feltörésekor még arról beszélt Péterfalvi Attila NAIH-elnök, hogy a pártnak is felelőssége lehet az „adatszivárgásban”, most ilyenre nem tértek ki."},{"type":"core/paragraph","params":{},"content":"A hétvégén a Mediaworks honlapját is \u003ca href=\"https://444.hu/2026/05/03/meghekkeltek-a-mediaworks-oldalat\" \u003emeghekkelték\u003c/a\u003e, az oldalon több helyen csak Gulyás Gergely fotója és a „\u003ca href=\"https://444.hu/2024/03/26/roganek-kiadtak-a-jelszot-kipukkadt-a-lufi\" target=\"_blank\" \u003ekipukkadt a lufi”\u003c/a\u003e szöveg volt látható."}]],"slug":"vizsgalatot-indit-az-adatvedelmi-hatosag-a-mediaworks-adatlopasi-ugyeben","publishedAt":"2026-05-04T12:32:39+02:00","bucket":{"__ref":"Bucket:70b47701-2c71-55dc-95b1-7ac5be6b8a21"},"excerpt":"Azt írták, a sajtóból értesültek a hekkertámadásról.","createdAt":"2026-05-04T12:32:42+02:00","updatedAt":"2026-05-04T12:38:43+02:00","authors":[{"__ref":"Author:81f4709f-24b4-428b-881a-b7e98cd216bc"}],"categories":[{"__ref":"Category:b722e920-44ed-4c26-bca0-2ac8fc0cd644"}],"tags":[{"__ref":"Tag:29e989ca-8281-4082-af7f-a788e45ef36a"},{"__ref":"Tag:30277029-c4e8-4f6c-9a84-4541762b877e"},{"__ref":"Tag:4f7073c1-0291-4439-ab7b-e9d35e06441c"},{"__ref":"Tag:81a06bbf-fffb-4d82-80af-73e44d4b285e"},{"__ref":"Tag:9b176caf-b5dd-40bc-a5cb-2deaba7ba60a"},{"__ref":"Tag:a1831f9d-1cef-42f2-9c1a-e223c883716e"},{"__ref":"Tag:bdbca947-9fa7-4667-968f-18fb1bc982d0"},{"__ref":"Tag:cd8fa4fd-150a-4c27-8f7f-5fa3157788cf"},{"__ref":"Tag:f23c4d05-b47d-5268-81bb-a87ddc75c7a3"}],"collections":[],"meta":[{"__typename":"Meta","key":"description","value":""},{"__typename":"Meta","key":"excerpt","value":"Azt írták, a sajtóból értesültek a hekkertámadásról."},{"__typename":"Meta","key":"featuredImage","value":"7a8bc1f8-4606-5a08-b008-46155aeed585"},{"__typename":"Meta","key":"og:description","value":""},{"__typename":"Meta","key":"og:image","value":""},{"__typename":"Meta","key":"og:title","value":""},{"__typename":"Meta","key":"title","value":""}],"options":[{"__typename":"Option","key":"template","value":""},{"__typename":"Option","key":"language","value":"hu"},{"__typename":"Option","key":"color_scheme","value":""},{"__typename":"Option","key":"is_anonym","value":false},{"__typename":"Option","key":"background_shadow","value":false},{"__typename":"Option","key":"title_inner","value":false},{"__typename":"Option","key":"lead_av","value":""},{"__typename":"Option","key":"jumbotron","value":""},{"__typename":"Option","key":"external_url","value":""},{"__typename":"Option","key":"title_alignment","value":""},{"__typename":"Option","key":"comments_enabled","value":true},{"__typename":"Option","key":"stream","value":true}],"url":"https://444.hu/2026/05/04/vizsgalatot-indit-az-adatvedelmi-hatosag-a-mediaworks-adatlopasi-ugyeben","format":{"__ref":"Format:7a6036e1-c587-11f0-9297-525400d76232"},"partners":[],"relatedArticles":[{"__ref":"Article:639fae40-292a-5cbe-9673-72a6b4636e7a"},{"__ref":"Article:81be135c-3ee1-5aa9-a455-52de5986d883"},{"__ref":"Article:a64e85db-a387-55ea-9cb0-6d3fafd3c244"}],"userHasAccess":true},"ROOT_QUERY":{"__typename":"Query","content({\"fromBucket\":{\"column\":\"SLUG\",\"operator\":\"IN\",\"value\":[\"444\"]},\"publishedAt\":\"2026-05-04\",\"slug\":\"vizsgalatot-indit-az-adatvedelmi-hatosag-a-mediaworks-adatlopasi-ugyeben\"})":{"__ref":"Article:58e142f6-0e1e-5044-9ab9-48af59dd5283"}}}}</script><script type="fastboot/shoebox" id="shoebox-abgroup">null</script><script type="x/boundary" id="fastboot-body-end"></script>

    
