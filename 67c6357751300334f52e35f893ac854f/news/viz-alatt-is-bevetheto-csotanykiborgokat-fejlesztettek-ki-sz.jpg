:287fbf6d-8bdb-4f01-82b0-f30fe6757132":{"__typename":"Tag","id":"287fbf6d-8bdb-4f01-82b0-f30fe6757132","slug":"csotanyok","name":"csótányok","description":"","url":"https://qubit.hu/tag/csotanyok"},"Tag:51a5f846-02bd-4d6a-bff9-c17763809feb":{"__typename":"Tag","id":"51a5f846-02bd-4d6a-bff9-c17763809feb","slug":"kiborgcsotany","name":"kiborgcsótány","description":"","url":"https://qubit.hu/tag/kiborgcsotany"},"Tag:c39c215f-cdaf-47ce-9814-6f5b3371548e":{"__typename":"Tag","id":"c39c215f-cdaf-47ce-9814-6f5b3371548e","slug":"buvarruha","name":"búvárruha","description":"","url":"https://qubit.hu/tag/buvarruha"},"Tag:d41b1b29-b0aa-4ccd-a178-83940b7d8861":{"__typename":"Tag","id":"d41b1b29-b0aa-4ccd-a178-83940b7d8861","slug":"szingapuri-nanyang-muszaki-egyetem","name":"Szingapúri Nanyang Műszaki Egyetem","description":"","url":"https://qubit.hu/tag/szingapuri-nanyang-muszaki-egyetem"},"Tag:d42fd64f-4681-4862-8db5-b669cb307dd1":{"__typename":"Tag","id":"d42fd64f-4681-4862-8db5-b669cb307dd1","slug":"csotany","name":"csótány","description":"","url":"https://qubit.hu/tag/csotany"},"Tag:e3a95231-3023-4b72-8c40-d43ce573f959":{"__typename":"Tag","id":"e3a95231-3023-4b72-8c40-d43ce573f959","slug":"gromphadorhina-portentosa","name":"Gromphadorhina portentosa","description":"","url":"https://qubit.hu/tag/gromphadorhina-portentosa"},"Format:f81a6100-387b-4a11-bd2e-76a77b2f9927":{"__typename":"Format","id":"f81a6100-387b-4a11-bd2e-76a77b2f9927","slug":"cikk","name":"Cikk","description":null,"url":"https://qubit.hu/format/cikk","mateType":"DEFAULT"},"MediaItem:38ceecff-215c-59f9-8e2f-1364f1543d50":{"__typename":"Image","caption":"A kiborgcsótányok a terepasztalon","author":"Yang Bai et al. arXiv (2024)","url":"https://assets.4cdn.hu/kraken/82COHFYv36ICf0N4s.jpeg","creditType":"Fotó","sourceLink":"https://arxiv.org/abs/2403.17392","bucket":{"__ref":"Bucket:94d7b8c8-1040-5a82-a86c-aaf977c902e4"},"id":"38ceecff-215c-59f9-8e2f-1364f1543d50","width":2542,"height":1430,"variations":[{"__typename":"ImageVariation","url":"https://assets.4cdn.hu/kraken/82COHFYv36ICf0N4s-xxs.jpeg","size":"xxs","width":96,"height":54},{"__typename":"ImageVariation","url":"https://assets.4cdn.hu/kraken/82COHFYv36ICf0N4s-xs.jpeg","size":"xs","width":360,"height":203},{"__typename":"ImageVariation","url":"https://assets.4cdn.hu/kraken/82COHFYv36ICf0N4s-sm.jpeg","size":"sm","width":640,"height":360},{"__typename":"ImageVariation","url":"https://assets.4cdn.hu/kraken/82COHFYv36ICf0N4s-md.jpeg","size":"md","width":768,"height":432},{"__typename":"ImageVariation","url":"https://assets.4cdn.hu/kraken/82COHFYv36ICf0N4s-lg.jpeg","size":"lg","width":1366,"height":768},{"__typename":"ImageVariation","url":"https://assets.4cdn.hu/kraken/82COHFYv36ICf0N4s-xl.jpeg","size":"xl","width":1920,"height":1080},{"__typename":"ImageVariation","url":"https://assets.4cdn.hu/kraken/82COHFYv36ICf0N4s-xxl.jpeg","size":"xxl","width":2560,"height":1440}]},"Author:68fba4e7-ae1e-4c2d-8ae9-ed98c76388a6":{"__typename":"Author","id":"68fba4e7-ae1e-4c2d-8ae9-ed98c76388a6","name":"Tóth András","avatar":"https://assets.4cdn.hu/kraken/8KkExeSoVR796S6Ss.jpeg?width=96\u0026height=96\u0026fit=crop","slug":"tothandras"},"Category:b5ab3398-1fe9-4d08-861f-d26831025b70":{"__typename":"Category","id":"b5ab3398-1fe9-4d08-861f-d26831025b70","slug":"tudomany","name":"tudomány","description":"","url":"https://qubit.hu/category/tudomany"},"Format:7a6036e1-c587-11f0-9297-525400d76232":{"__typename":"Format","id":"7a6036e1-c587-11f0-9297-525400d76232","slug":"cikk","name":"Cikk","description":null,"url":"https://444.hu/format/cikk","mateType":"DEFAULT"},"Article:be822006-5562-5b4c-88f4-2fb0356e1ca9":{"__typename":"Article","id":"be822006-5562-5b4c-88f4-2fb0356e1ca9","title":"Néhány métert szeltek át egy terepasztalon, de nagy ugrást tettek előre a kiborgcsótányok","slug":"nehany-metert-szeltek-at-egy-terepasztalon-de-nagy-ugrast-tettek-elore-a-kiborgcsotanyok","featuredImage":{"__ref":"MediaItem:38ceecff-215c-59f9-8e2f-1364f1543d50"},"excerpt":"Szingapúri és japán kutatók igazolták, hogy egy kiborgcsótányokból álló raj képes koordináltan bejárni egy kis területet. A jövőben így környezeti méréseket végezhetnek, vagy katasztrófák sérültjei után kutathatnak.","publishedAt":"2024-04-17T12:01:19+02:00","createdAt":"2024-04-17T12:01:21+02:00","authors":[{"__ref":"Author:68fba4e7-ae1e-4c2d-8ae9-ed98c76388a6"}],"categories":[{"__ref":"Category:b5ab3398-1fe9-4d08-861f-d26831025b70"}],"collections":[],"bucket":{"__ref":"Bucket:94d7b8c8-1040-5a82-a86c-aaf977c902e4"},"options":[{"__typename":"Option","key":"template","value":""},{"__typename":"Option","key":"color_scheme","value":""},{"__typename":"Option","key":"is_anonym","value":false},{"__typename":"Option","key":"background_shadow","value":false},{"__typename":"Option","key":"title_inner","value":false},{"__typename":"Option","key":"jumbotron","value":""},{"__typename":"Option","key":"external_url","value":""},{"__typename":"Option","key":"title_alignment","value":""},{"__typename":"Option","key":"comments_enabled","value":false}],"format":{"__ref":"Format:7a6036e1-c587-11f0-9297-525400d76232"},"partners":[],"url":"https://qubit.hu/2024/04/17/nehany-metert-szeltek-at-egy-terepasztalon-de-nagy-ugrast-tettek-elore-a-kiborgcsotanyok"},"MediaItem:ef2f13a9-a8cf-5185-b2b4-a21030ce5914":{"__typename":"Image","caption":"A meghekkelt rescue-csótány","author":"RIKEN / Shida Ayaka et al.","url":"https://assets.4cdn.hu/kraken/7nQU1rRBiUtCOUDks.png","creditType":"Fotó","sourceLink":null,"bucket":{"__ref":"Bucket:94d7b8c8-1040-5a82-a86c-aaf977c902e4"},"id":"ef2f13a9-a8cf-5185-b2b4-a21030ce5914","width":1518,"height":852,"variations":[{"__typename":"ImageVariation","url":"https://assets.4cdn.hu/kraken/7nQU1rRBiUtCOUDks-xxs.png","size":"xxs","width":96,"height":54},{"__typename":"ImageVariation","url":"https://assets.4cdn.hu/kraken/7nQU1rRBiUtCOUDks-xs.png","size":"xs","width":360,"height":202},{"__typename":"ImageVariation","url":"https://assets.4cdn.hu/kraken/7nQU1rRBiUtCOUDks-sm.png","size":"sm","width":640,"height":359},{"__typename":"ImageVariation","url":"https://assets.4cdn.hu/kraken/7nQU1rRBiUtCOUDks-md.png","size":"md","width":768,"height":431},{"__typename":"ImageVariation","url":"https://assets.4cdn.hu/kraken/7nQU1rRBiUtCOUDks-lg.png","size":"lg","width":1366,"height":767},{"__typename":"ImageVariation","url":"https://assets.4cdn.hu/kraken/7nQU1rRBiUtCOUDks-xl.png","size":"xl","width":1920,"height":1078},{"__typename":"ImageVariation","url":"https://assets.4cdn.hu/kraken/7nQU1rRBiUtCOUDks-xxl.png","size":"xxl","width":2560,"height":1437}]},"Author:600d5778-6afa-41df-a826-134a22a9d420":{"__typename":"Author","id":"600d5778-6afa-41df-a826-134a22a9d420","name":"Balázs Zsuzsanna","avatar":"https://assets.4cdn.hu/kraken/7RUx9ipUu4ktJ3Hvs.jpeg?width=96\u0026height=96\u0026fit=crop","slug":"balazszs"},"Article:c1a81721-7517-5543-be42-f12618983560":{"__typename":"Article","id":"c1a81721-7517-5543-be42-f12618983560","title":"Csótánykiborgokkal mentenék a katasztrófákban romok alá szorult embereket Japánban","slug":"csotanykiborgokkal-mentenek-a-katasztrofakban-romok-koze-szorult-embereket-japanban","featuredImage":{"__ref":"MediaItem:ef2f13a9-a8cf-5185-b2b4-a21030ce5914"},"excerpt":"Ultravékony filmrétegből álló napelemekkel dolgoztak, a technológia a kutatók szerint bármelyik nagyobb rovarfajnál bevethető lenne.","publishedAt":"2022-09-07T11:43:50+02:00","createdAt":"2022-09-07T11:43:53+02:00","authors":[{"__ref":"Author:600d5778-6afa-41df-a826-134a22a9d420"}],"categories":[{"__ref":"Category:b5ab3398-1fe9-4d08-861f-d26831025b70"}],"collections":[],"bucket":{"__ref":"Bucket:94d7b8c8-1040-5a82-a86c-aaf977c902e4"},"options":[{"__typename":"Option","key":"template","value":""},{"__typename":"Option","key":"feed_image","value":true},{"__typename":"Option","key":"color_scheme","value":""},{"__typename":"Option","key":"feed_large","value":""},{"__typename":"Option","key":"feed_excerpt","value":true},{"__typename":"Option","key":"is_anonym","value":false},{"__typename":"Option","key":"background_shadow","value":false},{"__typename":"Option","key":"title_inner","value":false},{"__typename":"Option","key":"jumbotron","value":""},{"__typename":"Option","key":"external_url","value":""},{"__typename":"Option","key":"title_alignment","value":""},{"__typename":"Option","key":"script_ad","value":""},{"__typename":"Option","key":"comments_enabled","value":false}],"format":{"__ref":"Format:7a6036e1-c587-11f0-9297-525400d76232"},"partners":[],"url":"https://qubit.hu/2022/09/07/csotanykiborgokkal-mentenek-a-katasztrofakban-romok-koze-szorult-embereket-japanban"},"Article:052b5785-8b66-5686-a1db-148110a6821f":{"__typename":"Article","id":"052b5785-8b66-5686-a1db-148110a6821f","featuredImage":{"__ref":"MediaItem:66e82643-43af-5acb-9639-cfb0ea4658dc"},"title":"Itt vannak a víz alatt is bevethető csótánykiborgok","body":[[{"type":"core/paragraph","params":{},"content":"2024 tavaszán \u003ca href=\"https://qubit.hu/2024/04/17/nehany-metert-szeltek-at-egy-terepasztalon-de-nagy-ugrast-tettek-elore-a-kiborgcsotanyok\" target=\"_blank\" \u003eszámoltunk be arról\u003c/a\u003e, hogy Hirotaka Szato, a Szingapúri Nanyang Műszaki Egyetem kutatója és kollégái invazív beavatkozás és az állatok sérülése nélkül hoztak létre irányítható \u003ca href=\"https://qubit.hu/2022/09/07/csotanykiborgokkal-mentenek-a-katasztrofakban-romok-koze-szorult-embereket-japanban\" \u003ecsótánykiborgokat\u003c/a\u003e, amelyek nemcsak pár percig, hanem akár napokig bevethetők maradnak. Szato és kollégái madagaszkári bütykös csótányokat (\u003ci \u003eGromphadorhina portentosa\u003c/i\u003e) tettek irányíthatóvá a parányi számítógépből, akkumulátorból és antennából álló „hátizsákokkal”. A 20 csótány a tesztek során sikeresen átszelt egy dombokkal és téglaakadályokkal tarkított 3,5 négyzetméteres kísérleti asztalt, amivel a kutatók egy sivatagi terepet kívántak szimulálni. "},{"type":"core/paragraph","params":{},"content":" Szato akkor azt nyilatkozta, hogy a kiborg csótányokból álló raj ideális lenne területek felderítésére, és a rájuk szerelt szenzorokkal környezeti méréseket tudnának elvégezni, vagy környezeti katasztrófák során romok alá szorult emberek után tudnának kutatni. "},{"type":"core/paragraph","params":{},"content":"A New Scientist most arról adott hírt, hogy a Szingapúri Nanyang Műszaki Egyetem kutatói nemrégiben elkészültek azzal a direkt csótánykiborgoknak fejlesztett „búvárruhával”, amelyekkel azok a víz alatt is tudnak lélegezni, így már alkalmassá váltak a katasztrófák vízzel elárasztott területein történő bevetésre. "},{"type":"image","params":{"src":"https://4cdn.hu/kraken/image/upload/s--MPuqMm2k--/c_limit,w_760/8MNJvlHUSllrGBAms.webp","id":"66e82643-43af-5acb-9639-cfb0ea4658dc","showauthor":"true","alt":"","link":"","mediaItem":{"caption":"Mélybúvár kiborgcsótány","author":"NTU Singapore","url":"https://assets.4cdn.hu/kraken/8MNJvlHUSllrGBAms.webp","creditType":"Fotó","sourceLink":null,"bucket":{"id":"94d7b8c8-1040-5a82-a86c-aaf977c902e4","slug":"qubit","name":"Qubit","__typename":"Bucket"},"__typename":"Image","id":"66e82643-43af-5acb-9639-cfb0ea4658dc","width":1003,"height":668,"variations":[{"url":"https://assets.4cdn.hu/kraken/8MNJvlHUSllrGBAms-xxs.webp","size":"xxs","width":96,"height":64,"__typename":"ImageVariation"},{"url":"https://assets.4cdn.hu/kraken/8MNJvlHUSllrGBAms-xs.webp","size":"xs","width":360,"height":240,"__typename":"ImageVariation"},{"url":"https://assets.4cdn.hu/kraken/8MNJvlHUSllrGBAms-sm.webp","size":"sm","width":640,"height":426,"__typename":"ImageVariation"},{"url":"https://assets.4cdn.hu/kraken/8MNJvlHUSllrGBAms-md.webp","size":"md","width":768,"height":511,"__typename":"ImageVariation"},{"url":"https://assets.4cdn.hu/kraken/8MNJvlHUSllrGBAms-lg.webp","size":"lg","width":1366,"height":910,"__typename":"ImageVariation"},{"url":"https://assets.4cdn.hu/kraken/8MNJvlHUSllrGBAms-xl.webp","size":"xl","width":1920,"height":1279,"__typename":"ImageVariation"},{"url":"https://assets.4cdn.hu/kraken/8MNJvlHUSllrGBAms-xxl.webp","size":"xxl","width":2560,"height":1705,"__typename":"ImageVariation"}]}},"content":"Mélybúvár kiborgcsótány"},{"type":"core/paragraph","params":{},"content":"A Nature Communications folyóiratban hétfőn megjelent \u003ca href=\"https://www.nature.com/articles/s41467-026-74235-1\" target=\"_blank\" \u003etanulmányuk\u003c/a\u003e szerint 3D-nyomtatással készült, zselatinszerűen lágy burok hidrogén-peroxid és mangán-dioxid keveréket tartalmaz, e két vegyület reakciójából felszabaduló oxigén tartja életben a rovart a víz alatt. A búvárfelszerelésükkel a csótányok 3 órán át bírták az 50 centiméteres mélységben. A tesztelésre kiszemelt rovarok három nappal a merülés után is életben voltak. "},{"type":"core/paragraph","params":{},"content":"A nyomtatott merülőburokban a csótányok szinte ugyanúgy mozogtak, mint a szárazföldön, ahol átlagosan 87,5 milliméter/másodperces sebességet produkáltak, míg a víz elérték a 78,4 milliméter/másodperces sebességet is. Szato szerint az ilyen felszerelések növelik a kutató-mentő csótánykiborgok bevetési képességeit, a búvárfelszerelés után fejleszteni kívánt űrhajós-burkokkal pedig akár a kozmoszban is bevethetőkké válhatnak. A kutatócsoport nem titkolt célja ugyanis, hogy teremtményeik részt vehessenek a Mars felszínének felfedezésében. "},{"type":"widget","params":{"type":"pr-box-donation","params":{"contenteditable":"false","data-id":"3feb0be7-5204-4a94-9808-70f7c09c7bdb","type":"pr-box-donation"}}}]],"slug":"itt-vannak-a-viz-alatt-is-bevetheto-csotanykiborgok","publishedAt":"2026-06-29T15:07:13+02:00","bucket":{"__ref":"Bucket:94d7b8c8-1040-5a82-a86c-aaf977c902e4"},"excerpt":"A Szingapúri Nanyang Műszaki Egyetem kutatói speciális búvárfelszerelést fejlesztettek az általuk korábban létrehozott távirányítható rovaroknak.","createdAt":"2026-06-29T15:07:15+02:00","updatedAt":"2026-06-29T15:07:15+02:00","authors":[{"__ref":"Author:ec6560f5-cd75-4f85-abd3-bc554d3ff029"}],"categories":[{"__ref":"Category:fcbb6fa4-d0d1-4381-a05c-24fa3323e119"}],"tags":[{"__ref":"Tag:287fbf6d-8bdb-4f01-82b0-f30fe6757132"},{"__ref":"Tag:51a5f846-02bd-4d6a-bff9-c17763809feb"},{"__ref":"Tag:c39c215f-cdaf-47ce-9814-6f5b3371548e"},{"__ref":"Tag:d41b1b29-b0aa-4ccd-a178-83940b7d8861"},{"__ref":"Tag:d42fd64f-4681-4862-8db5-b669cb307dd1"},{"__ref":"Tag:e3a95231-3023-4b72-8c40-d43ce573f959"}],"collections":[],"meta":[{"__typename":"Meta","key":"description","value":""},{"__typename":"Meta","key":"excerpt","value":"A Szingapúri Nanyang Műszaki Egyetem kutatói speciális búvárfelszerelést fejlesztettek az általuk korábban létrehozott távirányítható rovaroknak."},{"__typename":"Meta","key":"featuredImage","value":"66e82643-43af-5acb-9639-cfb0ea4658dc"},{"__typename":"Meta","key":"og:description","value":""},{"__typename":"Meta","key":"og:image","value":""},{"__typename":"Meta","key":"og:title","value":""},{"__typename":"Meta","key":"title","value":""}],"options":[{"__typename":"Option","key":"template","value":""},{"__typename":"Option","key":"language","value":"hu"},{"__typename":"Option","key":"color_scheme","value":""},{"__typename":"Option","key":"is_anonym","value":false},{"__typename":"Option","key":"background_shadow","value":false},{"__typename":"Option","key":"title_inner","value":false},{"__typename":"Option","key":"lead_av","value":""},{"__typename":"Option","key":"jumbotron","value":""},{"__typename":"Option","key":"external_url","value":""},{"__typename":"Option","key":"title_alignment","value":""},{"__typename":"Option","key":"comments_enabled","value":true}],"url":"https://qubit.hu/2026/06/29/itt-vannak-a-viz-alatt-is-bevetheto-csotanykiborgok","format":{"__ref":"Format:f81a6100-387b-4a11-bd2e-76a77b2f9927"},"partners":[],"relatedArticles":[{"__ref":"Article:be822006-5562-5b4c-88f4-2fb0356e1ca9"},{"__ref":"Article:c1a81721-7517-5543-be42-f12618983560"}],"userHasAccess":true},"ROOT_QUERY":{"__typename":"Query","content({\"fromBucket\":{\"column\":