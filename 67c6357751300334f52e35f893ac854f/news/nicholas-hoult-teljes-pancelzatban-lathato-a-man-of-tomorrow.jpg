encia-de-superman"},"eventSlugs":null,"events":null,"attributes":[{"__typename":"TypedAttribute","type":"Platform","attribute":{"__typename":"Attribute","name":"Digital"}},{"__typename":"TypedAttribute","type":"Genre","attribute":{"__typename":"Attribute","name":"Superhero"}},{"__typename":"TypedAttribute","type":"Platform","attribute":{"__typename":"Attribute","name":"Theater"}},{"__typename":"TypedAttribute","type":"Publisher","attribute":{"__typename":"Attribute","name":"Warner Bros. Pictures"}},{"__typename":"TypedAttribute","type":"Genre","attribute":{"__typename":"Attribute","name":"Action"}},{"__typename":"TypedAttribute","type":"Genre","attribute":{"__typename":"Attribute","name":"Fantasy"}},{"__typename":"TypedAttribute","type":"Producer","attribute":{"__typename":"Attribute","name":"DC Studios"}},{"__typename":"TypedAttribute","type":"Franchise","attribute":{"__typename":"Attribute","name":"DC Comics"}},{"__typename":"TypedAttribute","type":"Franchise","attribute":{"__typename":"Attribute","name":"Superman"}}],"primaryObject":{"__typename":"Object","franchises":[{"__typename":"Attribute","name":"DC Comics","slug":"dc"},{"__typename":"Attribute","name":"Superman","slug":"superman"}],"genres":[{"__typename":"Attribute","slug":"superhero"},{"__typename":"Attribute","slug":"action"}],"merchant":null,"affiliateLink":null,"objectRegions":[{"__typename":"ObjectRegion","releases":[{"__typename":"Release","id":"5b1a0c39-e73c-4506-9e3c-8d0712fc76b3","date":"2027-07-09","estimatedDate":false,"timeframeYear":null,"platformAttributes":[{"__typename":"Attribute","id":4236628,"name":"Theater","slug":"theater"}]}],"id":2343971,"name":null,"region":"US"}],"id":"99f0eb23-836b-40e0-9ca7-b1e78771cc70","url":"/movies/man-of-tomorrow","slug":"man-of-tomorrow","type":"Movie","metadata":{"__typename":"Metadata","names":{"__typename":"Names","name":"Man of Tomorrow","alt":[],"short":null}}},"objects":[{"__typename":"Object","id":"99f0eb23-836b-40e0-9ca7-b1e78771cc70","url":"/movies/man-of-tomorrow","slug":"man-of-tomorrow","type":"Movie","merchant":null,"affiliateLink":null,"metadata":{"__typename":"Metadata","names":{"__typename":"Names","name":"Man of Tomorrow","alt":[],"short":null}},"objectRegions":[{"__typename":"ObjectRegion","id":2343971,"name":null,"region":"US","releases":[{"__typename":"Release","id":"5b1a0c39-e73c-4506-9e3c-8d0712fc76b3","date":"2027-07-09","platformAttributes":[{"__typename":"Attribute","id":4236628,"name":"Theater"}]}]}],"franchises":[{"__typename":"Attribute","name":"DC Comics","slug":"dc"},{"__typename":"Attribute","name":"Superman","slug":"superman"}]},{"__typename":"Object","id":"32d61ebc-ba2f-4cd4-8957-c46315dddd49","url":"/movies/superman-2025","slug":"superman-2025","type":"Movie","merchant":null,"affiliateLink":null,"metadata":{"__typename":"Metadata","names":{"__typename":"Names","name":"Superman [2025]","alt":["Superman [James Gunn reboot]","\nSuperman's Legacy","\nSuperman Legacy"],"short":"Superman"}},"objectRegions":[{"__typename":"ObjectRegion","id":2337250,"name":"Superman","region":"US","releases":[{"__typename":"Release","id":"2ad58191-1a3a-466f-a12b-ed0da87c71cb","date":"2025-07-08","platformAttributes":[{"__typename":"Attribute","id":4236628,"name":"Theater"}]},{"__typename":"Release","id":"9dce077a-e4ad-4855-adb1-a15081d0ed6b","date":"2025-08-12","platformAttributes":[{"__typename":"Attribute","id":4097223,"name":"Digital"}]}]}],"franchises":[{"__typename":"Attribute","name":"DC Comics","slug":"dc"},{"__typename":"Attribute","name":"Superman","slug":"superman"}]}],"seoTitle":"Man of Tomorrow Set Image Reveals Lex Luthor Body Armor","ogTitle":"Lex Luthor Suits Up for Superman Rematch in Man of Tomorrow Set Image Shared by James Gunn","nonIndexable":false,"abTests":[{"__typename":"ABTest","id":67322,"represents":"promoTitle","values":["Man of Tomorrow Set Image Reveals First Look at Lex Luthor in Full Body Armor for Superman Sequel","Lex Luthor Suits Up for Superman Rematch in Man of Tomorrow Set Image"],"winnerIndex":0}],"sponsorships":[],"contentCategory":{"__typename":"ContentCategory","id":1,"name":"News"},"brand":null,"sequenceNumber":null,"id":"4d3ddcdb-16c1-4a87-a989-376e41e6d193","type":"Article","title":"Man of Tomorrow Set Image Reveals First Look at Lex Luthor in Full Body Armor for Superman Sequel - IGN","subtitle":"\"Fit check.\"","promoteAt":null,"publishDate":"2026-06-01T16:25:05.239Z","slug":"man-of-tomorrow-set-image-reveals-first-look-at-lex-luthor-in-full-body-armor-for-superman-sequel","feedTitle":"Man of Tomorrow Set Image Reveals First Look at Lex Luthor in Full Body Armor for Superman Sequel","feedImage":{"__typename":"Image","url":"https://assets-prd.ignimgs.com/2026/06/01/lex-luthor-in-man-of-tomorrow-1780330470945.png"},"v3Id":null,"url":"/articles/man-of-tomorrow-set-image-reveals-first-look-at-lex-luthor-in-full-body-armor-for-superman-sequel","heroVideoContentId":null,"heroVideoContentSlug":"","processedHtml":"\u003csection class=\"article-page\"\u003e\u003cp\u003eJames Gunn has posted a first look at Nicholas Hoult suited up in full body armor as Lex Luthor on the set of his Superman sequel, \u003ca href=\"https://www.ign.com/movies/man-of-tomorrow\"\u003eMan of Tomorrow\u003c/a\u003e.\u003c/p\u003e\u003csection data-transform=\"mobile-ad-break\"\u003e\u003c/section\u003e\u003cp\u003eThe DC Studios co-CEO and Superman director shared the behind-the-scenes image across \u003ca href=\"https://www.instagram.com/p/DZDJWAFs75Q/?utm_source=ig_web_copy_link\u0026igsh=MzRlODBiNWFlZA==\"\u003evarious social media platforms\u003c/a\u003e today. It\u0026#39;s a sneak peek at Clark Kent\u0026#39;s (David Corenswet) nemesis wearing what looks to be near-comic-accurate warsuit that should help him go toe-to-toe with the Son of Krypton and maybe even Brainiac when the DCU follow-up premieres next year.\u003c/p\u003e\u003cp\u003eGunn only confirmed that the image came straight from the Man of Tomorrow set with the message \u0026quot;fit check\u0026quot; in his post. You can see Hoult wearing the Lex Luthor suit below.\u003c/p\u003e\u003csection data-transform=\"image-with-caption\" data-image-url=\"https://assets-prd.ignimgs.com/2026/06/01/nicholas-hoult-as-lex-luthor-in-superman-man-of-tomorrow-1780330524416.jpg\" data-image-title=\"undefined\" data-image-class=\"article-image-full-size\" data-image-link=\"https://assets-prd.ignimgs.com/2026/06/01/nicholas-hoult-as-lex-luthor-in-superman-man-of-tomorrow-1780330524416.jpg\" data-caption=\"Nicholas%20Hoult%20as%20Lex%20Luthor%20in%20Man%20of%20Tomorrow.%20Image%20courtesy%20of%20James%20Gunn.\" /\u003e\u003c/section\u003e\u003cp\u003eIt looks like Hoult\u0026#39;s Kryptonian-hating supervillain made his suit in anticipation of a rematch with Corenswet\u0026#39;s Superman. There\u0026#39;s a good chance we see the two face off in a more even match-up when Man of Tomorrow arrives, but Gunn has told fans that the movie will feature an unexpected team-up, too.\u003c/p\u003e\u003cp\u003eIn September of last year, the director told \u003ca href=\"https://www.siriusxm.com/talk/howard-stern\"\u003e\u003cu\u003eHoward Stern\u003c/u\u003e\u003c/a\u003e that \u003ca href=\"https://www.ign.com/articles/james-gunn-reveals-first-details-on-man-of-tomorrow-confirms-superman-and-lex-luthor-have-to-work-together-against-a-much-much-bigger-threat-but-who-is-it\"\u003e\u003cu\u003eLex and Clark would be working together\u003c/u\u003e\u003c/a\u003e. Who they\u0026#39;d be fighting was a mystery at the time, but we can probably guess now that the \u0026quot;bigger threat\u0026quot; teased at the time is \u003ca href=\"https://www.ign.com/articles/brainiac-cast-lars-eidinger-to-play-superman-villain-in-man-of-tomorrow\"\u003e\u003cu\u003eLars Eidinger\u0026#39;s live-action portrayal of Brainiac\u003c/u\u003e\u003c/a\u003e.\u003c/p\u003e\u003cp\u003e\u0026quot;And it is a story about Lex Luthor and Superman having to work together, to a certain degree, against a much, much bigger threat,\u0026quot; Gunn said at the time. \u0026quot;And it\u0026#39;s more complicated than that. It\u0026#39;s as much a Lex movie as it is a Superman movie. I relate to the character of Lex Luthor, sadly.\u0026quot;\u003c/p\u003e\u003csection data-transform=\"slideshow\" data-slug=\"james-gunns-man-of-tomorrow-superman-vs-lex-luthor-art-gallery\" data-value=\"james-gunns-man-of-tomorrow-superman-vs-lex-luthor-art-gallery\" data-type=\"slug\" data-caption=\"\"\u003e\u003c/section\u003e\u003cp\u003eToday\u0026#39;s look at Hoult\u0026#39;s return as Lex Luthor offers one of the few behind-the-scenes looks at Man of Tomorrow we\u0026#39;ve seen so far. The \u003ca href=\"https://www.ign.com/articles/superman-sequel-man-of-tomorrow-filming-begins-with-new-image-from-james-gunn\"\u003e\u003cu\u003efirst\u003c/u\u003e\u003c/a\u003e, which featured a few notable clues that fans have already started digging into, was shared when filming began last month.\u003c/p\u003e\u003cp\u003eMan of Tomorrow will continue the DCU when its July 9, 2027, release date arrives. In addition to Hoult, Corenswet, and Eidinger, its cast includes \u003ca href=\"https://www.ign.com/articles/aaron-pierres-green-lantern-john-stewart-will-return-in-james-gunns-man-of-tomorrow\"\u003e\u003cu\u003eAaron Pierre as Green Lantern John Stewart\u003c/u\u003e\u003c/a\u003e, \u003ca href=\"https://www.ign.com/articles/man-of-tomorrow-maxima-casting-confirmed\"\u003e\u003cu\u003eAdria Arjona as Maxima\u003c/u\u003e\u003c/a\u003e, and \u003ca href=\"https://www.ign.com/articles/supergirl-confirmed-man-of-tomorrow-dcu\"\u003e\u003cu\u003eMilly Alcock as Supergirl\u003c/u\u003e\u003c/a\u003e. \u003ca href=\"https://www.ign.com/articles/superman-sequel-man-of-tomorrow-adds-matthew-lillard-to-cast-in-mystery-role\"\u003e\u003cu\u003eMatthew Lillard\u003c/u\u003e\u003c/a\u003e and \u003ca href=\"https://www.ign.com/articles/the-wire-actor-andre-royo-joins-superman-sequel-man-of-tomorrow-cast\"\u003e\u003cu\u003eAndre Royo\u003c/u\u003e\u003c/a\u003e have also joined the cast in mystery roles.\u003c/p\u003e\u003csection data-transform=\"poll\" data-id=\"71d04730-7c30-4010-a781-557621dd2ea6\"\u003e\u003c/section\u003e\u003cp\u003eFor more, you can see \u003ca href=\"https://www.ign.com/articles/man-of-tomorrow-brainiac-actor-compares-his-superman-villain-to-an-incarnation-of-satan\"\u003ehow Eidinger described his take on Brainiac\u003c/a\u003e. You can also check out \u003ca href=\"https://www.ign.com/articles/james-gunn-once-again-tweets-a-picture-of-a-pack-of-chocos-and-now-fans-think-martian-manhunter-is-on-his-way-to-the-dcu\"\u003ewhy some fans are expecting Martian Manhunter to show up\u003c/a\u003e.\u003c/p\u003e\u003csection data-transform=\"divider\"\u003e\u003c/section\u003e\u003cp\u003e\u003cem\u003eMichael Cripe is a freelance writer with IGN. He\u0026#39;s best known for his work at sites like The Pitch, The Escapist, and OnlySP. Be sure to give him a follow on Bluesky (@mikecripe.bsky.social) and Twitter (@MikeCripe).\u003c/em\u003e\u003c/p\u003e\u003c/section\u003e","showCommerceDisclaimer":false,"review":null,"articleId":"4d3ddcdb-16c1-4a87-a989-376e41e6d193","isCommunity":"no","resource":"article","pageType":"article","twitterCard":"summary_large_image","hasAds":true,"extraAds":false,"isPreview":false,"pageTitle":"Man of Tomorrow Set Image Reveals First Look at Lex Luthor in Full Body Armor for Superman Sequel","image":"https://assets-prd.ignimgs.com/2026/06/01/lex-luthor-in-man-of-tomorrow-1780330470945.png?width=1280\u0026format=jpg\u0026auto=webp\u0026quality=80","description":"James Gunn has posted a first look at Nicholas Hoult suited up in full body armor as Lex Luthor on the set of his Superman sequel, Man of Tomorrow.","category":"News","categories":["News"],"objectId":"99f0eb23-836b-40e0-9ca7-b1e78771cc70","objectSlug":"man-of-tomorrow","genreSlugs":["superhero","action"],"platforms":["Theater"],"platformSlugs":["theater"],"franchiseNames":["