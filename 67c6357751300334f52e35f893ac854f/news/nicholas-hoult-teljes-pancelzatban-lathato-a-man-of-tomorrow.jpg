ng-bar"></div></div><header class="jsx-1570451274 header"><div data-cy="sidebar-page-header" class="jsx-2708649821 sidebar-page-header collapsed"><span class="stack jsx-59817748 jsx-2389235030"><button class="button-text jsx-729543028 button button--secondary-alt jsx-3381835873 action-button sidebar-toggle contained centered small" data-cy="sidebar-toggle" type="button" title="Toggle Sidebar" tabindex="0"><span class="ign-icon left-chevron jsx-2750866048 jsx-3782449470" role="presentation" aria-hidden="true" data-cy="left-chevron" style="mask:url(https://kraken.ignimgs.com/_next/static/media/LeftChevron.c64b87f1.svg?cors=1) no-repeat center center / contain;background:currentColor"></span></button><span class="stack jsx-3236076941 jsx-1627515930 logo-container"><a href="/" data-cy="logo-link" title="IGN" class="logo-link" tabindex="-1"><img src="https://assets1.ignimgs.com/kraken/ign30-logo-alt.png?width=96&amp;auto=webp" srcSet="https://assets1.ignimgs.com/kraken/ign30-logo-alt.png?width=192&amp;auto=webp 2x" alt="IGN Logo" data-cy="icon-logo" class="ign-icon icon-logo light jsx-495676280"/><img src="https://assets1.ignimgs.com/kraken/ign30-logo.png?width=96&amp;auto=webp" srcSet="https://assets1.ignimgs.com/kraken/ign30-logo.png?width=192&amp;auto=webp 2x" alt="IGN Logo" data-cy="icon-logo" class="ign-icon icon-logo dark jsx-495676280"/></a><div class="doodle jsx-3562710790 empty"></div></span></span></div><div class="jsx-2155806329 adunit-wrapper"><div class="jsx-2155806329 bobble bobble- pogocnt pg-article"><div data-mix-name="fourBy" data-pos="" data-pogo-hide="1" class="jsx-343126785 pogo-slot"></div></div></div></header><main data-cy="page-main-content" id="main-content" class="jsx-1166515047"><div class="jsx-2155806329 adunit-wrapper"><div class="jsx-2155806329 bobble bobble-0 pogocnt pg-article"><div data-pogo="top" data-mix-name="leaderboardOnly" data-pos="0" class="jsx-343126785 top pogo-slot"></div></div></div><div data-cy="page-header" class="jsx-3209398698 page-header page-content short"><div class="interface jsx-326752785 stack jsx-2959124702 jsx-2128362915 bold small"><a href="/movies/man-of-tomorrow" class="link jsx-1337145738 jsx-3299197477 article-object-link underlined" data-cy="object-breadcrumb">Man of Tomorrow</a><a href="/movies/superman-2025" class="link jsx-1337145738 jsx-561297003 article-object-link underlined" data-cy="object-breadcrumb">Superman</a></div><h1 class="display-title jsx-684634384 jsx-560310519" data-cy="article-headline">Man of Tomorrow Set Image Reveals First Look at Lex Luthor in Full Body Armor for Superman Sequel</h1><h2 data-cy="article-sub-headline" class="title3 jsx-12333944 jsx-37621054">&quot;Fit check.&quot;</h2></div><div class="jsx-264942055 page-content"><section class="jsx-2162140478 byline"><span class="stack jsx-59817748 jsx-702910195 byline-stack"><span class="stack jsx-3647836811 jsx-4269505506 article-authors"><section data-cy="author-avatars" class="jsx-1825775112 author-avatars avatars-1"><div class="rounded jsx-444076027 jsx-4218469134 author-thumb profile-thumb jsx-3097962137 aspect-ratio aspect-ratio-1-1"><img alt="Michael Cripe Avatar" decoding="async" class="progressive-image profile-thumb-img jsx-249361588 jsx-2338608387 expand" loading="lazy" src="https://assets-prd.ignimgs.com/avatars/5205bf6a08586a205a834928/Michael_blue_red_2-1700460435246.png?crop=1%3A1&amp;width=21&amp;format=jpg&amp;auto=webp&amp;quality=80" srcSet="https://assets-prd.ignimgs.com/avatars/5205bf6a08586a205a834928/Michael_blue_red_2-1700460435246.png?crop=1%3A1&amp;width=21&amp;format=jpg&amp;auto=webp&amp;quality=80 1x, https://assets-prd.ignimgs.com/avatars/5205bf6a08586a205a834928/Michael_blue_red_2-1700460435246.png?crop=1%3A1&amp;width=21&amp;dpr=2&amp;format=jpg&amp;auto=webp&amp;quality=80 2x" data-cy="progressive-image"/></div></section><div data-cy="caption" class="caption jsx-1762799490">By <a href="/person/MikeCripe" class="link jsx-1337145738 article-author underlined" data-cy="article-author">Michael Cripe</a></div></span><div class="jsx-3449795453 divider jsx-428691023"></div><div data-cy="caption" class="caption jsx-1762799490 byline-date">Updated<!-- -->: <time dateTime="2026-06-01T17:09:08Z">Jun 1, 2026 5:09pm UTC</time></div><div class="jsx-3449795453 divider jsx-428691023"></div><div data-cy="caption" class="caption jsx-1762799490"><a class="link jsx-1337145738 jsx-2474574152 underlined" data-cy="styled-link" href="/articles/man-of-tomorrow-set-image-reveals-first-look-at-lex-luthor-in-full-body-armor-for-superman-sequel#comments"><span class="stack jsx-3647836811"><span class="ign-icon icon-comment jsx-2750866048 jsx-4173866675" role="img" aria-hidden="false" data-cy="icon-comment" aria-label="Comments" style="mask:url(https://kraken.ignimgs.com/_next/static/media/Comment.e2c389d0.svg?cors=1) no-repeat center center / contain;background:currentColor"></span>6 comments</span></a></div></span><div class="jsx-3449795453 divider jsx-3709034244"></div></section></div><div class="jsx-2870106660 page-content"><div class="jsx-2870106660 side-by-side"><div data-cy="article-content" class="jsx-2870106660 article-content page-0"><section data-cy="article-subtitle" class="article jsx-3932497636 article-section jsx-28683165 news" data-autopogo="true"><section class="article-page"><p data-cy="paragraph" class="paragraph jsx-2269604527">James Gunn has posted a first look at Nicholas Hoult suited up in full body armor as Lex Luthor on the set of his Superman sequel, <a class="link jsx-1337145738 jsx-3925284146 underlined" data-cy="styled-link" href="/movies/man-of-tomorrow">Man of Tomorrow</a>.</p><p></p><p data-cy="paragraph" class="paragraph jsx-2269604527">The DC Studios co-CEO and Superman director shared the behind-the-scenes image across <a href="https://www.instagram.com/p/DZDJWAFs75Q/?utm_source=ig_web_copy_link&amp;igsh=MzRlODBiNWFlZA==" class="link jsx-1337145738 jsx-3925284146 underlined" data-cy="styled-link" target="_blank" rel="noopener noreferrer">various social media platforms</a> today. It&#x27;s a sneak peek at Clark Kent&#x27;s (David Corenswet) nemesis wearing what looks to be near-comic-accurate warsuit that should help him go toe-to-toe with the Son of Krypton and maybe even Brainiac when the DCU follow-up premieres next year.</p><p data-cy="paragraph" class="paragraph jsx-2269604527">Gunn only confirmed that the image came straight from the Man of Tomorrow set with the message &quot;fit check&quot; in his post. You can see Hoult wearing the Lex Luthor suit below.</p><output class="box-wrapper jsx-2673806401"><figure class="jsx-313219616"><a href="https://assets-prd.ignimgs.com/2026/06/01/nicholas-hoult-as-lex-luthor-in-superman-man-of-tomorrow-1780330524416.jpg" target="_blank" rel="noopener noreferrer"><img alt="" aria-hidden="true" decoding="async" role="presentation" class="progressive-image article-image article-image-full-size jsx-1809694635 jsx-2338608387" loading="lazy" src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7" data-cy="progressive-image"/></a><figcaption data-cy="caption" class="caption jsx-1762799490 jsx-479945570 article-image-caption">Nicholas Hoult as Lex Luthor in Man of Tomorrow. Image courtesy of James Gunn.</figcaption></figure></output><p data-cy="paragraph" class="paragraph jsx-2269604527">It looks like Hoult&#x27;s Kryptonian-hating supervillain made his suit in anticipation of a rematch with Corenswet&#x27;s Superman. There&#x27;s a good chance we see the two face off in a more even match-up when Man of Tomorrow arrives, but Gunn has told fans that the movie will feature an unexpected team-up, too.</p><p data-cy="paragraph" class="paragraph jsx-2269604527">In September of last year, the director told <a href="https://www.siriusxm.com/talk/howard-stern" class="link jsx-1337145738 jsx-3925284146 underlined" data-cy="styled-link" target="_blank" rel="noopener noreferrer"><u>Howard Stern</u></a> that <a class="link jsx-1337145738 jsx-3925284146 underlined" data-cy="styled-link" href="/articles/james-gunn-reveals-first-details-on-man-of-tomorrow-confirms-superman-and-lex-luthor-have-to-work-together-against-a-much-much-bigger-threat-but-who-is-it"><u>Lex and Clark would be working together</u></a>. Who they&#x27;d be fighting was a mystery at the time, but we can probably guess now that the &quot;bigger threat&quot; teased at the time is <a class="link jsx-1337145738 jsx-3925284146 underlined" data-cy="styled-link" href="/articles/brainiac-cast-lars-eidinger-to-play-superman-villain-in-man-of-tomorrow"><u>Lars Eidinger&#x27;s live-action portrayal of Brainiac</u></a>.</p><p data-cy="paragraph" class="paragraph jsx-2269604527">&quot;And it is a story about Lex Luthor and Superman having to work together, to a certain degree, against a much, much bigger threat,&quot; Gunn said at the time. &quot;And it&#x27;s more complicated than that. It&#x27;s as much a Lex movie as it is a Superman movie. I relate to the character of Lex Luthor, sadly.&quot;</p><output class="box-wrapper jsx-2673806401" data-cy="article-slideshow"><button type="button" style="display:none" class="jsx-2228525885"></button><span data-cy="slideshow-view-trigger"><div data-cy="slideshow-preview" class="jsx-1711207865 slideshow-preview"><h3 class="title5 jsx-62124236 jsx-1085005187" data-cy="slideshow-preview-title">James Gunn&#x27;s Man of Tomorrow: Superman vs. Lex Luthor Art Gallery</h3><div data-cy="slideshow-images-container" class="jsx-1711207865 images-container"><button type="button" data-cy="hero-image" aria-label="Open Slideshow" class="jsx-1711207865 hero-image"><img alt="Click through to see all of the teaser art DC has released for 2027&#x27;s Man of Tomorrow movie." decoding="async" class="progressive-image jsx-2896921488 image aspect-ratio aspect-ratio-16-9 jsx-2605834259 jsx-2338608387 hover-opacity" loading="lazy" src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7" data-cy="progressive-image"/><span class="button-text jsx-729543028 button button--primary jsx-3381835873 jsx-4266531355 row-pagination-button next contained centered round large" data-cy="paginate next" title="Open Slideshow"><span class="ign-icon right-chevron jsx-2750866048 jsx-2919720488" role="presentation" aria-hidden="true" data-cy="right-chevron" style="mask:url(https://kraken.ignimgs.com/_next/static/media/RightChevron.272be43c.svg?cors=1) no-repeat center center / contain;background:currentColor"></span></span></button><div data-cy="slideshow-images-list" class="scrollbar jsx-2072772685 jsx-4243969252 images-list"><button data-cy="gallery-image" type="button" aria-label="Open Slideshow" class="jsx-1711207865 gallery-image"><img alt="Art by Jim Lee. (Image Credit: DC)" decoding="async" class="progressive-image jsx-2896921488 image aspect-ratio aspect-ratio-16-9 jsx-2605834259 jsx-2338608387 hover-opacity" loading="lazy" src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7" data-cy="progressive-image"/><div class="rounded jsx-412047461 overlay progressive-image jsx-2338608387 expand" data-cy="slideshow-image-overlay"><div data-cy="element-caption" class="caption jsx-1762799490">View 4 Images</div></div></button><button data-cy="gallery-image" type="button" aria-label="Open Slideshow" class="jsx-1711207865 gallery-image"><img alt="Art by Mitch Gerads. (Image Credit: DC)" decoding="async" class="progressive-image jsx-2896921488 image aspect-ratio aspect-ratio-16-9 jsx-2605834259 jsx-2338608387 hover-opacity" loading="lazy" src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7" data-cy="progressive-image"/></button><button data-cy="gallery-image" type="button" aria-label="Open Slideshow" class="jsx-1711207865 gallery-image"><img alt="Art by Jorge Jiménez. (Image Credit: DC)" decoding="async" class="progressive-image jsx-2896921488 image aspect-ratio aspect-ratio-16-9 jsx-2605834259 jsx-2338608387 hover-opacity" loading="lazy" src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7" data-cy="progressive-image"/></button></div></div></div></span></output><p data-cy="paragraph" class="paragraph jsx-2269604527">Today&#x27;s look at Hoult&#x27;s return as Lex Luthor offers one of the few behind-the-scenes looks at Man of Tomorrow we&#x27;ve seen so far. The <a class="link jsx-1337145738 jsx-3925284146 underlined" data-cy="styled-link" href="/articles/superman-sequel-man-of-tomorrow-filming-begins-with-new-image-from-james-gunn"><u>first</u></a>, which featured a few notable clues that fans have already started digging into, was shared when filming began last month.</p><p data-cy="paragraph" class="paragraph jsx-2269604527">Man of Tomorrow will continue the DCU when its July 9, 2027, release date arrives. In addition to Hoult, Corenswet, and Eidinger, its cast includes <a class="link jsx-1337145738 jsx-3925284146 underlined" data-cy="styled-link" href="/articles/aaron-pierres-green-lantern-john-stewart-will-return-in-james-gunns-man-of-tomorrow"><u>Aaron Pierre as Green Lantern John Stewart</u></a>, <a class="link jsx-1337145738 jsx-3925284146 underlined" data-cy="styled-link" href="/articles/man-of-tomorrow-maxima-casting-confirmed"><u>Adria Arjona as Maxima</u></a>, and <a class="link jsx-1337145738 jsx-3925284146 underlined" data-cy="styled-link" href="/articles/supergirl-confirmed-man-of-tomorrow-dcu"><u>Milly Alcock as Supergirl</u></a>. <a class="link jsx-1337145738 jsx-3925284146 underlined" data-cy="styled-link" href="/articles/superman-sequel-man-of-tomorrow-adds-matthew-lillard-to-cast-in-mystery-role"><u>Matthew Lillard</u></a> and <a class="link jsx-1337145738 jsx-3925284146 underlined" data-cy="styled-link" href="/articles/the-wire-actor-andre-royo-joins-superman-sequel-man-of-tomorrow-cast"><u>Andre Royo</u></a> have also joined the cast in mystery roles.</p><span data-cy="poll-view-trigger"><section class="box-wrapper jsx-2673806401"><div class="card jsx-1339469126 jsx-1355461925 box jsx-2627838217 poll-content-block" data-cy="poll-content-block"><form action="#" data-cy="poll-content" class="poll-content"><fieldset class="answers jsx-332304107" role="radiogroup" aria-labelledby="poll-question"><legend class="stack jsx-2624643483 jsx-4192417768"><span class="stack jsx-3547261442"><h2 data-cy="poll-question" class="title2 jsx-1903782357 jsx-1377259516 headline" id="poll-question">Which new DCU project are you most excited for?</h2></span><img alt="" aria-hidden="true" decoding="async" role="presentation" class="progressive-image jsx-4218469134 aspect-ratio aspect-ratio-1-1 jsx-3010959690 jsx-2338608387" loading="lazy" src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7" data-cy="progressive-image"/></legend><div data-cy="poll-answer" class="jsx-45304670 poll-answer"><label class="interface jsx-326752785 toggle-label jsx-803093603 left-justified radio" for="answerId66615" id="answerId66615-label"><input type="radio" data-cy="answer-supergirl" id="answerId66615" name="answerId" value="66615"/><span class="label">Supergirl</span><span data-cy="left-justified" class="left-justified toggle-wrapper"><span class="icon-toggle-indicator"></span></span></label><div class="title5 jsx-62124236 jsx-2988246289"></div></div><div data-cy="poll-answer" class="jsx-45304670 poll-answer"><label class="interface jsx-326752785 toggle-label jsx-803093603 left-justified radio" for="answerId66616" id="answerId66616-label"><input type="radio" data-cy="answer-clayface" id="answerId66616" name="answerId" value="66616"/><span class="label">Clayface</span><span data-cy="left-justified" class="left-justified toggle-wrapper"><span class="icon-toggle-indicator"></span></span></label><div class="title5 jsx-62124236 jsx-2988246289"></div></div><div data-cy="poll-answer" class="jsx-45304670 poll-answer"><label class="interface jsx-326752785 toggle-label jsx-803093603 left-justified radio" for="answerId66617" id="answerId66617-label"><input type="radio" data-cy="answer-man-of-tomorro" id="answerId66617" name="answerId" value="66617"/><span class="label">Man of Tomorrow</span><span data-cy="left-justified" class="left-justified toggle-wrapper"><span class="icon-toggle-indicator"></span></span></label><div class="title5 jsx-62124236 jsx-2988246289"></div></div><div data-cy="poll-answer" class="jsx-45304670 poll-answer highlight"><label class="interface jsx-326752785 toggle-label jsx-803093603 left-justified radio" for="answerId66618" id="answerId66618-label"><input type="radio" data-cy="answer-the-batman-par" id="answerId66618" name="answerId" value="66618"/><span class="label">The Batman Part II</span><span data-cy="left-justified" class="left-justified toggle-wrapper"><span class="icon-toggle-indicator"></span></span></label><div class="title5 jsx-62124236 jsx-1945348876"></div></div><div data-cy="poll-answer" class="jsx-45304670 poll-answer"><label class="interface jsx-326752785 toggle-label jsx-803093603 left-justified radio" for="answerId66619" id="answerId66619-label"><input type="radio" data-cy="answer-lanterns-tv-se" id="answerId66619" name="answerId" value="66619"/><span class="label">Lanterns TV Series</span><span data-cy="left-justified" class="left-justified toggle-wrapper"><span class="icon-toggle-indicator"></span></span></label><div class="title5 jsx-62124236 jsx-2988246289"></div></div><div data-cy="poll-answer" class="jsx-45304670 poll-answer"><label class="interface jsx-326752785 toggle-label jsx-803093603 left-justified radio" for="answerId66620" id="answerId66620-label"><input type="radio" data-cy="answer-batman:-the-br" id="answerId66620" name="answerId" value="66620"/><span class="label">Batman: The Brave and the Bold </span><span data-cy="left-justified" class="left-justified toggle-wrapper"><span class="icon-toggle-indicator"></span></span></label><div class="title5 jsx-62124236 jsx-2988246289"></div></div><input name="answerText" type="h