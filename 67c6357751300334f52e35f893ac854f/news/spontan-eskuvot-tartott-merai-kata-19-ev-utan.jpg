            <div class="time">
                <a title="Állandó link ehhez a bejegyzéshez" href="https://index.hu/mindekozben/poszt/2026/07/23/exek-csataja-2026-nagy-sanyi-kovacs-reni-balhe/" class="permalink">
                        <span class="ido" data-timestamp="1784782930000">4 perce</span>

                </a>
