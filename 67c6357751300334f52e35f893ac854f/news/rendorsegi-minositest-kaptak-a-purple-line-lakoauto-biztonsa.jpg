          <div class="m-all t-1of3 d-1of3 cf">
            <div class="item-post">
              <a href="https://www.caravantimes.co.uk/news/six-simple-safety-tips-for-motorhome-travel/" class="item-post-bg" title="Read Six simple safety tips for motorhome travel">
                <img width="680" height="477" src="https://www.caravantimes.co.uk/wp-content/uploads/2026/06/rsz_2roadpass-jvcipf_kh3q-unsplash.jpg" class="attachment-large size-large wp-post-image" alt="" decoding="async" loading="lazy" srcset="https://www.caravantimes.co.uk/wp-content/uploads/2026/06/rsz_2roadpass-jvcipf_kh3q-unsplash.jpg 770w, https://www.caravantimes.co.uk/wp-content/uploads/2026/06/rsz_2roadpass-jvcipf_kh3q-unsplash-300x210.jpg 300w, https://www.caravantimes.co.uk/wp-content/uploads/2026/06/rsz_2roadpass-jvcipf_kh3q-unsplash-768x539.jpg 768w" sizes="auto, (max-width: 680px) 100vw, 680px" />              </a>
