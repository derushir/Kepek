                <script>
                    (function() {
                        const bracket = document.querySelector('.m-compact-knockout-html_bracket');
                        const bracketOuter = document.querySelector('.m-compact-knockout-html_bracket_outer');
                        const bracketWrapper = document.querySelector('.m-compact-knockout-html_bracket-wrapper');

                        if (!bracket || !bracketWrapper) return;

                        // Function to update gradient visibility based on scroll position
                        function updateScrollGradients() {
                            const scrollLeft = bracket.scrollLeft;
                            const scrollTop = bracket.scrollTop;
                            const maxScrollLeft = bracket.scrollWidth - bracket.clientWidth;
                            const maxScrollTop = bracket.scrollHeight - bracket.clientHeight;
                            // Horizontal gradients
                            // Show left gradient if scrolled right
                            if (scrollLeft > 10) {
                                bracketOuter.classList.add('scrolled-left');
                            } else {
                                bracketOuter.classList.remove('scrolled-left');
                            }

                            // Hide right gradient if scrolled to end
                            if (scrollLeft >= maxScrollLeft - 10) {
                                bracketOuter.classList.add('scrolled-right');
                            } else {
                                bracketOuter.classList.remove('scrolled-right');
                            }

                            // Vertical gradients
                            // Show top gradient if scrolled down
                            if (scrollTop > 10) {
                                bracketWrapper.classList.add('scrolled-top');
                            } else {
                                bracketWrapper.classList.remove('scrolled-top');
                            }

                            // Hide bottom gradient if scrolled to bottom
                            if (scrollTop >= maxScrollTop - 10) {
                                bracketWrapper.classList.add('scrolled-bottom');
                            } else {
                                bracketWrapper.classList.remove('scrolled-bottom');
                            }
                        }

                        // Listen for scroll events
                        bracket.addEventListener('scroll', updateScrollGradients);

                        // Initial check
                        updateScrollGradients();

                        // Auto-scroll to live or last finished match
                        let targetMatch = document.querySelector('.c-compact-match.isLive');

                        // If no live match, find the last finished match
                        if (!targetMatch) {
                            const finishedMatches = document.querySelectorAll('.c-compact-match.isFinished');
                            if (finishedMatches.length > 0) {
                                targetMatch = finishedMatches[finishedMatches.length - 1];
                            }
                        }

                        if (targetMatch) {
                            // Get the round containing the target match
                            const targetRound = targetMatch.closest('.m-compact-knockout-html_round');

                            if (targetRound) {
                                // Calculate horizontal scroll position to center the target round
                                const bracketWidth = bracket.offsetWidth;
                                const bracketHeight = bracket.offsetHeight;
                                const roundLeft = targetRound.offsetLeft;
                                const roundWidth = targetRound.offsetWidth;

                                // Calculate vertical scroll position to center the target match
                                const matchTop = targetMatch.offsetTop;
                                const matchHeight = targetMatch.offsetHeight;

                                // Center the round horizontally and match vertically
                                const scrollLeft = roundLeft - (bracketWidth / 2) + (roundWidth / 2);
                                const scrollTop = matchTop - (bracketHeight / 2) + (matchHeight / 2);

                                // Smooth scroll to position
                                bracket.scrollTo({
                                    left: Math.max(0, scrollLeft),
                                    top: Math.max(0, scrollTop),
                                    behavior: 'smooth'
                                });

                                // Update gradients after scroll animation
                                setTimeout(updateScrollGradients, 500);
                            }
                        }
                    })();
                </script>

                ?>
