{"__typename":"ImageVariation","url":"https://assets.4cdn.hu/kraken/84rnY64MXJWnchPos-xxl.jpeg","size":"xxl","width":2560,"height":1707}]},"Author:88ea7ba6-f073-4b9a-b70f-51742b0614cb":{"__typename":"Author","id":"88ea7ba6-f073-4b9a-b70f-51742b0614cb","name":"Kolozsi Ádám","avatar":"https://assets.4cdn.hu/kraken/7zXYk0ZoEr9W1HNqvs.jpeg?width=96\u0026height=96\u0026fit=crop","slug":"kolozsia"},"Category:b722e920-44ed-4c26-bca0-2ac8fc0cd644":{"__typename":"Category","id":"b722e920-44ed-4c26-bca0-2ac8fc0cd644","slug":"belfold","name":"belföld","description":"","url":"https://444.hu/category/belfold"},"Article:0a915a78-6f82-5479-98d9-5d176c24d3d4":{"__typename":"Article","id":"0a915a78-6f82-5479-98d9-5d176c24d3d4","title":"A kormány belenyúl a NER párhuzamos valóságába: visszaveszik a kiszervezett KEKVA-kat","slug":"a-kormany-belenyul-a-ner-parhuzamos-valosagaba-visszaveszik-a-kiszervezett-kekva-kat","featuredImage":{"__ref":"MediaItem:34d417ed-11be-5c48-804a-5604af444757"},"excerpt":"Ez a Fidesz ideológiai hátországát, az MCC-t is érinti, de a modellváltó egyetemek kérdésének is nekimennek. Azonnal kell lépni, 10 milliárd euró a tét.","publishedAt":"2026-05-20T20:04:51+02:00","createdAt":"2026-05-20T20:04:53+02:00","authors":[{"__ref":"Author:88ea7ba6-f073-4b9a-b70f-51742b0614cb"}],"categories":[{"__ref":"Category:b722e920-44ed-4c26-bca0-2ac8fc0cd644"}],"collections":[],"bucket":{"__ref":"Bucket:70b47701-2c71-55dc-95b1-7ac5be6b8a21"},"options":[{"__typename":"Option","key":"template","value":""},{"__typename":"Option","key":"language","value":"hu"},{"__typename":"Option","key":"color_scheme","value":""},{"__typename":"Option","key":"is_anonym","value":false},{"__typename":"Option","key":"background_shadow","value":false},{"__typename":"Option","key":"title_inner","value":false},{"__typename":"Option","key":"lead_av","value":""},{"__typename":"Option","key":"jumbotron","value":""},{"__typename":"Option","key":"external_url","value":""},{"__typename":"Option","key":"title_alignment","value":""},{"__typename":"Option","key":"comments_enabled","value":true},{"__typename":"Option","key":"stream","value":true}],"format":{"__ref":"Format:7a6036e1-c587-11f0-9297-525400d76232"},"partners":[],"url":"https://444.hu/2026/05/20/a-kormany-belenyul-a-ner-parhuzamos-valosagaba-visszaveszik-a-kiszervezett-kekva-kat"},"MediaItem:dd7c132a-a77d-5350-9941-2c083c9a6214":{"__typename":"Image","caption":"","author":"Kovács Bendegúz/444","url":"https://assets.4cdn.hu/kraken/8LtkMtVlOk6LmOWGs.jpeg","creditType":"Fotó","sourceLink":null,"bucket":{"__ref":"Bucket:70b47701-2c71-55dc-95b1-7ac5be6b8a21"},"id":"dd7c132a-a77d-5350-9941-2c083c9a6214","width":3000,"height":2000,"variations":[{"__typename":"ImageVariation","url":"https://assets.4cdn.hu/kraken/8LtkMtVlOk6LmOWGs-xxs.jpeg","size":"xxs","width":96,"height":64},{"__typename":"ImageVariation","url":"https://assets.4cdn.hu/kraken/8LtkMtVlOk6LmOWGs-xs.jpeg","size":"xs","width":360,"height":240},{"__typename":"ImageVariation","url":"https://assets.4cdn.hu/kraken/8LtkMtVlOk6LmOWGs-sm.jpeg","size":"sm","width":640,"height":427},{"__typename":"ImageVariation","url":"https://assets.4cdn.hu/kraken/8LtkMtVlOk6LmOWGs-md.jpeg","size":"md","width":768,"height":512},{"__typename":"ImageVariation","url":"https://assets.4cdn.hu/kraken/8LtkMtVlOk6LmOWGs-lg.jpeg","size":"lg","width":1366,"height":911},{"__typename":"ImageVariation","url":"https://assets.4cdn.hu/kraken/8LtkMtVlOk6LmOWGs-xl.jpeg","size":"xl","width":1920,"height":1280},{"__typename":"ImageVariation","url":"https://assets.4cdn.hu/kraken/8LtkMtVlOk6LmOWGs-xxl.jpeg","size":"xxl","width":2560,"height":1707}]},"Author:2fda16e2-68cb-469a-9919-ea1eb9dadc5e":{"__typename":"Author","id":"2fda16e2-68cb-469a-9919-ea1eb9dadc5e","name":"Rovó Attila","avatar":"https://assets.4cdn.hu/kraken/838FyXjvkqaxWGWGs.jpeg?width=96\u0026height=96\u0026fit=crop","slug":"rovoa"},"Author:5448ff5b-7c80-42be-a9e7-b4ecf96b8813":{"__typename":"Author","id":"5448ff5b-7c80-42be-a9e7-b4ecf96b8813","name":"Tóth-Szenesi Attila","avatar":"https://assets.4cdn.hu/kraken/7vIf828A8bOm1Rrxus.jpeg?width=96\u0026height=96\u0026fit=crop","slug":"tothszenesia"},"Author:6cba2d25-9994-43cc-b220-239068a003f0":{"__typename":"Author","id":"6cba2d25-9994-43cc-b220-239068a003f0","name":"Bódog Bálint","avatar":"https://assets.4cdn.hu/kraken/7hwxGLtdChDIOwGWs.jpeg?width=96\u0026height=96\u0026fit=crop","slug":"bodogb"},"Format:7a6022ed-c587-11f0-9297-525400d76232":{"__typename":"Format","id":"7a6022ed-c587-11f0-9297-525400d76232","slug":"tldr","name":"TLDR","description":null,"url":"https://444.hu/format/tldr","mateType":"FEATURE"},"Article:3dfaa096-ebe8-5406-aca9-84df1206f3ed":{"__typename":"Article","id":"3dfaa096-ebe8-5406-aca9-84df1206f3ed","title":"Ez az a törvény, ami miatt magzatpózban sírhatnak a fideszesek","slug":"ez-az-a-torveny-ami-miatt-magzatpozban-sirhatnak-a-fideszesek","featuredImage":{"__ref":"MediaItem:dd7c132a-a77d-5350-9941-2c083c9a6214"},"excerpt":"Megszűnik több közérdekű vagyonkezelő alapítvány, amibe a Fidesz nagyon sokat tett. Nem csak anyagi értelemben – de persze úgy is. A lépéssel kastélyok, drága ingatlanok és több száz milliárd forintnyi részvénycsomag is visszakerül az államhoz. Néhánynak van esélye a túlélésre, szerényebb keretek között.","publishedAt":"2026-06-10T16:00:03+02:00","createdAt":"2026-06-10T16:00:07+02:00","authors":[{"__ref":"Author:2fda16e2-68cb-469a-9919-ea1eb9dadc5e"},{"__ref":"Author:5448ff5b-7c80-42be-a9e7-b4ecf96b8813"},{"__ref":"Author:6cba2d25-9994-43cc-b220-239068a003f0"},{"__ref":"Author:b6e04a12-64df-4b60-95a1-72155ed14bd6"}],"categories":[{"__ref":"Category:492b6bf0-019a-4f4a-a596-fec37b6676b1"}],"collections":[],"bucket":{"__ref":"Bucket:70b47701-2c71-55dc-95b1-7ac5be6b8a21"},"options":[{"__typename":"Option","key":"template","value":""},{"__typename":"Option","key":"locked","value":true},{"__typename":"Option","key":"language","value":"hu"},{"__typename":"Option","key":"color_scheme","value":"bright"},{"__typename":"Option","key":"is_anonym","value":false},{"__typename":"Option","key":"background_shadow","value":true},{"__typename":"Option","key":"title_inner","value":false},{"__typename":"Option","key":"lead_av","value":""},{"__typename":"Option","key":"jumbotron","value":"dd7c132a-a77d-5350-9941-2c083c9a6214"},{"__typename":"Option","key":"external_url","value":""},{"__typename":"Option","key":"title_alignment","value":"left bottom"},{"__typename":"Option","key":"comments_enabled","value":true},{"__typename":"Option","key":"stream","value":true}],"format":{"__ref":"Format:7a6022ed-c587-11f0-9297-525400d76232"},"partners":[],"url":"https://444.hu/2026/06/10/ez-az-a-torveny-ami-miatt-magzatpozban-sirhatnak-a-fideszesek"},"MediaItem:c924c14c-f767-52d6-8751-c6ce67c59105":{"__typename":"Image","caption":"","author":"Németh Dániel/444","url":"https://assets.4cdn.hu/kraken/8LXnkY5mO7sDmOWHs.jpeg","creditType":"Fotó","sourceLink":null,"bucket":{"__ref":"Bucket:70b47701-2c71-55dc-95b1-7ac5be6b8a21"},"id":"c924c14c-f767-52d6-8751-c6ce67c59105","width":3000,"height":2001,"variations":[{"__typename":"ImageVariation","url":"https://assets.4cdn.hu/kraken/8LXnkY5mO7sDmOWHs-xxs.jpeg","size":"xxs","width":96,"height":64},{"__typename":"ImageVariation","url":"https://assets.4cdn.hu/kraken/8LXnkY5mO7sDmOWHs-xs.jpeg","size":"xs","width":360,"height":240},{"__typename":"ImageVariation","url":"https://assets.4cdn.hu/kraken/8LXnkY5mO7sDmOWHs-sm.jpeg","size":"sm","width":640,"height":427},{"__typename":"ImageVariation","url":"https://assets.4cdn.hu/kraken/8LXnkY5mO7sDmOWHs-md.jpeg","size":"md","width":768,"height":512},{"__typename":"ImageVariation","url":"https://assets.4cdn.hu/kraken/8LXnkY5mO7sDmOWHs-lg.jpeg","size":"lg","width":1366,"height":911},{"__typename":"ImageVariation","url":"https://assets.4cdn.hu/kraken/8LXnkY5mO7sDmOWHs-xl.jpeg","size":"xl","width":1920,"height":1281},{"__typename":"ImageVariation","url":"https://assets.4cdn.hu/kraken/8LXnkY5mO7sDmOWHs-xxl.jpeg","size":"xxl","width":2560,"height":1708}]},"Article:57a78462-1a91-573b-ad68-123f4c1decf1":{"__typename":"Article","id":"57a78462-1a91-573b-ad68-123f4c1decf1","title":"Helyreigazította Orbán Balázst az MCC vezetése","slug":"helyreigazitotta-orban-balazst-az-mcc-vezetese","featuredImage":{"__ref":"MediaItem:c924c14c-f767-52d6-8751-c6ce67c59105"},"excerpt":"Orbán Balázs posztja után leírták, hogy semmi rendkívüli nem volt Ruff Bálint döntésében, és ők folytatni akarják.","publishedAt":"2026-07-06T16:27:22+02:00","createdAt":"2026-07-06T16:27:24+02:00","authors":[{"__ref":"Author:b6e04a12-64df-4b60-95a1-72155ed14bd6"}],"categories":[{"__ref":"Category:492b6bf0-019a-4f4a-a596-fec37b6676b1"}],"collections":[],"bucket":{"__ref":"Bucket:70b47701-2c71-55dc-95b1-7ac5be6b8a21"},"options":[{"__typename":"Option","key":"template","value":""},{"__typename":"Option","key":"language","value":"hu"},{"__typename":"Option","key":"color_scheme","value":""},{"__typename":"Option","key":"is_anonym","value":false},{"__typename":"Option","key":"background_shadow","value":false},{"__typename":"Option","key":"title_inner","value":false},{"__typename":"Option","key":"lead_av","value":""},{"__typename":"Option","key":"jumbotron","value":""},{"__typename":"Option","key":"external_url","value":""},{"__typename":"Option","key":"title_alignment","value":""},{"__typename":"Option","key":"comments_enabled","value":true},{"__typename":"Option","key":"stream","value":true}],"format":{"__ref":"Format:7a6036e1-c587-11f0-9297-525400d76232"},"partners":[],"url":"https://444.hu/2026/07/06/helyreigazitotta-orban-balazst-az-mcc-vezetese"},"Article:d73949ec-94de-5c09-b435-27ef8fab903d":{"__typename":"Article","id":"d73949ec-94de-5c09-b435-27ef8fab903d","featuredImage":{"__ref":"MediaItem:bac633dc-46c9-5312-b9bd-baa7ba1ec5b3"},"title":"Ruff Bálint aláírta: megszűnik az MCC alapítványa","body":[[{"type":"core/paragraph","params":{},"content":"Július 31-ével megszűnik a Mathias Corvinus Collegium Alapítvány, miután Ruff Bálint Miniszterelnökséget végző miniszter aláírta az erről szóló döntést."},{"type":"core/paragraph","params":{},"content":"Az MCC alapítványa is egy olyan kekva, amely nem felsőoktatási intézményt tart fenn, ezért a törvény értelmében a hónap végén megszűnik ebben a formában. "},{"type":"image","params":{"src":"https://4cdn.hu/kraken/image/upload/s--UdnGA4sJ--/c_limit,w_760/8MYI3BnJqe7NBPAIs.png","id":"4951d738-7ccf-50f1-8b63-fc69296e7025","showauthor":"true","alt":"","link":"","mediaItem":{"__typename":"Image","id":"4951d738-7ccf-50f1-8b63-fc69296e7025","author":"Orbán Balázs/Facebook","bucket":{"id":"70b47701-2c71-55dc-95b1-7ac5be6b8a21","slug":"444","name":"444","__typename":"Bucket"},"caption":"","creditType":"Fotó","sourceLink":null,"url":"https://assets.4cdn.hu/kraken/8MYI3BnJqe7NBPAIs.png","height":638,"width":707,"variations":[{"__typename":"ImageVariation","height":87,"width":96,"size":"xxs","url":"https://assets.4cdn.hu/kraken/8MYI3BnJqe7NBPAIs-xxs.png"},{"__typename":"ImageVariation","height":325,"width":360,"size":"xs","url":"https://assets.4cdn.hu/kraken/8MYI3BnJqe7NBPAIs-xs.png"},{"__typename":"ImageVariation","height":578,"width":640,"size":"sm","url":"https://assets.4cdn.hu/kraken/8MYI3BnJqe7NBPAIs-sm.png"},{"__typename":"ImageVariation","height":693,"width":768,"size":"md","url":"https://assets.4cdn.hu/kraken/8MYI3BnJqe7NBPAIs-md.png"},{"__typename":"ImageVariation","height":1233,"width":1366,"size":"lg","url":"https://assets.4cdn.hu/kraken/8MYI3BnJqe7NBPAIs-lg.png"},{"__typename":"ImageVariation","height":1733,"width":1920,"size":"xl","url":"https://assets.4cdn.hu/kraken/8MYI3BnJqe7NBPAIs-xl.png"},{"__typename":"ImageVariation","height":2310,"width":2560,"size":"xxl","url":"https://assets.4cdn.hu/kraken/8MYI3BnJqe7NBPAIs-xxl.png"}]}},"content":"Ruff döntése"},{"type":"core/paragraph","params":{},"content":"Az MCC alapítvánnyal együtt 15 kekva szűnik meg ezzel a határidővel, de \u003ca href=\"https://444.hu/2026/06/10/ez-az-a-torveny-ami-miatt-magzatpozban-sirhatnak-a-fideszesek\" target=\"_blank\" \u003ea törvény kimondja\u003c/a\u003e, hogy azok a szervezetek, amelyeket nem az állam hozott létre, működhetnek tovább alapítványként, ha az eredeti alapító ezt kéri."},{"type":"core/paragraph","params":{},"content":"Természetesen onnantól a több százmilliárd forintnyi állami vagyon nélkül kell boldogulniuk. Az MCC az egyik érintett, ahol az alapító korábban már közölte, folytatni akarják. Kérdés, hogy hogyan."},{"type":"core/paragraph","params":{},"content":"Orbán Balázs volt kuratóriumi elnök a Facebookon ugyanis \u003ca href=\"https://www.facebook.com/photo/?fbid=1655603939268302\u0026amp;set=a.386873116141397\" target=\"_blank\" \u003earról írt\u003c/a\u003e, értelmetlen pusztítás, rombolás és bosszú megszüntetni egy tehetséggondozással foglalkozó intézményt. "},{"type":"core/paragraph","params":{},"content":"Noha Orbán csak a tehetséggondozást, a kutatásokat és a 8000 diák és a tanárok elküldését emelte ki, az MCC jóval több volt ennél, valójában ez lett a Fidesz ideológiai hátországának legfontosabb intézménye. "},{"type":"image","params":{"src":"https://4cdn.hu/kraken/image/upload/s--G4aTlaT1--/c_limit,w_760/8MYB9a0anwghmOWHs.jpeg","id":"bac633dc-46c9-5312-b9bd-baa7ba1ec5b3","showauthor":"true","alt":"","link":"","mediaItem":{"caption":"","author":"Németh Dániel/444","url":"https://assets.4cdn.hu/kraken/8MYB9a0anwghmOWHs.jpeg","creditType":"Fotó","sourceLink":null,"bucket":{"id":"70b47701-2c71-55dc-95b1-7ac5be6b8a21","slug":"444","name":"444","__typename":"Bucket"},"__typename":"Image","id":"bac633dc-46c9-5312-b9bd-baa7ba1ec5b3","width":3000,"height":2001,"variations":[{"url":"https://assets.4cdn.hu/kraken/8MYB9a0anwghmOWHs-xxs.jpeg","size":"xxs","width":96,"height":64,"__typename":"ImageVariation"},{"url":"https://assets.4cdn.hu/kraken/8MYB9a0anwghmOWHs-xs.jpeg","size":"xs","width":360,"height":240,"__typename":"ImageVariation"},{"url":"https://assets.4cdn.hu/kraken/8MYB9a0anwghmOWHs-sm.jpeg","size":"sm","width":640,"height":427,"__typename":"ImageVariation"},{"url":"https://assets.4cdn.hu/kraken/8MYB9a0anwghmOWHs-md.jpeg","size":"md","width":768,"height":512,"__typename":"ImageVariation"},{"url":"https://assets.4cdn.hu/kraken/8MYB9a0anwghmOWHs-lg.jpeg","size":"lg","width":1366,"height":911,"__typename":"ImageVariation"},{"url":"https://assets.4cdn.hu/kraken/8MYB9a0anwghmOWHs-xl.jpeg","size":"xl","width":1920,"height":1281,"__typename":"ImageVariation"},{"url":"https://assets.4cdn.hu/kraken/8MYB9a0anwghmOWHs-xxl.jpeg","size":"xxl","width":2560,"height":1708,"__typename":"ImageVariation"}]}},"content":""},{"type":"core/paragraph","params":{},"content":"A Tisza-kormány pedig azért szünteti meg a kekvákat, mert a Fidesz egy \u003ca href=\"https://444.hu/2026/05/20/a-kormany-belenyul-a-ner-parhuzamos-valosagaba-visszaveszik-a-kiszervezett-kekva-kat\" target=\"_blank\" \u003epárhuzamos valóságot épített ki\u003c/a\u003e, közpénzszázmilliárdokkal kitömve. Az MCC ügyében azért Ruff döntött, mert ez a kekva hozzá került. "},{"type":"core/paragraph","params":{},"content":"\u003cb \u003eFrissítés:\u003c/b\u003e Orbán Balázs posztja után az MCC vezetése fontosnak tartotta \u003ca href=\"https://444.hu/2026/07/06/helyreigazitotta-orban-balazst-az-mcc-vezetese\" target=\"_blank\" \u003ehelyreigazítani\u003c/a\u003e a volt kuratóriumi elnököt. Közölték, hogy a döntésben semmi váratlan nincs, hiszen az a törvényből következik, a kormánnyal egyeztetnek és folytatni akarják a tehetséggondozást a a jelenlegi számokkal."}]],"slug":"ruff-balint-alairta-megszunik-az-mcc-alapitvanya","publishedAt":"2026-07-06T15:38:14+02:00","bucket":{"__ref":"Bucket:70b47701-2c71-55dc-95b1-7ac5be6b8a21"},"excerpt":"Orbán Balázs a tehetséggondozást sajnálja, de közben az MCC a Fidesz ideológiai hátterének egyik legfontosabb intézménye volt.","createdAt":"2026-07-06T15:38:14+02:00","updatedAt":"2026-07-06T16:49:32+02:00","authors":[{"__ref":"Author:b6e04a12-64df-4b60-95a1-72155ed14bd6"}],"categories":[{"__ref":"Category:492b6bf0-019a-4f4a-a596-fec37b6676b1"}],"tags":[{"__ref":"Tag:1bd8821e-ad74-40e5-a59d-532c6a9f8732"},{"__ref":"Tag:b11931b8-d3e0-4859-acad-1612552f00b8"},{"__ref":"Tag:ca82d16f-6347-404d-9496-21b1cb540be7"}],"collections":[],"meta":[{"__typename":"Meta","key":"description","value":""},{"__typename":"Meta","key":"excerpt","value":"Orbán Balázs a tehetséggondozást sajnálja, de közben az MCC a Fidesz ideológiai hátterének egyik legfontosabb intézménye volt."},{"__typename":"Meta","key":"featuredImage","value":"bac633dc-46c9-5312-b9bd-baa7ba1ec5b3"},{"__typename":"Meta","key":"og:description","value":""},{"__typename":"Meta","key":"og:image","value":""},{"__typename":"Meta","key":"og:title","value":""},{"__typename":"Meta","key":"title","value":""}],"options":[{"__typename":"Option","key":"template","value":""},{"__typename":"Option","key":"language","value":"hu"},{"__typename":"Option","key":"color_scheme","value":""},{"__typename":"Option","key":"is_anonym","value":false},{"__typename":"Option","key":"background_shadow","value":false},{"__typename":"Option","key":"title_inner","value":false},{"__typename":"Option","key":"lead_av","value":""},{"__typename":"Option","key":"jumbotron","value":""},{"__typename":"Option","key":"external_url","value":""},{"__typename":"Option","key":"title_alignment","value":""},{"__typename":"Option","key":"comments_enabled","value":true},{"__typename":"Option","key":"stream","value":true}],"url":"https://444.hu/2026/07/06/ruff-balint-alairta-megszunik-az-mcc-alapitvanya","format":{"__ref":"Format:7a6036e1-c587-11f0-9297-525400d76232"},"partners":[],"relatedArticles":[{"__ref":"Article:0a915a78-6f82-5479-98d9-5d176c24d3d4"},{"__ref":"Article:3dfaa096-ebe8-5406-aca9-84df1206f3ed"},{"__ref":"Article:57a78462-1a91-573b-ad68-123f4c1decf1"}],"userHasAccess":true},"ROOT_QUERY":{"__typename":"Query","content({\"fromBucket\":{\"column\":\"SLUG\",\"operator\":\"IN\",\"value\":[\"444\",\"jo\"]},\"publishedAt\":\"2026-07-06\",\"slug\":\"ruff-balint-alairta-megszunik-az-mcc-alapitvanya\"})":{"__ref":"Article:d73949ec-94de-5c09-b435-27ef8fab903d"}}}}</script><script type="fastboot/shoebox" id="shoebox-abgroup">"2"</script><script type="x/boundary" id="fastboot-body-end"></script>

    
