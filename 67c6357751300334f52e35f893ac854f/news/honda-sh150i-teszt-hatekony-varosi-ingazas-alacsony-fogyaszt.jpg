er?",1783761188,1783762626,"ragaszkodunk-a-bankszamlaszamhoz-pedig-mar-meglehetnenk-nelkule-miert-nem-robban-be-a-fintech-modszer",[44],{"id":45,"authorId":46,"name":47,"email":48,"slug":49,"avatarSrc":50,"position":51,"information":32,"title":52,"facebookUrl":50,"linkedinUrl":53,"organization":54},231387,1343,"Barát Mihály Tamás","g7@g7.hu","barat-mihaly-tamas","",0,"BiztosDöntés","https://www.linkedin.com/in/mih%C3%A1ly-tam%C3%A1s-barat-2852415b/","https://biztosdontes.hu/rolunk/barat-mihaly-tamas","A bevezetés óta eltelt hat év után sem éri el az egy százalékot azoknak a bankszámláknak az aránya, amelyhez másodlagos számlaazonosítót – például email címet vagy telefonszámot – kapcsoltak a magyarok. A BiztosDöntés.hu számításai szerint így százezer alatt lehet azoknak a lakossági és céges számláknak a száma, amelyeknél ezt használhatják. Hiába nagyon praktikus és könnyíti meg az átutalást, pénzküldést, egyelőre nem kaptunk rá erre a lehetőségre.",{"id":57,"name":58,"slug":59,"siteSlug":60,"active":8},56,"PR-cikk","pr-cikk","g7",[62],{"id":63,"name":64,"slug":65,"siteSlug":17,"active":8},58,"Biztos Döntés","biztos-dontes",[67],{"id":68,"name":69,"slug":70},5,"Reklámmentes","pr","/uploads/images/20260710/1783688673-temp-3pkdohi81b9j6cdnkob.jpg","/uploads/images/20260710/1783688714-temp-q9h13fbto4q0akdgngf.jpg","/uploads/images/20260710/1783688734-temp-7l3tpqe8d4qc9mjfkbp.jpg",4,[17],"Hiába nagyon praktikus és könnyíti meg az átutalást, pénzküldést, egyelőre nem kaptunk rá erre a lehetőségre.","https://audio-assets.telex.hu/20260711/1783762602-in1igc1rt1tabkgghfi.mp3","https://assets.telex.hu/images/20260710/1783688673-temp-3pkdohi81b9j6cdnkob_recommender-kedvenc.jpg",{"id":80,"type":38,"title":81,"pubDate":82,"updatedAt":82,"deletedAt":32,"version":83,"slug":84,"articleAuthors":85,"lead":92,"mainSuperTag":93,"superTags":96,"flags":97,"live":9,"recommendedBoxImage":103,"mobileImage43":104,"mobileImage11":105,"active":8,"rank":74,"mirroringSites":106,"recommender":107,