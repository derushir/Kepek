<script>
	window.dataLayer = window.dataLayer || [];
	window.dataLayer.push({
		'PageTitle': 'A nyári foci vb-ig Magyarországra is elhozza a világ legkülönlegesebb tévéjét az LG, mutatjuk mit tud',
		'PageType': 'article',
	});



	function containsObject(arr, obj) {
		for (let i = 0; i < arr.length; i++) {
			if (JSON.stringify(arr[i]) === JSON.stringify(obj)) {
				return true;
			}
		}
		return false;
	}

	window.postData = window.postData || {};
	if (!containsObject(window.dataLayer, window.postData)) {
		window.dataLayer.push(window.postData);
	}
</script>
