	<!-- Process AutoLogin -->
	<script>
		(() => {
			var urlParams = new URLSearchParams(window.location.search);
			var token = urlParams.get('autologin');
			if (token) {
        urlParams.delete('autologin');

        const currentUrl = new URL(window.location.href);
        currentUrl.search = urlParams.toString();

        const backUrl = currentUrl.toString().replace(/\/(\?|#|$)/, '/$1').replace(/\?$/, '');

        const baseUrl = 'https://elofizetes.forbes.hu/';
        const loginUrl = `${baseUrl}/sign/processAutoLogin/${token}?back=${encodeURIComponent(backUrl)}`;

				document.documentElement.classList.add('no-scroll');
				window.location.href = loginUrl;
			}
		})();
	</script>

