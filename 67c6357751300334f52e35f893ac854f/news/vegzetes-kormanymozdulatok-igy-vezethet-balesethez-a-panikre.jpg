              <picture><source srcset="/media/images/Screenshot_2026-06-30_at_9.15.format-avif.max-1440x1024.avif" type="image/avif"><source srcset="/media/images/Screenshot_2026-06-30_at_9.15.format-webp.max-1440x1024.webp" type="image/webp"><img alt="" class="max-h-[90vh] max-w-[90vw] sm:min-h-[500px] sm:min-w-[500px] object-contain shadow-xl" height="594" loading="lazy" src="/media/images/Screenshot_2026-06-30_at_9.15..format-jpeg.max-1440x1024.jpg" width="812"></picture>
            
