    <script>
    document.addEventListener('DOMContentLoaded', () => {
        (document.querySelectorAll('.notification .delete') || []).forEach(($delete) => {
            let $notification = $delete.parentNode;
            $delete.addEventListener('click', () => {
                $notification.parentNode.removeChild($notification);
            });
        });
    });
</script>

    <script>
        function syncDarkMode() {
            // Standard Tailwind CSS class-based dark mode
            const darkTheme = 'dark' || 'dark';
            const lightTheme = 'light' || 'light';
            const systemTheme = 'auto';

            const theme = localStorage.getItem('theme') || systemTheme;
            const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;

            if (theme === darkTheme || (theme === systemTheme && prefersDark)) {
                document.documentElement.classList.add('dark');
                document.cookie = `theme=${darkTheme};path=/;max-age=31536000`;
            } else {
                document.documentElement.classList.remove('dark');
                document.cookie = `theme=${lightTheme};path=/;max-age=31536000`;
            }
        }

        syncDarkMode();

        document.addEventListener('DOMContentLoaded', () => {
            // Watch for changes in the prefers-color-scheme
            const mediaQuery = window.matchMedia('(prefers-color-scheme: dark)');
            mediaQuery.addEventListener('change', syncDarkMode);

            // Watch for theme changes - controlled by the selector in the nav
            window.addEventListener('storage', (event) => {
                if (event.key === 'theme') {
                    syncDarkMode();
                }
            });
        });
    </script>

    





<script>
    window.googletag = window.googletag || {
        cmd: []
    };
    

    // Sales (w2g) creatives inject an inline !important full-width wrapper that breaks out of the subpage MobileBanner box, so we scale it down to fit (the homepage full-bleed variant is untouched).
    // The sales safeframe wrapper has a path-style id (e.g. "/26225854,.../Mobil_aloldal_BTF").
    const SALES_BREAKOUT_SELECTOR = 'div[id^="/"]';

    function scaleToBox(wrapper, salesDiv) {
        if (salesDiv.dataset.neonFitted) return;
        salesDiv.dataset.neonFitted = "1";

        // Animated creatives resize themselves continuously, so observer-driven runs are debounced and end in a no-op once the scale has settled.
        const ENFORCE_DEBOUNCE_MS = 200;
        const ZOOM_EPSILON = 0.01;
        const OFFSET_TOLERANCE_PX = 1;

        let styleObserver;
        let sizeObserver;
        let appliedZoom = 1;
        let maxNatural = 0;

        function connectObservers() {
            if (styleObserver) {
                styleObserver.observe(salesDiv, {
                    attributes: true,
                    attributeFilter: ["style"],
                });
            }
            if (sizeObserver) {
                sizeObserver.observe(salesDiv);
                sizeObserver.observe(wrapper);
            }
        }

        function teardown() {
            if (styleObserver) styleObserver.disconnect();
            if (sizeObserver) sizeObserver.disconnect();
            styleObserver = null;
            sizeObserver = null;
        }

        function enforce() {
            // Detach while we write so our own changes do not retrigger the observers.
            if (styleObserver) styleObserver.disconnect();
            if (sizeObserver) sizeObserver.disconnect();

            // The creative is gone (ad refresh, slot removal), so stop for good and let the observers and this closure be collected.
            if (!salesDiv.isConnected) {
                teardown();
                return;
            }

            // Read pass: take every measurement up front so the write pass below cannot force a synchronous layout in between.
            // clientWidth assumes .mobile-ad-container has no horizontal padding; otherwise it (padding-box) would let the creative overhang the content area.
            const boxWidth = wrapper.clientWidth;
            const boxRect = wrapper.getBoundingClientRect();
            const salesRect = salesDiv.getBoundingClientRect();
            const currentMargin = parseFloat(getComputedStyle(salesDiv).marginLeft) || 0;

            // Derive the unscaled width from what is actually rendered instead of stripping the zoom to measure it, because that strip-measure-reapply cycle is what made animated creatives flicker.
            const natural = salesRect.width / appliedZoom;
            // Sticky maximum: an animating creative oscillates in width, and following every dip would pulse it, so the scale only ever tracks its widest observed state.
            if (natural > maxNatural) maxNatural = natural;
            const targetZoom = (boxWidth && maxNatural > boxWidth) ? boxWidth / maxNatural : 1;
            // Align by measuring the real offset rather than by reasoning about margins: the sales code keeps re-injecting margin-left:-16px, and under zoom both auto and 0 margins resolve against the pre-zoom width, which shifts the creative sideways.
            // A scaled creative fills the box; an unscaled narrower one is centred.
            const targetLeft = boxRect.left + Math.max(0, (boxRect.width - salesRect.width) / 2);
            const offset = salesRect.left - targetLeft;

            // Write pass. Only write when something meaningfully changed, so a settled creative stops causing style writes altogether.
            const zoomChanged = Math.abs(targetZoom - appliedZoom) > ZOOM_EPSILON;
            if (zoomChanged) {
                appliedZoom = targetZoom;
                // Deliberately zoom, not transform: scale — zoom scales the layout box too, so no height compensation is needed. Trade-off: unsupported on Firefox < 126, which never renders this mobile-only slot. Do not "simplify" to transform.
                if (targetZoom < 1) {
                    salesDiv.style.setProperty("zoom", targetZoom.toString(), "important");
                } else {
                    salesDiv.style.removeProperty("zoom");
                }
            }
            if (Math.abs(offset) > OFFSET_TOLERANCE_PX) {
                // Cancel the measured offset in the element's own units, since zoom scales its margins too.
                salesDiv.style.setProperty("margin-left", (currentMargin - offset / appliedZoom) + "px", "important");
                salesDiv.style.setProperty("margin-right", "0px", "important");
            }

            if (zoomChanged) {
                requestAnimationFrame(enforce);
            } else {
                connectObservers();
            }
        }

        // Debounce on a timer rather than per frame, so a creative that animates its own size cannot drive one re-scale per frame.
        let timer = null;
        function scheduleEnforce() {
            if (timer) return;
            timer = setTimeout(function() {
                timer = null;
                enforce();
            }, ENFORCE_DEBOUNCE_MS);
        }

        requestAnimationFrame(function() {
            // Create the observers before the first enforce() so it wires them up itself. They stay alive for the element's lifetime:
            // the sales code re-injects the breakout margin repeatedly (including after a lazy re-render on scroll-back), and the
            // creative can also grow without touching its own style attribute (inner iframe resize) while the box changes on orientation change.
            styleObserver = new MutationObserver(scheduleEnforce);
            if (window.ResizeObserver) sizeObserver = new ResizeObserver(scheduleEnforce);
            enforce();
        });
    }

    function fitMobileBannerAd(wrapper) {
        if (!wrapper.classList.contains("mobile-ad-container")) return;

        function processBreakouts() {
            wrapper.querySelectorAll(SALES_BREAKOUT_SELECTOR).forEach(function(el) {
                scaleToBox(wrapper, el);
            });
        }

        processBreakouts();

        // slotRenderEnded can fire again on refresh, so set up the box observer only once (it stays alive to catch a fresh breakout div from a lazy re-render).
        if (wrapper.dataset.neonFitObserving) return;
        wrapper.dataset.neonFitObserving = "1";

        function holdsBreakout(node) {
            return node.nodeType === Node.ELEMENT_NODE
                && (node.matches(SALES_BREAKOUT_SELECTOR) || node.querySelector(SALES_BREAKOUT_SELECTOR));
        }

        const observer = new MutationObserver(function(mutations) {
            if (!wrapper.isConnected) {
                observer.disconnect();
                return;
            }
            // Only re-scan when an added node actually holds a breakout wrapper; an animated creative churns out plenty of unrelated nodes.
            const relevant = mutations.some(function(m) {
                return Array.from(m.addedNodes).some(holdsBreakout);
            });
            if (relevant) processBreakouts();
        });
        observer.observe(wrapper, { childList: true, subtree: true });
    }

    /**
     * Initializes Google Publisher Tags (GPT) event listeners.
     * Manages the visibility of ad containers based on whether an ad was successfully rendered or left empty,
     * ensuring proper viewability measurement and layout stability.
     */
    function definePubadsListeners() {
        googletag.pubads().addEventListener('slotRenderEnded', function(event) {
            const slotId = event.slot.getSlotElementId();
            const slot = document.getElementById(slotId);
            if (!slot) return;

            const isInsideGallerySlide = !!slot.closest(".is-ad");

            if (event.isEmpty) {
                // If the ad slot is empty: forcefully hide the immediate wrapper container
                const immediateWrapper = slot.closest('.advertisement');
                if (immediateWrapper) {
                    immediateWrapper.classList.remove("ad-loaded");
                    immediateWrapper.classList.add("ad-empty");
                    immediateWrapper.dataset.gptFilled = "false";

                    // Override all CSS and layout calculations to ensure complete invisibility
                    immediateWrapper.style.setProperty('display', 'none', 'important');
                    immediateWrapper.style.setProperty('height', '0', 'important');
                    immediateWrapper.style.setProperty('min-height', '0', 'important');
                    immediateWrapper.style.setProperty('padding', '0', 'important');
                    immediateWrapper.style.setProperty('margin', '0', 'important');
                    immediateWrapper.style.setProperty('border', '0', 'important');
                    immediateWrapper.style.setProperty('overflow', 'hidden', 'important');
                }
                if (isInsideGallerySlide) {
                    document.dispatchEvent(new CustomEvent("ad-slot-hidden"));
                }
            } else {
                // If an ad is loaded: forcefully display all parent wrapper containers up the DOM tree
                let currentEl = slot;
                while (currentEl) {
                    let wrapper = currentEl.closest('.advertisement');
                    if (!wrapper) break;

                    wrapper.classList.add("ad-loaded");
                    wrapper.dataset.gptFilled = "true";
                    fitMobileBannerAd(wrapper);

                    wrapper.style.setProperty('height', 'auto', 'important');
                    wrapper.style.setProperty('min-height', '50px', 'important');
                    wrapper.style.setProperty('display', 'block', 'important');
                    wrapper.style.setProperty('overflow', 'visible', 'important');

                    // Traverse up to the next parent element
                    currentEl = wrapper.parentElement;
                }
            }
        });
    }

    googletag.cmd.push(definePubadsListeners);
</script>



    
  <script>
    document.addEventListener("DOMContentLoaded", function() {
        function updateLeft() {
            const hahuContainer = document.querySelectorAll('.hasznaltauto-wrapper');

            for (let i = 0; i < hahuContainer.length; i++) {
                if (!JSON.parse(hahuContainer[i].getAttribute("data-widget-adjust"))) {
                    continue;
                }
                const hahuCardWidth = parseInt(hahuContainer[i].getAttribute("data-widget-width"));
                const containerWidth = hahuContainer[i].offsetWidth - 32;
                const padding = (containerWidth - hahuCardWidth) / 2;
                hahuContainer[i].style["padding-left"] = `${padding}px`;
                // Adjust the advertisement label position
                // to align with the left padding
                const adLabel = hahuContainer[i].querySelector(".advertisement-label")
                adLabel.style["margin-left"] = `-${padding / 2}px`;
            }

        }
        window.addEventListener('resize', updateLeft);
        updateLeft();
    });
</script>



