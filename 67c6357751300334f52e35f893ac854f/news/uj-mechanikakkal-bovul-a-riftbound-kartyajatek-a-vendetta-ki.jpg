-elements-objectBlock-items-shape: rounded; --theme-elements-objectBlock-items-border: 0; --theme-elements-schedule-background: transparent; --theme-elements-schedule-border-width: 0; --theme-elements-schedule-border-style: solid; --theme-elements-schedule-border-color: transparent; --theme-elements-schedule-heading: #f6f8f7; --theme-elements-schedule-padding: 0; --theme-elements-schedule-card-background: rgba(138, 147, 153, 0.15); --theme-elements-schedule-card-text-default: #f6f8f7; --theme-elements-schedule-card-text-hover: #edf2ef; --theme-elements-schedule-card-alt-background: #bf1313; --theme-elements-schedule-card-alt-border: #bf1313; --theme-elements-schedule-card-alt-text-default: #f6f8f7; --theme-elements-schedule-card-alt-text-hover: #ffffff; --theme-elements-columns-background: transparent; --theme-elements-columns-border-width: 0; --theme-elements-columns-border-style: solid; --theme-elements-columns-border-color: transparent; --theme-elements-columns-heading: #f6f8f7; --theme-elements-columns-padding: 0; --theme-elements-columns-items-border: 0; --theme-elements-columns-items-divider: rgba(138, 147, 153, 0.25); --theme-elements-columns-items-shape: roundedTiny; --theme-elements-columns-items-text-data: #bbc4c4; --theme-elements-columns-items-text-default: #ffffff; --theme-elements-columns-items-text-hover: #edf2ef; --theme-elements-columns-items-text-muted: #f6f8f7; --theme-elements-columns-items-overlay-text: #ffffff; --theme-elements-columns-items-overlay-textShadow: none; --theme-elements-columns-items-background: #283044; --theme-elements-sponsorBlock-background: #181c25; --theme-elements-sponsorBlock-border-width: 0; --theme-elements-sponsorBlock-border-style: solid; --theme-elements-sponsorBlock-border-color: transparent; --theme-elements-sponsorBlock-heading: #ffffff; --theme-elements-sponsorBlock-padding: 0; --theme-elements-sponsorBlock-text-default: #f6f8f7; --theme-elements-sponsorBlock-text-muted: #edf2ef; --theme-elements-sponsorBlock-icon-default-background: #d3ddd9; --theme-elements-sponsorBlock-icon-default-text: #181c25; --theme-elements-sponsorBlock-icon-active-background: #bbc4c4; --theme-elements-sponsorBlock-icon-active-text: #09090b; --theme-elements-oneUp-background: #181c25; --theme-elements-oneUp-border-width: 0; --theme-elements-oneUp-border-style: solid; --theme-elements-oneUp-border-color: transparent; --theme-elements-oneUp-heading: #ffffff; --theme-elements-oneUp-padding: 0; --theme-elements-oneUp-blur: linear-gradient(to bottom, rgba(27, 28, 29, 0) 0%, rgba(27, 28, 29, 0.25) 100%); --theme-elements-oneUpVideo-background: #181c25; --theme-elements-oneUpVideo-border-width: 0; --theme-elements-oneUpVideo-border-style: solid; --theme-elements-oneUpVideo-border-color: transparent; --theme-elements-oneUpVideo-heading: #ffffff; --theme-elements-oneUpVideo-padding: 0; --theme-elements-oneUpVideo-blur: rgba(27, 28, 29, 0.5); --theme-elements-catalog-background: transparent; --theme-elements-catalog-border-width: 0; --theme-elements-catalog-border-style: solid; --theme-elements-catalog-border-color: transparent; --theme-elements-catalog-heading: #f6f8f7; --theme-elements-catalog-padding: 0; --theme-elements-catalog-card-background: #283044; --theme-elements-catalog-card-border: rgba(138, 147, 153, 0.25); --theme-elements-catalog-card-heading: #f6f8f7; --theme-elements-catalog-card-text-default: #f6f8f7; --theme-elements-catalog-card-text-hover: #edf2ef; --theme-elements-catalog-card-sponsored-background: #09090b; --theme-elements-catalog-card-sponsored-heading: #d3ddd9; --theme-elements-video-background: #09090b; --theme-elements-video-border-width: 0; --theme-elements-video-border-style: solid; --theme-elements-video-border-color: transparent; --theme-elements-video-heading: #ffffff; --theme-elements-video-padding: 24px 0; --theme-elements-video-icon-default: #edf2ef; --theme-elements-video-icon-hover: #ffffff; --theme-elements-videoDuration-background: rgba(27, 28, 29, 0.85); --theme-elements-videoDuration-text-default: #f6f8f7; --theme-elements-poll-background: transparent; --theme-elements-poll-border-width: 0; --theme-elements-poll-border-style: solid; --theme-elements-poll-border-color: transparent; --theme-elements-poll-heading: #f6f8f7; --theme-elements-poll-padding: 0; --theme-elements-poll-items-border: 0; --theme-elements-poll-items-divider: rgba(138, 147, 153, 0.5); --theme-elements-poll-items-shape: rounded; --theme-elements-poll-items-text-data: #ffffff; --theme-elements-poll-items-text-default: #ffffff; --theme-elements-poll-items-text-hover: #edf2ef; --theme-elements-poll-items-text-muted: #d3ddd9; --theme-elements-poll-items-background: #283044; --theme-elements-deals-background: rgba(138, 147, 153, 0.25); --theme-elements-deals-border: 0; --theme-elements-deals-divider: rgba(138, 147, 153, 0.25); --theme-elements-deals-text-data: #ffffff; --theme-elements-deals-text-default: #f6f8f7; --theme-elements-deals-text-hover: #edf2ef; --theme-elements-deals-text-muted: #d3ddd9; --theme-elements-dataBar-header-background: #202634; --theme-elements-dataBar-header-button-default: #f6f8f7; --theme-elements-dataBar-header-button-hover: #ffffff; --theme-elements-dataBar-label: #f6f8f7; --theme-elements-dataBar-greenLabel: #99d000; --theme-elements-dataBar-orangeLabel: #b97e39; --theme-elements-dataBar-redLabel: #ff583d; --theme-elements-feedback-background: transparent; --theme-elements-feedback-border: rgba(138, 147, 153, 0.5); --theme-elements-feedback-question: #d3ddd9; --theme-elements-feedback-byline: #ffffff; --theme-elements-ad-background: rgba(138, 147, 153, 0.15); --theme-elements-ad-text: #d3ddd9; --theme-elements-forms-info-background: rgba(246, 248, 247, 0.1); --theme-elements-forms-info-border: rgba(246, 248, 247, 0.4); --theme-elements-forms-info-icon: #f6f8f7; --theme-elements-forms-error-background: rgba(248, 81, 73, 0.1); --theme-elements-forms-error-border: rgba(248, 81, 73, 0.4); --theme-elements-forms-error-icon: #F85149; --theme-elements-forms-success-background: rgba(57, 202, 106, 0.1); --theme-elements-forms-success-border: rgba(57, 202, 106, 0.4); --theme-elements-forms-success-icon: #39CA6A; --theme-elements-forms-warn-background: rgba(255, 136, 17, 0.1); --theme-elements-forms-warn-border: rgba(255, 136, 17, 0.4); --theme-elements-forms-warn-icon: #FF8811; --theme-elements-signIn-footer-border: rgba(211, 221, 217, 0.4); --theme-elements-faceoff-instructions-background: #181c25; --theme-elements-faceoff-instructions-caption: #d3ddd9; --theme-elements-faceoff-instructions-text: #f6f8f7; --theme-elements-tooltip-color: #181c25; --theme-elements-tooltip-background: #ffffff;;}</style><style id="__jsx-1166515047">#page.jsx-1166515047{display:-webkit-box;display:-webkit-flex;display:-ms-flexbox;display:flex;-webkit-flex-direction:column;-ms-flex-direction:column;flex-direction:column;min-height:100%;}#main-content.jsx-1166515047{-webkit-flex:1 0 auto;-ms-flex:1 0 auto;flex:1 0 auto;}#ow-notifications-wrapper.jsx-1166515047{position:absolute;top:calc(var(--headerHeightMedium));right:70px;z-index:calc(var(--maxZIndex) + 1);}#ow-notifications-wrapper.sidebar.jsx-1166515047{right:unset;top:calc(50% - 245px);left:calc(50% + 180px);}#ow-notifications-wrapper.jsx-1166515047>#ow-notifications.jsx-1166515047{position:fixed;}header,footer{-webkit-flex-shrink:0;-ms-flex-negative:0;flex-shrink:0;}</style><style id="__jsx-4250020241">@media (min-width: 1281px){#page{margin-left:var(--sidebarWidth);}#page .fixed-header{width:calc(100% - var(--sidebarWidth));}}</style></head><body><script id="__NEXT_DATA__" type="application/json">{"props":{"pageProps":{"page":{"canonical":"/articles/riftbound-vendetta-hands-on-preview-zed-vs-shen-showdown-deck-and-new-keywords-interview","routeName":"articles-show-slug","__typename":"ArticleContent","state":"Published","updatedAt":"2026-07-17T06:05:23.501Z","modifications":true,"comments":true,"ads":true,"headerImageUrl":null,"excerpt":"I played the Vendetta Zed vs. Shen Showdown decks with Riftbound game designer Jon Moormann, who spoke in depth about the new mechanics and keywords: Empower, Burn, and Flow. ","contributors":[{"__typename":"Contributor","authorId":3343491,"thumbnailUrl":"https://assets-prd.ignimgs.com/avatars/4ec71221e4b0ca04b5aac16d/profpic_copy-1647109546142.jpg","id":"6760e687-b4b0-11ea-b2e3-0e7c1d759882","name":"Casey DeFreitas","nickname":"Zenayru"}],"vertical":"Games","hrefLangs":{},"eventSlugs":["Summer-of-Gaming"],"events":["Summer-of-Gaming"],"attributes":[{"__typename":"TypedAttribute","type":"Publisher","attribute":{"__typename":"Attribute","name":"Riot Games"}},{"__typename":"TypedAttribute","type":"Producer","attribute":{"__typename":"Attribute","name":"Riot Games"}},{"__typename":"TypedAttribute","type":"Platform","attribute":{"__typename":"Attribute","name":"Tabletop"}},{"__typename":"TypedAttribute","type":"Genre","attribute":{"__typename":"Attribute","name":"Trading Card Game (TCG)"}},{"__typename":"TypedAttribute","type":"Franchise","attribute":{"__typename":"Attribute","name":"League of Legends"}}],"primaryObject":{"__typename":"Object","primaryImage":{"__typename":"Image","url":"https://assets-prd.ignimgs.com/2025/06/28/riftbound-button-1751112461531.jpg"},"franchises":[{"__typename":"Attribute","name":"League of Legends","slug":"league-of-legends"}],"genres":[{"__typename":"Attribute","slug":"trading-card-game-tcg"}],"merchant":null,"affiliateLink":null,"objectRegions":[{"__typename":"ObjectRegion","releases":[{"__typename":"Release","id":"6860cc28-0d7f-4432-a84b-51692a8fafac","date":"2049-12-31","estimatedDate":true,"timeframeYear":"TBA/TBA","platformAttributes":[{"__typename":"Attribute","id":5713891,"name":"Tabletop","slug":"tabletop"}]}],"id":2324012,"name":null,"region":"US"}],"id":"61c59bd1-81b6-4d88-9b18-e20e9ee01635","url":"/games/riftbound-the-league-of-legends-trading-card-game","slug":"riftbound-the-league-of-legends-trading-card-game","type":"Game","metadata":{"__typename":"Metadata","names":{"__typename":"Names","name":"Riftbound: The League of Legends Trading Card Game","alt":["Project K: The League of Legends Trading Card Game"],"short":"Riftbound"}}},"objects":[{"__typename":"Object","id":"61c59bd1-81b6-4d88-9b18-e20e9ee01635","url":"/games/riftbound-the-league-of-legends-trading-card-game","slug":"riftbound-the-league-of-legends-trading-card-game","type":"Game","merchant":null,"affiliateLink":null,"metadata":{"__typename":"Metadata","names":{"__typename":"Names","name":"Riftbound: The League of Legends Trading Card Game","alt":["Project K: The League of Legends Trading Card Game"],"short":"Riftbound"}},"objectRegions":[{"__typename":"ObjectRegion","id":2324012,"name":null,"region":"US","releases":[{"__typename":"Release","id":"6860cc28-0d7f-4432-a84b-51692a8fafac","date":"2049-12-31","platformAttributes":[{"__typename":"Attribute","id":5713891,"name":"Tabletop"}]}]}],"franchises":[{"__typename":"Attribute","name":"League of Legends","slug":"league-of-legends"}]}],"seoTitle":"Riftbound Vendetta Hands-On Preview: Zed vs. Shen Showdown Deck and New Keywords","ogTitle":null,"nonIndexable":false,"abTests":[{"__typename":"ABTest","id":68710,"represents":"promoTitle","values":["Riftbound: Vendetta Hands-On Preview: Zed vs. Shen Showdown Deck and New Keywords","Riftbound: Vendetta Hands-On Preview and Interview"],"winnerIndex":null}],"sponsorships":[],"contentCategory":{"__typename":"ContentCategory","id":2,"name":"Preview"},"brand":null,"sequenceNumber":null,"id":"417ee243-5536-42df-b9c1-c0e150782c71","type":"Article","title":"Riftbound: Vendetta Hands-On Preview: Zed vs. Shen Showdown Deck and New Keywords - IGN","subtitle":"Prepare for Flow, Burn, and Empowered.","promoteAt":null,"publishDate":"2026-07-17T16:00:00.000Z","slug":"riftbound-vendetta-hands-on-preview-zed-vs-shen-showdown-deck-and-new-keywords-interview","feedTitle":"Riftbound: Vendetta Hands-On Preview: Zed vs. Shen Showdown Deck and New Keywords","feedImage":{"__typename":"Image","url":"https://assets-prd.ignimgs.com/2026/07/17/zed-vs-shen-1784263644295.jpg"},"v3Id":null,"url":"/articles/riftbound-vendetta-hands-on-preview-zed-vs-shen-showdown-deck-and-new-keywords-interview","heroVideoContentId":null,"heroVideoContentSlug":"","processedHtml":"\u003csection class=\"article-page\"\u003e\u003cp\u003eRiftbound’s Vendetta is the League of Legends trading card game’s anticipated fourth set, and I got to go hands-on with the new Zed vs. Shen Showdown deck at Riot’s HQ before its release later this month. I played with Riftbound senior designer Jon Moormann, who spoke in depth about the new mechanics and keywords: Empower, Burn, and Flow. \u003c/p\u003e\u003csection data-transform=\"mobile-ad-break\"\u003e\u003c/section\u003e\u003cp\u003eBefore getting into my actual (all-too-short) experience testing out the Zed vs. Shen Showdown deck, here’s some background about those new keywords and some insight about them from Moormann. \u003c/p\u003e\u003ch3\u003e\u003cstrong\u003eNew Keywords: Empower, Burn, and Flow \u003c/strong\u003e\u003c/h3\u003e\u003cp\u003eA keyword in Riftbound is, to put it as simply as possible, a mechanic shared across cards. For example, Unleashed introduced the keywords Ambush and Hunt. So when a new one is introduced, we can expect new strategies to emerge. Here’s what you need to know about three new keywords introduced in Vendetta: \u003c/p\u003e\u003cp\u003e\u003cstrong\u003eEmpower\u003c/strong\u003e is a state you can activate on your turn usually for a cost–either runes or a trigger, like banishing a card. In exchange, the now-Empowered card gains an extra ability or effect. \u003c/p\u003e\u003csection data-transform=\"slideshow\" data-slug=\"empower-cards-in-riftbound-sample\" data-value=\"empower-cards-in-riftbound-sample\" data-type=\"slug\" data-caption=\"\"\u003e\u003c/section\u003e\u003cp\u003eFor example, the Legend Akali’s normal Action effect is, “If it’s your turn, move a friendly unit in a showdown to base.” If you Empower her by exhausting three runes and recycling one, that Action has this additional effect: “... and if I’m Empowered, ready it.”\u003c/p\u003e\u003cp\u003e“You can almost view [Empower] as a different way to draw cards in some ways,” Moormann explained. “It gives colors that maybe have less access to card flow more ways to develop their board over the course of the game.” Essentially, if you have Runes but no cards to play, you can instead spend the energy on Empowering units.\u003c/p\u003e\u003csection data-transform=\"quoteBox\"\u003e“You can almost view [Empower] as a different way to draw cards...\u0026quot;\u003c/section\u003e\u003cp\u003eMoormann specifically called out orange (Body) cards as having a lot of Empower cards that do “really great things,” and that Ambessa, a new red (Fury) and yellow (Order) Legend, also has a lot of “cool Empowered stuff in her kit.” \u003c/p\u003e\u003cp\u003eThe red (Fury) and purple (Chaos) Zed Legend also has an Empower mechanic, as do many of Vendetta’s new Legends. \u003c/p\u003e\u003cp\u003e“They have a base version of their ability, and at some point in the game, you get to upgrade it to the superpowered version,” Moormann said. “Which is one of our favorite things to do with Empowered–it lets us do cool stuff with Legends. You have a two-stage Legend–your Legend is a little weaker in the early game, but you can make an investment to make it better.” \u003c/p\u003e\u003cp\u003e\u003cstrong\u003eBurn \u003c/strong\u003erequires you to put a number of cards from the top of your deck into your trash–and some cards allow you to inflict this on your opponent. If your deck isn’t built specifically for Burn, you’ll probably want to stay away from it, but Burn combos hand-in-hand with Flow. \u003c/p\u003e\u003csection data-transform=\"slideshow\" data-slug=\"burn-cards-in-riftbound-sample\" data-value=\"burn-cards-in-riftbound-sample\" data-type=\"slug\" data-caption=\"\"\u003e\u003c/section\u003e\u003cp\u003e\u003cstrong\u003e\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003eFlow\u003c/strong\u003e allows you to play the card from your trash for its Flow cost, and then requires you to banish it. \u003c/p\u003e\u003cp\u003e“Flow works really well with anything that lets you Burn or Discard… because it\u0026#39;s basically just free cards,” Moormann said. \u003c/p\u003e\u003cp\u003eSince spoilers have begun rolling out, we’ve seen a lot of Legends make use of all of these new mechanics–like Kennen’s. Zed’s deck in the two-player Showdown Deck I played with makes use of them all as well. \u003c/p\u003e\u003csection data-transform=\"slideshow\" data-slug=\"flow-cards-in-riftbound-sample\" data-value=\"flow-cards-in-riftbound-sample\" data-type=\"slug\" data-caption=\"\"\u003e\u003c/section\u003e\u003cp\u003eMoormann said one of the things the team playtested a lot with Zed was Jinx–they wanted to make sure it wasn\u0026#39;t making Jinx superpowered. “I think we landed in a really cool spot where Zed is very strong, but also Jinx gets stronger, which, [I’m] not sad to see. She could use it,” Moormann said. \u003c/p\u003e\u003cp\u003eThe purple Jinx, Rebel, is readied and gets +1 that turn when a card is discarded, and the red Jinx, Demolitionist, discards two when she’s played, so it’s not difficult to consider the combo potential. \u003c/p\u003e\u003cp\u003eAs for other cards that benefit from Burn and Flow, Moormann cited red Rumble, Hotheaded, and a battlefield that’s sometimes run with him, Minefield. \u003cbr /\u003e“Rumble has some sub-themes where he already wants a little bit of Burn, where he probably plays Minefield in order to enable the red Rumble,” Moormann explained. “I think Minefield as a battlefield gets way better in this set because if I\u0026#39;m running a bunch of Flow cards, I\u0026#39;m very happy to get to take two shots at drawing them every time I go in.” \u003c/p\u003e\u003ch3\u003e\u003cstrong\u003eZed vs. Shen Showdown Decks Hands-On \u003c/strong\u003e\u003c/h3\u003e\u003csection data-transform=\"image-with-caption\" data-image-url=\"https://assets-prd.ignimgs.com/2026/07/17/lol-riftbound-s4-render-showdown-front-1784249463606.jpg\" data-image-title=\"undefined\" data-image-class=\"article-image-full-size\" data-image-link=\"https://assets-prd.ignimgs.com/2026/07/17/lol-riftbound-s4-render-showdown-front-1784249463606.jpg\" data-caption=\"%3Cem%3EThe%20box%20for%20the%20Riftbound%20Zed%20vs.%20Shen%20Showdown%20Decks.%3C%2Fem%3E\" /\u003e\u003c/section\u003e\u003cp\u003eNew to Riftbound in Vendetta are two-player Showdown Decks, the first of which is Zed vs. Shen. These boxes include “two complete 56-card preconstructed decks (40 cards + 12 runes, 1 Champion Legend, 3 battlefields per deck) and two Vendetta booster packs,” and retail for$34.99 USD. \u003c/p\u003e\u003cp\u003eMoormann summed up the playstyles succinctly: “Zed wants to go in and hit fast, Shen wants to sit back and protect the point with a friend.” \u003c/p\u003e\u003cp\u003eWhere Legend Zed, Master of Shadows makes a lot of use of the new mechanics, the yellow (Order) and green (Calm) Legend Shen, Eye of Twilight is a bit more straightforward: Action - Exhaust: Give a friendly unit Tank this turn. (It must be assigned combat damage first.) \u003c/p\u003e\u003csection data-transform=\"quoteBox\"\u003e“Zed wants to go in and hit fast, Shen wants to sit back and protect the point with a friend.” \u003c/section\u003e\u003cp\u003e“Shen is a Hold deck, but with a twist,” Moormann explained. “Rather than piling as many units as you can, Shen asks you to get exactly two units into a battlefield, and then pays you off handsomely for the duo defense.” \u003c/p\u003e\u003cp\u003eBoth of Shen’s Champion Units have extra effects when they hold with exactly one other unit. The yellow (Order) Shen, Leader of the Kinkou Order, scores an additional point. The green (Calm) Shen, Scourge of the Shadows, draws one card. \u003c/p\u003e\u003csection data-transform=\"slideshow\" data-slug=\"shen-deck-cards-riftbound-vendetta-shen-vs-zed-showndown-deck\" data-value=\"shen-deck-cards-riftbound-vendetta-shen-vs-zed-showndown-deck\" data-type=\"slug\" data-caption=\"\"\u003e\u003c/section\u003e\u003cp\u003eHypothetically, I can see some buffoonery with extra tanks, the new yellow Shen; Ahri, Alluring, and Hidden Blade. Moormann also said Ahri improves with some of the Shen cards, which is great to hear, personally, as an Ahri fan.\u003c/p\u003e\u003cp\u003e“Zed is much more aggressive, burning through your deck to get Flow cards into the trash and turning them into the offense-focused Shadow Clones,” Moorman explained. \u003c/p\u003e\u003cp\u003eI very foolishly chose to play as Zed, coming in off a high of playing an undefeated, bastardized mostly red and purple Pyke deck made in a sealed deck challenge at the Regional Qualifier in Vancouver. My current constructed deck is Vex, Gloomist, so I’m actually very much used to… holding. \u003c/p\u003e\u003csection data-transform=\"slideshow\" data-slug=\"zed-deck-cards-riftbound-vendetta-shen-vs-zed-showndown-deck\" data-value=\"zed-deck-cards-riftbound-vendetta-shen-vs-zed-showndown-deck\" data-type=\"slug\" data-caption=\"\"\u003e\u003c/section\u003e\u003cp\u003eMoormann out-tempo’d me as Shen, and when my attempts to break his hold were thwarted, I couldn’t replace units fast enough to try again. I also experienced the devastation of putting cards in the trash that would have been clutch when I chose to Burn or Discard, but it was so cool when I \u003cem\u003edid\u003c/em\u003e have stuff in the trash I could use. I’m sure there are failsafes for this, like Fizz, Heedless Resurrection, and some new cards I haven’t seen just yet. \u003c/p\u003e\u003cp\u003eI only got to play that one game, so Shen seemed like an easier deck to play without knowing your cards, but Zed absolutely has a lot of very cool combo potential that I wasn’t knowledgeable enough to unlock on my first go-around. Speaking of potential, I do think a unique Zed deck would have more potential than a Shen deck, but maybe I’ll be surprised with what pros come up with. \u003c/p\u003e\u003cp\u003eWith all that being said, if left constructed the way they are, the preconstructed Shen vs. Zed Showdown decks feel like even match ups. Both do what they want to do very well–Shen is great at holding battlefields with two units, and Zed is great at fiercely attacking while taking advantage of discarding to draw and do other tricks. \u003c/p\u003e\u003csection data-transform=\"quoteBox\"\u003e...the preconstructed Shen vs. Zed Showdown decks feel like even match ups. \u003c/section\u003e\u003cp\u003eThey also explore a \u003cem\u003elot\u003c/em\u003e of Riftbound’s mechanics. Between the two decks, you’ll experiment with Tank, Shield, Assault, Ambush, even movement triggers; and the three new mechanics of Flow, Burn, and Empower, too. Overall, I think this new showdown deck set is a great entry-point into Riftbound, and I could see friends swapping decks back and forth to learn what strategies they vibe with the most. \u003c/p\u003e\u003cp\u003eVendetta, the fourth Riftbound expansion set, releases on July 31 simultaneously worldwide for the first time. It’ll have more than 160 cards, 50 Showcase cards, and nine Champion Legends–setting a new standard for Champion Legends in the future. \u003c/p\u003e\u003cp\u003eYou can get a chance to play with Vendetta early at prerelease events at local game stores starting on July 24, which I highly recommend. They’re incredibly fun and beginner-friendly, and it’s where I got my start with Unleashed. \u003c/p\u003e\u003cp\u003eFor more on Vendetta, check out \u003ca href=\"https://www.ign.com/articles/vendetta-preview-why-riftbounds-design-team-chose-kennen-akali-and-jayce-for-the-first-opposing-domain-legends\"\u003eWhy Riftbound’s Design Team Chose Kennen, Akali, and Jayce for the First Opposing Domain Legends. \u003c/a\u003e\u003c/p\u003e\u003csection data-transform=\"divider\"\u003e\u003c/section\u003e\u003cp\u003e\u003cem\u003eCasey DeFreitas is the deputy editor of guides at IGN. Catch her on socials \u003c/em\u003e\u003ca href=\"https://bsky.app/profile/shinycaseyd.bsky.social\"\u003e\u003cem\u003e@ShinyCaseyD\u003c/em\u003e\u003c/a\u003e\u003cem\u003e. \u003c/em\u003e\u003c/p\u003e\u003c/section\u003e","showCommerceDisclaimer":false,"review":null,"articleId":"417ee243-5536-42df-b9c1-c0e150782c71","isCommunity":"no","resource":"article","pageType":"article","twitterCard":"summary_large_image","hasAds":true,"extraAds":false,"isPreview":false,"pageTitle":"Riftbound: Vendetta Hands-On Preview: Zed vs. Shen Showdown Deck and New Keywords","image":"https://assets-prd.ignimgs.com/2026/07/17/zed-vs-shen-1784263644295.jpg?width=1280\u0026format=jpg\u0026auto=webp\u0026quality=80","description":"I played the Vendetta Zed vs. Shen Showdown decks with Riftbound game designer Jon Moormann, who spoke in depth about the new mechanics and keywords: Empower, Burn, and Flow. ","category":"Preview","categories":["Preview"],"objectId":"61c59bd1-81b6-4d88-9b18-e20e9ee01635","objectSlug":"riftbound-the-league-of-legends-trading-card-game","genreSlugs":["trading-card-game-tcg"],"platforms":["Tabletop"],"platformSlugs":["tabletop"],"franchiseNames":["League of Legends"],"editPage":{"type":"article","params":{"id":"417ee243-5536-42df-b9c1-c0e150782c71"}},"additionalDataLayer":{"content":{"contentId":"417ee243-5536-42df-b9c1-c0e150782c71","objectIds":["61c59bd1-81b6-4d88-9b18-e20e9ee01635"]}},"commercePage":false,"articleType":"Article","schema":[{"@context":"http://schema.org/","mainEntityOfPage":{"@type":"WebPage","@id":"https://www.ign.com/articles/riftbound-vendetta-hands-on-preview-zed-vs-shen-showdown-deck-and-new-keywords-interview"},"image":["https://assets-prd.ignimgs.com/2026/07/17/zed-vs-shen-1784263644295.jpg?width=1200\u0026canvas=1200%2C1200\u0026format=jpg\u0026auto=webp\u0026quality=80","https://asset