<div class="pb-lightbox pb-lightbox--global" id="pb-global-lightbox">
    <button class="pb-lightbox__close" aria-label="Close">&times;</button>
    <button class="pb-lightbox__prev" aria-label="Previous">&lsaquo;</button>
    <button class="pb-lightbox__next" aria-label="Next">&rsaquo;</button>
    <div class="pb-lightbox__image-wrap">
        <img src="" alt="" class="pb-lightbox__image">
    </div>
    <div class="pb-lightbox__counter"></div>
</div>

<script>
// Global Lightbox System - collects all images on the page
(function() {
    const lightbox = document.getElementById('pb-global-lightbox');
    if (!lightbox) return;
    
    const lbImage = lightbox.querySelector('.pb-lightbox__image');
    const lbClose = lightbox.querySelector('.pb-lightbox__close');
    const lbPrev = lightbox.querySelector('.pb-lightbox__prev');
    const lbNext = lightbox.querySelector('.pb-lightbox__next');
    const lbCounter = lightbox.querySelector('.pb-lightbox__counter');
    
    let allImages = [];
    let currentIndex = 0;
    
    // Collect all lightbox-enabled images on the page
    function collectImages() {
        allImages = [];
        const imageElements = document.querySelectorAll('[data-pb-lightbox]');
        imageElements.forEach((el, idx) => {
            el.dataset.pbLightboxIndex = idx;
            allImages.push({
                full: el.dataset.full || el.querySelector('img')?.src || el.style.getPropertyValue('--image')?.replace(/url\(['"]?|['"]?\)/g, ''),
                alt: el.querySelector('img')?.alt || ''
            });
        });
        
        // Update counter visibility
        if (allImages.length <= 1) {
            lbPrev.style.display = 'none';
            lbNext.style.display = 'none';
            lbCounter.style.display = 'none';
        } else {
            lbPrev.style.display = '';
            lbNext.style.display = '';
            lbCounter.style.display = '';
        }
    }
    
    function openLightbox(index) {
        currentIndex = index;
        updateLightbox();
        lightbox.classList.add('is-open');
        document.body.style.overflow = 'hidden';
    }
    
    function closeLightbox() {
        lightbox.classList.remove('is-open');
        document.body.style.overflow = '';
    }
    
    function updateLightbox() {
        if (!allImages[currentIndex]) return;
        lbImage.src = allImages[currentIndex].full;
        lbImage.alt = allImages[currentIndex].alt;
        lbCounter.textContent = (currentIndex + 1) + ' / ' + allImages.length;
    }
    
    function nextImage() {
        currentIndex = (currentIndex + 1) % allImages.length;
        updateLightbox();
    }
    
    function prevImage() {
        currentIndex = (currentIndex - 1 + allImages.length) % allImages.length;
        updateLightbox();
    }
    
    // Event delegation for all lightbox images
    document.addEventListener('click', (e) => {
        const trigger = e.target.closest('[data-pb-lightbox]');
        if (trigger && !trigger.dataset.pbDragged) {
            e.preventDefault();
            // Re-collect to ensure indices are current, then get index
            collectImages();
            const index = parseInt(trigger.dataset.pbLightboxIndex, 10);
            if (!isNaN(index)) {
                openLightbox(index);
            }
        }
    });
    
    // Lightbox controls
    lbClose.addEventListener('click', closeLightbox);
    lbPrev.addEventListener('click', prevImage);
    lbNext.addEventListener('click', nextImage);
    
    lightbox.addEventListener('click', (e) => {
        if (e.target === lightbox || e.target.classList.contains('pb-lightbox__image-wrap')) {
            closeLightbox();
        }
    });
    
    // Keyboard navigation
    document.addEventListener('keydown', (e) => {
        if (!lightbox.classList.contains('is-open')) return;
        if (e.key === 'Escape') closeLightbox();
        if (e.key === 'ArrowRight') nextImage();
        if (e.key === 'ArrowLeft') prevImage();
    });
    
    // Collect images on page load
    collectImages();
    
    // Also collect after a short delay to catch any lazy-loaded content
    setTimeout(collectImages, 1000);
    
    // Expose globally for blocks that need it
    window.pbGlobalLightbox = { collectImages };
})();
</script>

<script>
// Nav scroll behavior - blur when image is under nav, hide once image passes
(function() {
    const nav = document.querySelector('.main-top');
    const imageSection = document.querySelector('.section_article-image');
    if (!nav || !imageSection) return;
    
    const navHeight = 64;
    let lastScrollY = 0;
    
    function handleScroll() {
        const currentScrollY = window.scrollY;
        const imageTop = imageSection.getBoundingClientRect().top;
        const imageBottom = imageSection.getBoundingClientRect().bottom;
        
        // Add blur class when image is under the nav
        if (imageTop < navHeight && imageBottom > 0) {
            nav.classList.add('nav-blurred');
        } else {
            nav.classList.remove('nav-blurred');
        }
        
        // Hide nav when the TOP of the image pushes against the nav
        // "Push effect": Image rising pushes Nav off screen
        if (imageTop <= navHeight) {
             nav.classList.add('nav-hidden');
             
             // If user scrolls UP, bring it back immediately
             if (currentScrollY < lastScrollY) {
                 nav.classList.remove('nav-hidden');
             }
        } else {
             // Image is below nav, ensure nav is visible
             nav.classList.remove('nav-hidden');
        }
        
        lastScrollY = currentScrollY;
    }
    
    window.addEventListener('scroll', handleScroll, { passive: true });
    handleScroll();
})();
</script>

