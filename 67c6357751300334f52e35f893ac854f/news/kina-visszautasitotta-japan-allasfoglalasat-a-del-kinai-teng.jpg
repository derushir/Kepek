        <script type="text/javascript">
    const WAIVE_NOTIFICATION = true;

    function initMarketingPopups() {
        const CMP_VISIBLE = $('#_ao-cmp-ui').length != 0 || $('.qc-cmp2-container').length != 0 ;
        const POPUP_VISIBLE = CMP_VISIBLE == 0 && sticky_footer_visible != 1;
        if (!POPUP_VISIBLE) {
            return;
        }
        invokeNotificationHandler();
        if ($('.notification-popup').length) {
            return;
        }
        invokeSmartbanner();
                    invokeExitPopup();
            };

            /*  */
        function invokeExitPopup() {
            /* 
            */
            const LARGE_SCREEN = window.matchMedia('(min-width: 1120px)').matches;

            const EXPIRE = 1;

            const TITLE  = 'Ezt is ajánljuk';
            
            const TEXT = '<div style="display: grid; grid-template-columns: repeat(' + (LARGE_SCREEN ? 4 : 2) + ', 265px); row-gap: 20px; column-gap: 13px;"><a href=\"https://www.portfolio.hu/gazdasag/20260712/egyre-biztosabb-egy-hidegcsepp-kozeppontja-eppen-magyarorszag-folott-helyezkedik-majd-el-849052\"><img class="img-fluid fullsize" src="https://pcdn.hu/articles/images-xs/i/d/o/idojaras-magyarorszag-vihar-eso-615513.jpg" /> Egyre biztosabb: egy hidegcsepp középpontja éppen Magyarország fölött helyezkedik majd el</a><a href=\"https://www.portfolio.hu/unios-forrasok/20260712/brusszel-uj-frontot-nyitott-a-tet-most-a-mobilunk-feletti-hatalom-848544\"><img class="img-fluid fullsize" src="https://pcdn.hu/articles/images-xs/e/u/r/europai-unio-eu-laptop-okostelefon-kepernyo-digitalizacio-technologia-840810.jpg" /> Brüsszel új frontot nyitott, a tét most a mobilunk feletti hatalom</a><a href=\"https://www.portfolio.hu/gazdasag/20260712/jon-a-bertranszparencia-mire-lesz-joguk-a-dolgozoknak-az-uj-szabalyozas-ertelmeben-848312\"><img class="img-fluid fullsize" src="https://pcdn.hu/articles/images-xs/k/o/n/konyveles-szamla-504224.jpg" /> Jön a bértranszparencia – Mire lesz joguk a dolgozóknak az új szabályozás értelmében?</a><a href=\"https://www.portfolio.hu/gazdasag/20260711/magyar-peter-a-kozvetlen-allamfo-valasztast-tamogatna-fontos-bejelenteseket-is-tett-a-miniszterelnok-849000\"><img class="img-fluid fullsize" src="https://pcdn.hu/articles/images-xs/g/e/t/gettyimages-2282275272-magyar-peter-tisza-part-politikus-politika-ellenzek-sajtotajekoztato-b-840104.jpg" /> Magyar Péter a közvetlen államfő-választást támogatná, fontos bejelentéseket is tett a miniszterelnök</a><a href=\"https://www.portfolio.hu/gazdasag/20260712/del-korea-segitseget-kert-eszak-koreatol-849078\"><img class="img-fluid fullsize" src="https://pcdn.hu/articles/images-xs/g/e/t/gettyimages-2227174524-eszak-korea-del-korea-koreai-felsziget-terkep-azsia-geopolitika-841330.jpg" /> Dél-Korea segítséget kért Észak-Koreától</a><a href=\"https://www.portfolio.hu/gazdasag/20260712/rekordhoseg-utan-jott-a-fontos-bejelentes-a-panelhazakrol-849026\"><img class="img-fluid fullsize" src="https://pcdn.hu/articles/images-xs/d/v/a/dvast20260424003-841296.jpg" /> Rekordhőség után jött a fontos bejelentés a panelházakról</a><a href=\"https://www.portfolio.hu/global/20260711/figyelmeztet-a-hirszerzes-egesz-egyszeru-trukkel-figyelte-meg-oroszorszag-a-nato-szallitmanyokat-848996\"><img class="img-fluid fullsize" src="https://pcdn.hu/articles/images-xs/k/a/m/kamera-437634.jpg" /> Figyelmeztet a hírszerzés: egész egyszerű trükkel figyelte meg Oroszország a NATO-szállítmányokat</a><a href=\"https://www.portfolio.hu/gazdasag/20260711/rakkelto-anyagokat-tartalmazhat-a-magyarorszagon-is-nepszeru-gyerekjatek-849002\"><img class="img-fluid fullsize" src="https://pcdn.hu/articles/images-xs/s/q/u/squishy-gyermekjatek-jatek-rakkelto-anyagok-jatek-gyerek-muanyag-termeszet-zold-szorakozas-ta-841288.jpg" /> Rákkeltő anyagokat tartalmazhat a Magyarországon is népszerű gyerekjáték</a></div>';

            const bioEpOptions = {
                width      : LARGE_SCREEN ? 1140 : 570,
                height     : LARGE_SCREEN ? 620 : 820,
                html       : '<div class="ep-modal-cont"><div class="ep-modal-title">' + TITLE + '</div><div class="ep-modal-text">' + TEXT + '</div></div>',
                css        : '#bio_ep_bg{opacity:.6;}#bio_ep{top:45%;background-color:var(--pf-dark-fix);padding-left:20px;padding-right:20px;overflow:hidden;}#bio_ep .ep-modal-title {font-family:Poppins,Roboto,Arial,Helvetica,sans-serif;text-transform:uppercase;font-size:15px;color:#fd5401;font-weight: 800;padding-top:20px; padding-bottom: 15px;}#bio_ep .ep-modal-text {font-size: 1.1rem; font-weight: bold; line-height:1.3} #bio_ep .ep-modal-text a { color: var(--white-fix);} #bio_ep .ep-modal-text img {height: 150px;margin-bottom:10px} #bio_ep_close {left: auto;color: #b3b3b3;font-size: 30px;font-weight: normal;background-color: transparent;right: 10px;top: 10px;}',
                cookieExp  : EXPIRE,
                delay      : 5,
                showOnDelay: false,
            };
            bioEp.init(bioEpOptions);
        }
    
    function invokeSmartbanner() {
        $.smartbanner({
            daysHidden: 1,
            daysReminder: 1
        });
    }

    $(function(){
        setTimeout(() => initMarketingPopups(), 1000)
    });
</script>
