    <script>
        (function () {
            const rows = document.querySelectorAll('.fifa-top-rows .fifa-row');
            let activeIndex = 0;
            window.setInterval(() => {
                activeIndex = (activeIndex + 1) % rows.length;
                rows.forEach((row, i) => row.classList.toggle('is-visible', i === activeIndex));
            }, 5500);
        })();
    </script>

