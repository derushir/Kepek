/* CAROUSEL */
.last-products h2 {
	color: var(--headings-with-color);
	font-size: 26px;
	font-family: 'PT Sans Narrow', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, 'Open Sans', 'Helvetica Neue', sans-serif;
	margin: 0 0 2rem;
}

.last-products .slider_prev, 
.last-products .slider_next {
    background: var(--link-color) !important;
}

.last-products .slider_prev{
    left: -10px !important;
}

.last-products .slider_next{
    right: -10px !important;
}

.last-products.last-products__home {
	margin-bottom: 60px;
    overflow: hidden;
    width: 1060px;
}

.last-products.last-products__home .last-products-wrapper{
	flex-direction: row;
    align-items: baseline;
}

.last-products.last-products__home .last-products-wrapper a{
	flex-direction: column;
    align-items: center;
    padding: 0 15px;
    text-align: center;
}

.last-products.last-products__home .last-products-wrapper span.count{
	display: none;
}

.last-products.last-products__home .last-products-item{
    display: flex;
    justify-content: center;
    /* margin: 0 !important; */
    /* max-width: 212px; */
    align-items: end;
}

.last-products.last-products__home .last-products-item a figure{
	margin: 0
}

.last-products.last-products__home .last-products-item a img{
	max-height: 150px;
}

@media only screen and (max-width: 1023px) {
    .last-products.last-products__home {
        width: 700px;
    }
}

@media only screen and (max-width: 743px) {
    .last-products.last-products__home{
        padding: 0 15px;
        width: 100%;
        margin: 30px 0;
    }

    .glide .controls {
        display: block !important;
    }

    .last-products.last-products__home .last-products-item a img{
        max-height: 220px;
    }

    .last-products.last-products__home .last-products-wrapper a{
        padding: 0;
    }

    .last-products .slider_prev{
        left: 5px !important;
    }

    .last-products .slider_next{
        right: 5px !important;
    }
}
</style>
<script>
new Glide('.last-products', {
  type: 'carousel',
  perView: 5,
  peek: {
      before: 0,
      after: 0
    },
  breakpoints: {
    1024: {
      perView: 3
    },
    744: {
      perView: 1, 
      focusAt: 'center'
    }
  }
}).mount()
