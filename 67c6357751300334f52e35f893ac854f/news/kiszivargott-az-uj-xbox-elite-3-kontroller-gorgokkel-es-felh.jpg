<script type='text/javascript'>
// GTM Start dataLayer 
window.dataLayer = window.dataLayer || [];

document.addEventListener("DOMContentLoaded", function(){
	fetch('https://tecnoblog.net/wp-admin/admin-ajax.php', {
		method: 'POST',
		body: new URLSearchParams({
			action: 'tb_random_widget'
		})
	})
	.then(response => response.json())
	.then(data => {
		let sidebar_widget = document.getElementById('sidebar_widget');
		sidebar_widget.innerHTML = data.widget.code;

		if(data.widget.script){
			let script = document.createElement('script');
			script.src = data.widget.script;
			sidebar_widget.appendChild(script);
		}
	})
	.catch(err => {
		console.log(err);
	})
});
</script>

