<script type="text/javascript">
	var storedTheme = localStorage.getItem('amp-dark-mode');
	if (storedTheme) document.documentElement.setAttribute('dark-mode', storedTheme);
	
	window.jQueryQueue = []
	window.jQueryQueue.pushExternal = (src, async, defer) => {
		window.jQueryQueue.push(() => {
			var tag = document.createElement('script')
			tag.setAttribute('async', async ||false)
			tag.setAttribute('defer', defer || false)
			tag.setAttribute('src', src)

			document.head.appendChild(tag)
		})
	}
	
		window.tecnoblogUserCanEdit = !!document.cookie.match(/tb_user_logged_in=1[^;]*/);

		window.startTime =  performance.now();
</script>
