        <script>
        (function() {
            const groupLinks = document.querySelectorAll('.group-navigation__link');
            const groupTables = document.querySelectorAll('.m-fixtures[data-group]');
            
            function showGroup(targetGroup) {
                groupLinks.forEach(function(l) {
                    l.classList.remove('active');
                });
                
                const targetLink = document.querySelector('.group-navigation__link[href="#' + targetGroup + '"]');
                if (targetLink) {
                    targetLink.classList.add('active');
                }
                
                groupTables.forEach(function(table) {
                    if (table.getAttribute('data-group') === targetGroup) {
                        table.style.display = 'block';
                    } else {
                        table.style.display = 'none';
                    }
                });
            }
            
            groupLinks.forEach(function(link) {
                link.addEventListener('click', function(e) {
                    e.preventDefault();
                    const targetGroup = this.getAttribute('href').substring(1);
                    showGroup(targetGroup);
                });
            });
            
            // Check for live match and show its group
            const liveMatch = document.querySelector('.vb-cards .card.status-live');
            let defaultGroup = 'A';
            
            if (liveMatch) {
                // Extract group from the stage text (e.g., "Csoportkör A csoport")
                const stageElement = liveMatch.querySelector('.round');
                if (stageElement) {
                    const stageText = stageElement.textContent;
                    const groupMatch = stageText.match(/\b([A-L])\s+csoport/i);
                    if (groupMatch) {
                        defaultGroup = groupMatch[1].toUpperCase();
                    }
                }
            } else {
                // If no live match, check for the next upcoming match
                const upcomingMatch = document.querySelector('.vb-cards .card.status-upcoming');
                if (upcomingMatch) {
                    const stageElement = upcomingMatch.querySelector('.round');
                    if (stageElement) {
                        const stageText = stageElement.textContent;
                        const groupMatch = stageText.match(/\b([A-L])\s+csoport/i);
                        if (groupMatch) {
                            defaultGroup = groupMatch[1].toUpperCase();
                        }
                    }
                }
            }
            
            showGroup(defaultGroup);
        })();
        </script>
    </div>
