<style>.google-pref-banner{display:flex;align-items:center;padding:2px 20px 2px 10px!important; text-align: left; margin: 0px auto 16px auto !important;  border-radius:12px;font-family:inherit;font-size:16px;line-height:22px;font-weight:700;transition:.3s;cursor:pointer;text-decoration:none!important;position:relative; margin: 16px 16px !important; max-width: 840px;}.google-pref-banner .googlelogo{width:42px;height:42px}.google-pref-banner:hover{transform:translateY(-2px);box-shadow:0 4px 12px rgba(0,0,0,.15)}.google-pref-banner.dark{background-color:#323232;color:#fff;border:1px solid #323232}.google-pref-banner.dark .arrow-icon path{fill:#ffffff}.google-pref-banner.light{background-color:#fff;color:#202124;border:1px solid #858585}.google-pref-banner.light .arrow-icon path{fill:#323232}.google-pref-banner .google-icon{width:32px;height:32px;margin-right:16px;flex-shrink:0}.google-pref-banner .banner-text{flex:1;line-height:1.4;text-align:center}.google-pref-banner .arrow-icon{width:11px;height:16px;margin-left:16px;flex-shrink:0;opacity:.7}@media (max-width:768px){.google-pref-banner{padding:12px!important;font-size:14px;margin:8px 12px;width:auto}.google-pref-banner .google-icon{width:40px;height:40px;margin-right:12px}.google-pref-banner .arrow-icon{width:20px;height:20px;margin-left:12px}.google-pref-banner .banner-text{text-align:left}}@media (max-width:480px){.google-pref-banner{padding:12px!important;font-size:14px;margin:8px 12px;width:auto; margin: 16px 12px !important; }.google-pref-banner .google-icon{width:40px;height:40px;margin-right:10px}.google-pref-banner .banner-text{line-height:1.4;text-align:left;margin-left:8px}.google-pref-banner .arrow-icon{width:11px;height:16px;margin-left:12px;}} </style>
