window.addEventListener('scroll', () => {
	if (document.body.classList.contains('dark')) {
		const header = document.querySelector('header');
		if (window.scrollY == 0) {
			header.classList.remove('header-shadow');
		} else {
			header.classList.add('header-shadow');
		}
	}
});
