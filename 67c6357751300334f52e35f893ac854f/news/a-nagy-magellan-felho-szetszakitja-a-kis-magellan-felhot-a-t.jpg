</script><div id="slice-container-authorBio-29dH62h582bBdwUqxxd9JY" class="slice-container slice-author-bio authorBio-29dH62h582bBdwUqxxd9JY slice-container-authorBio"><div class="author author__default-layout author--separator author--collapsible" data-hydrate="true"><div class="author__header"><div class="author__avatar-block"><figure class="image-wrapped__wrapper" data-bordeaux-image-check="false"><div class="image-wrapped__widthsetter" style="max-width:none"><div class="image-wrapped__aspect-padding" style="padding-bottom:56.25%"><div style="display:contents"><picture data-hydrate="false"><source class="author__avatar image-wrapped__image image__image" type="image/webp" srcset="https://cdn.mos.cms.futurecdn.net/ejNtNQxL6D4N3chXfethnP-140-80.jpg.webp 140w" sizes="(min-width: 700px) 140px, 100px" data-normal="https://cdn.mos.cms.futurecdn.net/ejNtNQxL6D4N3chXfethnP.jpg" data-original-mos="https://cdn.mos.cms.futurecdn.net/ejNtNQxL6D4N3chXfethnP.jpg" data-pin-media="https://cdn.mos.cms.futurecdn.net/ejNtNQxL6D4N3chXfethnP.jpg" data-pin-nopin="true" data-slice-image="true" /><source class="author__avatar image-wrapped__image image__image" type="image/jpeg" srcset="https://cdn.mos.cms.futurecdn.net/ejNtNQxL6D4N3chXfethnP-140-80.jpg 140w" sizes="(min-width: 700px) 140px, 100px" data-normal="https://cdn.mos.cms.futurecdn.net/ejNtNQxL6D4N3chXfethnP.jpg" data-original-mos="https://cdn.mos.cms.futurecdn.net/ejNtNQxL6D4N3chXfethnP.jpg" data-pin-media="https://cdn.mos.cms.futurecdn.net/ejNtNQxL6D4N3chXfethnP.jpg" data-pin-nopin="true" data-slice-image="true" /><img src="https://cdn.mos.cms.futurecdn.net/ejNtNQxL6D4N3chXfethnP.jpg" alt="Harry Baker" srcset="https://cdn.mos.cms.futurecdn.net/ejNtNQxL6D4N3chXfethnP-140-80.jpg 140w" sizes="(min-width: 700px) 140px, 100px" class="author__avatar image-wrapped__image image__image" loading="lazy" data-normal="https://cdn.mos.cms.futurecdn.net/ejNtNQxL6D4N3chXfethnP.jpg" data-original-mos="https://cdn.mos.cms.futurecdn.net/ejNtNQxL6