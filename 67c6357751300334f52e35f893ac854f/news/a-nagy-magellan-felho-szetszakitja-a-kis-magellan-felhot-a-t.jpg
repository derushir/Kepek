/* --custom-widget-tailwind-block-- */
#membership-banner-tailwind-1 {
padding: 0;
margin: 0;
height: 0;
/* Responsive Design */
}
#membership-banner-tailwind-1 .flcw-skinnyBanner-content-size {
max-width: 1300px;
}
#membership-banner-tailwind-1 .flcw-text {
color: var(--flcw-membership-skinnybanner-text-color, white);
}
#membership-banner-tailwind-1 .flcw-text-banner {
color: var(--flcw-membership-skinnybanner-sticky-banner-title-text-color, var(--flcw-membership-skinnybanner-text-color, white));
}
#membership-banner-tailwind-1 .flcw-text-popup {
color: var(--flcw-membership-skinnybanner-sticky-banner-title-text-color, var(--flcw-membership-skinnybanner-text-color, white));
}
#membership-banner-tailwind-1 .flcw-text-join-our-community {
color: var(--flcw-membership-skinnybanner-join-our-community-color, white);
}
#membership-banner-tailwind-1 .flcw-card {
background-color: var(--flcw-membership-skinnybanner-card-bg-color, rgba(186, 185, 200, 0.7));
}
#membership-banner-tailwind-1 .flcw-join-now-btn {
background-color: var(--flcw-membership-skinnybanner-join-our-btn-bg-color, rgba(255, 255, 255, 0.2));
}
#membership-banner-tailwind-1 .skinny-banner.show.flw-translate-150 {
transform: translateY(150px);
}
#membership-banner-tailwind-1 .skinny-banner.show {
transform: translateY(0px);
z-index: 9999;
}
#membership-banner-tailwind-1 .skinny-banner-bis.show {
z-index: 9999;
}
#membership-banner-tailwind-1 .flcw-membership-button {
border-radius: var(--flcw-membership-button-border-radius, 31px);
}
@media (max-width: 699px) {
#membership-banner-tailwind-1 .skinny-banner-bis.show {
transform: translateY(60px);
z-index: 9999;
}
#membership-banner-tailwind-1 .skinny-banner-bis.show {
z-index: 9999;
}
}
#membership-banner-tailwind-1 .join-now-text {
display: block;
}
@media (max-width: 460px) {
#membership-banner-tailwind-1 .join-now-text {
display: none;
}
}
#membership-banner-tailwind-1 .btn-find-out-more {
border: 1px solid var(--flcw-membership-skinnybanner-find-out-more-border-color, var(--flexi-brand-color-2)) !important;
}
#membership-banner-tailwind-1 .log-in-btn {
border: 1px solid var(--flcw-membership-skinnybanner-text-color, white) !important;
}
#membership-banner-tailwind-1 .btn-close-popup {
background-color: var(--flcw-membership-skinnybanner-find-out-more-border-color, var(--flexi-brand-color-2)) !important;
}#membership-newsletter-popup-tailwind-2 {
padding: 0 !important;
margin: 0 !important;
height: 0;
}
#membership-newsletter-popup-tailwind-2 .closedPopup {
display: none;
}
#membership-newsletter-popup-tailwind-2 .log-in-btn {
border: 1px solid var(--flcw-membership-skinnybanner-text-color, white) !important;
}
#membership-newsletter-popup-tailwind-2 .flcw-text {
color: var(--flcw-membership-skinnybanner-text-color, white);
}
#membership-newsletter-popup-tailwind-2 .flcw-text-popup {
color: var(--flcw-membership-popup-text-color, white);
}
#membership-newsletter-popup-tailwind-2 .flcw-membership-button {
border-radius: var(--flcw-membership-button-border-radius, 31px);
