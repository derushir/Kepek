}
.kiosq-dropdown label {
position: absolute;
top: 0;
right: 95px;
line-height: 60px;
}
.kiosq-main-layer.kiosq-sticky-layer {
width: calc(100% - 20px);
left: 10px;
}
.kiosq-main-layer.kiosq-header-menu-layer .kiosq-title {
width: 100%;
font-size: 22px;
line-height: 30px;
text-align: center;
