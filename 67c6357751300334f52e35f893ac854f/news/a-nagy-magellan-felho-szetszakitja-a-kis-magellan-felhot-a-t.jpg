}
.kiosq-main-layer.kiosq-header-menu-layer .kiosq-subtitle {
width: 100%;
font-size: 14px;
line-height: 22px;
text-align: center;
order: 3;
}
.kiosq-main-layer.kiosq-header-menu-layer .kiosq-description {
width: 100%;
text-align: center;
margin-bottom: 10px;
