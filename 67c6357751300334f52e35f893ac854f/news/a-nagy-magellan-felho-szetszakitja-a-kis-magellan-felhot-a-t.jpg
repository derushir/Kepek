                    <a href="https://www.livescience.com/space/black-holes/2-supermassive-black-holes-may-collide-100-years-from-now-and-earth-would-feel-it" class="flex gap-2 items-center no-underline text-inherit flex-row" data-before-rewrite-localise="https://www.livescience.com/space/black-holes/2-supermassive-black-holes-may-collide-100-years-from-now-and-earth-would-feel-it">
                            <picture data-new-v2-image="true" class="aspect-square size-[85px] md:size-20 flex-shrink-0">
    <source type="image/webp" srcset="https://cdn.mos.cms.futurecdn.net/GwVdCy2wAw22nJtYL37UwR-250-80.jpg.webp 250w, https://cdn.mos.cms.futurecdn.net/GwVdCy2wAw22nJtYL37UwR-150-80.jpg.webp 150w" sizes="150px" />
    <img src="https://cdn.mos.cms.futurecdn.net/GwVdCy2wAw22nJtYL37UwR.jpg" alt="Two large dark holes are seen close together against a red glowing cosmic background" srcset="https://cdn.mos.cms.futurecdn.net/GwVdCy2wAw22nJtYL37UwR-250-80.jpg 250w, https://cdn.mos.cms.futurecdn.net/GwVdCy2wAw22nJtYL37UwR-150-80.jpg 150w" sizes="150px" loading="lazy" data-new-v2-image="true" data-original-mos="https://cdn.mos.cms.futurecdn.net/GwVdCy2wAw22nJtYL37UwR.jpg" data-pin-media="https://cdn.mos.cms.futurecdn.net/GwVdCy2wAw22nJtYL37UwR.jpg" class="rounded-[var(--image--border-radius,0)] aspect-square size-[85px] md:size-20 object-cover flex-shrink-0" data-pin-nopin="true">
    </picture>
                        <span class="w-full text-base font-[var(--article-river-item--font-weight,500)] font-article-heading line-clamp-3 md:line-clamp-2">2 supermassive black holes may collide 100 years from now &#8234;&mdash;&#8236; and Earth would feel it</span>
                    </a>
