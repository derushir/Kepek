                    <a href="https://www.livescience.com/space/astronomy/astronomers-just-mapped-one-of-the-largest-structures-in-the-universe-long-hidden-behind-the-milky-ways-zone-of-avoidance" class="flex gap-2 items-center no-underline text-inherit flex-row" data-before-rewrite-localise="https://www.livescience.com/space/astronomy/astronomers-just-mapped-one-of-the-largest-structures-in-the-universe-long-hidden-behind-the-milky-ways-zone-of-avoidance">
                            <picture data-new-v2-image="true" class="aspect-square size-[85px] md:size-20 flex-shrink-0">
    <source type="image/webp" srcset="https://cdn.mos.cms.futurecdn.net/thH5eRiKi56mALrPtsKUu9-250-80.jpg.webp 250w, https://cdn.mos.cms.futurecdn.net/thH5eRiKi56mALrPtsKUu9-150-80.jpg.webp 150w" sizes="150px" />
