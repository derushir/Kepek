<div data-widget-type="contentparsed" id="content" class="clear-both widget widget-contentparsed widget-content widget-contentparsed-content widget-content-parsed widget-content-parsed-default ">
<div class="wcp-item-content">
<section class="article-wrapper">
<div class="image image--hero">
<figure class="mb-0">
<picture data-new-v2-image="true" class="block w-full pt-[--aspect-padding] relative" style="--aspect-padding: 56.25%;">
<source type="image/webp" srcset="https://cdn.mos.cms.futurecdn.net/gPhSDiVdA2yTPkKHwbZ5bD-1920-80.jpg.webp 1920w, https://cdn.mos.cms.futurecdn.net/gPhSDiVdA2yTPkKHwbZ5bD-1600-80.jpg.webp 1600w, https://cdn.mos.cms.futurecdn.net/gPhSDiVdA2yTPkKHwbZ5bD-1280-80.jpg.webp 1280w, https://cdn.mos.cms.futurecdn.net/gPhSDiVdA2yTPkKHwbZ5bD-1024-80.jpg.webp 1024w, https://cdn.mos.cms.futurecdn.net/gPhSDiVdA2yTPkKHwbZ5bD-768-80.jpg.webp 768w, https://cdn.mos.cms.futurecdn.net/gPhSDiVdA2yTPkKHwbZ5bD-415-80.jpg.webp 415w" sizes="(min-width: 1024px) 970px, 100vw" />
<img src="https://cdn.mos.cms.futurecdn.net/gPhSDiVdA2yTPkKHwbZ5bD.jpg" alt="A photo of the SMC with multicolor arrows showing the directions its stars are moving" srcset="https://cdn.mos.cms.futurecdn.net/gPhSDiVdA2yTPkKHwbZ5bD-1920-80.jpg 1920w, https://cdn.mos.cms.futurecdn.net/gPhSDiVdA2yTPkKHwbZ5bD-1600-80.jpg 1600w, https://cdn.mos.cms.futurecdn.net/gPhSDiVdA2yTPkKHwbZ5bD-1280-80.jpg 1280w, https://cdn.mos.cms.futurecdn.net/gPhSDiVdA2yTPkKHwbZ5bD-1024-80.jpg 1024w, https://cdn.mos.cms.futurecdn.net/gPhSDiVdA2yTPkKHwbZ5bD-768-80.jpg 768w, https://cdn.mos.cms.futurecdn.net/gPhSDiVdA2yTPkKHwbZ5bD-415-80.jpg 415w" sizes="(min-width: 1024px) 970px, 100vw" data-new-v2-image="true" data-original-mos="https://cdn.mos.cms.futurecdn.net/gPhSDiVdA2yTPkKHwbZ5bD.jpg" data-pin-media="https://cdn.mos.cms.futurecdn.net/gPhSDiVdA2yTPkKHwbZ5bD.jpg" class="rounded-[var(--image--border-radius,0)] block-image-ads absolute top-0 left-0 w-full h-full object-center" data-pin-nopin="true" fetchpriority="high" data-component-name="Image">
</picture>
<figcaption class="font-article-copy text-[var(--image--text--color)] font-article-copy mt-1 image--hero__caption"> <div class="caption__text--hero">A new study shows that the stars within the Small Magellanic Cloud are being dragged apart by the gravitational pull of its big sibling, the Large Magellanic Cloud.</div>
<div class="credit">(Image credit: ESO/VISTA VMC/ AIP/ S. Vijayasree)</div>
</figcaption>
</figure></div>
