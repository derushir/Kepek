/* --flexi-site-css-- */
@layer legacy { @media screen and (min-width: 700px) {
body.flexi-page .navigation__burgerbar #auth-in-nav-header {
right: 11rem;
font-size: 14px;
color: white;
}
}
:root{
/** Membership variables **/
--flcw-membership-skinnybanner-bg-color: var(--flexi-brand-color-2);
--flcw-membership-skinnybanner-mobile-bg-color: var(--flexi-brand-color-1);
--flcw-membership-skinnybanner-sticky-banner-title-text-color: white;
--flcw-membership-skinnybanner-signup-bg-color: white;
--flcw-membership-skinnybanner-signup-color: black;
--flcw-membership-skinnybanner-close-bg-color: white;
--flcw-membership-skinnybanner-close-color: black;
--flcw-membership-skinnybanner-login-bg-color: white;
--flcw-membership-skinnybanner-login-color: black;
--flcw-membership-skinnybanner-join-now-color: white;
--flcw-membership-skinnybanner-join-now-color: black;
--flcw-membership-popup-signup-bg-color: white;
--flcw-membership-popup-signup-color: black;
--flcw-membership-popup-find-out-more-bg-color: white;
--flcw-membership-popup-find-out-more-color: black;
--flcw-membership-popup-login-bg-color: white;
--flcw-membership-popup-login-color: black;
--flcw-membership-landing-page-bg-logo: white;
--flcw-membership-landing-page-logo-width: 230px;
--flcw-membership-landing-page-title-subline-color: #1A98EE;
--flcw-membership-landing-page-hero-join-now-bg-color: #1A98EE;
--flcw-membership-landing-page-feature-inverted-bg-color: #C0D9E4;
}
html{
scroll-behavior: smooth;
}
.author.author--separator {
/** remove blank space due to Ads **/
clear:unset;
}
body.flexi-page .infoVerified-by a {
overflow-wrap: break-word;
} }
/* --flexi-layout-- */
@layer legacy {.widget-area svg {visibility: hidden;}}
/* --flexi-core-- */
