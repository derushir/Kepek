                {
                    "name": "Mennyivel csökken a benzin ára?",
                    "@type": "Question",
                    "acceptedAnswer": {
                        "text": "A benzin nagykereskedelmi ára bruttó 4 forinttal megy lejjebb.",
                        "@type": "Answer"
                    }
                },
                {
                    "name": "Mennyivel csökken a gázolaj ára?",
                    "@type": "Question",
                    "acceptedAnswer": {
                        "text": "A gázolaj nagykereskedelmi ára 10 forinttal lesz olcsóbb.",
                        "@type": "Answer"
                    }
                },
                {
                    "name": "Mennyi most a benzin ára Magyarországon?",
                    "@type": "Question",
                    "acceptedAnswer": {
                        "text": "A 95-ös benzin átlagára jelenleg 640 forint literenként.",
                        "@type": "Answer"
                    }
                },
                {
                    "name": "Mennyi most a dízel ára?",
                    "@type": "Question",
                    "acceptedAnswer": {
                        "text": "A gázolaj átlagára 663 forint literenként.",
                        "@type": "Answer"
                    }
                },
                {
                    "name": "Érzem majd a kúton ezt az árcsökkenést?",
                    "@type": "Question",
                    "acceptedAnswer": {
                        "text": "Közvetlenül nem, mert a védett áras rendszer miatt továbbra is a rögzített áron tankolsz.",
                        "@type": "Answer"
                    }
                },
                {
                    "name": "Mi az a védett áras rendszer?",
                    "@type": "Question",
                    "acceptedAnswer": {
                        "text": "Egy állami szabályozás, ami maximalizálja az üzemanyag árát a kutakon. Emiatt nem a valós piaci árat fizeted, hanem egy rögzített összeget.",
                        "@type": "Answer"
                    }
                },
                {
                    "name": "Miért csökken most az üzemanyag ára?",
                    "@type": "Question",
                    "acceptedAnswer": {
                        "text": "Két ok miatt: az olaj világpiaci ára nagyot esett a közel-keleti békehírek miatt, és közben a forint is erősödött.",
                        "@type": "Answer"
                    }
                },
                {
                    "name": "Mi történne, ha most vezetnék ki a védett áras rendszert?",
                    "@type": "Question",
                    "acceptedAnswer": {
                        "text": "Most sokkal kisebb lenne a hatása, mint az elmúlt hónapokban bármikor. A piaci ár és a védett ár közötti különbség jelentősen csökkent.",
                        "@type": "Answer"
                    }
                },
                {
                    "name": "Mikor szűnhet meg a védett üzemanyagár?",
                    "@type": "Question",
                    "acceptedAnswer": {
                        "text": "A kormány korábban azt mondta, hogy az olajár csökkenéséhez és a forint erősödéséhez köti a kivezetést. Most épp mindkét feltétel javult.",
                        "@type": "Answer"
                    }
                },
                {
                    "name": "Drágább volt tavaly a benzin?",
                    "@type": "Question",
                    "acceptedAnswer": {
                        "text": "Igen, tavaly januárban mindkét üzemanyag literára magasabb volt, mint amennyibe most kerülne védett ár nélkül.",
                        "@type": "Answer"
                    }
                }
            ]
